Rel(c_pr_jobs, d_http_api_employer_accounts, "Calls the API of", "HTTP")
Rel(c_pr_jobs, d_http_api_pas_account, "Calls the API of", "HTTP")
Rel(c_pr_jobs, d_http_api_provider_relationships, "Calls the API of", "HTTP")
Rel(c_pr_jobs, d_http_api_roatp_service, "Calls the API of", "HTTP")

@enduml
