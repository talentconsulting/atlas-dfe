Rel(c_employer_finance_jobs_funding_projection, d_message_broker_azure_service_bus, "Publishes messages to and consumes messages from", "Azure Service Bus")
Rel(c_employer_finance_jobs, d_message_broker_azure_service_bus, "Publishes messages to and consumes messages from", "Azure Service Bus")
Rel(c_employer_finance_jobs_expire_funds, d_telemetry_application_insights, "Sends telemetry to")
Rel(c_employer_finance_jobs_funding_projection, d_telemetry_application_insights, "Sends telemetry to")
Rel(c_employer_finance_jobs_import_levy, d_telemetry_application_insights, "Sends telemetry to")
Rel(c_employer_finance_jobs, d_telemetry_application_insights, "Sends telemetry to")

