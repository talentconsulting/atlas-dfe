{
  "openapi": "3.1.0",
  "info": {
    "title": "Assessor Service API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/standards/{epaoId}": {
      "get": {
        "tags": [
          "Standards"
        ],
        "summary": "Get standards registered by EPAO",
        "operationId": "GetEpaoRegisteredStandards",
        "parameters": [
          {
            "name": "epaoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "requireAtLeastOneVersion",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            }
          },
          {
            "name": "pageIndex",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetEpaoRegisteredStandardsResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
