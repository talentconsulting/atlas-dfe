{
  "openapi": "3.1.0",
  "info": {
    "title": "Assessor Service API",
    "version": "1.0.0",
    "description": "API for managing Assessor Service functionality."
  },
  "paths": {
    "/api/v1/assessor-setting/{name}/{value}": {
      "put": {
        "summary": "Set Assessor Setting",
        "operationId": "SetAssessorSetting",
        "tags": [
          "Setting"
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "value",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The setting was updated successfully."
          },
          "400": {
            "description": "Bad Request - Validation Errors.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequest"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/epa": {
      "post": {
        "summary": "Create EPA Records",
        "operationId": "CreateEpaRecords",
        "tags": [
          "EPA"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/CreateEpaRequest"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Records created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCertificateResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - Batch limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update EPA Records",
        "operationId": "UpdateEpaRecords",
        "tags": [
          "EPA"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/UpdateEpaRequest"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Records updated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateEpaResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - Batch limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/epa/{uln}/{familyName}/{standard}/{epaReference}": {
      "delete": {
        "summary": "Delete EPA Record",
        "operationId": "DeleteEpaRecord",
        "tags": [
          "EPA"
        ],
        "parameters": [
          {
            "name": "uln",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "familyName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "standard",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "epaReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted successfully."
          },
          "403": {
            "description": "Forbidden - Validation errors.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BadRequest": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "ApiResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "statusCode"
        ]
      },
      "CreateEpaRequest": {
        "type": "object",
        "properties": {
          "RequestId": {
            "type": "string"
          },
          "Standard": {
            "$ref": "#/components/schemas/Standard"
          },
          "Learner": {
            "$ref": "#/components/schemas/Learner"
          },
          "LearningDetails": {
            "$ref": "#/components/schemas/LearningDetails"
          },
          "EpaDetails": {
            "$ref": "#/components/schemas/EpaDetails"
          }
        },
        "required": [
          "RequestId",
          "Standard",
          "Learner",
          "EpaDetails"
        ]
      },
      "UpdateEpaRequest": {
        "type": "object",
        "properties": {
          "RequestId": {
            "type": "string"
          },
          "Standard": {
            "$ref": "#/components/schemas/Standard"
          },
          "Learner": {
            "$ref": "#/components/schemas/Learner"
          },
          "EpaReference": {
            "type": "string"
          },
          "LearningDetails": {
            "$ref": "#/components/schemas/LearningDetails"
          },
          "EpaDetails": {
            "$ref": "#/components/schemas/EpaDetails"
          }
        },
        "required": [
          "RequestId",
          "Standard",
          "Learner",
          "EpaDetails",
          "EpaReference"
        ]
      },
      "CreateCertificateResponse": {
        "type": "object",
        "properties": {
          "RequestId": {
            "type": "string"
          },
          "Certificate": {
            "type": "object"
          },
          "ValidationErrors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "UpdateEpaResponse": {
        "type": "object",
        "properties": {
          "RequestId": {
            "type": "string"
          },
          "EpaReference": {
            "type": "string"
          },
          "ValidationErrors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Learner": {
        "type": "object",
        "properties": {
          "Uln": {
            "type": "integer",
            "format": "int64"
          },
          "FamilyName": {
            "type": "string"
          }
        },
        "required": [
          "Uln",
          "FamilyName"
        ]
      },
      "LearningDetails": {
        "type": "object",
        "properties": {
          "CourseOption": {
            "type": "string"
          },
          "OverallGrade": {
            "type": "string"
          },
          "AchievementDate": {
            "type": "string",
            "format": "date-time"
          },
          "Version": {
            "type": "string"
          }
        },
        "required": [
          "OverallGrade",
          "AchievementDate"
        ]
      },
      "EpaDetails": {
        "type": "object",
        "properties": {
          "Epas": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "EpaDate": {
                  "type": "string",
                  "format": "date-time"
                },
                "EpaOutcome": {
                  "type": "string"
                }
              },
              "required": [
                "EpaDate",
                "EpaOutcome"
              ]
            }
          }
        },
        "required": [
          "Epas"
        ]
      },
      "Standard": {
        "type": "object",
        "properties": {
          "StandardCode": {
            "type": "integer",
            "format": "int32"
          },
          "StandardReference": {
            "type": "string"
          }
        }
      }
    }
  }
}
