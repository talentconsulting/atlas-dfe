{
  "openapi": "3.1.0",
  "info": {
    "title": "Staff Reports API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/staffreports": {
      "get": {
        "tags": [
          "StaffReports"
        ],
        "summary": "Get a list of staff reports",
        "operationId": "GetReportList",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StaffReport"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      }
    },
    "/api/v1/staffreports/{reportId}/report-type": {
      "get": {
        "tags": [
          "StaffReports"
        ],
        "summary": "Get the type of a specific report",
        "operationId": "GetReportTypeFromId",
        "parameters": [
          {
            "name": "reportId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportType"
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      }
    },
    "/api/v1/staffreports/{reportId}/report-details": {
      "get": {
        "tags": [
          "StaffReports"
        ],
        "summary": "Get detailed information about a specific report",
        "operationId": "GetReportDetailsFromId",
        "parameters": [
          {
            "name": "reportId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportDetails"
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      }
    },
    "/api/v1/staffreports/report-content/{storedProcedure}": {
      "get": {
        "tags": [
          "StaffReports"
        ],
        "summary": "Generate report content using a stored procedure",
        "operationId": "GetWorksheetContent",
        "parameters": [
          {
            "name": "storedProcedure",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      }
    },
    "/api/v1/staffreports/{reportId}": {
      "get": {
        "tags": [
          "StaffReports"
        ],
        "summary": "Generate a report based on its ID",
        "operationId": "GetReport",
        "parameters": [
          {
            "name": "reportId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "StaffReport": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "reportName": {
            "type": "string"
          },
          "storedProcedure": {
            "type": "string"
          },
          "displayOrder": {
            "type": "integer",
            "nullable": true
          },
          "reportType": {
            "type": "string"
          },
          "reportDetails": {
            "type": "string"
          }
        }
      },
      "ReportType": {
        "type": "string",
        "enum": [
          "ViewOnScreen",
          "Download"
        ]
      },
      "ReportDetails": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "worksheets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorksheetDetails"
            }
          }
        }
      },
      "WorksheetDetails": {
        "type": "object",
        "properties": {
          "worksheet": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          },
          "storedProcedure": {
            "type": "string"
          }
        }
      },
      "ApiResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "message": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode"
        ]
      }
    },
    "securitySchemes": {
      "Authorization": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
