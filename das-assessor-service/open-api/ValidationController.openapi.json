{
  "openapi": "3.1.0",
  "info": {
    "title": "Validation and EPA Service API",
    "version": "1.0.0",
    "description": "This API provides endpoints for validation operations and managing EPA records."
  },
  "paths": {
    "/api/validation/is-phonenumber-format/{phoneNumberToValidate}": {
      "get": {
        "summary": "Validate if the provided string is a valid phone number format",
        "operationId": "ValidatePhoneNumber",
        "parameters": [
          {
            "name": "phoneNumberToValidate",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Validation result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/validation/is-email-format/{emailToValidate}": {
      "get": {
        "summary": "Validate if the provided string is a valid email format",
        "operationId": "ValidateEmail",
        "parameters": [
          {
            "name": "emailToValidate",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Validation result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/validation/is-websitelink-format": {
      "get": {
        "summary": "Validate if the provided string is a valid website link format",
        "operationId": "ValidateWebsiteLink",
        "parameters": [
          {
            "name": "websiteLinkToValidate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Validation result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/epa": {
      "post": {
        "summary": "Create EPA records",
        "operationId": "CreateEpaRecords",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/CreateEpaRequest"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created EPA records or validation errors",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CreateCertificateResponse"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Too many EPA records specified within the request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update EPA records",
        "operationId": "UpdateEpaRecords",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/UpdateEpaRequest"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated EPA records or validation errors",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UpdateEpaResponse"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Too many EPA records specified within the request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/epa/{uln}/{familyName}/{standard}/{epaReference}": {
      "delete": {
        "summary": "Delete EPA record",
        "operationId": "DeleteEpaRecord",
        "parameters": [
          {
            "name": "uln",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "familyName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "standard",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "epaReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The specified EPA record has been deleted."
          },
          "403": {
            "description": "Validation errors preventing the deletion of the EPA record",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "ApiResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CreateEpaRequest": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "standard": {
            "$ref": "#/components/schemas/Standard"
          },
          "learner": {
            "$ref": "#/components/schemas/Learner"
          },
          "learningDetails": {
            "$ref": "#/components/schemas/LearningDetails"
          },
          "epaDetails": {
            "$ref": "#/components/schemas/EpaDetails"
          }
        }
      },
      "Standard": {
        "type": "object",
        "properties": {
          "standardCode": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "standardReference": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Learner": {
        "type": "object",
        "properties": {
          "uln": {
            "type": "integer",
            "format": "int64"
          },
          "familyName": {
            "type": "string"
          }
        }
      },
      "LearningDetails": {
        "type": "object",
        "properties": {
          "courseOption": {
            "type": "string",
            "nullable": true
          },
          "overallGrade": {
            "type": "string"
          },
          "achievementDate": {
            "type": "string",
            "format": "date"
          },
          "version": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "EpaDetails": {
        "type": "object",
        "properties": {
          "epas": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "CreateCertificateResponse": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "certificate": {
            "type": "object",
            "nullable": true
          },
          "validationErrors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "UpdateEpaRequest": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "epaReference": {
            "type": "string"
          },
          "learner": {
            "$ref": "#/components/schemas/Learner"
          },
          "learningDetails": {
            "$ref": "#/components/schemas/LearningDetails"
          },
          "standard": {
            "$ref": "#/components/schemas/Standard"
          },
          "epaDetails": {
            "$ref": "#/components/schemas/EpaDetails"
          }
        }
      },
      "UpdateEpaResponse": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "validationErrors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
