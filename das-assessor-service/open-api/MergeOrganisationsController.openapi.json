{
  "openapi": "3.1.0",
  "info": {
    "title": "Assessment Organisation Management API",
    "version": "1.0.0",
    "description": "API for managing assessment organisations, including merging organisations, EPA records, and retrieving logs."
  },
  "paths": {
    "/api/v1/mergeorganisations": {
      "post": {
        "operationId": "MergeOrganisations",
        "summary": "Merge organisations.",
        "tags": [
          "MergeOrganisations"
        ],
        "security": [
          {
            "Authorization": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MergeOrganisationsRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {}
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/mergeorganisations/{id}": {
      "get": {
        "operationId": "GetMergeOrganisation",
        "summary": "Retrieve details of a merged organisation log by ID.",
        "tags": [
          "MergeOrganisations"
        ],
        "security": [
          {
            "Authorization": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MergeLogEntry"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {}
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/mergeorganisations/log": {
      "get": {
        "operationId": "GetMergeLog",
        "summary": "Retrieve a paginated merge log based on query parameters.",
        "tags": [
          "MergeOrganisations"
        ],
        "security": [
          {
            "Authorization": []
          }
        ],
        "parameters": [
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "pageIndex",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "orderBy",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "orderDirection",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "primaryEPAOId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "secondaryEPAOId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MergeLogEntry"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {}
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MergeOrganisationsRequest": {
        "type": "object",
        "properties": {
          "primaryEndPointAssessorOrganisationId": {
            "type": "string"
          },
          "secondaryEndPointAssessorOrganisationId": {
            "type": "string"
          },
          "secondaryStandardsEffectiveTo": {
            "type": "string",
            "format": "date-time"
          },
          "actionedByUser": {
            "type": "string"
          }
        },
        "required": [
          "primaryEndPointAssessorOrganisationId",
          "secondaryEndPointAssessorOrganisationId",
          "secondaryStandardsEffectiveTo",
          "actionedByUser"
        ]
      },
      "MergeLogEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "primaryEndPointAssessorOrganisationName": {
            "type": "string"
          },
          "secondaryEndPointAssessorOrganisationName": {
            "type": "string"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "secondaryEpaoEffectiveTo": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ApiResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
