{
  "openapi": "3.1.0",
  "info": {
    "title": "Organisation Search API",
    "version": "1.0.0",
    "description": "API for searching and retrieving details about organisations such as charities, companies, and EPAOs."
  },
  "paths": {
    "/api/v1/organisationsearch/organisations": {
      "get": {
        "summary": "Search Organisations",
        "description": "Search for organisations based on various criteria including name, UKPRN, EPAO ID, company number, or charity number.",
        "tags": [
          "Organisation Search"
        ],
        "parameters": [
          {
            "name": "searchTerm",
            "in": "query",
            "description": "Search term for organisation lookup.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Number of items per page.",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "pageIndex",
            "in": "query",
            "description": "Page number for paginated results.",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of organisation search results.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedListOrganisationSearchResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/organisationsearch/company/{companyNumber}/isActivelyTrading": {
      "get": {
        "summary": "Check if Company is Actively Trading",
        "description": "Determines whether a company with the given company number is actively trading.",
        "tags": [
          "Companies"
        ],
        "parameters": [
          {
            "name": "companyNumber",
            "in": "path",
            "description": "Company number.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Boolean value indicating if the company is actively trading.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/organisationsearch/company/{companyNumber}": {
      "get": {
        "summary": "Get Company Details",
        "description": "Retrieves full details of a company with the specified company number.",
        "tags": [
          "Companies"
        ],
        "parameters": [
          {
            "name": "companyNumber",
            "in": "path",
            "description": "Company number.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Company details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Company"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/organisationsearch/charity/{charityNumber}": {
      "get": {
        "summary": "Get Charity Details",
        "description": "Retrieves full details of a charity with the specified charity number.",
        "tags": [
          "Charities"
        ],
        "parameters": [
          {
            "name": "charityNumber",
            "in": "path",
            "description": "Charity number.",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Charity details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Charity"
                }
              }
            }
          }
        }
      }
    }
  },
