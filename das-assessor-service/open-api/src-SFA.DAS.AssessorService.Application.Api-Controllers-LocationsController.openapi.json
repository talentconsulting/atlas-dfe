{
  "openapi": "3.1.0",
  "info": {
    "title": "Assessor Service API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/locations": {
      "get": {
        "operationId": "SearchLocations",
        "summary": "Search for any locations matching query",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AddressResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/epa": {
      "post": {
        "operationId": "CreateEpaRecords",
        "summary": "Create EPA Records",
        "description": "Creates an initial EPA record for each valid item within the request.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/CreateEpaRequest"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "EPA records created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CreateCertificateResponse"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Too many requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "UpdateEpaRecords",
        "summary": "Update EPA Records",
        "description": "Updates the specified EPA record with the information contained in each valid request.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/UpdateEpaRequest"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "EPA records updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UpdateEpaResponse"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Too many requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/epa/{uln}/{familyName}/{standard}/{epaReference}": {
      "delete": {
        "operationId": "DeleteEpaRecord",
        "summary": "Delete EPA Record",
        "description": "Deletes the specified EPA record.",
        "parameters": [
          {
            "name": "uln",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "familyName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "standard",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "epaReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddressResponse": {
        "type": "object",
        "properties": {
          "Uprn": {
            "type": "string"
          },
          "Organisation": {
            "type": "string"
          },
          "Premises": {
            "type": "string"
          },
          "Thoroughfare": {
            "type": "string"
          },
          "Locality": {
            "type": "string"
          },
          "Town": {
            "type": "string"
          },
          "County": {
            "type": "string"
          },
          "Postcode": {
            "type": "string"
          },
          "AddressLine1": {
            "type": "string"
          },
          "AddressLine2": {
            "type": "string"
          },
          "AddressLine3": {
            "type": "string"
          },
          "Longitude": {
            "type": "number",
            "format": "float"
          },
          "Latitude": {
            "type": "number",
            "format": "float"
          },
          "Match": {
            "type": "number",
            "format": "float"
          },
          "Text": {
            "type": "string"
          }
        }
      },
      "ApiResponse": {
        "type": "object",
        "properties": {
          "StatusCode": {
            "type": "integer",
            "format": "int32"
          },
          "Message": {
            "type": "string"
          }
        }
      },
      "CreateEpaRequest": {
        "type": "object",
        "properties": {
          "RequestId": {
            "type": "string"
          },
          "Standard": {
            "$ref": "#/components/schemas/Standard"
          },
          "Learner": {
            "$ref": "#/components/schemas/Learner"
          },
          "LearningDetails": {
            "$ref": "#/components/schemas/LearningDetails"
          },
          "EpaDetails": {
            "$ref": "#/components/schemas/EpaDetails"
          }
        }
      },
      "CreateCertificateResponse": {
        "type": "object",
        "properties": {
          "RequestId": {
            "type": "string"
          },
          "Certificate": {
            "type": "object"
          },
          "ValidationErrors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "UpdateEpaRequest": {
        "type": "object",
        "properties": {
          "RequestId": {
            "type": "string"
          },
          "EpaReference": {
            "type": "string"
          },
          "Learner": {
            "$ref": "#/components/schemas/Learner"
          },
          "LearningDetails": {
            "$ref": "#/components/schemas/LearningDetails"
          },
          "Standard": {
            "$ref": "#/components/schemas/Standard"
          },
          "EpaDetails": {
            "$ref": "#/components/schemas/EpaDetails"
          }
        }
      },
      "UpdateEpaResponse": {
        "type": "object",
        "properties": {
          "RequestId": {
            "type": "string"
          },
          "ValidationErrors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Standard": {
        "type": "object",
        "properties": {
          "StandardCode": {
            "type": "integer"
          },
          "StandardReference": {
            "type": "string"
          }
        }
      },
      "Learner": {
        "type": "object",
        "properties": {
          "FamilyName": {
            "type": "string"
          },
          "Uln": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "LearningDetails": {
        "type": "object",
        "properties": {
          "Version": {
            "type": "string"
          },
          "CourseOption": {
            "type": "string"
          }
        }
      },
      "EpaDetails": {
        "type": "object",
        "properties": {
          "Epas": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "EpaDate": {
                  "type": "string",
                  "format": "date-time"
                },
                "EpaOutcome": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
