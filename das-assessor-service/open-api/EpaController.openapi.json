{
  "openapi": "3.1.0",
  "info": {
    "title": "Epa Service API",
    "description": "API for managing End Point Assessment (EPA) records.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/epa": {
      "post": {
        "summary": "Create EPA Records",
        "description": "Creates an initial EPA record for each valid item within the request.",
        "operationId": "CreateEpaRecords",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/CreateEpaRequest"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "For each item: The created EPA record if valid, else a list of validation errors.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CreateCertificateResponse"
                  }
                }
              }
            }
          },
          "403": {
            "description": "There are too many EPA records specified within the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update EPA Records",
        "description": "Updates the specified EPA record with the information contained in each valid request.",
        "operationId": "UpdateEpaRecords",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/UpdateEpaRequest"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "For each item: The updated EPA records if valid, else a list of validation errors.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UpdateEpaResponse"
                  }
                }
              }
            }
          },
          "403": {
            "description": "There are too many EPA records specified within the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/epa/{uln}/{familyName}/{standard}/{epaReference}": {
      "delete": {
        "summary": "Delete EPA Record",
        "description": "Deletes the specified EPA record.",
        "operationId": "DeleteEpaRecord",
        "parameters": [
          {
            "name": "uln",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "familyName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "standard",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "epaReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The specified EPA record has been deleted."
          },
          "403": {
            "description": "There are validation errors preventing you from deleting the EPA record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer",
            "example": 403
          },
          "message": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode"
        ]
      },
      "CreateEpaRequest": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "standard": {
            "$ref": "#/components/schemas/Standard"
          },
          "learner": {
            "$ref": "#/components/schemas/Learner"
          },
          "learningDetails": {
            "$ref": "#/components/schemas/LearningDetails"
          },
          "epaDetails": {
            "$ref": "#/components/schemas/EpaDetails"
          }
        },
        "required": [
          "requestId",
          "standard",
          "learner",
          "learningDetails",
          "epaDetails"
        ]
      },
      "CreateCertificateResponse": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "certificate": {
            "$ref": "#/components/schemas/Certificate"
          },
          "validationErrors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "requestId"
        ]
      },
      "UpdateEpaRequest": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "epaReference": {
            "type": "string"
          },
          "standard": {
            "$ref": "#/components/schemas/Standard"
          },
          "learner": {
            "$ref": "#/components/schemas/Learner"
          },
          "learningDetails": {
            "$ref": "#/components/schemas/LearningDetails"
          },
          "epaDetails": {
            "$ref": "#/components/schemas/EpaDetails"
          }
        },
        "required": [
          "requestId",
          "epaReference",
          "standard",
          "learner",
          "learningDetails",
          "epaDetails"
        ]
      },
      "UpdateEpaResponse": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "epaReference": {
            "type": "string",
            "nullable": true
          },
          "validationErrors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "requestId"
        ]
      },
      "Standard": {
        "type": "object",
        "properties": {
          "standardCode": {
            "type": "integer",
            "nullable": true
          },
          "standardReference": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Learner": {
        "type": "object",
        "properties": {
          "uln": {
            "type": "integer",
            "format": "int64"
          },
          "familyName": {
            "type": "string"
          }
        },
        "required": [
          "uln",
          "familyName"
        ]
      },
      "LearningDetails": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "nullable": true
          },
          "courseOption": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "EpaDetails": {
        "type": "object",
        "properties": {
          "epas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EpaRecord"
            }
          }
        },
        "required": [
          "epas"
        ]
      },
      "EpaRecord": {
        "type": "object",
        "properties": {
          "epaDate": {
            "type": "string",
            "format": "date-time"
          },
          "epaOutcome": {
            "type": "string"
          }
        },
        "required": [
          "epaDate",
          "epaOutcome"
        ]
      },
      "Certificate": {
        "type": "object",
        "properties": {
          "certificateData": {
            "type": "object"
          },
          "status": {
            "type": "object"
          }
        },
        "nullable": true
      }
    }
  }
}
