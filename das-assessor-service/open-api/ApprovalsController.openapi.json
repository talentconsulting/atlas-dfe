{
  "openapi": "3.1.0",
  "info": {
    "title": "Assessor Service API",
    "version": "1.0.0",
    "description": "API documentation for the Assessor Service."
  },
  "paths": {
    "/api/approvals/update-approvals": {
      "post": {
        "operationId": "GatherAndStoreApprovals",
        "summary": "Gather and store approvals",
        "responses": {
          "202": {
            "description": "Request accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/approvals/learner": {
      "get": {
        "operationId": "GetLearner",
        "summary": "Retrieve learner record",
        "parameters": [
          {
            "name": "stdCode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Standard code for the learner."
          },
          {
            "name": "uln",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Unique learner number."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          },
          "404": {
            "description": "Learner not found"
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/epa": {
      "post": {
        "operationId": "CreateEpaRecords",
        "summary": "Create EPA records",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/CreateEpaRequest"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "EPA records created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CreateCertificateResponse"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Too many EPA records specified",
            "content": {
              "application/json": {
                "$ref": "#/components/schemas/ApiResponse"
              }
            }
          }
        }
      },
      "put": {
        "operationId": "UpdateEpaRecords",
        "summary": "Update EPA records",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/UpdateEpaRequest"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "EPA records updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UpdateEpaResponse"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Too many EPA records specified",
            "content": {
              "application/json": {
                "$ref": "#/components/schemas/ApiResponse"
              }
            }
          }
        }
      }
    },
    "/api/v1/epa/{uln}/{familyName}/{standard}/{epaReference}": {
      "delete": {
        "operationId": "DeleteEpaRecord",
        "summary": "Delete EPA record",
        "parameters": [
          {
            "name": "uln",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "familyName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "standard",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "epaReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "EPA record deleted successfully"
          },
          "403": {
            "description": "Validation errors preventing deletion",
            "content": {
              "application/json": {
                "$ref": "#/components/schemas/ApiResponse"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ImportApprovalsRequest": {
        "type": "object",
        "description": "Request to import approvals"
      },
      "CreateEpaRequest": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "standard": {
            "$ref": "#/components/schemas/Standard"
          },
          "learner": {
            "$ref": "#/components/schemas/Learner"
          },
          "learningDetails": {
            "$ref": "#/components/schemas/LearningDetails"
          },
          "epaDetails": {
            "$ref": "#/components/schemas/EpaDetails"
          }
        }
      },
      "Learner": {
        "type": "object",
        "properties": {
          "uln": {
            "type": "integer",
            "format": "int64"
          },
          "familyName": {
            "type": "string"
          }
        }
      },
      "Standard": {
        "type": "object",
        "properties": {
          "standardCode": {
            "type": "integer"
          },
          "standardReference": {
            "type": "string"
          }
        }
      },
      "LearningDetails": {
        "type": "object",
        "properties": {
          "courseOption": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "EpaDetails": {
        "type": "object",
        "properties": {
          "epas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EpaRecord"
            }
          }
        }
      },
      "EpaRecord": {
        "type": "object",
        "properties": {
          "epaDate": {
            "type": "string",
            "format": "date-time"
          },
          "epaOutcome": {
            "type": "string"
          }
        }
      },
      "CreateCertificateResponse": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "validationErrors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "UpdateEpaRequest": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "epaReference": {
            "type": "string"
          },
          "learner": {
            "$ref": "#/components/schemas/Learner"
          },
          "learningDetails": {
            "$ref": "#/components/schemas/LearningDetails"
          },
          "standard": {
            "$ref": "#/components/schemas/Standard"
          },
          "epaDetails": {
            "$ref": "#/components/schemas/EpaDetails"
          }
        }
      },
      "UpdateEpaResponse": {
        "type": "object",
        "properties": {
          "validationErrors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "epaReference": {
            "type": "string"
          }
        }
      },
      "DeleteBatchEpaRequest": {
        "type": "object",
        "properties": {
          "uln": {
            "type": "integer",
            "format": "int64"
          },
          "familyName": {
            "type": "string"
          },
          "standard": {
            "type": "string"
          },
          "epaReference": {
            "type": "string"
          }
        }
      }
    }
  }
}
