{
  "openapi": "3.1.0",
  "info": {
    "title": "Certificate Check API",
    "version": "1.0.0"
  },
  "paths": {
    "/certificate/check": {
      "get": {
        "summary": "Retrieve the certificate check view",
        "operationId": "getCertificateCheckView",
        "parameters": [],
        "responses": {
          "302": {
            "description": "Redirect to the Search page if the session is not available"
          },
          "200": {
            "description": "Successful retrieval of CertificateCheckView",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateCheckViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Submit certificate check data",
        "operationId": "postCertificateCheckData",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CertificateCheckViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to the confirmation page if valid"
          },
          "200": {
            "description": "Validation errors occurred. Returns another CertificateCheckView"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CertificateCheckViewModel": {
        "type": "object",
        "properties": {
          "Option": {
            "type": "string",
            "nullable": true
          },
          "Version": {
            "type": "string",
            "nullable": true
          },
          "SelectedGrade": {
            "type": "string",
            "nullable": true
          },
          "SelectedUkPrn": {
            "type": "string",
            "nullable": true
          },
          "SelectedStandard": {
            "type": "string",
            "nullable": true
          },
          "AchievementDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "LearnerStartDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "StandardHasSingleOption": {
            "type": "boolean"
          },
          "StandardHasOptions": {
            "type": "boolean"
          },
          "StandardHasSingleVersion": {
            "type": "boolean"
          },
          "Name": {
            "type": "string",
            "nullable": true
          },
          "Dept": {
            "type": "string",
            "nullable": true
          },
          "Employer": {
            "type": "string",
            "nullable": true
          },
          "AddressLine1": {
            "type": "string",
            "nullable": true
          },
          "AddressLine2": {
            "type": "string",
            "nullable": true
          },
          "AddressLine3": {
            "type": "string",
            "nullable": true
          },
          "City": {
            "type": "string",
            "nullable": true
          },
          "Postcode": {
            "type": "string",
            "nullable": true
          },
          "FirstName": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
