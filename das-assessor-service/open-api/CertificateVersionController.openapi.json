          },
          "standardReference": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "standardName": {
            "type": "string"
          },
          "standardLevel": {
            "type": "integer"
          },
          "coronationEmblem": {
            "type": "boolean"
          },
          "standardPublicationDate": {
            "type": "string",
            "format": "date-time"
          },
          "contactName": {
            "type": "string"
          },
          "contactOrganisation": {
