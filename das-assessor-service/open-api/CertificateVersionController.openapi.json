{
  "openapi": "3.1.0",
  "info": {
    "title": "Certificate Version Service",
    "description": "API for managing certificate versions and related operations.",
    "version": "1.0.0"
  },
  "paths": {
    "/certificate/version": {
      "get": {
        "summary": "Get Certificate Version",
        "description": "Retrieve the certificate version view or redirect to other views based on session information.",
        "parameters": [
          {
            "name": "redirectToCheck",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "View rendered successfully"
          },
          "302": {
            "description": "Redirected to another page"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      },
      "post": {
        "summary": "Select Certificate Version",
        "description": "Submit the selected certificate version details.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CertificateVersionViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully processed the certificate version"
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CertificateVersionViewModel": {
        "type": "object",
        "properties": {
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StandardVersionViewModel"
            }
          },
          "selectedStandardVersion": {
            "$ref": "#/components/schemas/StandardVersion"
          },
          "selectedStandardOptions": {
            "$ref": "#/components/schemas/StandardOptions"
          },
          "previousFailData": {
            "$ref": "#/components/schemas/CertificateData"
          }
        }
      },
      "StandardVersionViewModel": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "standardUId": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "StandardVersion": {
