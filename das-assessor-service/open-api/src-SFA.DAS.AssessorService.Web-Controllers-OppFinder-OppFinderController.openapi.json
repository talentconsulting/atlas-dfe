{
  "openapi": "3.1.0",
  "info": {
    "title": "Opportunity Finder API",
    "version": "1.0.0"
  },
  "paths": {
    "/find-an-assessment-opportunity": {
      "get": {
        "operationId": "Index",
        "responses": {
          "200": {
            "description": "Render the index view."
          }
        }
      }
    },
    "/find-an-assessment-opportunity/ResetSession": {
      "get": {
        "operationId": "ResetSession",
        "responses": {
          "302": {
            "description": "Redirect to the opportunity finder route after resetting the session."
          }
        }
      }
    },
    "/find-an-assessment-opportunity/ContactUs": {
      "get": {
        "operationId": "ContactUs",
        "responses": {
          "200": {
            "description": "Render the contact us view."
          }
        }
      }
    },
    "/find-an-assessment-opportunity/Cookies": {
      "get": {
        "operationId": "Cookies",
        "responses": {
          "200": {
            "description": "Render the cookies view."
          }
        }
      }
    },
    "/find-an-assessment-opportunity/Privacy": {
      "get": {
        "operationId": "Privacy",
        "responses": {
          "200": {
            "description": "Render the privacy view."
          }
        }
      }
    },
    "/find-an-assessment-opportunity/Error": {
      "get": {
        "operationId": "Error",
        "responses": {
          "200": {
            "description": "Render the error view with associated error information."
          }
        }
      }
    },
    "/find-an-assessment-opportunity/Search": {
      "get": {
        "operationId": "Search",
        "parameters": [
          {
            "name": "searchTerm",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Render search results view."
          }
        }
      }
    },
    "/find-an-assessment-opportunity/SearchPartial": {
      "get": {
        "operationId": "SearchPartial",
        "parameters": [
          {
            "name": "searchTerm",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Render search partial results."
          }
        }
      }
    },
    "/find-an-assessment-opportunity/ApplyFilters": {
      "post": {
        "operationId": "ApplyFilters",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OppFinderApplyFiltersViewModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Render filtered results view."
          }
        }
      }
    },
    "/find-an-assessment-opportunity/ApplyFiltersPartial": {
      "post": {
        "operationId": "ApplyFiltersPartial",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OppFinderApplyFiltersViewModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Render filtered partial results."
          }
        }
      }
    },
    "/find-an-assessment-opportunity/ResetFilters": {
      "get": {
        "operationId": "ResetFilters",
        "responses": {
          "200": {
            "description": "Reset filters session data and render results view."
          }
        }
      }
    },
    "/find-an-assessment-opportunity/ResetFiltersPartial": {
      "get": {
        "operationId": "ResetFiltersPartial",
        "responses": {
          "200": {
            "description": "Reset filters session data and render partial results."
          }
        }
      }
    },
    "/find-an-assessment-opportunity/RefreshFiltersPartial": {
      "get": {
        "operationId": "RefreshFiltersPartial",
        "responses": {
          "200": {
            "description": "Refresh and render updated filters partial view."
          }
        }
      }
    },
    "/find-an-assessment-opportunity/ChangePageApprovedStandards": {
      "get": {
        "operationId": "ChangePageApprovedStandards",
        "parameters": [
          {
            "name": "pageIndex",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Render updated pagination view for approved standards."
          }
        }
      }
    },
    "/find-an-assessment-opportunity/ChangePageApprovedStandardsPartial": {
      "get": {
        "operationId": "ChangePageApprovedStandardsPartial",
        "parameters": [
          {
            "name": "pageIndex",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Render updated pagination partial view for approved standards."
          }
        }
      }
    },
    "/find-an-assessment-opportunity/ShowApprovedStandardsPerPage": {
      "get": {
        "operationId": "ShowApprovedStandardsPerPage",
        "parameters": [
          {
            "name": "approvedStandardsPerPage",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Update approved standards pagination size and render results."
          }
        }
      }
    },
    "/find-an-assessment-opportunity/ShowApprovedStandardsPerPagePartial": {
      "get": {
        "operationId": "ShowApprovedStandardsPerPagePartial",
        "parameters": [
          {
            "name": "standardsPerPage",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Update approved standards pagination partial size and render."
          }
        }
      }
    },
    "/find-an-assessment-opportunity/SortApprovedStandards": {
      "get": {
        "operationId": "SortApprovedStandards",
        "parameters": [
          {
            "name": "sortColumn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sortDirection",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sort approved standards based on a column and render results."
          }
        }
      }
    },
    "/find-an-assessment-opportunity/SortApprovedStandardsPartial": {
      "get": {
        "operationId": "SortApprovedStandardsPartial",
        "parameters": [
          {
            "name": "sortColumn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sortDirection",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sort approved standards based on a column and render partial results."
          }
        }
      }
    },
    "/find-an-assessment-opportunity/ShowApprovedStandardDetails": {
      "get": {
        "operationId": "ShowApprovedStandardDetails",
        "parameters": [
          {
            "name": "standardReference",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Render detailed view of an approved standard."
          }
        }
      }
    },
    "/find-an-assessment-opportunity/ShowInDevelopmentStandardDetails": {
      "get": {
        "operationId": "ShowInDevelopmentStandardDetails",
        "parameters": [
          {
            "name": "standardReference",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Render detailed view of a standard in development."
          }
        }
      }
    },
    "/find-an-assessment-opportunity/ShowProposedStandardDetails": {
      "get": {
        "operationId": "ShowProposedStandardDetails",
        "parameters": [
          {
            "name": "standardReference",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Render detailed view of a proposed standard."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OppFinderApplyFiltersViewModel": {
        "type": "object",
        "properties": {
          "SectorFilters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "LevelFilters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
