              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/epa": {
      "post": {
        "summary": "Create EPA Records",
        "operationId": "CreateEpaRecords",
        "tags": [
          "EPA"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/CreateEpaRequest"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "For each item: The created EPA record if valid, else a list of validation errors.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CreateCertificateResponse"
                  }
                }
              }
            }
          },
          "403": {
            "description": "There are too many EPA records specified within the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update EPA Records",
        "operationId": "UpdateEpaRecords",
        "tags": [
          "EPA"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/UpdateEpaRequest"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "For each item: The updated EPA records if valid, else a list of validation errors.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UpdateEpaResponse"
                  }
                }
              }
            }
          },
          "403": {
            "description": "There are too many EPA records specified within the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete EPA Record",
        "operationId": "DeleteEpaRecord",
        "tags": [
          "EPA"
        ],
        "parameters": [
          {
            "name": "uln",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "familyName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "standard",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "epaReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No content: The specified EPA record has been deleted."
          },
          "403": {
            "description": "There are validation errors preventing you from deleting the EPA record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "message": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "GetOppFinderFilterStandardsRequest": {
        "type": "object",
        "properties": {
          "searchTerm": {
            "type": "string"
          },
          "sectorFilters": {
            "type": "string"
          },
          "levelFilters": {
            "type": "string"
          }
        }
      },
      "GetOppFinderFilterStandardsResponse": {
        "type": "object",
        "properties": {
          "sectorFilterResults": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OppFinderFilterResult"
            }
          },
          "levelFilterResults": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OppFinderFilterResult"
            }
          }
        }
      },
      "OppFinderFilterResult": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "matches": {
            "type": "integer"
          },
          "selected": {
            "type": "boolean"
          }
        }
      },
      "GetOppFinderApprovedStandardsRequest": {
        "type": "object",
        "properties": {
          "searchTerm": {
            "type": "string"
          },
          "sectorFilters": {
            "type": "string"
          },
          "levelFilters": {
            "type": "string"
          },
          "sortColumn": {
            "type": "string"
          },
          "sortAscending": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "pageIndex": {
            "type": "integer",
            "nullable": true
          },
          "pageSetSize": {
            "type": "integer"
          }
        }
      },
      "GetOppFinderApprovedStandardsResponse": {
        "type": "object",
        "properties": {
          "standards": {
            "$ref": "#/components/schemas/PaginatedList"
          }
        }
      },
      "PaginatedList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OppFinderApprovedSearchResult"
            }
          },
          "totalRecordCount": {
            "type": "integer"
          },
          "pageIndex": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "pageSetSize": {
            "type": "integer"
          }
        }
      },
      "OppFinderApprovedSearchResult": {
        "type": "object",
        "properties": {
          "standardCode": {
            "type": "integer"
          },
          "standardReference": {
            "type": "string"
          },
          "standardName": {
            "type": "string"
          },
          "activeApprentices": {
            "type": "integer"
          },
          "activeEpaos": {
            "type": "integer"
          },
          "versions": {
            "type": "string"
          }
        }
      },
      "GetOppFinderNonApprovedStandardsRequest": {
        "type": "object",
        "properties": {
          "searchTerm": {
            "type": "string"
          },
          "sectorFilters": {
            "type": "string"
          },
          "levelFilters": {
            "type": "string"
          },
          "sortColumn": {
            "type": "string"
          },
          "sortAscending": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "pageIndex": {
            "type": "integer",
            "nullable": true
          },
          "pageSetSize": {
            "type": "integer"
          },
          "nonApprovedType": {
            "type": "string"
          }
        }
      },
      "GetOppFinderNonApprovedStandardsResponse": {
        "type": "object",
        "properties": {
          "standards": {
            "$ref": "#/components/schemas/PaginatedList"
          }
        }
      },
      "GetOppFinderApprovedStandardDetailsRequest": {
        "type": "object",
        "properties": {
          "standardReference": {
            "type": "string"
          }
        }
      },
      "GetOppFinderApprovedStandardDetailsResponse": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "overviewOfRole": {
            "type": "string"
          },
          "standardLevel": {
            "type": "string"
          },
          "standardCode": {
            "type": "integer",
            "nullable": true
          },
          "standardReference": {
            "type": "string"
          },
          "totalActiveApprentices": {
            "type": "integer"
          },
          "totalCompletedAssessments": {
            "type": "integer"
          },
          "sector": {
            "type": "string"
          },
          "typicalDuration": {
            "type": "integer",
            "nullable": true
          },
          "approvedForDelivery": {
            "type": "string"
          },
          "maxFunding": {
            "type": "string"
          },
          "trailblazer": {
            "type": "string"
          },
          "standardPageUrl": {
            "type": "string"
          },
          "eqaProvider": {
            "type": "string"
          },
          "regionResults": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OppFinderApprovedStandardDetailsRegionResult"
            }
          },
          "versionResults": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OppFinderApprovedStandardDetailsVersionResult"
            }
          }
        }
      },
      "OppFinderApprovedStandardDetailsRegionResult": {
        "type": "object",
        "properties": {
          "region": {
            "type": "string"
          },
          "endPointAssessorsNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "endPointAssessors": {
            "type": "integer"
          },
          "activeApprentices": {
            "type": "integer"
          },
          "completedAssessments": {
            "type": "integer"
          }
        }
      },
      "OppFinderApprovedStandardDetailsVersionResult": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "endPointAssessors": {
            "type": "integer"
          },
          "activeApprentices": {
            "type": "integer"
          },
          "completedAssessments": {
            "type": "integer"
          }
        }
      },
      "GetOppFinderNonApprovedStandardDetailsRequest": {
        "type": "object",
        "properties": {
          "standardReference": {
            "type": "string"
          }
        }
      },
      "GetOppFinderNonApprovedStandardDetailsResponse": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "overviewOfRole": {
            "type": "string"
          },
          "standardLevel": {
            "type": "string"
          },
          "standardReference": {
            "type": "string"
          },
          "sector": {
            "type": "string"
          },
          "typicalDuration": {
            "type": "integer"
          },
          "trailblazer": {
            "type": "string"
          },
          "standardPageUrl": {
            "type": "string"
          }
        }
      },
      "CreateEpaRequest": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "standard": {
            "$ref": "#/components/schemas/Standard"
          },
          "learner": {
            "$ref": "#/components/schemas/Learner"
          },
          "learningDetails": {
            "$ref": "#/components/schemas/LearningDetails"
          },
          "epaDetails": {
            "$ref": "#/components/schemas/EpaDetailsRequest"
          }
        }
      },
      "Standard": {
        "type": "object",
        "properties": {
          "standardCode": {
            "type": "integer",
            "nullable": true
          },
          "standardReference": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Learner": {
        "type": "object",
        "properties": {
          "uln": {
            "type": "integer"
          },
          "familyName": {
            "type": "string"
          }
        }
      },
      "LearningDetails": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "nullable": true
          },
          "courseOption": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "EpaDetailsRequest": {
        "type": "object",
        "properties": {
          "epas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EpaRecord"
            }
          }
        }
      },
      "EpaRecord": {
        "type": "object",
        "properties": {
          "epaDate": {
            "type": "string",
            "format": "date-time"
          },
          "epaOutcome": {
            "type": "string"
          },
          "resit": {
            "type": "boolean",
            "nullable": true
          },
          "retake": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "CreateCertificateResponse": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "certificate": {
            "type": "object"
          },
          "validationErrors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "UpdateEpaRequest": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "epaReference": {
            "type": "string"
          },
          "standard": {
            "$ref": "#/components/schemas/Standard"
          },
          "learner": {
            "$ref": "#/components/schemas/Learner"
          },
          "learningDetails": {
            "$ref": "#/components/schemas/LearningDetails"
          },
          "epaDetails": {
            "$ref": "#/components/schemas/EpaDetailsRequest"
          }
        }
      },
      "UpdateEpaResponse": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "validationErrors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
