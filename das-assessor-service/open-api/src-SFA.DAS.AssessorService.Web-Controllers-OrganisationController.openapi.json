{
  "openapi": "3.1.0",
  "info": {
    "title": "Organisation API",
    "version": "1.0.0",
    "description": "API for managing organisation details including contact information, address, phone number, email, website, and subscriptions."
  },
  "paths": {
    "/": {
      "get": {
        "operationId": "getIndex",
        "summary": "Get the organisation details",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganisationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/organisationDetails": {
      "get": {
        "operationId": "getOrganisationDetails",
        "summary": "Show organisation details",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewAndEditOrganisationViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "postOrganisationDetails",
        "summary": "Update organisation details",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ViewAndEditOrganisationViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful update"
          }
        }
      }
    },
    "/renewApiKey": {
      "get": {
        "operationId": "getRenewApiKey",
        "summary": "Renew API Key",
        "parameters": [
          {
            "name": "subscriptionId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the subscription"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RenewApiKeyViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "postRenewApiKey",
        "summary": "Renew the API key for a subscription",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenewApiKeyViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "API Key Renewed"
          }
        }
      }
    },
    "/changeAddress": {
      "get": {
        "operationId": "getChangeAddress",
        "summary": "Change organisation address",
        "responses": {
          "200": {
            "description": "Request to change address",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangeAddressViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "postChangeAddress",
        "summary": "Submit the new organisation address",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeAddressViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Address updated successfully"
          }
        }
      }
    },
    "/changePhoneNumber": {
      "get": {
        "operationId": "getChangePhoneNumber",
        "summary": "Change organisation phone number",
        "responses": {
          "200": {
            "description": "Request to change phone number",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangePhoneNumberViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "postChangePhoneNumber",
        "summary": "Submit the new phone number",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePhoneNumberViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Phone number updated"
          }
        }
      }
    },
    "/changeEmail": {
      "get": {
        "operationId": "getChangeEmail",
        "summary": "Change organisation email",
        "responses": {
          "200": {
            "description": "Request to change email",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangeEmailViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "postChangeEmail",
        "summary": "Submit the new email",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeEmailViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email updated"
          }
        }
      }
    },
    "/changeWebsite": {
      "get": {
        "operationId": "getChangeWebsite",
        "summary": "Change organisation website URL",
        "responses": {
          "200": {
            "description": "Request to change website URL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangeWebsiteViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "postChangeWebsite",
        "summary": "Submit the new website URL",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeWebsiteViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Website URL updated"
          }
        }
      }
    },
    "/selectOrChangeContact": {
      "get": {
        "operationId": "getSelectOrChangeContactName",
        "summary": "Select or change the primary contact name",
        "responses": {
          "200": {
            "description": "Request to update contact name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectOrChangeContactNameViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "postSelectOrChangeContactName",
        "summary": "Submit the new contact name",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectOrChangeContactNameViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contact name updated successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OrganisationResponse": {
        "type": "object",
        "properties": {
          "endPointAssessorName": {
            "type": "string"
          },
          "endPointAssessorOrganisationId": {
            "type": "string"
          },
          "endPointAssessorUkprn": {
            "type": "integer"
          },
          "primaryContact": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "ViewAndEditOrganisationViewModel": {
        "type": "object",
        "properties": {
          "organisationId": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phoneNumber": {
            "type": "string"
          },
          "websiteLink": {
            "type": "string"
          },
          "address1": {
            "type": "string"
          },
          "address2": {
            "type": "string"
          },
          "address3": {
            "type": "string"
          },
          "address4": {
            "type": "string"
          },
          "postcode": {
            "type": "string"
          },
          "primaryContact": {
            "type": "string"
          },
          "primaryContactName": {
            "type": "string"
          },
          "contacts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContactResponse"
            }
          }
        }
      },
      "ContactResponse": {
        "type": "object",
        "properties": {
          "endPointAssessorOrganisationId": {
            "type": "string"
          },
          "organisationId": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phoneNumber": {
            "type": "string"
          }
        }
      },
      "RenewApiKeyViewModel": {
        "type": "object",
        "properties": {
          "subscriptionId": {
            "type": "string"
          },
          "currentKey": {
            "type": "string"
          },
          "lastRenewedDate": {
            "type": "string",
            "format": "date-time"
          },
          "lastRenewedTicks": {
            "type": "integer"
          }
        }
      },
      "ChangeAddressViewModel": {
        "type": "object",
        "properties": {
          "addressLine1": {
            "type": "string"
          },
          "addressLine2": {
            "type": "string"
          },
          "addressLine3": {
            "type": "string"
          },
          "addressLine4": {
            "type": "string"
          },
          "postcode": {
            "type": "string"
          }
        }
      },
      "ChangePhoneNumberViewModel": {
        "type": "object",
        "properties": {
          "phoneNumber": {
            "type": "string"
          }
        }
      },
      "ChangeEmailViewModel": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "ChangeWebsiteViewModel": {
        "type": "object",
        "properties": {
          "websiteLink": {
            "type": "string"
          }
        }
      },
      "SelectOrChangeContactNameViewModel": {
        "type": "object",
        "properties": {
          "primaryContact": {
            "type": "string"
          },
          "primaryContactName": {
            "type": "string"
          }
        }
      }
    }
  }
}
