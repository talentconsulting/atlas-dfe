@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_employer_feedback_api, "Employer Feedback") {
  Container(c_employer_feedback, "Employer Feedback", "API")
}

SystemDb_Ext(d_configuration_store_azure_table_storage_configuration, "Azure Table Storage configuration")
SystemDb_Ext(d_database_employer_feedback, "Employer Feedback", "SQL Server")
System_Ext(d_identity_provider_microsoft_entra_id, "Microsoft Entra ID")
System_Ext(d_telemetry_azure_app_insights, "Azure App Insights")

Rel(c_employer_feedback, d_configuration_store_azure_table_storage_configuration, "Reads configuration from")
Rel(c_employer_feedback, d_database_employer_feedback, "Reads from and writes to", "SQL Server")
Rel(c_employer_feedback, d_identity_provider_microsoft_entra_id, "Authenticates with")
Rel(c_employer_feedback, d_telemetry_azure_app_insights, "Sends telemetry to")

@enduml
