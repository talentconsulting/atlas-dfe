{
  "openapi": "3.1.0",
  "info": {
    "title": "DfE Example Web API",
    "version": "1.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Render the Index view",
        "operationId": "Home_Index",
        "parameters": [
          {
            "name": "error",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response returning the Index view",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/{employerAccountId}": {
      "get": {
        "summary": "Render the Index view for a specific employer account",
        "operationId": "Home_Index_EmployerAccount",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "error",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response returning the Index view",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/logout": {
      "get": {
        "summary": "Logout user and clear authentication tokens",
        "operationId": "Home_Logout",
        "responses": {
          "204": {
            "description": "Successful logout without content"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
