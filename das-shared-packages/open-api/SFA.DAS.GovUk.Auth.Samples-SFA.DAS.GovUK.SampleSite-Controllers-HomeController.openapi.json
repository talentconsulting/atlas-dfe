{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA.DAS.GovUK.SampleSite API",
    "version": "1.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "operationId": "GetIndex",
        "summary": "Redirects to home when authenticated or shows the index view.",
        "responses": {
          "200": {
            "description": "Index view displayed."
          },
          "302": {
            "description": "Redirect to home."
          }
        }
      }
    },
    "/start": {
      "post": {
        "operationId": "PostStart",
        "summary": "Starts the session and redirects to home.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "suspend": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to home."
          }
        }
      }
    },
    "/home": {
      "get": {
        "operationId": "GetHome",
        "summary": "Displays the home view.",
        "security": [
          {
            "IsActiveAccount": []
          }
        ],
        "responses": {
          "200": {
            "description": "Home view displayed."
          }
        }
      }
    },
    "/account-details": {
      "get": {
        "operationId": "GetAccountDetails",
        "summary": "Displays account details.",
        "security": [
          {
            "IsActiveAccount": []
          }
        ],
        "responses": {
          "200": {
            "description": "Account details view displayed."
          }
        }
      }
    },
    "/active": {
      "get": {
        "operationId": "GetActiveStatus",
        "summary": "Displays the active status view.",
        "security": [
          {
            "IsAuthenticated": []
          }
        ],
        "responses": {
          "200": {
            "description": "Active status view displayed."
          }
        }
      }
    },
    "/verified-account-details": {
      "get": {
        "operationId": "GetVerifiedAccountDetails",
        "summary": "Displays verified account details.",
        "security": [
          {
            "IsVerified": []
          }
        ],
        "responses": {
          "200": {
            "description": "Verified account details view displayed."
          }
        }
      }
    },
    "/explain-verify": {
      "get": {
        "operationId": "GetExplainVerify",
        "summary": "Displays an explanation view for verify identity.",
        "security": [
          {
            "IsActiveAccount": []
          }
        ],
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "/"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Explain verify view displayed."
          }
        }
      },
      "post": {
        "operationId": "PostExplainVerifyContinue",
        "summary": "Redirects to the verify identity service.",
        "security": [
          {
            "IsActiveAccount": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "returnUrl": {
                    "type": "string",
                    "default": "/"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to verify identity service."
          }
        }
      }
    },
    "/sign-out": {
      "get": {
        "operationId": "GetSigningOut",
        "summary": "Signs out the user and redirects to signed out view.",
        "responses": {
          "302": {
            "description": "Redirect to signed out view."
          }
        }
      }
    },
    "/user-signed-out": {
      "get": {
        "operationId": "GetUserSignedOut",
        "summary": "Displays the signed out view.",
        "responses": {
          "200": {
            "description": "Signed out view displayed."
          }
        }
      }
    },
    "/user-suspended": {
      "get": {
        "operationId": "GetUserSuspended",
        "summary": "Displays the suspended view.",
        "responses": {
          "200": {
            "description": "Suspended view displayed."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "IsAuthenticated": {
        "type": "http",
        "scheme": "bearer",
        "description": "Required for endpoints protected by IsAuthenticated policy."
      },
      "IsActiveAccount": {
        "type": "http",
        "scheme": "bearer",
        "description": "Required for endpoints protected by IsActiveAccount policy."
      },
      "IsVerified": {
        "type": "http",
        "scheme": "bearer",
        "description": "Required for endpoints protected by IsVerified policy."
      }
    },
    "schemas": {}
  }
}
