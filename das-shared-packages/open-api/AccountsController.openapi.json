{
  "openapi": "3.1.0",
  "info": {
    "title": "Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/create": {
      "get": {
        "summary": "Create Account Page",
        "parameters": [
          {
            "name": "Username",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account creation page",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAccountViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirected to Created page",
            "headers": {
              "Location": {
                "description": "URL of the Created page",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/created": {
      "get": {
        "summary": "Account Created Page",
        "responses": {
          "200": {
            "description": "Account successfully created",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateAccountViewModel": {
        "type": "object",
        "properties": {
          "Username": {
            "type": "string"
          }
        },
        "required": [
          "Username"
        ]
      }
    }
  }
}
