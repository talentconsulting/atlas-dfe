{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA.DAS.GovUK.Auth API",
    "version": "1.0.0"
  },
  "paths": {
    "/service/verify-identity": {
      "get": {
        "operationId": "VerifyIdentityController_Index",
        "summary": "Verify Identity",
        "description": "Starts a challenge with GovUK Verify service to verify identity.",
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "/"
            },
            "description": "URL to redirect to after verification."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "302": {
            "description": "Redirect response"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
