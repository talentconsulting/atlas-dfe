{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA.DAS.DfESignIn.SampleSite API",
    "version": "1.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "operationId": "Home_Index",
        "summary": "Get the home page view.",
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/authenticated": {
      "get": {
        "operationId": "Home_Authenticated",
        "summary": "Get an authenticated view.",
        "security": [
          {
            "oauth2": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated view successfully retrieved.",
            "content": {
              "text/html": {}
            }
          },
          "401": {
            "description": "Unauthorized. Requires authentication."
          }
        }
      }
    },
    "/signed-out": {
      "get": {
        "operationId": "Home_SigningOut",
        "summary": "Sign out the user and redirect.",
        "security": [
          {
            "oauth2": []
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect after sign-out."
          },
          "401": {
            "description": "Unauthorized. Requires authentication."
          }
        }
      }
    },
    "/dashboard": {
      "get": {
        "operationId": "Home_RedirectToDashboard",
        "summary": "Redirect to the dashboard view.",
        "responses": {
          "301": {
            "description": "Permanent redirect to the dashboard URL."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
