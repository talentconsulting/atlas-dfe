{
  "openapi": "3.1.0",
  "info": {
    "title": "HomeController API",
    "version": "1.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "operationId": "HomeController_Index",
        "summary": "Index",
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/authenticated": {
      "get": {
        "operationId": "HomeController_Authenticated",
        "summary": "Authenticated",
        "security": [
          {
            "oauth2": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/signed-out": {
      "get": {
        "operationId": "HomeController_SigningOut",
        "summary": "Signing Out",
        "security": [
          {
            "oauth2": []
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect on sign-out",
            "headers": {
              "Location": {
                "description": "The URL to redirect to",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/dashboard": {
      "get": {
        "operationId": "HomeController_RedirectToDashboard",
        "summary": "Redirect to Dashboard",
        "responses": {
          "301": {
            "description": "Permanent Redirect",
            "headers": {
              "Location": {
                "description": "The URL to redirect to",
                "schema": {
                  "type": "string",
                  "example": "https://test-pas.apprenticeships.education.gov.uk/"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {}
}
