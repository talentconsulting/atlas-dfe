Rel(c_results_and_certification_functions, d_database_results_and_certification_database, "Reads from and writes to", "SQL Server")
Rel(c_results_and_certification_internalapi, d_database_results_and_certification_database, "Reads from and writes to", "SQL Server")
Rel(c_results_and_certification_api_client, d_http_api_department_for_education_sign_in, "Calls the API of", "HttpClient")
