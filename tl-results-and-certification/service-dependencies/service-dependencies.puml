  Container(c_results_and_certification_web, "Results And Certification Web", "Web Application")
  Container(c_tl_results_and_certification, "Tl Results And Certification", "Component")
}

SystemDb_Ext(d_cache_redis_cache, "Redis Cache", "Redis")
SystemDb_Ext(d_database_results_and_certification_database, "Results And Certification Database", "Entity Framework Core")
