{
  "openapi": "3.1.0",
  "info": {
    "title": "Registration API",
    "version": "1.0.0",
    "description": "API for managing registration-related resources."
  },
  "paths": {
    "/registrations": {
      "get": {
        "summary": "Registration Dashboard",
        "operationId": "GetRegistrationDashboard",
        "responses": {
          "200": {
            "description": "Returns the registration dashboard view."
          }
        }
      }
    },
    "/upload-registrations-file/{requestErrorTypeId}": {
      "get": {
        "summary": "Upload Registrations File",
        "operationId": "UploadRegistrationsFile",
        "parameters": [
          {
            "name": "requestErrorTypeId",
            "in": "path",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Displays the file upload page."
          }
        }
      }
    },
    "/upload-registrations-file": {
      "post": {
        "summary": "Submit Registrations File Upload",
        "operationId": "SubmitRegistrationsFileUpload",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/UploadRegistrationsRequestViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect after upload submission."
          },
          "400": {
            "description": "Validation errors occurred during file upload."
          }
        }
      }
    },
    "/download-registration-errors": {
      "get": {
        "summary": "Download Registration Errors",
        "operationId": "DownloadRegistrationErrors",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the registration error file.",
            "content": {
              "text/csv": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UploadRegistrationsRequestViewModel": {
        "type": "object",
        "properties": {
          "AoUkprn": {
            "type": "integer"
          },
          "File": {
            "type": "string",
            "format": "binary"
          },
          "RequestErrorTypeId": {
            "type": "integer"
          }
        },
        "required": [
          "AoUkprn",
          "File"
        ]
      }
    }
  }
}
