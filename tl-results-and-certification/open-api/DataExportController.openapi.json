{
  "openapi": "3.1.0",
  "info": {
    "title": "Data Export API",
    "version": "1.0.0",
    "description": "API for exporting data from Results and Certification service."
  },
  "paths": {
    "/api/DataExport/GetDataExport/{aoUkprn}/{requestType}/{requestedBy}": {
      "get": {
        "summary": "Gets data export",
        "parameters": [
          {
            "name": "aoUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "requestType",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/DataExportType"
            }
          },
          {
            "name": "requestedBy",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DataExportResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/DataExport/DownloadOverallResultsData/{providerUkprn}/{requestedBy}": {
      "get": {
        "summary": "Download overall results data",
        "parameters": [
          {
            "name": "providerUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "requestedBy",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataExportResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/DataExport/DownloadOverallResultSlipsData/{providerUkprn}/{requestedBy}": {
      "get": {
        "summary": "Download overall result slips data",
        "parameters": [
          {
            "name": "providerUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "requestedBy",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataExportResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/DataExport/DownloadLearnerOverallResultSlipsData/{providerUkprn}/{profileId}/{requestedBy}": {
      "get": {
        "summary": "Download learner overall result slips data",
        "parameters": [
          {
            "name": "providerUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "requestedBy",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataExportResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/DataExport/DownloadRommExport/{aoUkprn}/{requestedBy}": {
      "get": {
        "summary": "Download ROMM data",
        "parameters": [
          {
            "name": "aoUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "requestedBy",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DataExportResponse"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DataExportResponse": {
        "type": "object",
        "properties": {
          "isDataFound": {
            "type": "boolean"
          },
          "blobUniqueReference": {
            "type": "string",
            "format": "uuid"
          },
          "fileSize": {
            "type": "number"
          },
          "componentType": {
            "$ref": "#/components/schemas/ComponentType"
          }
        }
      },
      "DataExportType": {
        "type": "string",
        "enum": [
          "NotSpecified",
          "Registrations",
          "Assessments",
          "Results",
          "PendingWithdrawals",
          "ProviderRegistrations",
          "Romms"
        ]
      },
      "ComponentType": {
        "type": "string",
        "enum": [
          "NotSpecified",
          "Core",
          "Specialism"
        ]
      }
    }
  }
}
