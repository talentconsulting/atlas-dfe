{
  "openapi": "3.1.0",
  "info": {
    "title": "Admin Download Learner Results API",
    "version": "1.0.0"
  },
  "paths": {
    "/admin/download-learner-results-find-provider-clear": {
      "get": {
        "operationId": "AdminDownloadLearnerResultsFindProviderClear",
        "summary": "Clear the provider search cache and redirect to the provider search page.",
        "security": [
          {
            "OAuth2": []
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to the provider search page."
          },
          "default": {
            "description": "Error response."
          }
        }
      }
    },
    "/admin/download-learner-results-find-provider": {
      "get": {
        "operationId": "AdminDownloadLearnerResultsFindProvider",
        "summary": "Retrieve the provider search view model data from the cache.",
        "security": [
          {
            "OAuth2": []
          }
        ],
        "responses": {
          "200": {
            "description": "Provider search view model displayed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminDownloadLearnerResultsFindProviderViewModel"
                }
              }
            }
          },
          "default": {
            "description": "Error response."
          }
        }
      },
      "post": {
        "operationId": "AdminDownloadLearnerResultsSubmitFindProvider",
        "summary": "Submit the provider search form and redirect to results page.",
        "security": [
          {
            "OAuth2": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminDownloadLearnerResultsFindProviderViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to provider results page with providerId."
          },
          "400": {
            "description": "Validation error returned for the form."
          },
          "default": {
            "description": "Error response."
          }
        }
      }
    },
    "/admin/download-learner-results-provider/{providerId}": {
      "get": {
        "operationId": "AdminDownloadLearnerResultsByProvider",
        "summary": "Retrieve learner results overview for a specific provider.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "description": "The ID of the provider.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "security": [
          {
            "OAuth2": []
          }
        ],
        "responses": {
          "200": {
            "description": "View model of learner results overview.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminDownloadLearnerResultsByProviderViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirects to a problem page if the provider is not found."
          },
          "default": {
            "description": "Error response."
          }
        }
      }
    },
    "/admin/download-learner-results-file-csv/{ukprn}": {
      "get": {
        "operationId": "AdminDownloadLearnerResultsCsv",
        "summary": "Download learner results data as a CSV file.",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "description": "The UKPRN of the provider.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "security": [
          {
            "OAuth2": []
          }
        ],
        "responses": {
          "200": {
            "description": "CSV file containing learner results data.",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "302": {
            "description": "Redirects to a problem page if the file stream is not found."
          },
          "default": {
            "description": "Error response."
          }
        }
      }
    },
    "/admin/download-learner-results-file-pdf/{ukprn}": {
      "get": {
        "operationId": "AdminDownloadLearnerResultsPdf",
        "summary": "Download learner results slips as a PDF.",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "description": "The UKPRN of the provider.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "security": [
          {
            "OAuth2": []
          }
        ],
        "responses": {
          "200": {
            "description": "PDF file containing learner results slips.",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "302": {
            "description": "Redirects to a problem page if the file stream is not found."
          },
          "default": {
            "description": "Error response."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminDownloadLearnerResultsFindProviderViewModel": {
        "type": "object",
        "properties": {
          "search": {
            "type": "string",
            "maxLength": 400,
            "description": "Provider name to search for."
          }
        },
        "required": [
          "search"
        ]
      },
      "AdminDownloadLearnerResultsByProviderViewModel": {
        "type": "object",
        "description": "Model displaying learner results for a specific provider.",
        "properties": {
          "providerId": {
            "type": "integer",
            "description": "The ID of the provider."
          },
          "downloadFilename": {
            "type": "string",
            "description": "Filename for downloaded results file."
          }
        }
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "description": "OAuth2 security scheme for authorization."
      }
    }
  }
}
