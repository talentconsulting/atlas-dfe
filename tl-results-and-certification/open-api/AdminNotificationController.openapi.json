{
  "openapi": "3.1.0",
  "info": {
    "title": "Admin Notification API",
    "version": "1.0.0"
  },
  "paths": {
    "/admin/find-notification-clear": {
      "get": {
        "operationId": "AdminFindNotificationClear",
        "summary": "Clears cached notification data.",
        "responses": {
          "302": {
            "description": "Redirect to the AdminFindNotification route."
          }
        }
      }
    },
    "/admin/find-notification/{pageNumber}": {
      "get": {
        "operationId": "AdminFindNotification",
        "summary": "Finds notifications based on page number and filters.",
        "parameters": [
          {
            "name": "pageNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "Page number of notifications to fetch."
          }
        ],
        "responses": {
          "200": {
            "description": "Success, returns notification data."
          }
        }
      }
    },
    "/admin/find-notification-apply-filters": {
      "post": {
        "operationId": "AdminFindNotificationApplyFilters",
        "summary": "Applies filters to notification search.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminFindNotificationCriteriaViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to the AdminFindNotification route."
          }
        }
      }
    },
    "/admin/find-notification-clear-filters": {
      "post": {
        "operationId": "AdminFindNotificationClearFilters",
        "summary": "Clears applied filters for notification search.",
        "responses": {
          "302": {
            "description": "Redirects to the AdminFindNotification route."
          }
        }
      }
    },
    "/admin/notification-details/{notificationId}": {
      "get": {
        "operationId": "AdminNotificationDetails",
        "summary": "Gets details for a specific notification.",
        "parameters": [
          {
            "name": "notificationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "The ID of the notification."
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the details of the notification."
          },
          "302": {
            "description": "Redirects to the ProblemWithService route if notification is not found."
          }
        }
      }
    },
    "/admin/edit-notification": {
      "get": {
        "operationId": "AdminEditNotificationGet",
        "summary": "Fetches details for editing a notification.",
        "parameters": [
          {
            "name": "notificationId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "The ID of the notification to edit."
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the notification details for editing."
          },
          "302": {
            "description": "Redirects to the ProblemWithService route if notification is not found."
          }
        }
      },
      "post": {
        "operationId": "AdminEditNotificationPost",
        "summary": "Updates an existing notification.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminEditNotificationViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects based on success or failure (ProblemWithService or AdminNotificationDetails routes)."
          }
        }
      }
    },
    "/admin/add-notification": {
      "get": {
        "operationId": "AdminAddNotificationGet",
        "summary": "Displays the add notification view.",
        "responses": {
          "200": {
            "description": "Returns the add notification view."
          }
        }
      },
      "post": {
        "operationId": "AdminAddNotificationPost",
        "summary": "Adds a new notification.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminAddNotificationViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects based on success or failure (ProblemWithService or AdminNotificationDetails route)."
          }
        }
      }
    },
    "/admin/delete-notification/{notificationId}": {
      "get": {
        "operationId": "AdminDeleteNotificationGet",
        "summary": "Displays the delete notification view.",
        "parameters": [
          {
            "name": "notificationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "The ID of the notification to delete."
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the delete notification view."
          },
          "302": {
            "description": "Redirects to ProblemWithService if notification not found."
          }
        }
      },
      "post": {
        "operationId": "AdminDeleteNotificationPost",
        "summary": "Deletes a notification.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminDeleteNotificationViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects based on success or failure (ProblemWithService or AdminFindNotification route)."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminAddNotificationViewModel": {
        "type": "object",
        "properties": {
          "Title": {
            "type": "string"
          },
          "Content": {
            "type": "string"
          },
          "Target": {
            "type": "string",
            "enum": [
              "AwardingOrganisation",
              "Provider",
              "Both"
            ]
          },
          "StartDay": {
            "type": "string"
          },
          "StartMonth": {
            "type": "string"
          },
          "StartYear": {
            "type": "string"
          },
          "EndDay": {
            "type": "string"
          },
          "EndMonth": {
            "type": "string"
          },
          "EndYear": {
            "type": "string"
          }
        }
      },
      "AdminEditNotificationViewModel": {
        "type": "object",
        "properties": {
          "NotificationId": {
            "type": "integer",
            "format": "int32"
          },
          "Title": {
            "type": "string"
          },
          "Content": {
            "type": "string"
          },
          "Target": {
            "type": "string",
            "enum": [
              "AwardingOrganisation",
              "Provider",
              "Both"
            ]
          },
          "StartDay": {
            "type": "string"
          },
          "StartMonth": {
            "type": "string"
          },
          "StartYear": {
            "type": "string"
          },
          "EndDay": {
            "type": "string"
          },
          "EndMonth": {
            "type": "string"
          },
          "EndYear": {
            "type": "string"
          }
        }
      },
      "AdminFindNotificationCriteriaViewModel": {
        "type": "object",
        "properties": {
          "ActiveFilters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FilterLookupData"
            }
          },
          "PageNumber": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "AdminDeleteNotificationViewModel": {
        "type": "object",
        "properties": {
          "NotificationId": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "FilterLookupData": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int32"
          },
          "Name": {
            "type": "string"
          },
          "CoreCode": {
            "type": "string"
          },
          "IsSelected": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
