{
  "openapi": "3.1.0",
  "info": {
    "title": "Admin Notification API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/AdminNotification/SearchNotifications": {
      "post": {
        "operationId": "SearchNotifications",
        "summary": "Search for notifications.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminSearchNotificationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paged response of notification details.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "totalRecords": {
                      "type": "integer"
                    },
                    "records": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SearchNotificationDetail"
                      }
                    },
                    "pagerInfo": {
                      "type": "object"
                    }
                  },
                  "required": [
                    "totalRecords",
                    "records"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/AdminNotification/GetNotification/{notificationId}": {
      "get": {
        "operationId": "GetNotification",
        "summary": "Get a specific notification by ID.",
        "parameters": [
          {
            "name": "notificationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Details of the notification.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetNotificationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/AdminNotification/AddNotification": {
      "post": {
        "operationId": "AddNotification",
        "summary": "Add a new notification.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddNotificationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Response for adding a notification.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddNotificationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/AdminNotification/UpdateNotification": {
      "put": {
        "operationId": "UpdateNotification",
        "summary": "Update an existing notification.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateNotificationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Whether the notification update was successful.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "/api/AdminNotification/DeleteNotification/{notificationId}": {
      "delete": {
        "operationId": "DeleteNotification",
        "summary": "Delete a notification by ID.",
        "parameters": [
          {
            "name": "notificationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Response for deleting a notification.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteNotificationResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminSearchNotificationRequest": {
        "type": "object",
        "properties": {
          "selectedActive": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "pageNumber": {
            "type": "integer",
            "nullable": true
          }
        },
        "required": [
          "selectedActive"
        ]
      },
      "SearchNotificationDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "target": {
            "$ref": "#/components/schemas/NotificationTarget"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "target",
          "end",
          "isActive"
        ]
      },
      "GetNotificationResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "target": {
            "$ref": "#/components/schemas/NotificationTarget"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "content",
          "target",
          "start",
          "end",
          "isActive"
        ]
      },
      "AddNotificationRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "target": {
            "$ref": "#/components/schemas/NotificationTarget"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "createdBy": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "content",
          "target",
          "start",
          "end",
          "createdBy"
        ]
      },
      "AddNotificationResponse": {
        "type": "object",
        "properties": {
          "notificationId": {
            "type": "integer"
          },
          "success": {
            "type": "boolean"
          }
        },
        "required": [
          "notificationId",
          "success"
        ]
      },
      "UpdateNotificationRequest": {
        "type": "object",
        "properties": {
          "notificationId": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "target": {
            "$ref": "#/components/schemas/NotificationTarget"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "modifiedBy": {
            "type": "string"
          }
        },
        "required": [
          "notificationId",
          "title",
          "content",
          "target",
          "start",
          "end",
          "modifiedBy"
        ]
      },
      "DeleteNotificationResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          }
        },
        "required": [
          "success"
        ]
      },
      "NotificationTarget": {
        "type": "string",
        "enum": [
          "NotSpecified",
          "AwardingOrganisation",
          "Provider",
          "Both"
        ]
      }
    }
  }
}
