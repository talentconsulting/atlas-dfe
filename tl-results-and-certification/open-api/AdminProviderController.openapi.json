{
  "openapi": "3.1.0",
  "info": {
    "title": "Admin Provider API",
    "version": "1.0.0"
  },
  "paths": {
    "/admin/find-provider-clear": {
      "get": {
        "summary": "Clear cached provider find data",
        "operationId": "AdminFindProviderClear",
        "responses": {
          "302": {
            "description": "Redirect to provider find route"
          }
        }
      }
    },
    "/admin/find-provider": {
      "get": {
        "summary": "Display provider find form",
        "operationId": "AdminFindProviderGet",
        "responses": {
          "200": {
            "description": "Form displayed successfully"
          }
        }
      },
      "post": {
        "summary": "Submit find provider form",
        "operationId": "AdminFindProviderPost",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminFindProviderViewModel"
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Validation errors or provider not found"
          },
          "302": {
            "description": "Redirect to provider details route"
          }
        }
      }
    },
    "/admin/provider-details/{providerId}": {
      "get": {
        "summary": "Get provider details",
        "operationId": "AdminProviderDetails",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider details retrieved successfully"
          },
          "302": {
            "description": "Redirect to problem with service route"
          }
        }
      }
    },
    "/admin/edit-provider/{providerId}": {
      "get": {
        "summary": "Edit provider data",
        "operationId": "AdminEditProviderGet",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Edit form displayed"
          },
          "302": {
            "description": "Redirect to problem with service route"
          }
        }
      }
    },
    "/admin/edit-provider": {
      "post": {
        "summary": "Submit edited provider data",
        "operationId": "AdminEditProviderPost",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminEditProviderViewModel"
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Validation errors"
          },
          "302": {
            "description": "Redirect to provider details or problem with service route"
          }
        }
      }
    },
    "/admin/add-provider": {
      "get": {
        "summary": "Add new provider",
        "operationId": "AdminAddProviderGet",
        "responses": {
          "200": {
            "description": "Add form displayed successfully"
          }
        }
      },
      "post": {
        "summary": "Submit new provider data",
        "operationId": "AdminAddProviderPost",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminAddProviderViewModel"
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Validation errors"
          },
          "302": {
            "description": "Redirect to provider details or problem with service route"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminFindProviderViewModel": {
        "type": "object",
        "properties": {
          "search": {
            "type": "string"
          }
        },
        "required": [
          "search"
        ]
      },
      "AdminAddProviderViewModel": {
        "type": "object",
        "properties": {
          "ukPrn": {
            "type": "string",
            "pattern": "^\\d{8}$"
          },
          "name": {
            "type": "string",
            "maxLength": 256
          },
          "displayName": {
            "type": "string",
            "maxLength": 256
          }
        },
        "required": [
          "ukPrn",
          "name",
          "displayName"
        ]
      },
      "AdminEditProviderViewModel": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "integer"
          },
          "ukPrn": {
            "type": "string",
            "pattern": "^\\d{8}$"
          },
          "name": {
            "type": "string",
            "maxLength": 256
          },
          "displayName": {
            "type": "string",
            "maxLength": 256
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "required": [
          "providerId",
          "ukPrn",
          "name",
          "displayName",
          "isActive"
        ]
      }
    }
  }
}
