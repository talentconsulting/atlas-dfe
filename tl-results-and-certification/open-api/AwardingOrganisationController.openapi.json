{
  "openapi": "3.1.0",
  "info": {
    "title": "Awarding Organisation API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/AwardingOrganisation/GetAllAwardingOrganisations": {
      "get": {
        "summary": "Get all awarding organisations",
        "operationId": "GetAllAwardingOrganisationsAsync",
        "responses": {
          "200": {
            "description": "Successfully fetched awarding organisations list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AwardingOrganisationMetadata"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/AwardingOrganisation/GetAwardingOrganisationByUkprn/{ukprn}": {
      "get": {
        "summary": "Get awarding organisation by UKPRN",
        "operationId": "GetAwardingOrganisationByUkprnAsync",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "UKPRN of the awarding organisation"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully fetched awarding organisation details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AwardingOrganisationMetadata"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AwardingOrganisationMetadata": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer",
            "format": "int64",
            "description": "UK provider reference number of the awarding organisation"
          },
          "DisplayName": {
            "type": "string",
            "description": "Display name of the awarding organisation"
          },
          "Id": {
            "type": "integer",
            "description": "The unique identifier for the entity"
          }
        },
        "required": [
          "Ukprn",
          "DisplayName",
          "Id"
        ]
      }
    }
  }
}
