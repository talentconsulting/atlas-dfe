{
  "openapi": "3.1.0",
  "info": {
    "title": "TL Results and Certification Internal API",
    "version": "1.0.0",
    "description": "API for managing results and certifications in the TL education system."
  },
  "paths": {
    "/api/Result/ProcessBulkResults": {
      "post": {
        "summary": "Processes bulk result uploads",
        "operationId": "ProcessBulkResultsAsync",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkProcessRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkResultResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/Result/GetResultDetails/{aoUkprn}/{profileId}/{status}": {
      "get": {
        "summary": "Retrieves detailed result information for a learner",
        "operationId": "GetResultDetailsAsync",
        "parameters": [
          {
            "name": "aoUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "status",
            "in": "path",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/RegistrationPathwayStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detailed learner result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Result/AddResult": {
      "post": {
        "summary": "Adds a new result",
        "operationId": "AddResultAsync",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddResultRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Response after adding the result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddResultResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/Result/ChangeResult": {
      "put": {
        "summary": "Changes an existing result",
        "operationId": "ChangeResultAsync",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeResultRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Response after changing the result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangeResultResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BulkProcessRequest": {
        "type": "object",
        "properties": {
          "AoUkprn": {
            "type": "integer",
            "format": "int64"
          },
          "BlobFileName": {
            "type": "string"
          },
          "BlobUniqueReference": {
            "type": "string",
            "format": "uuid"
          },
          "FileType": {
            "$ref": "#/components/schemas/FileType"
          },
          "DocumentType": {
            "$ref": "#/components/schemas/DocumentType"
          },
          "LoginUserType": {
            "$ref": "#/components/schemas/LoginUserType"
          },
          "PerformedBy": {
            "type": "string"
          }
        }
      },
      "BulkResultResponse": {
        "type": "object",
        "properties": {
          "IsSuccess": {
            "type": "boolean"
          },
          "BlobUniqueReference": {
            "type": "string",
            "format": "uuid"
          },
          "ErrorFileSize": {
            "type": "number"
          },
          "Stats": {
            "type": "object"
          }
        }
      },
      "AddResultRequest": {
        "type": "object",
        "properties": {
          "AoUkprn": {
            "type": "integer",
            "format": "int64"
          },
          "ProfileId": {
            "type": "integer",
            "format": "int32"
          },
          "AssessmentId": {
            "type": "integer",
            "format": "int32"
          },
          "LookupId": {
            "type": "integer",
            "format": "int32"
          },
          "ComponentType": {
            "$ref": "#/components/schemas/ComponentType"
          },
          "PerformedBy": {
            "type": "string"
          }
        }
      },
      "AddResultResponse": {
        "type": "object",
        "properties": {
          "Uln": {
            "type": "integer",
            "format": "int64"
          },
          "ProfileId": {
            "type": "integer",
            "format": "int32"
          },
          "IsSuccess": {
            "type": "boolean"
          }
        }
      },
      "ChangeResultRequest": {
        "type": "object",
        "properties": {
          "AoUkprn": {
            "type": "integer",
            "format": "int64"
          },
          "Uln": {
            "type": "integer",
            "format": "int64"
          },
          "ProfileId": {
            "type": "integer",
            "format": "int32"
          },
          "ResultId": {
            "type": "integer",
            "format": "int32"
          },
          "LookupId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "ComponentType": {
            "$ref": "#/components/schemas/ComponentType"
          },
          "PerformedBy": {
            "type": "string"
          }
        }
      },
      "ChangeResultResponse": {
        "type": "object",
        "properties": {
          "Uln": {
            "type": "integer",
            "format": "int64"
          },
          "ProfileId": {
            "type": "integer",
            "format": "int32"
          },
          "IsSuccess": {
            "type": "boolean"
          }
        }
      },
      "ResultDetails": {
        "type": "object",
        "properties": {
          "ProfileId": {
            "type": "integer",
            "format": "int32"
          },
          "Uln": {
            "type": "integer",
            "format": "int64"
          },
          "Firstname": {
            "type": "string"
          },
          "Lastname": {
            "type": "string"
          },
          "DateofBirth": {
            "type": "string",
            "format": "date-time"
          },
          "ProviderUkprn": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderName": {
            "type": "string"
          },
          "TlevelTitle": {
            "type": "string"
          },
          "PathwayLarId": {
            "type": "string"
          },
          "PathwayName": {
            "type": "string"
          },
          "PathwayAssessmentSeries": {
            "type": "string"
          },
          "PathwayAssessmentId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "AppealEndDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "PathwayResultId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "PathwayResultCode": {
            "type": "string"
          },
          "PathwayResult": {
            "type": "string"
          },
          "PathwayPrsStatus": {
            "$ref": "#/components/schemas/PrsStatus",
            "nullable": true
          },
          "Status": {
            "$ref": "#/components/schemas/RegistrationPathwayStatus"
          }
        }
      },
      "ComponentType": {
        "enum": [
          "NotSpecified",
          "Core",
          "Specialism"
        ],
        "type": "string"
      },
      "RegistrationPathwayStatus": {
        "enum": [
          "NotSpecified",
          "Active",
          "InActive",
          "Transferred",
          "Withdrawn"
        ],
        "type": "string"
      },
      "FileType": {
        "enum": [
          "Csv",
          "Xlsx",
          "Pdf"
        ],
        "type": "string"
      },
      "DocumentType": {
        "enum": [
          "Registrations",
          "Assessments",
          "Results",
          "Documents",
          "Ucas",
          "DataExports",
          "OverallResults",
          "IndustryPlacements",
          "AnalystOverallResults",
          "AnalystCoreResults",
          "CoreRomm",
          "SpecialismRomm",
          "ProviderAddressess",
          "CertificateTracking",
          "Withdrawals",
          "ResultSlips",
          "Romms",
          "Aspose"
        ],
        "type": "string"
      },
      "LoginUserType": {
        "enum": [
          "NotSpecified",
          "AwardingOrganisation",
          "TrainingProvider",
          "Admin"
        ],
        "type": "string"
      },
      "PrsStatus": {
        "enum": [
          "NotSpecified",
          "UnderReview",
          "Reviewed",
          "BeingAppealed",
          "Final",
          "Withdraw"
        ],
        "type": "string"
      }
    }
  }
}
