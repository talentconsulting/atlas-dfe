{
  "openapi": "3.1.0",
  "info": {
    "title": "Results Management API",
    "version": "1.0.0",
    "description": "API to manage learner results for T Level certifications."
  },
  "paths": {
    "/results": {
      "get": {
        "operationId": "getResultsDashboard",
        "summary": "Results Dashboard",
        "description": "Returns the results dashboard for the logged-in user.",
        "tags": [
          "Results"
        ],
        "responses": {
          "200": {
            "description": "HTML view of the results dashboard",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/upload-results-file/{requestErrorTypeId}": {
      "get": {
        "operationId": "getUploadResultsFile",
        "summary": "Upload Results File",
        "description": "Displays the page to upload results files.",
        "tags": [
          "Results"
        ],
        "parameters": [
          {
            "name": "requestErrorTypeId",
            "in": "path",
            "required": false,
            "description": "Optional error type ID for displaying error messages.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "HTML view of the upload results file page",
            "content": {
              "text/html": {}
            }
          }
        }
      },
      "post": {
        "operationId": "postUploadResultsFile",
        "summary": "Submit Results File",
        "description": "Uploads and processes the submitted results file.",
        "tags": [
          "Results"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "CSV file containing results."
                  }
                },
                "required": [
                  "file"
                ]
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to appropriate outcome page based on processing result."
          }
        }
      }
    },
    "/results-upload-confirmation": {
      "get": {
        "operationId": "getUploadSuccessful",
        "summary": "Upload Successful",
        "description": "Displays a confirmation page when results file upload is successful.",
        "tags": [
          "Results"
        ],
        "responses": {
          "200": {
            "description": "HTML view of the upload successful page",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/results-upload-unsuccessful": {
      "get": {
        "operationId": "getUploadUnsuccessful",
        "summary": "Upload Unsuccessful",
        "description": "Displays a page when results file upload is unsuccessful.",
        "tags": [
          "Results"
        ],
        "responses": {
          "200": {
            "description": "HTML view of the upload unsuccessful page",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/results-file-upload-service-problem": {
      "get": {
        "operationId": "getProblemWithResultsUpload",
        "summary": "Service Problem",
        "description": "Displays a service problem page related to results upload.",
        "tags": [
          "Results"
        ],
        "responses": {
          "200": {
            "description": "HTML view of the problem with results upload page",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/download-result-errors": {
      "get": {
        "operationId": "getDownloadResultErrors",
        "summary": "Download Result Errors",
        "description": "Downloads a file containing validation errors in the results upload.",
        "tags": [
          "Results"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Unique ID of the file to download.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "CSV file containing validation errors.",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/results-learner-withdrawn/{profileId}": {
      "get": {
        "operationId": "getResultWithdrawnDetails",
        "summary": "Learner Withdrawn Details",
        "description": "Displays details of withdrawn learner results.",
        "tags": [
          "Results"
        ],
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "description": "Learner's profile ID.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "HTML view of withdrawn learner details page",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/learner-results/{profileId}": {
      "get": {
        "operationId": "getResultDetails",
        "summary": "Learner Results Details",
        "description": "Displays details of the given learner's results.",
        "tags": [
          "Results"
        ],
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "description": "Learner's profile ID.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "HTML view of results details page",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/results-no-records-found": {
      "get": {
        "operationId": "getResultsNoRecordsFound",
        "summary": "No Records Found",
        "description": "Displays a page indicating no records found for results data.",
        "tags": [
          "Results"
        ],
        "responses": {
          "200": {
            "description": "HTML view of no records found page",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
