{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Lookup API",
    "version": "1.0.0",
    "description": "API for provider lookup functionality."
  },
  "paths": {
    "/search-provider/{name}": {
      "get": {
        "summary": "Get provider lookup data by name",
        "operationId": "getProviderLookupData",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "Name of the provider. Minimum length is 3 characters.",
            "schema": {
              "type": "string",
              "minLength": 3
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider lookup data retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderLookupData"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request: Invalid or missing provider name.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProviderLookupData": {
        "type": "object",
        "description": "Details about a provider.",
        "properties": {}
      }
    }
  }
}
