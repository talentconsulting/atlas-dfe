{
  "openapi": "3.1.0",
  "info": {
    "title": "Tlevel API",
    "version": "1.0.0",
    "description": "API documentation for Tlevel functionalities in the system."
  },
  "paths": {
    "/tlevels": {
      "get": {
        "operationId": "Tlevels_Index",
        "summary": "Navigate to the Tlevels dashboard",
        "responses": {
          "200": {
            "description": "Tlevels dashboard page",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/review-tlevels": {
      "get": {
        "operationId": "Tlevels_Review",
        "summary": "Review Tlevels",
        "responses": {
          "302": {
            "description": "Redirect to the appropriate Tlevel review or completion page."
          }
        }
      }
    },
    "/all-tlevels-reviewed": {
      "get": {
        "operationId": "AllTlevelsReviewed",
        "summary": "View confirmation of all reviewed Tlevels",
        "responses": {
          "200": {
            "description": "All Tlevels reviewed page"
          },
          "302": {
            "description": "Redirect to a page not found if there are pending Tlevels."
          }
        }
      }
    },
    "/select-tlevel/{id}": {
      "get": {
        "operationId": "SelectTlevel_Get",
        "summary": "Select a Tlevel to review",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tlevel selection page"
          },
          "302": {
            "description": "Redirect based on the selection logic."
          }
        }
      },
      "post": {
        "operationId": "SelectTlevel_Submit",
        "summary": "Submit a selected Tlevel for review",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectToReviewPageViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Redirection to Tlevel details review page"
          },
          "400": {
            "description": "Validation errors on submitted model"
          }
        }
      }
    },
    "/review-t-level-details/{id}/{isback}": {
      "get": {
        "operationId": "ReviewTlevelDetails",
        "summary": "View Tlevel details for review",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "isback",
            "in": "path",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tlevel details verification page",
            "content": {
              "text/html": {}
            }
          },
          "302": {
            "description": "Redirect to page not found if Tlevel cannot be verified."
          }
        }
      }
    },
    "/tlevel-details-queried-confirmation/{id}": {
      "get": {
        "operationId": "TlevelDetailsQueriedConfirmation",
        "summary": "Confirm queried Tlevel details",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Queried details confirmation page",
            "content": {
              "text/html": {}
            }
          },
          "302": {
            "description": "Redirect to page not found if confirmation is invalid."
          }
        }
      }
    },
    "/confirm-tlevel": {
      "post": {
        "operationId": "ConfirmTlevel",
        "summary": "Confirm Tlevel review outcome",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmTlevelViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tlevel review confirmation result"
          },
          "400": {
            "description": "Validation errors or issues confirming Tlevel."
          }
        }
      }
    },
    "/query-t-level/{id}/{isBackToConfirmed}": {
      "get": {
        "operationId": "QueryTlevelDetails_Get",
        "summary": "Report issue with a Tlevel",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "isBackToConfirmed",
            "in": "path",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Issue reporting page"
          },
          "302": {
            "description": "Redirect to page not found if Tlevel details are not available."
          }
        }
      },
      "post": {
        "operationId": "SubmitTlevelIssue",
        "summary": "Submit reported issue with a Tlevel",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TlevelQueryViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Redirect after querying issue."
          },
          "400": {
            "description": "Validation errors on submitted query."
          }
        }
      }
    },
    "/tlevel-query-sent": {
      "get": {
        "operationId": "TlevelQuerySent",
        "summary": "Confirmation page for successful Tlevel query",
        "responses": {
          "200": {
            "description": "Query sent confirmation page.",
            "content": {
              "text/html": {}
            }
          },
          "302": {
            "description": "Redirect to page not found if query submission data is invalid."
          }
        }
      }
    },
    "/query-service-problem": {
      "get": {
        "operationId": "QueryServiceProblem",
        "summary": "Page shown when a query service problem occurs",
        "responses": {
          "200": {
            "description": "Query service problem page",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/confirmed-tlevels": {
      "get": {
        "operationId": "ConfirmedTlevels",
        "summary": "View confirmed Tlevels",
        "responses": {
          "200": {
            "description": "Confirmed Tlevels page",
            "content": {
              "text/html": {}
            }
          },
          "302": {
            "description": "Redirect to no confirmed Tlevels page."
          }
        }
      }
    },
    "/no-confirmed-tlevels": {
      "get": {
        "operationId": "NoConfirmedTlevels",
        "summary": "Page displayed when no Tlevels are marked as confirmed",
        "responses": {
          "200": {
            "description": "No confirmed Tlevels page",
            "content": {
              "text/html": {}
            }
          },
          "302": {
            "description": "Redirect to a page not found if there are confirmed Tlevels."
          }
        }
      }
    },
    "/queried-tlevels": {
      "get": {
        "operationId": "QueriedTlevels",
        "summary": "View queried Tlevels",
        "responses": {
          "200": {
            "description": "Queried Tlevels page"
          },
          "302": {
            "description": "Redirect to no queried Tlevels page."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TlevelQueryViewModel": {
        "type": "object",
        "properties": {
          "TqAwardingOrganisationId": {
            "type": "integer",
            "format": "int32"
          },
          "RouteId": {
            "type": "integer",
            "format": "int32"
          },
          "PathwayId": {
            "type": "integer",
            "format": "int32"
          },
          "PathwayStatusId": {
            "type": "integer",
            "format": "int32"
          },
          "IsBackToConfirmed": {
            "type": "boolean"
          },
          "Query": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "Query"
        ]
      },
      "ConfirmTlevelViewModel": {
        "type": "object",
        "properties": {
          "TqAwardingOrganisationId": {
            "type": "integer",
            "format": "int32"
          },
          "RouteId": {
            "type": "integer",
            "format": "int32"
          },
          "PathwayId": {
            "type": "integer",
            "format": "int32"
          },
          "PathwayStatusId": {
            "type": "integer",
            "format": "int32"
          },
          "TlevelTitle": {
            "type": "string"
          },
          "IsEverythingCorrect": {
            "type": "boolean"
          },
          "Specialisms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "PathwayId",
          "IsEverythingCorrect"
        ]
      },
      "SelectToReviewPageViewModel": {
        "type": "object",
        "properties": {
          "SelectedPathwayId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "SelectedPathwayId"
        ]
      }
    }
  }
}
