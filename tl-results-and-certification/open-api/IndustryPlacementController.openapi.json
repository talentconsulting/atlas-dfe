{
  "openapi": "3.1.0",
  "info": {
    "title": "Industry Placement API",
    "version": "1.0.0",
    "description": "API for managing industry placement records."
  },
  "paths": {
    "/add-industry-placement/{profileId}": {
      "get": {
        "operationId": "addIndustryPlacement",
        "summary": "Add or Change Industry Placement",
        "description": "Redirects to either the add or change journey for industry placement based on route.",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to another endpoint."
          }
        }
      }
    },
    "/industry-placement-completion/{profileId}/{isChangeMode}": {
      "get": {
        "operationId": "getIpCompletion",
        "summary": "Industry Placement Completion Details",
        "description": "Displays completion details for the industry placement.",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "isChangeMode",
            "in": "path",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Completion details displayed."
          },
          "404": {
            "description": "Not found."
          }
        }
      },
      "post": {
        "operationId": "submitIpCompletion",
        "summary": "Submit Industry Placement Completion",
        "description": "Submits industry placement completion details.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IpCompletionViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to another endpoint."
          },
          "400": {
            "description": "Bad request due to validation errors."
          }
        }
      }
    },
    "/industry-placement-special-consideration-hours/{isChangeMode}": {
      "get": {
        "operationId": "getIpSpecialConsiderationHours",
        "summary": "Special Consideration Hours",
        "description": "Displays special consideration hours for industry placement.",
        "parameters": [
          {
            "name": "isChangeMode",
            "in": "path",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Special consideration hours displayed."
          },
          "404": {
            "description": "Not found."
          }
        }
      },
      "post": {
        "operationId": "submitIpSpecialConsiderationHours",
        "summary": "Submit Special Consideration Hours",
        "description": "Submits special consideration hours for industry placement.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpecialConsiderationHoursViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to another endpoint."
          },
          "400": {
            "description": "Bad request due to validation errors."
          }
        }
      }
    },
    "/industry-placement-special-consideration-reasons/{isChangeMode}": {
      "get": {
        "operationId": "getIpSpecialConsiderationReasons",
        "summary": "Special Consideration Reasons",
        "description": "Displays reasons for special consideration.",
        "parameters": [
          {
            "name": "isChangeMode",
            "in": "path",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Special consideration reasons displayed."
          },
          "404": {
            "description": "Not found."
          }
        }
      },
      "post": {
        "operationId": "submitIpSpecialConsiderationReasons",
        "summary": "Submit Special Consideration Reasons",
        "description": "Submits reasons for special consideration in industry placement.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpecialConsiderationReasonsViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to another endpoint."
          },
          "400": {
            "description": "Bad request due to validation errors."
          }
        }
      }
    },
    "/industry-placement-check-your-answers": {
      "get": {
        "operationId": "getIpCheckAndSubmit",
        "summary": "Check Your Answers",
        "description": "Displays a summary for review and confirmation of submission.",
        "responses": {
          "200": {
            "description": "Check your answers page displayed."
          },
          "404": {
            "description": "Not Found."
          }
        }
      },
      "post": {
        "operationId": "submitIpCheckAndSubmit",
        "summary": "Submit Check and Submit",
        "description": "Finalizes and submits the check and submit workflow.",
        "responses": {
          "302": {
            "description": "Redirect to another endpoint."
          },
          "400": {
            "description": "Bad request due to errors during processing."
          }
        }
      }
    },
    "/industry-placement-check-your-answers-cancel/{profileId}": {
      "get": {
        "operationId": "cancelIpCheckAndSubmit",
        "summary": "Cancel Check and Submit",
        "description": "Cancels the check and submit workflow.",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to another endpoint."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IpCompletionViewModel": {
        "type": "object",
        "properties": {
          "profileId": {
            "type": "integer"
          },
          "industryPlacementStatus": {
            "type": "integer",
            "description": "The status of the industry placement."
          },
          "isChangeMode": {
            "type": "boolean"
          }
        }
      },
      "SpecialConsiderationHoursViewModel": {
        "type": "object",
        "properties": {
          "profileId": {
            "type": "integer"
          },
          "hours": {
            "type": "integer",
            "description": "Number of hours completed."
          },
          "isChangeMode": {
            "type": "boolean"
          }
        }
      },
      "SpecialConsiderationReasonsViewModel": {
        "type": "object",
        "properties": {
          "reasonsList": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "List of reasons for special consideration."
          },
          "isChangeMode": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
