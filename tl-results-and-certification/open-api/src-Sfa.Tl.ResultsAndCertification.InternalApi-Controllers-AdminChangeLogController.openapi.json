{
  "openapi": "3.1.0",
  "info": {
    "title": "Results and Certification API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/AdminChangeLog/SearchChangeLogs": {
      "post": {
        "operationId": "SearchChangeLogs",
        "summary": "Search Admin Change Logs",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminSearchChangeLogRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paged response containing admin change log search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResponse_AdminSearchChangeLog"
                }
              }
            }
          }
        }
      }
    },
    "/api/AdminChangeLog/GetAdminChangeLogRecord/{changeLogId}": {
      "get": {
        "operationId": "GetAdminChangeLogRecord",
        "summary": "Get Admin Change Log Record",
        "parameters": [
          {
            "name": "changeLogId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID of the change log record"
          }
        ],
        "responses": {
          "200": {
            "description": "Admin change log record details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminChangeLogRecord"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminSearchChangeLogRequest": {
        "type": "object",
        "properties": {
          "searchKey": {
            "type": "string",
            "description": "Search key for filtering change logs"
          },
          "pageNumber": {
            "type": "integer",
            "description": "Page number for paginated results"
          }
        },
        "required": [
          "searchKey"
        ]
      },
      "PagedResponse_AdminSearchChangeLog": {
        "type": "object",
        "properties": {
          "totalRecords": {
            "type": "integer"
          },
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminSearchChangeLog"
            }
          },
          "pagerInfo": {
            "$ref": "#/components/schemas/Pager"
          }
        }
      },
      "AdminSearchChangeLog": {
        "type": "object",
        "properties": {
          "changeLogId": {
            "type": "integer"
          },
          "changeType": {
            "$ref": "#/components/schemas/ChangeType"
          },
          "dateAndTimeOfChange": {
            "type": "string",
            "format": "date-time"
          },
          "zendeskTicketID": {
            "type": "string"
          },
          "learnerFirstname": {
            "type": "string"
          },
          "learnerLastname": {
            "type": "string"
          },
          "uln": {
            "type": "integer"
          },
          "providerName": {
            "type": "string"
          },
          "providerUkprn": {
            "type": "integer"
          },
          "lastUpdatedBy": {
            "type": "string"
          }
        }
      },
      "ChangeType": {
        "type": "string",
        "enum": [
          "StartYear",
          "IndustryPlacement",
          "AddPathwayAssessment",
          "AddSpecialismAssessment",
          "RemovePathwayAssessment",
          "RemoveSpecialismAssessment",
          "AddPathwayResult",
          "AddSpecialismResult",
          "ChangePathwayResult",
          "ChangeSpecialismResult",
          "OpenPathwayRomm",
          "OpenSpecialismRomm",
          "PathwayRommOutcome",
          "SpecialismRommOutcome",
          "OpenPathwayAppeal",
          "OpenSpecialismAppeal",
          "PathwayAppealOutcome",
          "SpecialismAppealOutcome",
          "MathsStatus",
          "EnglishStatus",
          "Uln"
        ]
      },
      "AdminChangeLogRecord": {
        "type": "object",
        "properties": {
          "changeLogId": {
            "type": "integer"
          },
          "registrationPathwayId": {
            "type": "integer"
          },
          "pathwayName": {
            "type": "string"
          },
          "coreExamPeriod": {
            "type": "string"
          },
          "coreCode": {
            "type": "string"
          },
          "coreGrade": {
            "type": "string"
          },
          "specialismName": {
            "type": "string"
          },
          "specialismCode": {
            "type": "string"
          },
          "specialismExamPeriod": {
            "type": "string"
          },
          "specialismGrade": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "uln": {
            "type": "integer"
          },
          "createdBy": {
            "type": "string"
          },
          "changeType": {
            "$ref": "#/components/schemas/ChangeType"
          },
          "changeDetails": {
            "type": "string"
          },
          "changeRequestedBy": {
            "type": "string"
          },
          "changeDateOfRequest": {
            "type": "string",
            "format": "date-time"
          },
          "reasonForChange": {
            "type": "string"
          },
          "zendeskTicketID": {
            "type": "string"
          },
          "dateAndTimeOfChange": {
            "type": "string",
            "format": "date-time"
          },
          "pathway": {
            "$ref": "#/components/schemas/AdminChangeLogPathway"
          }
        }
      },
      "AdminChangeLogPathway": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "larId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "startYear": {
            "type": "integer"
          },
          "academicYear": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "Active",
              "InActive",
              "Transferred",
              "Withdrawn",
              "NotSpecified"
            ]
          },
          "provider": {
            "$ref": "#/components/schemas/Provider"
          },
          "pathwayAssessments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminChangeLogAssessment"
            }
          },
          "specialisms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminChangeLogSpecialism"
            }
          }
        }
      },
      "AdminChangeLogAssessment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "seriesId": {
            "type": "integer"
          },
          "seriesName": {
            "type": "string"
          },
          "resultEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "rommEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "appealEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "lastUpdatedOn": {
            "type": "string",
            "format": "date-time"
          },
          "lastUpdatedBy": {
            "type": "string"
          },
          "componentType": {
            "type": "integer"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminChangeLogResult"
            }
          }
        }
      },
      "AdminChangeLogSpecialism": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "larId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "tlSpecialismCombinations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "integer"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "assessments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminChangeLogAssessment"
            }
          }
        }
      },
      "Pager": {
        "type": "object",
        "properties": {
          "totalItems": {
            "type": "integer"
          },
          "currentPage": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          },
          "startPage": {
            "type": "integer"
          },
          "recordFrom": {
            "type": "integer"
          },
          "recordTo": {
            "type": "integer"
          }
        }
      },
      "Provider": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "ukprn": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "AdminChangeLogResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      }
    }
  }
}
