{
  "openapi": "3.1.0",
  "info": {
    "title": "Post Results Service",
    "version": "1.0.0",
    "description": "API for managing post results services such as reviews, appeals, and grade changes."
  },
  "paths": {
    "/post-results-reviews-appeals-and-grade-changes": {
      "get": {
        "operationId": "StartReviewsAndAppealsAsync",
        "summary": "Start reviews and appeals",
        "responses": {
          "200": {
            "description": "Returns the StartReviewsAndAppeals page",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/results-reviews-appeals-and-grade-changes": {
      "get": {
        "operationId": "ResultReviewsAndAppealsAsync",
        "summary": "Result reviews and appeals",
        "responses": {
          "200": {
            "description": "Returns the ResultReviewsAndAppeals page",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/post-results-learner-withdrawn/{profileId}": {
      "get": {
        "operationId": "PrsUlnWithdrawnAsync",
        "summary": "Handles learner with withdrawn status",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns learner withdrawn details",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Learner record not found"
          }
        }
      }
    },
    "/post-results-no-results/{profileId}": {
      "get": {
        "operationId": "PrsNoResultsAsync",
        "summary": "Handles learner with no results",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns no results page",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Learner record not found"
          }
        }
      }
    },
    "/post-results-learners-grades/{profileId}": {
      "get": {
        "operationId": "PrsLearnerDetailsAsync",
        "summary": "Fetch learner details and grades",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns learner dashboard with grades",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Learner record not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PrsLearnerRecord": {
        "type": "object",
        "properties": {}
      },
      "PrsUlnWithdrawnViewModel": {
        "type": "object",
        "properties": {}
      },
      "PrsNoResultsViewModel": {
        "type": "object",
        "properties": {}
      },
      "PrsLearnerDetailsViewModel": {
        "type": "object",
        "properties": {}
      }
    }
  }
}
