{
  "openapi": "3.1.0",
  "info": {
    "title": "ManageRegistration API",
    "version": "1.0.0",
    "description": "API definition for managing registration-related operations in tl-results-and-certification application."
  },
  "paths": {
    "/change-registration-learners-name/{profileId}": {
      "get": {
        "operationId": "getChangeLearnersName",
        "summary": "Get learner's registration profile for name change",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangeLearnersNameViewModel"
                }
              }
            }
          },
          "404": {
            "description": "No registration details found for the provided profile ID"
          }
        }
      }
    },
    "/change-registration-learners-name": {
      "post": {
        "operationId": "postChangeLearnersName",
        "summary": "Submit learner's name change request",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeLearnersNameViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirection response"
          }
        }
      }
    },
    "/change-registration-learners-date-of-birth/{profileId}": {
      "get": {
        "operationId": "getChangeDateofBirth",
        "summary": "Get learner's registration profile for date of birth change",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangeDateofBirthViewModel"
                }
              }
            }
          },
          "404": {
            "description": "No registration details found for the provided profile ID"
          }
        }
      }
    },
    "/change-registration-learners-date-of-birth": {
      "post": {
        "operationId": "postChangeDateofBirth",
        "summary": "Submit learner's date of birth change request",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeDateofBirthViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirection response"
          }
        }
      }
    },
    "/registration-details-change-confirmation": {
      "get": {
        "operationId": "getChangeConfirmationPage",
        "summary": "Redirect to confirmation page after change",
        "responses": {
          "200": {
            "description": "Redirect to confirmation page view."
          },
          "404": {
            "description": "Unable to find confirmation."
          }
        }
      }
    },
    "/change-registration-provider/{profileId}/{isback}": {
      "get": {
        "operationId": "getChangeProvider",
        "summary": "Get learner's registration profile for provider change",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "isback",
            "in": "path",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangeProviderViewModel"
                }
              }
            }
          },
          "404": {
            "description": "No registration details found."
          }
        }
      }
    },
    "/change-registration-provider": {
      "post": {
        "operationId": "postChangeProvider",
        "summary": "Submit provider change request for learner registration",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeProviderViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirection response"
          }
        }
      }
    },
    "/change-core-and-provider/{profileId}": {
      "get": {
        "operationId": "getChangeCoreQuestion",
        "summary": "Get core change question details for registration",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangeCoreQuestionViewModel"
                }
              }
            }
          },
          "404": {
            "description": "No change core question details found."
          }
        }
      }
    },
    "/change-core-and-provider": {
      "post": {
        "operationId": "postChangeCoreQuestion",
        "summary": "Submit core change question response for registration",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeCoreQuestionViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirection response"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChangeLearnersNameViewModel": {
        "type": "object",
        "properties": {
          "ProfileId": {
            "type": "integer"
          },
          "Firstname": {
            "type": "string"
          },
          "Lastname": {
            "type": "string"
          }
        }
      },
      "ChangeDateofBirthViewModel": {
        "type": "object",
        "properties": {
          "ProfileId": {
            "type": "integer"
          },
          "DateofBirth": {
            "type": "string",
            "description": "Date of birth in format DD/MM/YYYY"
          }
        }
      },
      "ManageRegistrationResponse": {
        "type": "object",
        "properties": {}
      },
      "ChangeProviderViewModel": {
        "type": "object",
        "properties": {
          "ProfileId": {
            "type": "integer"
          },
          "SelectedProviderUkprn": {
            "type": "string"
          },
          "SelectedProviderDisplayName": {
            "type": "string"
          }
        }
      },
      "ChangeCoreQuestionViewModel": {
        "type": "object",
        "properties": {
          "ProfileId": {
            "type": "integer"
          },
          "CanChangeCore": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
