{
  "openapi": "3.1.0",
  "info": {
    "title": "Admin Assessment Series Dates API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/AdminAssessmentSeriesDates/GetAssessmentSeriesDate/{assessmentId}": {
      "get": {
        "summary": "Get details of an assessment series date",
        "operationId": "GetAssessmentSeriesDatesAsync",
        "parameters": [
          {
            "name": "assessmentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAssessmentSeriesDatesDetailsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/AdminAssessmentSeriesDates/SearchAssessmentSeriesDates": {
      "post": {
        "summary": "Search for assessment series dates",
        "operationId": "SearchAssessmentSeriesDatesAsync",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchAssessmentSeriesDatesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paged list of assessment series dates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResponseGetAssessmentSeriesDatesDetailsResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAssessmentSeriesDatesDetailsResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "componentType": {
            "$ref": "#/components/schemas/ComponentType"
          },
          "resultCalculationYear": {
            "type": "integer",
            "nullable": true
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "endDate": {
            "type": "string",
            "format": "date-time"
          },
          "rommEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "appealEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "resultPublishDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "printAvailableDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "SearchAssessmentSeriesDatesRequest": {
        "type": "object",
        "properties": {
          "selectedFilters": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "pageNumber": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "PagedResponseGetAssessmentSeriesDatesDetailsResponse": {
        "type": "object",
        "properties": {
          "totalRecords": {
            "type": "integer"
          },
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetAssessmentSeriesDatesDetailsResponse"
            }
          },
          "pagerInfo": {
            "$ref": "#/components/schemas/Pager"
          }
        }
      },
      "Pager": {
        "type": "object",
        "properties": {
          "totalItems": {
            "type": "integer"
          },
          "currentPage": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          },
          "startPage": {
            "type": "integer"
          },
          "recordFrom": {
            "type": "integer"
          },
          "recordTo": {
            "type": "integer"
          }
        }
      },
      "ComponentType": {
        "type": "string",
        "enum": [
          "NotSpecified",
          "Core",
          "Specialism"
        ]
      }
    }
  }
}
