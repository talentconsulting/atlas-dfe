{
  "openapi": "3.1.0",
  "info": {
    "title": "Learner API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/Learner/GetLearnerRecord/{aoUkprn}/{profileId}/{status}": {
      "get": {
        "summary": "Get a learner record",
        "operationId": "GetLearnerRecord",
        "parameters": [
          {
            "name": "aoUkprn",
            "in": "path",
            "required": true,
            "description": "The awarding organization's UK Provider Reference Number.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "description": "The learner's profile ID.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "status",
            "in": "path",
            "required": false,
            "description": "The registration pathway status (optional).",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1,
                2,
                3,
                4
              ],
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The learner record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LearnerRecord"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LearnerRecord": {
        "type": "object",
        "properties": {
          "ProfileId": {
            "type": "integer",
            "format": "int32"
          },
          "Uln": {
            "type": "integer",
            "format": "int64"
          },
          "Firstname": {
            "type": "string"
          },
          "Lastname": {
            "type": "string"
          },
          "DateofBirth": {
            "type": "string",
            "format": "date-time"
          },
          "Gender": {
            "type": "string"
          },
          "Pathway": {
            "$ref": "#/components/schemas/Pathway"
          }
        }
      },
      "Pathway": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int32"
          },
          "LarId": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          },
          "StartYear": {
            "type": "integer",
            "format": "int32"
          },
          "AcademicYear": {
            "type": "integer",
            "format": "int32"
          },
          "Status": {
            "$ref": "#/components/schemas/RegistrationPathwayStatus"
          },
          "Provider": {
            "$ref": "#/components/schemas/Provider"
          },
          "PathwayAssessments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Assessment"
            }
          },
          "Specialisms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Specialism"
            }
          },
          "IndustryPlacements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IndustryPlacement"
            }
          }
        }
      },
      "RegistrationPathwayStatus": {
        "type": "integer",
        "description": "Registration pathway status.",
        "enum": [
          0,
          1,
          2,
          3,
          4
        ]
      },
      "Provider": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int32"
          },
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "Name": {
            "type": "string"
          }
        }
      },
      "Assessment": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int32"
          },
          "SeriesId": {
            "type": "integer",
            "format": "int32"
          },
          "SeriesName": {
            "type": "string"
          },
          "Result": {
            "$ref": "#/components/schemas/Result"
          }
        }
      },
      "Result": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int32"
          },
          "Grade": {
            "type": "string"
          },
          "PublishDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Specialism": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int32"
          },
          "LarId": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "ComponentGrades": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ComponentGrade"
            }
          }
        }
      },
      "ComponentGrade": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int32"
          },
          "Code": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          }
        }
      },
      "IndustryPlacement": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int32"
          },
          "Status": {
            "$ref": "#/components/schemas/IndustryPlacementStatus"
          }
        }
      },
      "IndustryPlacementStatus": {
        "type": "string",
        "enum": [
          "Completed",
          "NotCompleted",
          "Exempt"
        ]
      }
    }
  }
}
