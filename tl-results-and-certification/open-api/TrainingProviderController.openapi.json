{
  "openapi": "3.1.0",
  "info": {
    "title": "Training Provider API",
    "version": "1.0.0"
  },
  "paths": {
    "/manage-learners/{academicYear}/{pageNumber}": {
      "get": {
        "operationId": "SearchLearnerDetails",
        "parameters": [
          {
            "name": "academicYear",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "pageNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Learner details fetched successfully"
          }
        }
      },
      "post": {
        "operationId": "SubmitSearchLearnerDetails",
        "parameters": [
          {
            "name": "academicYear",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchCriteriaViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Learner details fetched successfully"
          }
        }
      }
    },
    "/manage-learners-clearsearchkey/{academicYear}": {
      "get": {
        "operationId": "SearchLearnerClearKey",
        "parameters": [
          {
            "name": "academicYear",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cleared search key successfully"
          }
        }
      }
    },
    "/manage-learners-applyfilters": {
      "post": {
        "operationId": "SubmitSearchLearnerApplyFilters",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchCriteriaViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Filters applied successfully"
          }
        }
      }
    },
    "/manage-learners-clearfilters/{academicYear}": {
      "get": {
        "operationId": "SearchLearnerClearFilters",
        "parameters": [
          {
            "name": "academicYear",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cleared filters successfully"
          }
        }
      }
    },
    "/request-replacement-document/{profileId}": {
      "get": {
        "operationId": "RequestReplacementDocument",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fetched replacement document eligibility"
          }
        }
      },
      "post": {
        "operationId": "SubmitRequestReplacementDocument",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestReplacementDocumentViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Replacement document request submitted successfully"
          }
        }
      }
    },
    "/manage-learners-add-withdrawn-status/{profileId}": {
      "get": {
        "operationId": "AddWithdrawnStatus",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fetched withdrawn status view"
          }
        }
      },
      "post": {
        "operationId": "SubmitWithdrawnStatus",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddWithdrawnStatusViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Withdrawal status updated successfully"
          }
        }
      }
    },
    "/search-learner-records": {
      "get": {
        "operationId": "SearchLearnerRecord",
        "responses": {
          "200": {
            "description": "Fetched learner record search view"
          }
        }
      },
      "post": {
        "operationId": "SubmitSearchLearnerRecord",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchLearnerRecordViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Searched learner record successfully"
          }
        }
      }
    },
    "/learner-record-page/{profileId}": {
      "get": {
        "operationId": "LearnerRecordDetails",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fetched learner record details successfully"
          }
        }
      }
    },
    "/provider-guidance": {
      "get": {
        "operationId": "ProviderGuidance",
        "responses": {
          "200": {
            "description": "Fetched provider guidance view successfully"
          }
        }
      }
    },
    "/provider-timeline": {
      "get": {
        "operationId": "ProviderTimeline",
        "responses": {
          "200": {
            "description": "Fetched provider timeline view successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SearchCriteriaViewModel": {
        "type": "object",
        "properties": {
          "SearchLearnerFilters": {
            "type": "object"
          },
          "SearchKey": {
            "type": "string"
          },
          "AcademicYear": {
            "type": "integer"
          },
          "PageNumber": {
            "type": "integer"
          },
          "IsSearchKeyApplied": {
            "type": "boolean"
          }
        }
      },
      "RequestReplacementDocumentViewModel": {
        "type": "object",
        "properties": {
          "ProfileId": {
            "type": "integer"
          },
          "Uln": {
            "type": "integer"
          },
          "LearnerName": {
            "type": "string"
          },
          "ProviderAddress": {
            "$ref": "#/components/schemas/ProviderAddress"
          },
          "PrintCertificateId": {
            "type": "integer"
          },
          "PrintCertificateType": {
            "type": "string"
          },
          "LastDocumentRequestedDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProviderAddress": {
        "type": "object",
        "properties": {
          "AddressId": {
            "type": "integer"
          },
          "DepartmentName": {
            "type": "string"
          },
          "OrganisationName": {
            "type": "string"
          },
          "AddressLine1": {
            "type": "string"
          },
          "AddressLine2": {
            "type": "string"
          },
          "Town": {
            "type": "string"
          },
          "Postcode": {
            "type": "string"
          }
        }
      },
      "AddWithdrawnStatusViewModel": {
        "type": "object",
        "properties": {
          "IsPendingWithdrawl": {
            "type": "boolean"
          },
          "RegistrationPathwayStatus": {
            "type": "string"
          },
          "ProfileId": {
            "type": "integer"
          },
          "LearnerName": {
            "type": "string"
          },
          "AcademicYear": {
            "type": "integer"
          },
          "AwardingOrganisationName": {
            "type": "string"
          },
          "ProviderUkprn": {
            "type": "integer"
          }
        }
      },
      "SearchLearnerRecordViewModel": {
        "type": "object",
        "properties": {
          "SearchUln": {
            "type": "string"
          },
          "IsLearnerRegistered": {
            "type": "boolean"
          },
          "IsLearnerRecordAdded": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
