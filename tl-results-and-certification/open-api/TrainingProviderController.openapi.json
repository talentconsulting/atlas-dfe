{
  "openapi": "3.1.0",
  "info": {
    "title": "TrainingProvider API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/TrainingProvider/FindLearnerRecord/{providerUkprn}/{uln}": {
      "get": {
        "summary": "Find Learner Record",
        "operationId": "FindLearnerRecord",
        "parameters": [
          {
            "name": "providerUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "uln",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Learner record found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FindLearnerRecord"
                }
              }
            }
          }
        }
      }
    },
    "/api/TrainingProvider/GetLearnerRecordDetails/{providerUkprn}/{profileId}/{pathwayId}": {
      "get": {
        "summary": "Get Learner Record Details",
        "operationId": "GetLearnerRecordDetails",
        "parameters": [
          {
            "name": "providerUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pathwayId",
            "in": "path",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Learner record details found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LearnerRecordDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/TrainingProvider/UpdateLearnerSubject": {
      "put": {
        "summary": "Update Learner Subject",
        "operationId": "UpdateLearnerSubject",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateLearnerSubjectRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Learner subject updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "/api/TrainingProvider/SearchLearnerDetails": {
      "post": {
        "summary": "Search Learner Details",
        "operationId": "SearchLearnerDetails",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchLearnerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Learner details found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResponse_SearchLearnerDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/TrainingProvider/GetSearchLearnerFilters/{providerukprn}": {
      "get": {
        "summary": "Get Search Learner Filters",
        "operationId": "GetSearchLearnerFilters",
        "parameters": [
          {
            "name": "providerukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search learner filters retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchLearnerFilters"
                }
              }
            }
          }
        }
      }
    },
    "/api/TrainingProvider/CreateReplacementDocumentPrintingRequest": {
      "post": {
        "summary": "Create Replacement Document Printing Request",
        "operationId": "CreateReplacementDocumentPrintingRequest",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplacementPrintRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Replacement document printing request created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
