{
  "openapi": "3.1.0",
  "info": {
    "title": "ProviderRegistrations API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/ProviderRegistrations/GetAvailableStartYears": {
      "get": {
        "tags": [
          "ProviderRegistrations"
        ],
        "operationId": "GetAvailableStartYears",
        "responses": {
          "200": {
            "description": "List of available start years",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/ProviderRegistrations/GetRegistrations": {
      "post": {
        "tags": [
          "ProviderRegistrations"
        ],
        "operationId": "GetRegistrations",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetProviderRegistrationsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Provider registrations data export response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataExportResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetProviderRegistrationsRequest": {
        "type": "object",
        "properties": {
          "ProviderUkprn": {
            "type": "integer",
            "example": 12345678,
            "description": "UKPRN of the provider"
          },
          "StartYear": {
            "type": "integer",
            "example": 2024,
            "description": "Start year for the provider registration"
          },
          "RequestedBy": {
            "type": "string",
            "example": "John Doe",
            "description": "Identifier of the requestor"
          }
        },
        "required": [
          "ProviderUkprn",
          "StartYear",
          "RequestedBy"
        ]
      },
      "DataExportResponse": {
        "type": "object",
        "properties": {
          "IsDataFound": {
            "type": "boolean",
            "description": "Status indicating if the data is found"
          },
          "BlobUniqueReference": {
            "type": "string",
            "format": "uuid",
            "description": "Unique reference for the exported file"
          },
          "FileSize": {
            "type": "number",
            "description": "Size of the exported file"
          },
          "ComponentType": {
            "type": "integer",
            "description": "Type of the component",
            "enum": [
              0,
              1,
              2
            ],
            "example": 1
          }
        }
      }
    }
  }
}
