{
  "openapi": "3.1.0",
  "info": {
    "title": "ProviderRegistrations API",
    "version": "1.0.0"
  },
  "paths": {
    "/download-registrations-data": {
      "get": {
        "summary": "Download registrations data overview",
        "operationId": "DownloadRegistrationsDataAsync",
        "security": [
          {
            "RolesExtensions.RequireLearnerRecordsEditorAccess": []
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the view for selecting start years for registration data download.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadRegistrationsDataViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirects to a problem service route if the start years are unavailable."
          }
        }
      }
    },
    "/download-registrations-data-for": {
      "get": {
        "summary": "Download registrations data for a specific year",
        "operationId": "DownloadRegistrationsDataForAsync",
        "parameters": [
          {
            "name": "startYear",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "security": [
          {
            "RolesExtensions.RequireLearnerRecordsEditorAccess": []
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the view for downloading registrations for a specific start year.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadRegistrationsDataForViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirects to different routes based on the availability of data."
          }
        }
      }
    },
    "/download-registrations-data-for/{id}": {
      "get": {
        "summary": "Generate and download the registration file by ID",
        "operationId": "DownloadRegistrationsDataForLinkAsync",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "RolesExtensions.RequireLearnerRecordsEditorAccess": []
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the binary content of the registration data file.",
            "content": {
              "application/octet-stream": {}
            }
          },
          "302": {
            "description": "Redirects to an error route for invalid GUID."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AvailableStartYearViewModel": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer"
          }
        }
      },
      "DownloadRegistrationsDataViewModel": {
        "type": "object",
        "properties": {
          "availableStartYearViewModels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailableStartYearViewModel"
            }
          }
        }
      },
      "DownloadRegistrationsDataForViewModel": {
        "type": "object",
        "properties": {
          "downloadUrl": {
            "type": "string",
            "format": "url"
          },
          "startYear": {
            "type": "integer"
          }
        }
      }
    },
    "securitySchemes": {
      "RolesExtensions.RequireLearnerRecordsEditorAccess": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
