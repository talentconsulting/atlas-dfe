{
  "openapi": "3.1.0",
  "info": {
    "title": "Common API",
    "version": "1.0.0",
    "description": "Provides endpoints for common operations such as lookup data, user type info, and academic years."
  },
  "paths": {
    "/api/Common/GetLookupData/{lookupCategory}": {
      "get": {
        "summary": "Retrieve lookup data for the specified category.",
        "parameters": [
          {
            "name": "lookupCategory",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/LookupCategory"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful lookup data retrieval.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LookupData"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/Common/GetLoggedInUserTypeInfo/{ukprn}": {
      "get": {
        "summary": "Retrieve logged-in user type information based on UKPRN.",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Logged-in user type information retrieval successful.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoggedInUserTypeInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/Common/CurrentAcademicYears": {
      "get": {
        "summary": "Retrieve current academic years.",
        "responses": {
          "200": {
            "description": "Current academic years retrieval successful.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AcademicYear"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/Common/AcademicYears": {
      "get": {
        "summary": "Retrieve all academic years.",
        "responses": {
          "200": {
            "description": "All academic years retrieval successful.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AcademicYear"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LookupCategory": {
        "type": "string",
        "enum": [
          "PathwayComponentGrade",
          "QualificationSubject",
          "SpecialismComponentGrade",
          "OverallResult"
        ]
      },
      "LookupData": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "code",
          "value"
        ]
      },
      "LoggedInUserTypeInfo": {
        "type": "object",
        "properties": {
          "ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "userType": {
            "$ref": "#/components/schemas/LoginUserType"
          }
        },
        "required": [
          "ukprn",
          "name",
          "userType"
        ]
      },
      "LoginUserType": {
        "type": "string",
        "enum": [
          "NotSpecified",
          "AwardingOrganisation",
          "TrainingProvider",
          "Admin"
        ]
      },
      "AcademicYear": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "year"
        ]
      }
    }
  }
}
