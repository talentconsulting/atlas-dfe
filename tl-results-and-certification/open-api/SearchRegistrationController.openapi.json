{
  "openapi": "3.1.0",
  "info": {
    "title": "Search Registration API",
    "version": "1.0.0",
    "description": "Endpoints for managing Search Registration functionality."
  },
  "paths": {
    "/search-learner-clear": {
      "get": {
        "summary": "Clear Cache for Search Registration",
        "operationId": "searchRegistrationClear",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "Registration",
                "Assessment",
                "Result",
                "PostResult"
              ]
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to the corresponding search registration page."
          }
        }
      }
    },
    "/search-learner": {
      "get": {
        "summary": "Search Registration",
        "operationId": "searchRegistration",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "Registration",
                "Assessment",
                "Result",
                "PostResult"
              ]
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "Page number for paginated results."
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the Search Registration view.",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/search-learner-search-key": {
      "post": {
        "summary": "Submit Search Key for Search Registration",
        "operationId": "searchRegistrationSearchKey",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRegistrationCriteriaViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to search registration details with filters applied."
          }
        }
      }
    },
    "/search-learner-clear-key": {
      "post": {
        "summary": "Clear Search Key",
        "operationId": "searchRegistrationClearKey",
        "responses": {
          "302": {
            "description": "Redirects to search registration details with search key cleared."
          }
        }
      }
    },
    "/search-learner-filters": {
      "post": {
        "summary": "Submit Filters for Search Registration",
        "operationId": "searchRegistrationFilters",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRegistrationFiltersViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to search registration details with filters applied."
          }
        }
      }
    },
    "/search-learner-clear-filters": {
      "post": {
        "summary": "Clear Filters",
        "operationId": "searchRegistrationClearFilters",
        "responses": {
          "302": {
            "description": "Redirects to search registration details with filters cleared."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SearchRegistrationCriteriaViewModel": {
        "type": "object",
        "properties": {
          "Filters": {
            "$ref": "#/components/schemas/SearchRegistrationFiltersViewModel"
          },
          "SearchKey": {
            "type": "string",
            "description": "Search key for the registration."
          },
          "PageNumber": {
            "type": "integer",
            "format": "int32",
            "description": "Specifies the page number for paginated results."
          },
          "IsSearchKeyApplied": {
            "type": "boolean",
            "description": "Indicates whether a search key has been applied."
          },
          "AreFiltersApplied": {
            "type": "boolean",
            "description": "Indicates whether filters have been applied."
          }
        }
      },
      "SearchRegistrationFiltersViewModel": {
        "type": "object",
        "properties": {
          "Search": {
            "type": "string",
            "description": "Search term for provider name."
          },
          "SelectedProviderId": {
            "type": "integer",
            "format": "int32",
            "description": "Selected provider identifier."
          },
          "AcademicYears": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "The list of academic years."
          },
          "IsApplyFiltersSelected": {
            "type": "boolean",
            "description": "Indicates if filters are selected."
          }
        }
      }
    }
  }
}
