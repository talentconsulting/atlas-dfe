{
  "openapi": "3.1.0",
  "info": {
    "title": "Search Registration API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/SearchRegistration/GetSearchRegistrationFilters": {
      "get": {
        "summary": "Retrieve search registration filters",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchRegistrationFilters"
                }
              }
            }
          }
        }
      }
    },
    "/api/SearchRegistration/SearchRegistrationDetails": {
      "post": {
        "summary": "Search registration details",
        "requestBody": {
          "description": "Search registration request payload",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRegistrationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResponse_SearchRegistrationDetail"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SearchRegistrationFilters": {
        "type": "object",
        "properties": {
          "AcademicYears": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FilterLookupData"
            }
          }
        }
      },
      "FilterLookupData": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer"
          },
          "Name": {
            "type": "string"
          },
          "CoreCode": {
            "type": "string"
          },
          "IsSelected": {
            "type": "boolean"
          }
        }
      },
      "SearchRegistrationRequest": {
        "type": "object",
        "properties": {
          "AoUkprn": {
            "type": "integer"
          },
          "SearchKey": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer",
            "nullable": true
          },
          "SelectedAcademicYears": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "PageNumber": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "PagedResponse_SearchRegistrationDetail": {
        "type": "object",
        "properties": {
          "TotalRecords": {
            "type": "integer"
          },
          "Records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchRegistrationDetail"
            }
          },
          "PagerInfo": {
            "$ref": "#/components/schemas/Pager"
          }
        }
      },
      "SearchRegistrationDetail": {
        "type": "object",
        "properties": {
          "RegistrationProfileId": {
            "type": "integer"
          },
          "Uln": {
            "type": "integer"
          },
          "Firstname": {
            "type": "string"
          },
          "Lastname": {
            "type": "string"
          },
          "ProviderName": {
            "type": "string"
          },
          "ProviderUkprn": {
            "type": "integer"
          },
          "PathwayName": {
            "type": "string"
          },
          "PathwayLarId": {
            "type": "string"
          },
          "AcademicYear": {
            "type": "integer"
          },
          "IsWithdrawn": {
            "type": "boolean"
          },
          "HasResults": {
            "type": "boolean"
          }
        }
      },
      "Pager": {
        "type": "object",
        "properties": {
          "TotalItems": {
            "type": "integer"
          },
          "CurrentPage": {
            "type": "integer"
          },
          "PageSize": {
            "type": "integer"
          },
          "TotalPages": {
            "type": "integer"
          },
          "StartPage": {
            "type": "integer"
          },
          "RecordFrom": {
            "type": "integer"
          },
          "RecordTo": {
            "type": "integer"
          }
        }
      }
    }
  }
}
