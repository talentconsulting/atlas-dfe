{
  "openapi": "3.1.0",
  "info": {
    "title": "TimeoutController API",
    "version": "1.0.0",
    "description": "API for managing user session activities and timeouts."
  },
  "paths": {
    "/active-duration": {
      "get": {
        "summary": "Get active session duration",
        "operationId": "getActiveDuration",
        "responses": {
          "200": {
            "description": "Returns the remaining active session duration in minutes and seconds.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionActivityData"
                }
              }
            }
          }
        }
      }
    },
    "/renew-activity": {
      "get": {
        "summary": "Renew user session activity",
        "operationId": "renewSessionActivity",
        "responses": {
          "200": {
            "description": "Returns the renewed session time in minutes and seconds.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionActivityData"
                }
              }
            }
          }
        }
      }
    },
    "/activity-timeout": {
      "get": {
        "summary": "Handle user session timeout",
        "operationId": "activityTimeout",
        "responses": {
          "204": {
            "description": "Successfully handled session timeout with no response body."
          }
        }
      }
    },
    "/timeout": {
      "get": {
        "summary": "Timeout confirmation view",
        "operationId": "timeoutConfirmation",
        "responses": {
          "200": {
            "description": "Displays the timeout confirmation view.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string",
                  "example": "Timeout confirmation page."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SessionActivityData": {
        "type": "object",
        "properties": {
          "Minutes": {
            "type": "integer",
            "example": 5,
            "description": "Number of minutes remaining in the session activity."
          },
          "Seconds": {
            "type": "integer",
            "example": 30,
            "description": "Number of seconds remaining in the session activity."
          }
        },
        "required": [
          "Minutes",
          "Seconds"
        ]
      }
    }
  }
}
