{
  "openapi": "3.1.0",
  "info": {
    "title": "AssessmentSeries API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/AssessmentSeries/GetResultCalculationAssessment": {
      "get": {
        "operationId": "GetResultCalculationAssessmentAsync",
        "summary": "Retrieves details of the assessment series used for result calculation.",
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentSeriesDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssessmentSeriesDetails": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer"
          },
          "ComponentType": {
            "$ref": "#/components/schemas/ComponentType"
          },
          "Name": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          },
          "Year": {
            "type": "integer"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          },
          "AppealEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "ResultPublishDate": {
            "type": "string",
            "format": "date-time"
          },
          "ResultCalculationYear": {
            "type": "integer"
          }
        },
        "required": [
          "Id",
          "ComponentType",
          "Name",
          "Year",
          "StartDate",
          "EndDate"
        ]
      },
      "ComponentType": {
        "type": "string",
        "enum": [
          "NotSpecified",
          "Core",
          "Specialism"
        ]
      }
    }
  }
}
