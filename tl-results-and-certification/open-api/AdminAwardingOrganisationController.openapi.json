{
  "openapi": "3.1.0",
  "info": {
    "title": "Admin Awarding Organisation API",
    "version": "1.0.0",
    "description": "API for managing and interacting with resources related to awarding organisations."
  },
  "paths": {
    "/admin/select-awarding-organisation-clear": {
      "get": {
        "operationId": "AdminSelectAwardingOrganisationClear",
        "summary": "Clear awarding organisation selection.",
        "tags": [
          "AdminAwardingOrganisation"
        ],
        "responses": {
          "302": {
            "description": "Redirects to the main Select Awarding Organisation route."
          }
        }
      }
    },
    "/admin/select-awarding-organisation": {
      "get": {
        "operationId": "AdminGetSelectAwardingOrganisation",
        "summary": "Get the selection page for awarding organisations.",
        "tags": [
          "AdminAwardingOrganisation"
        ],
        "responses": {
          "200": {
            "description": "Returns the selection page view."
          }
        }
      },
      "post": {
        "operationId": "AdminPostSelectAwardingOrganisation",
        "summary": "Submit selected awarding organisation.",
        "tags": [
          "AdminAwardingOrganisation"
        ],
        "requestBody": {
          "description": "Selected awarding organisation data.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminSelectAwardingOrganisation"
              }
            }
          },
          "required": true
        },
        "responses": {
          "302": {
            "description": "Redirects to the results and ROMMs download page for the selected awarding organisation."
          },
          "400": {
            "description": "Validation errors in the submitted data."
          }
        }
      }
    },
    "/admin/download-results-romms-awarding-organisation/{awardingOrganisationUkprn}": {
      "get": {
        "operationId": "AdminDownloadResultsRomms",
        "summary": "Download results and ROMMs data for an awarding organisation.",
        "tags": [
          "AdminAwardingOrganisation"
        ],
        "parameters": [
          {
            "name": "awardingOrganisationUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Unique identifying UKPRN of the awarding organisation."
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the download page view for results and ROMMs data."
          },
          "404": {
            "description": "Awarding organisation not found."
          },
          "302": {
            "description": "Redirects to the problem with service page."
          }
        }
      }
    },
    "/admin/download-core-results/{awardingOrganisationUkprn}/{fileId}": {
      "get": {
        "operationId": "AdminDownloadCoreResults",
        "summary": "Download core results data file.",
        "tags": [
          "AdminAwardingOrganisation"
        ],
        "parameters": [
          {
            "name": "awardingOrganisationUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Unique identifying UKPRN of the awarding organisation."
          },
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the file to download."
          }
        ],
        "responses": {
          "200": {
            "description": "Stream containing the core results data file in CSV format."
          },
          "404": {
            "description": "File not found or invalid fileId."
          },
          "302": {
            "description": "Redirects to the problem with service page."
          }
        }
      }
    },
    "/admin/download-specialism-results/{awardingOrganisationUkprn}/{fileId}": {
      "get": {
        "operationId": "AdminDownloadSpecialismResults",
        "summary": "Download specialism results data file.",
        "tags": [
          "AdminAwardingOrganisation"
        ],
        "parameters": [
          {
            "name": "awardingOrganisationUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Unique identifying UKPRN of the awarding organisation."
          },
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the file to download."
          }
        ],
        "responses": {
          "200": {
            "description": "Stream containing the specialism results data file in CSV format."
          },
          "404": {
            "description": "File not found or invalid fileId."
          },
          "302": {
            "description": "Redirects to the problem with service page."
          }
        }
      }
    },
    "/admin/download-romms-data/{awardingOrganisationUkprn}/{fileId}": {
      "get": {
        "operationId": "AdminDownloadRommsData",
        "summary": "Download ROMMs data file.",
        "tags": [
          "AdminAwardingOrganisation"
        ],
        "parameters": [
          {
            "name": "awardingOrganisationUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Unique identifying UKPRN of the awarding organisation."
          },
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the file to download."
          }
        ],
        "responses": {
          "200": {
            "description": "Stream containing the ROMMs data report in CSV format."
          },
          "404": {
            "description": "File not found or invalid fileId."
          },
          "302": {
            "description": "Redirects to the problem with service page."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminSelectAwardingOrganisation": {
        "type": "object",
        "properties": {
          "selectedAwardingOrganisationUkprn": {
            "type": "integer",
            "format": "int64",
            "description": "Selected awarding organisation UKPRN."
          },
          "awardingOrganisations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AwardingOrganisationMetadata"
            },
            "description": "List of available awarding organisations for selection."
          }
        },
        "required": [
          "selectedAwardingOrganisationUkprn"
        ]
      },
      "AwardingOrganisationMetadata": {
        "type": "object",
        "properties": {
          "ukprn": {
            "type": "integer",
            "format": "int64",
            "description": "Unique identifying UKPRN."
          },
          "displayName": {
            "type": "string",
            "description": "Display name of the awarding organisation."
          }
        },
        "required": [
          "ukprn",
          "displayName"
        ]
      }
    }
  }
}
