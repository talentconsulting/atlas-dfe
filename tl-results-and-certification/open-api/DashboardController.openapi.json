{
  "openapi": "3.1.0",
  "info": {
    "title": "Dashboard API",
    "description": "API for managing dashboard operations",
    "version": "1.0.0"
  },
  "paths": {
    "/home": {
      "get": {
        "operationId": "getDashboardViewData",
        "tags": [
          "Dashboard"
        ],
        "summary": "Retrieve dashboard view model data",
        "description": "Fetches and returns data for the dashboard view model",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "JWT token for authentication",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of dashboard view model data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardViewModel"
                }
              }
            }
          },
          "302": {
            "description": "User access denied and redirected to another route",
            "headers": {
              "Location": {
                "description": "Redirect location URL",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DashboardViewModel": {
        "type": "object",
        "properties": {
          "hasAccessToService": {
            "type": "boolean",
            "description": "Indicates if the user has access to the service"
          }
        }
      }
    }
  }
}
