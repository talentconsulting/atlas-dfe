{
  "openapi": "3.1.0",
  "info": {
    "title": "AdminDashboard Controller API",
    "description": "APIs for managing administrative tasks and learner records.",
    "version": "1.0.0"
  },
  "paths": {
    "/admin/home": {
      "get": {
        "tags": [
          "AdminDashboard"
        ],
        "summary": "Redirect to the admin home page.",
        "operationId": "AdminHome",
        "responses": {
          "307": {
            "description": "Redirect to home page."
          }
        }
      }
    },
    "/admin/search-learner-records-clear": {
      "get": {
        "tags": [
          "AdminDashboard"
        ],
        "summary": "Clears search criteria for learner records.",
        "operationId": "AdminSearchLearnersRecordsClear",
        "responses": {
          "307": {
            "description": "Redirect to admin search learner records."
          }
        }
      }
    },
    "/admin/search-learner-records/{pageNumber}": {
      "get": {
        "tags": [
          "AdminDashboard"
        ],
        "summary": "Search for learner records using pagination.",
        "operationId": "AdminSearchLearners",
        "parameters": [
          {
            "name": "pageNumber",
            "in": "path",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "Page number for pagination."
          }
        ],
        "responses": {
          "200": {
            "description": "A list of learner records."
          },
          "404": {
            "description": "No learner records found."
          }
        }
      }
    },
    "/admin/search-learner-records-search-key": {
      "post": {
        "tags": [
          "AdminDashboard"
        ],
        "summary": "Apply a search key to filter learner records.",
        "operationId": "SubmitAdminSearchLearnerRecordsApplySearchKey",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminSearchLearnerCriteriaViewModel"
              }
            }
          }
        },
        "responses": {
          "307": {
            "description": "Redirect to admin search learner records."
          }
        }
      }
    },
    "/admin/search-learner-records-clear-key": {
      "post": {
        "tags": [
          "AdminDashboard"
        ],
        "summary": "Clear the search key for learner records.",
        "operationId": "SubmitAdminSearchLearnerClearKey",
        "responses": {
          "307": {
            "description": "Redirect to admin search learner records."
          }
        }
      }
    },
    "/admin/search-learner-records-filters": {
      "post": {
        "tags": [
          "AdminDashboard"
        ],
        "summary": "Apply filters to search learner records.",
        "operationId": "SubmitAdminSearchLearnerRecordsApplyFilters",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminSearchLearnerFiltersViewModel"
              }
            }
          }
        },
        "responses": {
          "307": {
            "description": "Redirect to admin search learner records."
          }
        }
      }
    },
    "/admin/search-learner-records-clear-filters": {
      "post": {
        "tags": [
          "AdminDashboard"
        ],
        "summary": "Clear filters for learner records search.",
        "operationId": "SubmitAdminSearchLearnerClearFilters",
        "responses": {
          "307": {
            "description": "Redirect to admin search learner records."
          }
        }
      }
    },
    "/admin/learner-record/{pathwayid}": {
      "get": {
        "tags": [
          "AdminDashboard"
        ],
        "summary": "Retrieve learner record by pathway ID.",
        "operationId": "AdminLearnerRecord",
        "parameters": [
          {
            "name": "pathwayid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The pathway ID of the learner."
          }
        ],
        "responses": {
          "200": {
            "description": "Learner record details retrieved successfully."
          },
          "404": {
            "description": "Learner record not found."
          }
        }
      }
    },
    "/admin/change-uln-clear/{registrationPathwayId}": {
      "get": {
        "tags": [
          "AdminDashboard"
        ],
        "summary": "Clear ULN change information for a learner.",
        "operationId": "AdminChangeUlnClear",
        "parameters": [
          {
            "name": "registrationPathwayId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The registration pathway ID of the learner."
          }
        ],
        "responses": {
          "307": {
            "description": "Redirect to AdminChangeUln endpoint."
          }
        }
      }
    },
    "/admin/change-uln/{registrationPathwayId}": {
      "get": {
        "tags": [
          "AdminDashboard"
        ],
        "summary": "View details for updating ULN of a learner.",
        "operationId": "AdminChangeUln",
        "parameters": [
          {
            "name": "registrationPathwayId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The registration pathway ID of the learner."
          }
        ],
        "responses": {
          "200": {
            "description": "Details retrieved for updating ULN."
          },
          "404": {
            "description": "Learner record not found."
          }
        }
      },
      "post": {
        "tags": [
          "AdminDashboard"
        ],
        "summary": "Submit changes to a learner's ULN.",
        "operationId": "SubmitChangeUln",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminChangeUlnViewModel"
              }
            }
          }
        },
        "responses": {
          "307": {
            "description": "Redirect to review ULN changes."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminSearchLearnerCriteriaViewModel": {
        "type": "object",
        "properties": {
          "SearchLearnerFilters": {
            "$ref": "#/components/schemas/AdminSearchLearnerFiltersViewModel"
          },
          "SearchKey": {
            "type": "string"
          },
          "PageNumber": {
            "type": "integer"
          },
          "IsSearchKeyApplied": {
            "type": "boolean"
          },
          "AreFiltersApplied": {
            "type": "boolean"
          }
        }
      },
      "AdminSearchLearnerFiltersViewModel": {
        "type": "object",
        "properties": {
          "Search": {
            "type": "string"
          },
          "SelectedProviderId": {
            "type": "integer"
          },
          "AwardingOrganisations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "AcademicYears": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "IsApplyFiltersSelected": {
            "type": "boolean"
          }
        }
      },
      "AdminChangeUlnViewModel": {
        "type": "object",
        "properties": {
          "RegistrationPathwayId": {
            "type": "integer"
          },
          "Uln": {
            "type": "integer"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "ProviderName": {
            "type": "string"
          },
          "ProviderUkprn": {
            "type": "integer"
          },
          "TlevelName": {
            "type": "string"
          },
          "AcademicYear": {
            "type": "integer"
          },
          "DisplayAcademicYear": {
            "type": "string"
          },
          "UlnTo": {
            "type": "string"
          }
        }
      }
    }
  }
}
