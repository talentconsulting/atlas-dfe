    "/tlevels-registration-data-format-and-rules": {
      "get": {
        "operationId": "DownloadRegistrationDataFormatAndRulesGuide",
        "summary": "Download Registration Data Format and Rules Guide",
        "responses": {
          "200": {
            "description": "Returns the T-levels registration data format and rules guide as a .xlsx file.",
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "302": {
            "description": "Redirects to page not found if the file does not exist."
          }
        }
      }
    },
