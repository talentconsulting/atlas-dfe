{
  "openapi": "3.1.0",
  "info": {
    "title": "Admin Change Log API",
    "version": "1.0.0",
    "description": "API for managing admin change logs and related operations."
  },
  "paths": {
    "/admin/change-log-clear": {
      "get": {
        "operationId": "AdminSearchChangeLogClear",
        "summary": "Clears the admin change log cache.",
        "responses": {
          "302": {
            "description": "Redirects to the Admin Search Change Log route."
          }
        }
      }
    },
    "/admin/change-log/{pageNumber}": {
      "get": {
        "operationId": "AdminSearchChangeLog",
        "summary": "Fetches admin change logs with pagination.",
        "parameters": [
          {
            "name": "pageNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the requested admin change logs."
          },
          "302": {
            "description": "Redirects to the Admin Search Change Log route if a cache is found."
          }
        }
      }
    },
    "/admin/change-log-search-key": {
      "post": {
        "operationId": "AdminSearchChangeLogSearchKey",
        "summary": "Submits a search criteria for change logs.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminSearchChangeLogCriteriaViewModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "302": {
            "description": "Redirects to Admin Search Change Log route after processing the search key."
          }
        }
      }
    },
    "/admin/change-log-clear-key": {
      "post": {
        "operationId": "AdminSearchChangeLogClearKey",
        "summary": "Clears the admin search key for change logs.",
        "responses": {
          "302": {
            "description": "Redirects to the Admin Search Change Log route after clearing the search key."
          }
        }
      }
    },
    "/admin/view-change-record/{changeLogId}": {
      "get": {
        "operationId": "AdminViewChangeRecordUln",
        "summary": "View a specific ULN admin change log record.",
        "parameters": [
          {
            "name": "changeLogId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the requested change log record."
          },
          "302": {
            "description": "Redirects to the Page Not Found route if the record is not found."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminSearchChangeLogCriteriaViewModel": {
        "type": "object",
        "properties": {
          "SearchKey": {
            "type": "string"
          },
          "PageNumber": {
            "type": "integer",
            "nullable": true
          },
          "IsSearchKeyApplied": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
