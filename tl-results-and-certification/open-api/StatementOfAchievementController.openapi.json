{
  "openapi": "3.1.0",
  "info": {
    "title": "Statement of Achievement API",
    "version": "1.0.0",
    "description": "API for managing statements of achievement operations"
  },
  "paths": {
    "/SoA-unavailable": {
      "get": {
        "tags": [
          "Statement of Achievement"
        ],
        "summary": "Get statement of achievement availability",
        "operationId": "StatementsOfAchievementNotAvailable",
        "responses": {
          "200": {
            "description": "Statement of achievement not available view",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotAvailableViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/postal-address-missing": {
      "get": {
        "tags": [
          "Postal Address"
        ],
        "summary": "Get postal address missing view",
        "operationId": "PostalAddressMissing",
        "responses": {
          "200": {
            "description": "Postal address missing view",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostalAddressMissingViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/request-statement-of-achievement-unique-learner-number": {
      "get": {
        "tags": [
          "Statement of Achievement"
        ],
        "summary": "Get unique learner number input view",
        "operationId": "RequestSoaUniqueLearnerNumber",
        "responses": {
          "200": {
            "description": "Request unique learner number view",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestSoaUniqueLearnerNumberViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Statement of Achievement"
        ],
        "summary": "Submit unique learner number",
        "operationId": "SubmitRequestSoaUniqueLearnerNumber",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestSoaUniqueLearnerNumberViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status of statement of achievement request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SoaLearnerRecordDetailsViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/request-statement-of-achievement-ULN-not-registered": {
      "get": {
        "tags": [
          "Statement of Achievement"
        ],
        "summary": "Get ULN not registered view",
        "operationId": "RequestSoaUlnNotFound",
        "responses": {
          "200": {
            "description": "ULN not registered view",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestSoaUlnNotFoundViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/request-statement-of-achievement-check-and-submit/{profileId}": {
      "get": {
        "tags": [
          "Statement of Achievement"
        ],
        "summary": "Review and submit statement of achievement",
        "operationId": "RequestSoaCheckAndSubmit",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Profile ID of the learner"
          }
        ],
        "responses": {
          "200": {
            "description": "View for checking and submitting the statement of achievement request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SoaLearnerRecordDetailsViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/request-statement-of-achievement-check-and-submit": {
      "post": {
        "tags": [
          "Statement of Achievement"
        ],
        "summary": "Submit confirmed request for statement of achievement",
        "operationId": "SubmitRequestSoaCheckAndSubmit",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SoaLearnerRecordDetailsViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Confirmation of request submission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SoaConfirmationViewModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NotAvailableViewModel": {
        "type": "object",
        "properties": {
          "SoaAvailableDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PostalAddressMissingViewModel": {
        "type": "object",
        "properties": {}
      },
      "RequestSoaUniqueLearnerNumberViewModel": {
        "type": "object",
        "properties": {
          "SearchUln": {
            "type": "string"
          }
        },
        "required": [
          "SearchUln"
        ]
      },
      "RequestSoaUlnNotFoundViewModel": {
        "type": "object",
        "properties": {
          "Uln": {
            "type": "string"
          }
        }
      },
      "SoaLearnerRecordDetailsViewModel": {
        "type": "object",
        "properties": {
          "ProfileId": {
            "type": "integer"
          },
          "LearnerName": {
            "type": "string"
          },
          "Uln": {
            "type": "string"
          },
          "ProviderName": {
            "type": "string"
          },
          "TlevelTitle": {
            "type": "string"
          }
        }
      },
      "SoaConfirmationViewModel": {
        "type": "object",
        "properties": {
          "Uln": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          }
        }
      }
    }
  }
}
