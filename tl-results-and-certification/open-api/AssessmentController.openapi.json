{
  "openapi": "3.1.0",
  "info": {
    "title": "Assessment Management API",
    "version": "1.0.0"
  },
  "paths": {
    "/assessment-entries": {
      "get": {
        "operationId": "getAssessmentDashboard",
        "summary": "Retrieve the assessment dashboard view",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {}
          }
        }
      }
    },
    "/upload-assessment-entries-file/{requestErrorTypeId}": {
      "get": {
        "operationId": "getUploadAssessmentsFile",
        "summary": "Shows the upload assessments file page",
        "parameters": [
          {
            "name": "requestErrorTypeId",
            "in": "path",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {}
          }
        }
      }
    },
    "/upload-assessment-entries-file": {
      "post": {
        "operationId": "postUploadAssessmentsFile",
        "summary": "Processes the uploaded assessment file",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/UploadAssessmentsRequestViewModel"
              }
            }
          }
        },
        "responses": {
          "303": {
            "description": "Redirect to a status page",
            "content": {}
          }
        }
      }
    },
    "/assessment-entries-upload-confirmation": {
      "get": {
        "operationId": "getAssessmentUploadSuccessful",
        "summary": "Retrieve the successful upload confirmation",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {}
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/assessment-entries-upload-unsuccessful": {
      "get": {
        "operationId": "getAssessmentUploadUnsuccessful",
        "summary": "Retrieve the unsuccessful upload view",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {}
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/assessment-entries-file-upload-service-problem": {
      "get": {
        "operationId": "getProblemWithAssessmentsUpload",
        "summary": "View for service issues during upload",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {}
          }
        }
      }
    },
    "/download-assessment-errors": {
      "get": {
        "operationId": "downloadAssessmentErrors",
        "summary": "Fetches assessment error files",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "text/csv": {}
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/assessment-entries-learner-withdrawn/{profileId}": {
      "get": {
        "operationId": "getAssessmentWithdrawnDetails",
        "summary": "Fetches details for a withdrawn learner assessment",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {}
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/assessment-entry-learner-details/{profileId}": {
      "get": {
        "operationId": "getAssessmentDetails",
        "summary": "Fetches assessment details for a learner",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {}
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/assessment-entry-add-core/{profileId}": {
      "get": {
        "operationId": "getAddCoreAssessmentEntry",
        "summary": "Shows view for adding core assessment entry",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {}
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "post": {
        "operationId": "postAddCoreAssessmentEntry",
        "summary": "Adds a core assessment entry",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddAssessmentEntryViewModel"
              }
            }
          }
        },
        "responses": {
          "303": {
            "description": "Redirect to learner assessment details"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/assessment-entry-remove-core/{assessmentId}": {
      "get": {
        "operationId": "getRemoveCoreAssessmentEntry",
        "summary": "Shows view to remove core assessment entry",
        "parameters": [
          {
            "name": "assessmentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {}
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "post": {
        "operationId": "postRemoveCoreAssessmentEntry",
        "summary": "Removes a core assessment entry",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssessmentEntryDetailsViewModel"
              }
            }
          }
        },
        "responses": {
          "303": {
            "description": "Redirect to learner assessment details"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UploadAssessmentsRequestViewModel": {
        "type": "object",
        "properties": {
          "AoUkprn": {
            "type": "integer"
          },
          "File": {
            "type": "string",
            "format": "binary"
          },
          "RequestErrorTypeId": {
            "type": "integer"
          }
        }
      },
      "AddAssessmentEntryViewModel": {
        "type": "object",
        "properties": {
          "AssessmentSeriesId": {
            "type": "integer"
          },
          "AssessmentSeriesName": {
            "type": "string"
          },
          "IsOpted": {
            "type": "boolean"
          },
          "ComponentType": {
            "$ref": "#/components/schemas/ComponentType"
          },
          "PathwayDisplayName": {
            "type": "string"
          }
        }
      },
      "AssessmentEntryDetailsViewModel": {
        "type": "object",
        "properties": {
          "AssessmentId": {
            "type": "integer"
          },
          "AssessmentSeriesName": {
            "type": "string"
          },
          "CanRemoveAssessmentEntry": {
            "type": "boolean"
          },
          "ComponentType": {
            "$ref": "#/components/schemas/ComponentType"
          },
          "PathwayDisplayName": {
            "type": "string"
          }
        }
      },
      "ComponentType": {
        "type": "string",
        "enum": [
          "Core",
          "Specialism",
          "NotSpecified"
        ]
      }
    }
  }
}
