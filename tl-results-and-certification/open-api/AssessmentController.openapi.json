{
  "openapi": "3.1.0",
  "info": {
    "title": "Assessment API",
    "version": "1.0.0",
    "description": "API for managing assessments and associated entities within the Results and Certification system."
  },
  "paths": {
    "/api/Assessment/ProcessBulkAssessments": {
      "post": {
        "operationId": "ProcessBulkAssessmentsAsync",
        "summary": "Processes bulk assessment entries.",
        "requestBody": {
          "description": "Bulk process request data",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkProcessRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bulk assessment processing has been completed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkAssessmentResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/Assessment/GetAvailableAssessmentSeries/{aoUkprn}/{profileId}/{componentType}/{componentIds}": {
      "get": {
        "operationId": "GetAvailableAssessmentSeriesAsync",
        "summary": "Retrieves available assessment series.",
        "parameters": [
          {
            "name": "aoUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "componentType",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ComponentType"
            }
          },
          {
            "name": "componentIds",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Available assessment series retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailableAssessmentSeries"
                }
              }
            }
          }
        }
      }
    },
    "/api/Assessment/AddAssessmentEntry": {
      "post": {
        "operationId": "AddAssessmentEntryAsync",
        "summary": "Adds a new assessment entry.",
        "requestBody": {
          "description": "AddAssessmentEntry request data",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddAssessmentEntryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Assessment entry added successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddAssessmentEntryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/Assessment/GetActiveAssessmentEntryDetails/{aoUkprn}/{assessmentId}/{componentType}": {
      "get": {
        "operationId": "GetActiveAssessmentEntryDetailsAsync",
        "summary": "Retrieves active assessment entry details.",
        "parameters": [
          {
            "name": "aoUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "assessmentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "componentType",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ComponentType"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Active assessment entry details retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentEntryDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Assessment/GetActiveSpecialismAssessmentEntries/{aoUkprn}/{specialismAssessmentIds}": {
      "get": {
        "operationId": "GetActiveSpecialismAssessmentEntriesAsync",
        "summary": "Retrieves active specialism assessment entries.",
        "parameters": [
          {
            "name": "aoUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "specialismAssessmentIds",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Active specialism assessment entries retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AssessmentEntryDetails"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/Assessment/RemoveAssessmentEntry": {
      "put": {
        "operationId": "RemoveAssessmentEntryAsync",
        "summary": "Removes an assessment entry.",
        "requestBody": {
          "description": "Remove assessment entry request",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RemoveAssessmentEntryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Assessment entry removed successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "/api/Assessment/GetAssessmentSeries": {
      "get": {
        "operationId": "GetAssessmentSeriesAsync",
        "summary": "Retrieves all assessment series details.",
        "responses": {
          "200": {
            "description": "Assessment series details retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AssessmentSeriesDetails"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BulkProcessRequest": {
        "type": "object",
        "properties": {
          "aoUkprn": {
            "type": "integer",
            "format": "int64"
          },
          "blobFileName": {
            "type": "string"
          },
          "blobUniqueReference": {
            "type": "string",
            "format": "uuid"
          },
          "fileType": {
            "$ref": "#/components/schemas/FileType"
          },
          "documentType": {
            "$ref": "#/components/schemas/DocumentType"
          },
          "loginUserType": {
            "$ref": "#/components/schemas/LoginUserType"
          },
          "performedBy": {
            "type": "string"
          }
        }
      },
      "BulkAssessmentResponse": {
        "type": "object",
        "description": "Response for bulk assessment processing.",
        "properties": {
          "isSuccess": {
            "type": "boolean"
          }
        }
      },
      "AvailableAssessmentSeries": {
        "type": "object",
        "properties": {
          "profileId": {
            "type": "integer",
            "format": "int32"
          },
          "assessmentSeriesId": {
            "type": "integer",
            "format": "int32"
          },
          "assessmentSeriesName": {
            "type": "string"
          }
        }
      },
      "AddAssessmentEntryRequest": {
        "type": "object",
        "properties": {
          "aoUkprn": {
            "type": "integer",
            "format": "int64"
          },
          "profileId": {
            "type": "integer",
            "format": "int32"
          },
          "assessmentSeriesId": {
            "type": "integer",
            "format": "int32"
          },
          "specialismIds": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "componentType": {
            "$ref": "#/components/schemas/ComponentType"
          },
          "performedBy": {
            "type": "string"
          }
        }
      },
      "AddAssessmentEntryResponse": {
        "type": "object",
        "properties": {
          "uln": {
            "type": "integer",
            "format": "int64"
          },
          "isSuccess": {
            "type": "boolean"
          }
        }
      },
      "AssessmentEntryDetails": {
        "type": "object",
        "properties": {
          "profileId": {
            "type": "integer",
            "format": "int32"
          },
          "uln": {
            "type": "integer",
            "format": "int64"
          },
          "assessmentId": {
            "type": "integer",
            "format": "int32"
          },
          "assessmentSeriesId": {
            "type": "integer",
            "format": "int32"
          },
          "assessmentSeriesName": {
            "type": "string"
          }
        }
      },
      "RemoveAssessmentEntryRequest": {
        "type": "object",
        "properties": {
          "assessmentId": {
            "type": "integer",
            "format": "int32"
          },
          "aoUkprn": {
            "type": "integer",
            "format": "int64"
          },
          "specialismAssessmentIds": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "componentType": {
            "$ref": "#/components/schemas/ComponentType"
          },
          "performedBy": {
            "type": "string"
          }
        }
      },
      "AssessmentSeriesDetails": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "componentType": {
            "$ref": "#/components/schemas/ComponentType"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "year": {
            "type": "integer",
            "format": "int32"
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "endDate": {
            "type": "string",
            "format": "date-time"
          },
          "appealEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "resultPublishDate": {
            "type": "string",
            "format": "date-time"
          },
          "resultCalculationYear": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "FileType": {
        "type": "string",
        "enum": [
          "Csv",
          "Xlsx",
          "Pdf"
        ]
      },
      "DocumentType": {
        "type": "string",
        "enum": [
          "Registrations",
          "Assessments",
          "Results",
          "Documents",
          "Ucas",
          "DataExports",
          "OverallResults",
          "IndustryPlacements"
        ]
      },
      "LoginUserType": {
        "type": "string",
        "enum": [
          "NotSpecified",
          "AwardingOrganisation",
          "TrainingProvider",
          "Admin"
        ]
      },
      "ComponentType": {
        "type": "string",
        "enum": [
          "NotSpecified",
          "Core",
          "Specialism"
        ]
      }
    }
  }
}
