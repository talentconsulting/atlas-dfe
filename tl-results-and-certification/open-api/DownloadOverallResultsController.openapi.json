{
  "openapi": "3.1.0",
  "info": {
    "title": "Download Overall Results API",
    "version": "1.0.0"
  },
  "paths": {
    "/download-tlevel-results": {
      "get": {
        "operationId": "DownloadOverallResults",
        "summary": "Renders the overall results page.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/html": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "IsOverallResultsAvailable": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "learnerRecordsEditor": []
          }
        ]
      }
    },
    "/download-tlevel-results-file": {
      "get": {
        "operationId": "DownloadOverallResultsFileAsync",
        "summary": "Downloads the overall results file.",
        "responses": {
          "200": {
            "description": "CSV file containing the overall results.",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "File not found."
          }
        },
        "security": [
          {
            "learnerRecordsEditor": []
          }
        ]
      }
    },
    "/download-tlevel-result-slips-file": {
      "get": {
        "operationId": "DownloadOverallResultSlipsFileAsync",
        "summary": "Downloads the overall result slips as a PDF.",
        "responses": {
          "200": {
            "description": "PDF file containing overall result slips.",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "File not found."
          }
        },
        "security": [
          {
            "learnerRecordsEditor": []
          }
        ]
      }
    },
    "/download-learner-tlevel-result-slips-file/{profileId}": {
      "get": {
        "operationId": "DownloadLearnerOverallResultSlipsFileAsync",
        "summary": "Downloads the result slips for a specific learner profile.",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PDF file containing the result slips for the learner.",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "File not found."
          }
        },
        "security": [
          {
            "learnerRecordsEditor": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "learnerRecordsEditor": {
        "type": "oauth2",
        "description": "Requires Learner Records Editor access.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/auth",
            "tokenUrl": "https://example.com/token",
            "scopes": {}
          }
        }
      }
    }
  }
}
