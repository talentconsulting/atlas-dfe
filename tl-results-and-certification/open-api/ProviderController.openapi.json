{
  "openapi": "3.1.0",
  "info": {
    "title": "ProviderController API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/Provider/IsAnyProviderSetupCompleted/{ukprn}": {
      "get": {
        "summary": "Check if any provider setup is completed",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider setup status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "/api/Provider/FindProvider/{name}/{isExactMatch}": {
      "get": {
        "summary": "Find a provider by name",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "isExactMatch",
            "in": "path",
            "required": true,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching providers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProviderMetadata"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/Provider/GetSelectProviderTlevels/{aoUkprn}/{providerId}": {
      "get": {
        "summary": "Get selected provider Tlevels",
        "parameters": [
          {
            "name": "aoUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Selected provider Tlevels",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderTlevels"
                }
              }
            }
          }
        }
      }
    },
    "/api/Provider/AddProviderTlevels": {
      "post": {
        "summary": "Add provider Tlevels",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ProviderTlevel"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Provider Tlevels added successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "/api/Provider/GetAllProviderTlevels/{aoUkprn}/{providerId}": {
      "get": {
        "summary": "Get all provider Tlevels",
        "parameters": [
          {
            "name": "aoUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "All provider Tlevels",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderTlevels"
                }
              }
            }
          }
        }
      }
    },
    "/api/Provider/GetTqAoProviderDetails/{aoUkprn}": {
      "get": {
        "summary": "Get TQ Awarding Organisation provider details",
        "parameters": [
          {
            "name": "aoUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProviderDetails"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/Provider/GetTqProviderTlevelDetails/{aoUkprn}/{tqProviderId}": {
      "get": {
        "summary": "Get TQ provider Tlevel details",
        "parameters": [
          {
            "name": "aoUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "tqProviderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider Tlevel details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderTlevelDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Provider/RemoveProviderTlevel/{aoUkprn}/{tqProviderId}": {
      "delete": {
        "summary": "Remove TQ provider Tlevel",
        "parameters": [
          {
            "name": "aoUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "tqProviderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Removal status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "/api/Provider/HasAnyTlevelSetupForProvider/{aoUkprn}/{tlProviderId}": {
      "get": {
        "summary": "Check if any Tlevel setup exists for a provider",
        "parameters": [
          {
            "name": "aoUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "tlProviderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Check result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "/api/Provider/GetRegisteredProviderPathwayDetails/{aoUkprn}/{providerUkprn}": {
      "get": {
        "summary": "Get registered provider pathway details",
        "parameters": [
          {
            "name": "aoUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "providerUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of pathway details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PathwayDetails"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/Provider/GetChangeProviderPathwayDetails/{aoUkprn}/{providerUkprn}": {
      "get": {
        "summary": "Get change provider pathway details",
        "parameters": [
          {
            "name": "aoUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "providerUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of change provider pathway details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PathwayDetails"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BaseModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer"
          }
        }
      },
      "ProviderMetadata": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/BaseModel"
          }
        ],
        "properties": {
          "DisplayName": {
            "type": "string"
          },
          "UkPrn": {
            "type": "string"
          }
        }
      },
      "ProviderDetails": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/BaseModel"
          }
        ],
        "properties": {
          "DisplayName": {
            "type": "string"
          },
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ProviderTlevel": {
        "type": "object",
        "properties": {
          "TqProviderId": {
            "type": "integer",
            "nullable": true
          },
          "TqAwardingOrganisationId": {
            "type": "integer"
          },
          "TlProviderId": {
            "type": "integer"
          },
          "TlevelTitle": {
            "type": "string"
          },
          "TlevelCode": {
            "type": "string"
          },
          "CreatedBy": {
            "type": "string"
          }
        }
      },
      "ProviderTlevelDetails": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/ProviderDetails"
          }
        ],
        "properties": {
          "ProviderTlevel": {
            "$ref": "#/components/schemas/ProviderTlevel"
          }
        }
      },
      "ProviderTlevels": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/ProviderDetails"
          }
        ],
        "properties": {
          "Tlevels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderTlevel"
            }
          }
        }
      },
      "PathwayDetails": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/BaseModel"
          }
        ],
        "properties": {
          "Code": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          }
        }
      }
    }
  }
}
