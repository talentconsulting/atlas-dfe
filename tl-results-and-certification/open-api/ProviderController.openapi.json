{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider API",
    "version": "1.0.0"
  },
  "paths": {
    "/your-providers": {
      "get": {
        "operationId": "YourProvidersAsync",
        "description": "Retrieves the list of providers for the authenticated user.",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderDetails"
                }
              }
            }
          },
          "302": {
            "description": "No provider found, redirected to the find provider page"
          }
        }
      }
    },
    "/find-provider/{isback}": {
      "get": {
        "operationId": "FindProviderAsync_Get",
        "parameters": [
          {
            "name": "isback",
            "in": "path",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FindProviderViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "FindProviderAsync_Post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FindProviderViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FindProviderViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/select-providers-tlevels/{providerId}": {
      "get": {
        "operationId": "SelectProviderTlevelsAsync_Get",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderTlevels"
                }
              }
            }
          }
        }
      }
    },
    "/add-additional-tlevels/{providerId}": {
      "get": {
        "operationId": "AddProviderTlevelsAsync",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderTlevels"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "SubmitAddProviderTlevelsAsync",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderTlevelsViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirected after successfully adding the TLevels or upon failure"
          }
        }
      }
    },
    "/remove-tlevel/{id}/{navigation}": {
      "get": {
        "operationId": "RemoveProviderTlevelAsync_Get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "navigation",
            "in": "path",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderTlevelDetailsViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirected to a different page when no TLevel is found"
          }
        }
      },
      "post": {
        "operationId": "RemoveProviderTlevelAsync_Post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderTlevelDetailsViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirected after successfully removing the TLevel or upon failure"
          }
        }
      }
    },
    "/tlevel-removed-confirmation": {
      "get": {
        "operationId": "RemoveConfirmationAsync",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderTlevelDetailsViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirected when no cached confirmation data is available"
          }
        }
      }
    },
    "/provider-tlevels/{providerId}/{navigation}": {
      "get": {
        "operationId": "ViewProviderTlevelsAsync",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "navigation",
            "in": "path",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderTlevels"
                }
              }
            }
          },
          "302": {
            "description": "Redirected when no TLevels are available"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProviderDetails": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          },
          "ukprn": {
            "type": "integer"
          }
        }
      },
      "FindProviderViewModel": {
        "type": "object",
        "properties": {
          "search": {
            "type": "string"
          },
          "showViewProvidersLink": {
            "type": "boolean"
          },
          "selectedProviderId": {
            "type": "integer"
          }
        }
      },
      "ProviderTlevels": {
        "type": "object",
        "properties": {
          "tlevels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderTlevel"
            }
          }
        }
      },
      "ProviderTlevel": {
        "type": "object",
        "properties": {
          "tqProviderId": {
            "type": "integer"
          },
          "tqAwardingOrganisationId": {
            "type": "integer"
          },
          "tlProviderId": {
            "type": "integer"
          },
          "tlevelTitle": {
            "type": "string"
          }
        }
      },
      "ProviderTlevelsViewModel": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "integer"
          },
          "displayName": {
            "type": "string"
          },
          "ukprn": {
            "type": "integer"
          },
          "tlevels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderTlevelViewModel"
            }
          }
        }
      },
      "ProviderTlevelViewModel": {
        "type": "object",
        "properties": {
          "tqProviderId": {
            "type": "integer"
          },
          "tqAwardingOrganisationId": {
            "type": "integer"
          },
          "tlProviderId": {
            "type": "integer"
          },
          "tlevelTitle": {
            "type": "string"
          },
          "isSelected": {
            "type": "boolean"
          }
        }
      },
      "ProviderTlevelDetailsViewModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "displayName": {
            "type": "string"
          },
          "ukprn": {
            "type": "integer"
          },
          "tlevelTitle": {
            "type": "string"
          },
          "tlProviderId": {
            "type": "integer"
          },
          "canRemoveTlevel": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
