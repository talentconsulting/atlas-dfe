@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_providercommitments, "Provider Commitments") {
  Container(c_provider_commitments_web, "Provider Commitments", "Web Application")
}

SystemDb_Ext(d_cache_redis, "Redis", "Redis")
SystemDb_Ext(d_configuration_store_azure_table_storage_configuration, "Azure Table Storage configuration", "Azure Table Storage")
SystemDb_Ext(d_configuration_store_configuration_store, "Configuration Store")
System_Ext(d_http_api_commitments, "Commitments", "HttpClient")
System_Ext(d_http_api_outer_api, "Outer API", "HttpClient")
System_Ext(d_http_api_pas_account, "PAS Account", "HttpClient")
System_Ext(d_identity_provider_dfe_sign_in, "DfE Sign-in")
System_Ext(d_identity_provider_microsoft_entra_id, "Microsoft Entra ID")
System_Ext(d_telemetry_application_insights, "Application Insights")

Rel(c_provider_commitments_web, d_cache_redis, "Caches data in", "Redis")
Rel(c_provider_commitments_web, d_configuration_store_azure_table_storage_configuration, "Reads configuration from", "Azure Table Storage")
Rel(c_provider_commitments_web, d_configuration_store_configuration_store, "Reads configuration from")
Rel(c_provider_commitments_web, d_http_api_commitments, "Calls the API of", "HttpClient")
Rel(c_provider_commitments_web, d_http_api_outer_api, "Calls the API of", "HttpClient")
Rel(c_provider_commitments_web, d_http_api_pas_account, "Calls the API of", "HttpClient")
Rel(c_provider_commitments_web, d_identity_provider_dfe_sign_in, "Authenticates with")
Rel(c_provider_commitments_web, d_identity_provider_microsoft_entra_id, "Authenticates with")
Rel(c_provider_commitments_web, d_telemetry_application_insights, "Sends telemetry to")

@enduml
