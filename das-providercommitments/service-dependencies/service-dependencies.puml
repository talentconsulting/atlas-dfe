@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_providercommitments, "Provider Commitments") {
  Container(c_provider_commitments, "Provider Commitments", "API")
  Container(c_provider_commitments_web, "Provider Commitments", "Web Application")
}

SystemDb_Ext(d_cache_redis, "Redis", "StackExchange.Redis")
System_Ext(d_http_api_approvals_outer, "Approvals Outer", "HttpClient")
System_Ext(d_http_api_commitment_permissions, "Commitment Permissions")
System_Ext(d_http_api_commitments, "Commitments")
System_Ext(d_http_api_provider_apprenticeships_service_account, "Provider Apprenticeships Service Account")

Rel(c_provider_commitments_web, d_cache_redis, "Caches data in", "StackExchange.Redis")
Rel(c_provider_commitments, d_http_api_approvals_outer, "Calls the API of", "HttpClient")
Rel(c_provider_commitments_web, d_http_api_approvals_outer, "Calls the API of")
Rel(c_provider_commitments_web, d_http_api_commitment_permissions, "Calls the API of")
Rel(c_provider_commitments_web, d_http_api_commitments, "Calls the API of")
Rel(c_provider_commitments_web, d_http_api_provider_apprenticeships_service_account, "Calls the API of")

@enduml
