{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Commitments Learner Controller",
    "version": "1.0.0"
  },
  "paths": {
    "/{providerId}/unapproved/add/learners/select": {
      "get": {
        "summary": "Select a learner record",
        "operationId": "SelectLearnerRecord",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "EmployerAccountLegalEntityPublicHashedId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "CacheKey",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "ReservationId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "AccountLegalEntityId",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "SearchTerm",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SortField",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ReverseSort",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "Page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "CohortReference",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "CohortId",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "StartMonth",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "StartYear",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 2023
            }
          },
          {
            "name": "CourseCode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "LearningType",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/LearningType"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectLearnerRecordViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/{providerId}/unapproved/add/learners/select-multiple": {
      "get": {
        "summary": "Select multiple learner records",
        "operationId": "SelectMultipleLearnerRecords",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "CacheKey",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectMultipleLearnerRecordsViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Submit selection of multiple learner records",
        "operationId": "SubmitSelectMultipleLearnerRecords",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "description": "Submit selection",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectMultipleLearnerRecordsPostRequest"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to cohort details"
          }
        }
      }
    },
    "/{providerId}/unapproved/add/learners/select-multiple-validation-errors": {
      "get": {
        "summary": "Get validation errors for multiple learner records",
        "operationId": "GetSelectMultipleLearnerRecordsValidationErrors",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "CacheKey",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectMultipleLearnerRecordsValidationErrorsViewModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SelectLearnerRecordViewModel": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer"
          },
          "EmployerAccountName": {
            "type": "string"
          },
          "EmployerAccountLegalEntityPublicHashedId": {
            "type": "string"
          },
          "AccountLegalEntityId": {
            "type": "integer"
          },
          "CohortReference": {
            "type": "string"
          },
          "Learners": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LearnerSummary"
            }
          }
        }
      },
      "LearnerSummary": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Uln": {
            "type": "integer"
          },
          "CourseName": {
            "type": "string"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "LearningType": {
            "$ref": "#/components/schemas/LearningType"
          }
        }
      },
      "SelectMultipleLearnerRecordsViewModel": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer"
          },
          "Page": {
            "type": "integer"
          }
        }
      },
      "SelectMultipleLearnerRecordsPostRequest": {
        "type": "object",
        "properties": {
          "CacheKey": {
            "type": "string",
            "format": "uuid"
          },
          "ProviderId": {
            "type": "integer"
          }
        }
      },
      "LearningType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "FoundationApprenticeship",
          "ApprenticeshipUnit"
        ]
      },
      "SelectMultipleLearnerRecordsValidationErrorsViewModel": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer"
          },
          "CacheKey": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
}
