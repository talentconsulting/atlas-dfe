{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Management API",
    "version": "1.0.0"
  },
  "paths": {
    "/{providerId}/apprentices": {
      "get": {
        "operationId": "IndexApprentices",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of apprentices."
          }
        }
      }
    },
    "/{providerId}/apprentices/{apprenticeshipHashedId}": {
      "get": {
        "operationId": "GetApprenticeDetails",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "apprenticeshipHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Details about an apprentice."
          }
        }
      }
    },
    "/{providerId}/apprentices/{apprenticeshipHashedId}/edit": {
      "get": {
        "operationId": "EditApprenticeship",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "apprenticeshipHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Edit apprenticeship details."
          }
        }
      },
      "post": {
        "operationId": "SubmitApprenticeshipEdit",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "apprenticeshipHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Apprenticeship has been updated."
          }
        }
      }
    },
    "/{providerId}/apprentices/{apprenticeshipHashedId}/download": {
      "get": {
        "operationId": "DownloadApprentices",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "apprenticeshipHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Download apprentice information.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "content": {
                      "type": "string"
                    },
                    "contentType": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "integer"
          },
          "apprenticeshipHashedId": {
            "type": "string"
          }
        },
        "required": [
          "providerId",
          "apprenticeshipHashedId"
        ]
      },
      "ApprenticeshipEditRequest": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "integer"
          },
          "apprenticeshipHashedId": {
            "type": "string"
          }
        },
        "required": [
          "providerId",
          "apprenticeshipHashedId"
        ]
      },
      "ApprenticeshipDownloadRequest": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "integer"
          },
          "apprenticeshipHashedId": {
            "type": "string"
          }
        },
        "required": [
          "providerId",
          "apprenticeshipHashedId"
        ]
      }
    }
  }
}
