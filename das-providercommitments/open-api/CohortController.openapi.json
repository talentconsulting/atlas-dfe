{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Commitments API",
    "version": "1.0.0",
    "description": "API for managing provider commitments, cohorts, and apprenticeships."
  },
  "paths": {
    "/{providerId}/unapproved/review": {
      "get": {
        "operationId": "ReviewCohortsByProvider",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "SortField",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ReverseSort",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response."
          }
        }
      }
    },
    "/{providerId}/unapproved/draft": {
      "get": {
        "operationId": "FetchDraftCohorts",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "SortField",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ReverseSort",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response."
          }
        }
      }
    },
    "/{providerId}/unapproved/with-employer": {
      "get": {
        "operationId": "FetchCohortsWithEmployer",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "SortField",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ReverseSort",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response."
          }
        }
      }
    },
    "/{providerId}/unapproved/with-transfer-sender": {
      "get": {
        "operationId": "FetchCohortsWithTransferSender",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "SortField",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ReverseSort",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response."
          }
        }
      }
    },
    "/{providerId}/unapproved/add-apprentice": {
      "get": {
        "operationId": "AddNewDraftApprenticeship",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "CacheKey",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "EmployerAccountLegalEntityPublicHashedId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "UseLearnerData",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully prepared for adding a draft apprenticeship."
          }
        },
        "security": [
          {
            "policyAuth": [
              "CreateCohort",
              "HasContributorOrAbovePermission"
            ]
          }
        ]
      }
    },
    "/{providerId}/unapproved/add/select-how": {
      "get": {
        "operationId": "SelectHowToAddApprentice",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "CacheKey",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully provided selection options for how to add an apprentice."
          }
        }
      },
      "post": {
        "operationId": "SetHowToAddApprentice",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectHowToAddFirstApprenticeshipJourneyViewModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully selected a method to add apprentice."
          }
        },
        "security": [
          {
            "policyAuth": [
              "HasContributorOrAbovePermission"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "SelectHowToAddFirstApprenticeshipJourneyViewModel": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "description": "Unique ID for provider."
          },
          "CacheKey": {
            "type": "string",
            "format": "uuid",
            "description": "CacheKey."
          },
          "EmployerAccountLegalEntityPublicHashedId": {
            "type": "string",
            "description": "EmployerAccountLegal ID given/hash Key id for retriavable dat interface."
          }
        }
      }
    }
  }
}
