    "/{providerId}/unapproved/overlappingtrainingdaterequest/overlap-alert": {
      "get": {
        "summary": "Get draft apprenticeship overlap alert",
        "tags": [
          "OverlappingTrainingDateRequest"
        ],
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Provider ID"
          },
          {
            "name": "DraftApprenticeshipHashedId",
            "in": "query",
