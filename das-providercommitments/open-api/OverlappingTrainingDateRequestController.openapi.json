      "ApprenticeshipStatus": {
        "type": "string",
        "enum": [
          "WaitingToStart",
          "Live",
          "Paused",
          "Stopped",
          "Completed",
          "Unknown"
        ]
      },
      "OverlapOptionsForChangeEmployerViewModel": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer"
          },
          "CohortReference": {
            "type": "string"
          },
          "OverlapOptions": {
            "$ref": "#/components/schemas/OverlapOptions"
          },
          "DraftApprenticeshipHashedId": {
            "type": "string"
          },
          "DraftApprenticeshipId": {
            "type": "integer"
          },
          "Status": {
