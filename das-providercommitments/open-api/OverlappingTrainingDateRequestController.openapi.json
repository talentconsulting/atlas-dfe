          },
          "EnableStopRequestEmail": {
            "type": "boolean"
          },
          "HasWithdrawnStatusCode": {
            "type": "boolean"
          },
          "IsSameProvider": {
            "type": "boolean"
          },
          "ProviderName": {
            "type": "string"
          },
          "ApprenticeshipHashedId": {
            "type": "string"
