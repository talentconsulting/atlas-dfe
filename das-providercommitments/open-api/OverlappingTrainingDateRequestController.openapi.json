{
  "openapi": "3.1.0",
  "info": {
    "title": "Overlapping Training Date Request API",
    "description": "API for managing overlapping training date requests for apprenticeships.",
    "version": "1.0.0"
  },
  "paths": {
    "/{providerId}/unapproved/overlappingtrainingdaterequest/overlap-options-change-employer": {
      "get": {
        "summary": "Get overlap options for changing employer",
        "tags": [
          "OverlappingTrainingDateRequest"
        ],
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Provider ID"
          },
          {
            "name": "CacheKey",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "ApprenticeshipHashedId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ApprenticeshipId",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "Status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ApprenticeshipStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success retrieving overlap options for changing employer"
          }
        }
      },
      "post": {
        "summary": "Post overlap options for changing employer",
        "tags": [
          "OverlappingTrainingDateRequest"
        ],
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Provider ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OverlapOptionsForChangeEmployerViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirection based on overlap options"
          }
        }
      }
    },
