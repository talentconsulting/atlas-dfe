            "type": "string"
          },
          "NextAction": {
            "$ref": "#/components/schemas/NextAction"
          }
        }
      },
      "DraftApprenticeshipOverlapAlertViewModel": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer"
          },
          "CohortReference": {
            "type": "string"
