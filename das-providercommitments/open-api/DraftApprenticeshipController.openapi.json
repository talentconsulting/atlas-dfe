{
  "openapi": "3.1.0",
  "info": {
    "title": "Draft Apprenticeship API",
    "version": "1.0.0"
  },
  "paths": {
    "/{providerId}/unapproved/{cohortReference}/apprentices/add": {
      "get": {
        "summary": "Add New Draft Apprenticeship",
        "tags": [
          "Draft Apprenticeship"
        ],
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to appropriate route"
          }
        },
        "security": [
          {
            "AccessCohort": []
          },
          {
            "HasContributorOrAbovePermission": []
          }
        ]
      }
    },
    "/{providerId}/unapproved/{cohortReference}/apprentices/add/select-how": {
      "get": {
        "summary": "Add Another Select Method",
        "tags": [
          "Draft Apprenticeship"
        ],
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns select journey view model",
            "content": {
              "text/html": {}
            }
          }
        }
      },
      "post": {
        "summary": "Select Method for Adding Another Apprentice",
        "tags": [
          "Draft Apprenticeship"
        ],
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/SelectAddAnotherDraftApprenticeshipJourneyViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to GetReservationId endpoint"
          }
        },
        "security": [
          {
            "HasContributorOrAbovePermission": []
          }
        ]
      }
    },
    "/{providerId}/unapproved/{cohortReference}/apprentices/add/reservation": {
      "get": {
        "summary": "Get Reservation Id",
        "tags": [
          "Draft Apprenticeship"
        ],
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to reservation URL"
          }
        }
      }
    },
    "/{providerId}/unapproved/{cohortReference}/apprentices/add/select-course": {
      "get": {
        "summary": "Add Draft Apprenticeship Course",
        "tags": [
          "Draft Apprenticeship"
        ],
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Displays course selection view"
          }
        },
        "security": [
          {
            "HasContributorOrAbovePermission": []
          }
        ]
      },
      "post": {
        "summary": "Set Course",
        "tags": [
          "Draft Apprenticeship"
        ],
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/SelectCourseViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to SelectDeliveryModel endpoint"
          }
        },
        "security": [
          {
            "HasContributorOrAbovePermission": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "DraftApprenticeshipViewModel": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "integer"
          },
          "cohortReference": {
            "type": "string"
          },
          "cacheKey": {
            "type": "string",
            "format": "uuid"
          },
          "deliveryModel": {
            "type": "string",
            "enum": [
              "Regular",
              "PortableFlexiJob",
              "FlexiJobAgency"
            ]
          }
        }
      },
      "SelectAddAnotherDraftApprenticeshipJourneyViewModel": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "integer"
          },
          "cohortReference": {
            "type": "string"
          },
          "cohortId": {
            "type": "integer"
          },
          "selection": {
            "type": "string",
            "enum": [
              "Ilr",
              "Manual"
            ]
          }
        }
      },
      "SelectCourseViewModel": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "integer"
          },
          "courseCode": {
            "type": "string"
          },
          "standards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Standard"
            }
          }
        }
      },
      "Standard": {
        "type": "object",
        "properties": {
          "courseCode": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "AccessCohort": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/auth",
            "tokenUrl": "https://example.com/token",
            "scopes": {
              "AccessCohort": "Access cohort data"
            }
          }
        }
      },
      "HasContributorOrAbovePermission": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/auth",
            "tokenUrl": "https://example.com/token",
            "scopes": {
              "HasContributorOrAbovePermission": "Contributor-level access"
            }
          }
        }
      }
    }
  }
}
