@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_findapprenticeship_web, "Find an Apprenticeship") {
  Container(c_find_an_apprenticeship_mock_server, "Find an Apprenticeship Mock Server", "Component")
  Container(c_find_an_apprenticeship_web, "Find an Apprenticeship", "Web Application")
  Container(c_findanapprenticeship, "FindAnApprenticeship", "Component")
}

SystemDb_Ext(d_cache_redis, "Redis", "StackExchange.Redis")
System_Ext(d_cloud_service_azure_key_vault, "Azure Key Vault")
System_Ext(d_http_api_find_an_apprenticeship_outer, "Find an Apprenticeship Outer", "HttpClient")

Rel(c_find_an_apprenticeship_web, d_cache_redis, "Caches data in", "StackExchange.Redis")
Rel(c_find_an_apprenticeship_web, d_cloud_service_azure_key_vault, "Uses")
Rel(c_findanapprenticeship, d_cloud_service_azure_key_vault, "Uses", "Azure SDK")
Rel(c_find_an_apprenticeship_web, d_http_api_find_an_apprenticeship_outer, "Calls the API of", "HttpClient")
Rel(c_findanapprenticeship, d_http_api_find_an_apprenticeship_outer, "Calls the API of", "HttpClient")

@enduml
