@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_findapprenticeship_web, "Find an Apprenticeship") {
  Container(c_find_an_apprenticeship_mockserver, "Find an Apprenticeship MockServer", "Component")
  Container(c_find_an_apprenticeship_web, "Find an Apprenticeship", "Web Application")
  Container(c_find_apprenticeship, "Find Apprenticeship", "API")
}

SystemDb_Ext(d_cache_redis_cache, "Redis Cache", "Redis")
System_Ext(d_cloud_service_azure_key_vault, "Azure Key Vault", "Azure Key Vault")
System_Ext(d_http_api_find_an_apprenticeship_outer, "Find An Apprenticeship Outer", "HttpClient")
System_Ext(d_http_api_find_an_apprenticeship_outer_api, "Find an Apprenticeship Outer API")

Rel(c_find_an_apprenticeship_web, d_cache_redis_cache, "Caches data in", "Redis")
Rel(c_find_an_apprenticeship_web, d_cloud_service_azure_key_vault, "Uses", "Azure Key Vault")
Rel(c_find_apprenticeship, d_cloud_service_azure_key_vault, "Uses", "Azure.Security.KeyVault.Secrets")
Rel(c_find_apprenticeship, d_http_api_find_an_apprenticeship_outer, "Calls the API of", "HttpClient")
Rel(c_find_an_apprenticeship_web, d_http_api_find_an_apprenticeship_outer_api, "Calls the API of")

@enduml
