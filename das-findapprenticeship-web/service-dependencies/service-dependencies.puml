@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_findapprenticeship_web, "Find An Apprenticeship") {
  Container(c_faa_web, "FAA", "Web Application")
  Container(c_find_an_apprenticeship, "Find An Apprenticeship", "API")
}

SystemDb_Ext(d_cache_redis, "Redis", "StackExchange.Redis")
System_Ext(d_cloud_service_azure_key_vault, "Azure Key Vault", "Azure SDK")
SystemDb_Ext(d_configuration_store_azure_table_storage_configuration, "Azure Table Storage configuration", "Azure Table Storage")
System_Ext(d_http_api_find_an_apprenticeship_outer, "Find An Apprenticeship Outer", ".NET HttpClient")
System_Ext(d_identity_provider_gov_uk_authentication, "GOV.UK Authentication")
System_Ext(d_telemetry_application_insights, "Application Insights", "Application Insights")

Rel(c_faa_web, d_cache_redis, "Caches data in", "StackExchange.Redis")
Rel(c_find_an_apprenticeship, d_cloud_service_azure_key_vault, "Uses", "Azure SDK")
Rel(c_faa_web, d_cloud_service_azure_key_vault, "Uses", "Azure.Security.KeyVault.Secrets")
Rel(c_faa_web, d_configuration_store_azure_table_storage_configuration, "Reads configuration from", "Azure Table Storage")
Rel(c_find_an_apprenticeship, d_http_api_find_an_apprenticeship_outer, "Calls the API of", ".NET HttpClient")
Rel(c_faa_web, d_http_api_find_an_apprenticeship_outer, "Calls the API of", "HttpClient")
Rel(c_faa_web, d_identity_provider_gov_uk_authentication, "Authenticates with")
Rel(c_faa_web, d_telemetry_application_insights, "Sends telemetry to", "Application Insights")

@enduml
