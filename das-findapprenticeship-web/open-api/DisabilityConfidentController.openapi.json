{
  "openapi": "3.1.0",
  "info": {
    "title": "Disability Confident API",
    "version": "1.0.0"
  },
  "paths": {
    "/apply/{applicationId}/disability-confident": {
      "get": {
        "operationId": "GetDisabilityConfident",
        "summary": "Retrieve disability confident information for a specific application",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "isEdit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Disability confident information retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DisabilityConfidentViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "UpdateDisabilityConfident",
        "summary": "Update disability confident information for a specific application",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "isEdit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DisabilityConfidentViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Disability confident information updated successfully"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/apply/{applicationId}/disability-confident/confirm": {
      "get": {
        "operationId": "GetDisabilityConfidentSummary",
        "summary": "Retrieve summary information for disability confident application",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "isEdit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Disability confident summary retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DisabilityConfidentSummaryViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "UpdateDisabilityConfidentSummary",
        "summary": "Update summary information for disability confident application",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "isEdit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DisabilityConfidentSummaryViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Disability confident summary updated successfully"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DisabilityConfidentViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "employerName": {
            "type": "string",
            "nullable": true
          },
          "applyUnderDisabilityConfidentScheme": {
            "type": "boolean",
            "nullable": true
          }
        },
        "required": [
          "applicationId"
        ]
      },
      "DisabilityConfidentSummaryViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "backLinkUrl": {
            "type": "string",
            "nullable": true
          },
          "isApplyUnderDisabilityConfidentSchemeRequired": {
            "type": "boolean"
          },
          "isSectionCompleted": {
            "type": "boolean",
            "nullable": true
          }
        },
        "required": [
          "applicationId",
          "isApplyUnderDisabilityConfidentSchemeRequired"
        ]
      }
    }
  }
}
