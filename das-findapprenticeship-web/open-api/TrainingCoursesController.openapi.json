{
  "openapi": "3.1.0",
  "info": {
    "title": "Training Courses API",
    "description": "API for managing training courses related to apprenticeship applications.",
    "version": "1.0.0"
  },
  "paths": {
    "/apply/{applicationId}/training-courses/": {
      "get": {
        "summary": "Get training courses for an application.",
        "operationId": "getTrainingCourses",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Training courses retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainingCoursesViewModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "tags": [
          "TrainingCourses"
        ]
      },
      "post": {
        "summary": "Update training courses for an application.",
        "operationId": "updateTrainingCourses",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrainingCoursesViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Training courses updated successfully."
          },
          "400": {
            "description": "Validation error."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "tags": [
          "TrainingCourses"
        ]
      }
    },
    "/apply/{applicationId}/trainingcourses/add": {
      "get": {
        "summary": "Get a view for adding a new training course.",
        "operationId": "getAddTrainingCourseView",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Add training course view displayed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddTrainingCourseViewModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "tags": [
          "TrainingCourses"
        ]
      },
      "post": {
        "summary": "Add a new training course.",
        "operationId": "addTrainingCourse",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddTrainingCourseViewModel"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Training course added successfully."
          },
          "400": {
            "description": "Validation error."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "tags": [
          "TrainingCourses"
        ]
      }
    },
    "/apply/{applicationId}/trainingcourses/{trainingCourseId}": {
      "get": {
        "summary": "Get a training course for editing.",
        "operationId": "getEditTrainingCourseView",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "trainingCourseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Edit training course view displayed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EditTrainingCourseViewModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "tags": [
          "TrainingCourses"
        ]
      },
      "post": {
        "summary": "Edit an existing training course.",
        "operationId": "editTrainingCourse",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EditTrainingCourseViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Training course edited successfully."
          },
          "400": {
            "description": "Validation error."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "tags": [
          "TrainingCourses"
        ]
      }
    },
    "/apply/{applicationId}/trainingcourses/{trainingCourseId}/delete": {
      "get": {
        "summary": "Get a view for deleting a training course.",
        "operationId": "getDeleteTrainingCourseView",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "trainingCourseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Delete training course view displayed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteTrainingCourseViewModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "tags": [
          "TrainingCourses"
        ]
      },
      "post": {
        "summary": "Delete a training course.",
        "operationId": "deleteTrainingCourse",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteTrainingCourseViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Training course deleted successfully."
          },
          "400": {
            "description": "Error during deletion."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "tags": [
          "TrainingCourses"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "TrainingCoursesViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "doYouWantToAddAnyTrainingCourses": {
            "type": "boolean",
            "nullable": true
          },
          "backLinkUrl": {
            "type": "string"
          },
          "showTrainingCoursesAchieved": {
            "type": "boolean"
          },
          "trainingCourses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingCourse"
            }
          },
          "isSectionComplete": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "TrainingCourse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "courseName": {
            "type": "string",
            "nullable": true
          },
          "yearAchieved": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "AddTrainingCourseViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "courseName": {
            "type": "string",
            "nullable": true
          },
          "yearAchieved": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "EditTrainingCourseViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "trainingCourseId": {
            "type": "string",
            "format": "uuid"
          },
          "courseName": {
            "type": "string",
            "nullable": true
          },
          "yearAchieved": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "DeleteTrainingCourseViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "trainingCourseId": {
            "type": "string",
            "format": "uuid"
          },
          "courseName": {
            "type": "string",
            "nullable": true
          },
          "yearAchieved": {
            "type": "string",
            "nullable": true
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
