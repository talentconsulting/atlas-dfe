{
  "openapi": "3.1.0",
  "info": {
    "title": "Find Apprenticeship API",
    "version": "1.0.0"
  },
  "paths": {
    "/saved-vacancies": {
      "get": {
        "tags": [
          "SavedVacancies"
        ],
        "summary": "Retrieve saved vacancies",
        "operationId": "getSavedVacancies",
        "parameters": [
          {
            "name": "vacancyReference",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sortOrder",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "DateSaved",
                "ClosingSoon"
              ],
              "default": "DateSaved"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetSavedVacanciesResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "FaaUser": []
          }
        ]
      }
    },
    "/saved-vacancies/{vacancyReference}/delete": {
      "post": {
        "tags": [
          "SavedVacancies"
        ],
        "summary": "Delete a saved vacancy",
        "operationId": "deleteSavedVacancy",
        "parameters": [
          {
            "name": "vacancyReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Redirects to saved vacancies list"
          }
        },
        "security": [
          {
            "FaaUser": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "GetSavedVacanciesResponse": {
        "type": "object",
        "properties": {
          "vacancies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "vacancyReference": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "dateSaved": {
                  "type": "string",
                  "format": "date-time"
                },
                "closingDate": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "vacancyReference",
                "title",
                "dateSaved",
                "closingDate"
              ]
            }
          }
        },
        "required": [
          "vacancies"
        ]
      }
    },
    "securitySchemes": {
      "FaaUser": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
