{
  "openapi": "3.1.0",
  "info": {
    "title": "ServiceController API",
    "version": "1.0.0",
    "description": "API for ServiceController in SFA DAS FAA Web application."
  },
  "paths": {
    "/signout": {
      "post": {
        "operationId": "signOut",
        "summary": "Sign out user from the service.",
        "tags": [
          "Service"
        ],
        "parameters": [],
        "responses": {
          "302": {
            "description": "User has been redirected after sign-out."
          }
        }
      }
    },
    "/service/signout": {
      "post": {
        "operationId": "serviceSignOut",
        "summary": "Sign out user from the service endpoint.",
        "tags": [
          "Service"
        ],
        "parameters": [],
        "responses": {
          "302": {
            "description": "User has been redirected after service sign-out."
          }
        }
      }
    },
    "/signin": {
      "post": {
        "operationId": "signIn",
        "summary": "Sign in user with the given query parameter value.",
        "tags": [
          "Service"
        ],
        "parameters": [
          {
            "name": "signInValue",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Protected value for signing in."
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects user upon successful sign-in."
          }
        }
      }
    },
    "/account-unavailable": {
      "get": {
        "operationId": "accountUnavailable",
        "summary": "Indicates account unavailability.",
        "tags": [
          "Service"
        ],
        "responses": {
          "200": {
            "description": "Page displayed for unavailable accounts."
          }
        }
      }
    },
    "/account-details": {
      "get": {
        "operationId": "getAccountDetails",
        "summary": "Fetch account details for a user.",
        "tags": [
          "Service"
        ],
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Return URL."
          }
        ],
        "responses": {
          "404": {
            "description": "Not Found if in a production environment."
          },
          "200": {
            "description": "Returns account details view.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StubAuthenticationViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "updateAccountDetails",
        "summary": "Update account details.",
        "tags": [
          "Service"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StubAuthenticationViewModel"
              }
            }
          }
        },
        "responses": {
          "404": {
            "description": "Not Found if in a production environment."
          },
          "302": {
            "description": "Redirects to the signed-in route."
          }
        }
      }
    },
    "/Stub-Auth": {
      "get": {
        "operationId": "stubSignedIn",
        "summary": "Indicate user is signed in under stub authentication.",
        "tags": [
          "Service"
        ],
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Return URL."
          }
        ],
        "responses": {
          "404": {
            "description": "Not Found if in a production environment."
          },
          "200": {
            "description": "Returns Stub Signed-in View.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountStubViewModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StubAuthenticationViewModel": {
        "type": "object",
        "properties": {
          "MobilePhone": {
            "type": "integer",
            "description": "User's mobile phone number."
          },
          "ReturnUrl": {
            "type": "string",
            "description": "Return URL after authentication."
          }
        }
      },
      "AccountStubViewModel": {
        "type": "object",
        "properties": {
          "Email": {
            "type": "string",
            "description": "User email address."
          },
          "Id": {
            "type": "string",
            "description": "User identifier."
          },
          "ReturnUrl": {
            "type": "string",
            "description": "Return URL after authentication."
          }
        }
      }
    }
  }
}
