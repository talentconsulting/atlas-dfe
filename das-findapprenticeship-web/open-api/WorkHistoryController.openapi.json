{
  "openapi": "3.1.0",
  "info": {
    "title": "Work History API",
    "version": "1.0.0"
  },
  "paths": {
    "/apply/{applicationId}/jobs": {
      "get": {
        "operationId": "GetJobs",
        "summary": "Retrieve work history jobs for an application",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "description": "ID of the application",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobsViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "UpdateJobs",
        "summary": "Update the work history jobs for an application",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobsViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully updated"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/apply/{applicationId}/jobs/add": {
      "get": {
        "operationId": "GetAddJob",
        "summary": "Retrieve the add job form for an application",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "description": "ID of the application",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddJobViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "CreateJob",
        "summary": "Create and add a job to an application",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddJobViewModel"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Job created and added to application"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/apply/{applicationId}/jobs/{jobId}": {
      "get": {
        "operationId": "GetJob",
        "summary": "Retrieve job details for a specific job in an application",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "description": "ID of the application",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "description": "ID of the job",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EditJobViewModel"
                }
              }
            }
          },
          "404": {
            "description": "Job not found"
          }
        }
      },
      "post": {
        "operationId": "UpdateJob",
        "summary": "Update details of a specific job in an application",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EditJobViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully updated"
          },
          "400": {
            "description": "Validation error"
          },
          "404": {
            "description": "Job not found"
          }
        }
      }
    },
    "/apply/{applicationId}/jobs/{jobId}/delete": {
      "get": {
        "operationId": "GetDeleteJob",
        "summary": "Retrieve information for deleting a job",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "description": "ID of the application",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "description": "ID of the job",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteJobViewModel"
                }
              }
            }
          },
          "404": {
            "description": "Job not found"
          }
        }
      },
      "post": {
        "operationId": "DeleteJob",
        "summary": "Delete a specific job",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteJobViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully deleted"
          },
          "404": {
            "description": "Job not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "JobsViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "jobHistory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Job"
            }
          },
          "showJobHistory": {
            "type": "boolean"
          },
          "isSectionCompleted": {
            "type": "boolean"
          },
          "doYouWantToAddAnyJobs": {
            "type": "boolean"
          }
        }
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "jobTitle": {
            "type": "string"
          },
          "employer": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "jobDates": {
            "type": "string"
          }
        }
      },
      "AddJobViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "jobTitle": {
            "type": "string"
          },
          "employerName": {
            "type": "string"
          },
          "jobDescription": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "endDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "isCurrentRole": {
            "type": "boolean"
          }
        }
      },
      "EditJobViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "jobId": {
            "type": "string",
            "format": "uuid"
          },
          "jobTitle": {
            "type": "string"
          },
          "employerName": {
            "type": "string"
          },
          "jobDescription": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "endDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "isCurrentRole": {
            "type": "boolean"
          }
        }
      },
      "DeleteJobViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "jobId": {
            "type": "string",
            "format": "uuid"
          },
          "jobDates": {
            "type": "string"
          },
          "employerName": {
            "type": "string"
          },
          "jobDescription": {
            "type": "string"
          },
          "jobTitle": {
            "type": "string"
          }
        }
      }
    }
  }
}
