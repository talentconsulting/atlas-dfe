        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/BrowseByInterestViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect"
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    },
