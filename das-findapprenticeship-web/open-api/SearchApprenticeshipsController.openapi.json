  "components": {
    "schemas": {
      "BrowseByInterestViewModel": {
        "type": "object",
        "properties": {
          "SelectedRouteIds": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "Routes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RouteResponse"
            }
          }
        }
      },
      "LocationViewModel": {
        "type": "object",
        "properties": {
          "NationalSearch": {
            "type": "boolean",
            "nullable": true
          },
          "SearchTerm": {
            "type": "string",
            "nullable": true
          },
          "Distance": {
            "type": "integer",
            "nullable": true
          },
          "SelectedRouteIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "RouteData": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "MapSearchResultsViewModel": {
        "type": "object",
        "properties": {
          "ApprenticeshipMapData": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprenticeshipMapData"
            }
          },
          "SearchedLocation": {
            "$ref": "#/components/schemas/LocationViewModel"
          }
        }
      },
      "ApprenticeshipMapData": {
        "type": "object",
        "properties": {
          "Position": {
            "type": "object",
            "properties": {
              "Lat": {
                "type": "number",
                "nullable": true
              },
              "Lng": {
                "type": "number",
                "nullable": true
              }
            }
          },
          "Job": {
            "type": "object",
            "properties": {
              "Id": {
                "type": "string"
              },
              "Title": {
                "type": "string"
              },
              "Company": {
                "type": "string"
              },
              "VacancyLocation": {
                "type": "string"
              },
              "Distance": {
                "type": "number",
                "nullable": true
              },
              "Apprenticeship": {
                "type": "string"
              },
              "Wage": {
                "type": "string"
              },
              "ClosingDate": {
                "type": "string"
              },
              "PostedDate": {
                "type": "string"
              },
              "ApplicationStatus": {
                "type": "string"
              },
              "ApplicationStatusCssClass": {
                "type": "string"
              },
              "IsClosingSoon": {
                "type": "boolean"
              },
              "IsNew": {
                "type": "boolean"
              },
              "IsFoundation": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "RouteResponse": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          }
        }
      },
      "SaveSearchRequest": {
        "type": "object",
        "properties": {
          "Data": {
            "type": "string",
            "nullable": true
          }
        }
      }
    },
    "securitySchemes": {
      "faaUser": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
