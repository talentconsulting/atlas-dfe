            "name": "vacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "redirect",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect"
          },
          "200": {
            "description": "Success"
          }
        },
        "security": [
          {
            "faaUser": []
          }
        ]
      }
    },
    "/search-results/delete/{vacancyId}": {
      "post": {
        "operationId": "deleteSavedVacancy",
        "tags": [
