        "tags": [
          "Search Apprenticeships"
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/html": {}
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
