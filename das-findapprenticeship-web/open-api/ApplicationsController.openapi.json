{
  "openapi": "3.1.0",
  "info": {
    "title": "Applications API",
    "version": "1.0.0",
    "description": "Endpoints for managing apprenticeship applications."
  },
  "paths": {
    "/applications": {
      "get": {
        "operationId": "ViewApplications",
        "summary": "Retrieve all applications.",
        "parameters": [
          {
            "name": "tab",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "None",
                "Started",
                "Submitted",
                "Successful",
                "Unsuccessful"
              ]
            },
            "description": "Filter applications based on their tab."
          },
          {
            "name": "showEqualityQuestionsBanner",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Flag to display equality questions banner."
          }
        ],
        "responses": {
          "200": {
            "description": "A list of applications.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewApplicationsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/applications/{applicationId}/withdraw": {
      "get": {
        "operationId": "GetWithdrawApplication",
        "summary": "Retrieve an application for withdrawal.",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "ID of the application to be withdrawn."
          }
        ],
        "responses": {
          "200": {
            "description": "Details of the application for withdrawal.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WithdrawApplicationViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "WithdrawApplication",
        "summary": "Withdraw an application.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostWithdrawApplication"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to view applications."
          }
        }
      }
    },
    "/applications/{applicationId}/view": {
      "get": {
        "operationId": "ViewApplication",
        "summary": "View details of a specific application.",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "ID of the application to be viewed."
          }
        ],
        "responses": {
          "200": {
            "description": "Details of the specific application.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/applications/{applicationId}/delete": {
      "get": {
        "operationId": "ConfirmDeleteApplication",
        "summary": "Confirm application deletion.",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "ID of the application to be deleted."
          }
        ],
        "responses": {
          "200": {
            "description": "Details for confirming application deletion.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfirmDeleteApplicationViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "DeleteApplication",
        "summary": "Delete an application.",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "ID of the application to be deleted."
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to view applications."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "WithdrawApplicationViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "advertTitle": {
            "type": "string"
          },
          "employerName": {
            "type": "string"
          },
          "submittedDate": {
            "type": "string",
            "format": "date-time"
          },
          "closesOnDate": {
            "type": "string",
            "format": "date"
          },
          "closesToday": {
            "type": "boolean"
          },
          "closesTomorrow": {
            "type": "boolean"
          },
          "isClosed": {
            "type": "boolean"
          },
          "employmentWorkLocation": {
            "type": "string"
          }
        }
      },
      "PostWithdrawApplication": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "withdrawApplication": {
            "type": "boolean"
          },
          "advertTitle": {
            "type": "string"
          },
          "employerName": {
            "type": "string"
          }
        }
      },
      "ViewApplicationsResponse": {
        "type": "object",
        "properties": {
          "applications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Application"
            }
          }
        }
      },
      "Application": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "vacancyReference": {
            "type": "string"
          },
          "employerName": {
            "type": "string"
          },
          "closingDate": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "Draft",
              "Submitted",
              "Withdrawn",
              "Successful",
              "Unsuccessful",
              "Expired"
            ]
          },
          "workLocation": {
            "type": "string"
          },
          "apprenticeshipType": {
            "type": "string",
            "enum": [
              "Standard",
              "Foundation"
            ]
          }
        }
      },
      "ApplicationViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "candidate": {
            "$ref": "#/components/schemas/CandidateDetailsSection"
          },
          "applicationStatus": {
            "type": "string",
            "enum": [
              "Draft",
              "Submitted",
              "Withdrawn",
              "Successful",
              "Unsuccessful",
              "Expired"
            ]
          },
          "vacancyDetails": {
            "$ref": "#/components/schemas/VacancyDetailsSection"
          }
        }
      },
      "CandidateDetailsSection": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          }
        }
      },
      "VacancyDetailsSection": {
        "type": "object",
        "properties": {
          "employerName": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "ConfirmDeleteApplicationViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "applicationStartDate": {
            "type": "string",
            "format": "date"
          },
          "vacancyTitle": {
            "type": "string"
          },
          "employerName": {
            "type": "string"
          },
          "workLocation": {
            "type": "string"
          }
        }
      }
    }
  }
}
