{
  "openapi": "3.1.0",
  "info": {
    "title": "What Interests You API",
    "version": "1.0.0",
    "description": "API for managing the 'What Interests You' section of an application process."
  },
  "paths": {
    "/apply/{applicationId}/what-interests-you": {
      "get": {
        "summary": "Retrieve details for the 'What Interests You' section",
        "operationId": "GetWhatInterestsYou",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the application"
          }
        ],
        "responses": {
          "200": {
            "description": "A view model with details of the 'What Interests You' section",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhatInterestsYouViewModel"
                }
              }
            }
          },
          "404": {
            "description": "Application not found"
          }
        },
        "security": [
          {
            "FaaUserAuth": []
          }
        ]
      },
      "post": {
        "summary": "Update details for the 'What Interests You' section",
        "operationId": "PostWhatInterestsYou",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the application"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WhatInterestsYouViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully updated the 'What Interests You' section"
          },
          "400": {
            "description": "Validation errors in the request body"
          }
        },
        "security": [
          {
            "FaaUserAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "WhatInterestsYouViewModel": {
        "type": "object",
        "required": [
          "ApplicationId"
        ],
        "properties": {
          "ApplicationId": {
            "type": "string",
            "format": "uuid",
            "description": "The ID of the application"
          },
          "StandardName": {
            "type": "string",
            "nullable": true,
            "description": "The name of the apprenticeship standard"
          },
          "EmployerName": {
            "type": "string",
            "nullable": true,
            "description": "The name of the employer"
          },
          "AnswerText": {
            "type": "string",
            "nullable": true,
            "description": "The text describing what interests the candidate"
          },
          "IsSectionCompleted": {
            "type": "boolean",
            "nullable": true,
            "description": "Indicates whether this section is completed"
          },
          "AutoSave": {
            "type": "boolean",
            "description": "Indicates whether the model was auto-saved"
          }
        }
      }
    },
    "securitySchemes": {
      "FaaUserAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization required for FAA users"
      }
    }
  }
}
