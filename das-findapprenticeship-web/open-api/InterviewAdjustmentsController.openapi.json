{
  "openapi": "3.1.0",
  "info": {
    "title": "Interview Adjustments API",
    "version": "1.0.0",
    "description": "API for managing interview adjustments in apprenticeship applications."
  },
  "paths": {
    "/apply/{applicationId}/interview-adjustments": {
      "get": {
        "summary": "Retrieve interview adjustments for a specific application",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "isEdit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InterviewAdjustmentsViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirect to summary view"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "post": {
        "summary": "Submit updates to interview adjustments",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "isEdit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InterviewAdjustmentsViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to summary view"
          },
          "400": {
            "description": "Validation errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewModelBase"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/apply/{applicationId}/interview-adjustments/summary": {
      "get": {
        "summary": "Retrieve summary of interview adjustments for a specific application",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InterviewAdjustmentSummaryViewModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "post": {
        "summary": "Submit updates to the summary of interview adjustments",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InterviewAdjustmentSummaryViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to application view"
          },
          "400": {
            "description": "Validation errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewModelBase"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "InterviewAdjustmentsViewModel": {
        "type": "object",
        "properties": {
          "ApplicationId": {
            "type": "string",
            "format": "uuid"
          },
          "DoYouWantInterviewAdjustments": {
            "type": "boolean",
            "nullable": true
          },
          "InterviewAdjustmentsDescription": {
            "type": "string",
            "nullable": true
          },
          "BackLinkUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "ApplicationId"
        ]
      },
      "InterviewAdjustmentSummaryViewModel": {
        "type": "object",
        "properties": {
          "ApplicationId": {
            "type": "string",
            "format": "uuid"
          },
          "IsSupportRequestRequired": {
            "type": "boolean"
          },
          "SupportRequestAnswer": {
            "type": "string",
            "nullable": true
          },
          "IsSectionCompleted": {
            "type": "boolean",
            "nullable": true
          },
          "BackLinkUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "ApplicationId"
        ]
      },
      "ViewModelBase": {
        "type": "object",
        "properties": {
          "Valid": {
            "type": "boolean"
          },
          "ErrorDictionary": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "nullable": true
            }
          }
        },
        "required": [
          "Valid",
          "ErrorDictionary"
        ]
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
