{
  "openapi": "3.1.0",
  "info": {
    "title": "Vacancies API",
    "version": "1.0.0",
    "description": "API for managing apprenticeship vacancies and related user actions."
  },
  "paths": {
    "/apprenticeship/{vacancyReference}": {
      "get": {
        "operationId": "GetVacancyDetails",
        "summary": "Retrieve details of an apprenticeship vacancy",
        "parameters": [
          {
            "name": "vacancyReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Reference ID of the vacancy"
          },
          {
            "name": "signedIn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "description": "Indicates if the user is signed in"
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "Applications",
                "None"
              ]
            },
            "description": "Source of the request"
          },
          {
            "name": "tab",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "Started",
                "Submitted",
                "Successful",
                "Unsuccessful",
                "None"
              ]
            },
            "description": "Active Applications Tab"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of vacancy details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VacancyDetailsViewModel"
                }
              }
            }
          },
          "404": {
            "description": "Vacancy not found"
          }
        }
      },
      "post": {
        "operationId": "ApplyToVacancy",
        "summary": "Apply to a specific apprenticeship vacancy",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostApplyRequest"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to Apply page after successful application"
          },
          "404": {
            "description": "Vacancy not found"
          }
        },
        "security": [
          {
            "Policy": [
              "IsFaaUser"
            ]
          }
        ]
      }
    },
    "/vacancy/save/{vacancyId}": {
      "post": {
        "operationId": "SaveVacancy",
        "summary": "Save an apprenticeship vacancy",
        "parameters": [
          {
            "name": "vacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID of the vacancy"
          },
          {
            "name": "redirect",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Enable redirect after the save action"
          }
        ],
        "responses": {
          "200": {
            "description": "Vacancy saved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "OK"
                }
              }
            }
          },
          "302": {
            "description": "Redirect after saving vacancy"
          }
        },
        "security": [
          {
            "Policy": [
              "IsFaaUser"
            ]
          }
        ]
      }
    },
    "/vacancy/delete/{vacancyId}": {
      "post": {
        "operationId": "DeleteSavedVacancy",
        "summary": "Delete a saved apprenticeship vacancy",
        "parameters": [
          {
            "name": "vacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID of the vacancy to delete"
          },
          {
            "name": "redirect",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Enable redirect after the delete action"
          }
        ],
        "responses": {
          "200": {
            "description": "Vacancy deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "OK"
                }
              }
            }
          },
          "302": {
            "description": "Redirect after deleting vacancy"
          }
        },
        "security": [
          {
            "Policy": [
              "IsFaaUser"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "PostApplyRequest": {
        "type": "object",
        "properties": {
          "vacancyReference": {
            "type": "string"
          }
        },
        "required": [
          "vacancyReference"
        ]
      },
      "VacancyDetailsViewModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "vacancyReference": {
            "type": "string"
          },
          "longDescription": {
            "type": "string"
          },
          "outcomeDescription": {
            "type": "string"
          },
          "trainingDescription": {
            "type": "string"
          },
          "thingsToConsider": {
            "type": "string"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "closingDate": {
            "type": "string",
            "format": "date-time"
          },
          "postedDate": {
            "type": "string",
            "format": "date-time"
          },
          "withdrawnDate": {
            "type": "string",
            "format": "date-time"
          },
          "wageAmount": {
            "type": "string"
          },
          "wageType": {
            "type": "integer"
          },
          "wageText": {
            "type": "string"
          },
          "distance": {
            "type": "number"
          },
          "courseTitle": {
            "type": "string"
          },
          "courseLevel": {
            "type": "string"
          },
          "courseId": {
            "type": "integer"
          },
          "apprenticeshipLevel": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "categoryCode": {
            "type": "string"
          },
          "subCategory": {
            "type": "string"
          },
          "subCategoryCode": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "frameworkLarsCode": {
            "type": "string"
          },
          "hoursPerWeek": {
            "type": "number"
          },
          "isDisabilityConfident": {
            "type": "boolean"
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "numberOfPositions": {
            "type": "integer"
          },
          "providerName": {
            "type": "string"
          },
          "standardLarsCode": {
            "type": "integer"
          },
          "workingWeek": {
            "type": "string"
          },
          "expectedDuration": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "ukprn": {
            "type": "string"
          },
          "employerName": {
            "type": "string"
          },
          "isSavedVacancy": {
            "type": "boolean"
          }
        }
      },
      "Location": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number"
          },
          "lon": {
            "type": "number"
          },
          "locationName": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "Policy": {
        "type": "oauth2",
        "description": "Allows access based on specific policy conditions",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "tokenUrl": "https://example.com/oauth/token",
            "scopes": {
              "IsFaaUser": "User must be part of FaaUser group"
            }
          }
        }
      }
    }
  }
}
