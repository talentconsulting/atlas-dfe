{
  "openapi": "3.1.0",
  "info": {
    "title": "Employment Locations API",
    "version": "1.0.0"
  },
  "paths": {
    "/apply/{applicationId}/employmentLocations": {
      "get": {
        "summary": "Get Employment Locations",
        "operationId": "getEmploymentLocations",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the application."
          },
          {
            "name": "isEdit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Indicates if the operation is in edit mode."
          }
        ],
        "responses": {
          "200": {
            "description": "Employment locations retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddEmploymentLocationsViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Update Employment Locations",
        "operationId": "updateEmploymentLocations",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the application."
          },
          {
            "name": "isEdit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Indicates if the operation is in edit mode."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddEmploymentLocationsViewModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Employment locations updated successfully."
          },
          "400": {
            "description": "Validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/apply/{applicationId}/employmentLocations/summary": {
      "get": {
        "summary": "Get Employment Locations Summary",
        "operationId": "getEmploymentLocationsSummary",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the application."
          },
          {
            "name": "isEdit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Indicates if the operation is in edit mode."
          }
        ],
        "responses": {
          "200": {
            "description": "Employment locations summary retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmploymentLocationsSummaryViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Update Employment Locations Summary",
        "operationId": "updateEmploymentLocationsSummary",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the application."
          },
          {
            "name": "isEdit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Indicates if the operation is in edit mode."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmploymentLocationsSummaryViewModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Employment locations summary updated successfully."
          },
          "400": {
            "description": "Validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddEmploymentLocationsViewModel": {
        "type": "object",
        "properties": {
          "addresses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EmploymentLocationViewModel"
            }
          },
          "applicationId": {
            "type": "string",
            "format": "uuid",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "selectedAddressIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "addresses",
          "applicationId"
        ]
      },
      "EmploymentLocationsSummaryViewModel": {
        "type": "object",
        "properties": {
          "addresses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EmploymentLocationViewModel"
            }
          },
          "applicationId": {
            "type": "string",
            "format": "uuid",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "backLinkUrl": {
            "type": "string",
            "example": "/previous/link"
          },
          "isSectionCompleted": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "addresses",
          "applicationId"
        ]
      },
      "EmploymentLocationViewModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "fullAddress": {
            "type": "string",
            "example": "123 Main Street, Springfield, USA"
          },
          "isSelected": {
            "type": "boolean",
            "example": true
          },
          "addressOrder": {
            "type": "integer",
            "example": 1
          }
        },
        "required": [
          "id",
          "fullAddress",
          "isSelected",
          "addressOrder"
        ]
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "string",
              "example": "Invalid address format."
            }
          }
        }
      }
    }
  }
}
