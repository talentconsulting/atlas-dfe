{
  "openapi": "3.1.0",
  "info": {
    "title": "Locations API",
    "version": "1.0.0",
    "description": "API for fetching locations based on a search term"
  },
  "paths": {
    "/Locations": {
      "get": {
        "summary": "Fetch locations by search term",
        "operationId": "getLocationsBySearch",
        "parameters": [
          {
            "name": "searchTerm",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The search term used to find locations."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with matching locations.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocationViewModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LocationViewModel": {
        "type": "object",
        "properties": {
          "Locations": {
            "$ref": "#/components/schemas/LocationsBySearchViewModel"
          }
        }
      },
      "LocationsBySearchViewModel": {
        "type": "object",
        "properties": {
          "Locations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LocationBySearchViewModel"
            }
          }
        }
      },
      "LocationBySearchViewModel": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
