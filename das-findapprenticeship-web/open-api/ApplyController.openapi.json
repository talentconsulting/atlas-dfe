{
  "openapi": "3.1.0",
  "info": {
    "title": "ApplyController API",
    "version": "1.0.0"
  },
  "paths": {
    "/applications/{applicationId}": {
      "get": {
        "operationId": "getApplicationIndex",
        "summary": "Get application index",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Application index details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetIndexQuery"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "redirectApplicationSubmission",
        "summary": "Redirect to application submission",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to application submission"
          }
        }
      }
    },
    "/applications/{applicationId}/preview": {
      "get": {
        "operationId": "getApplicationPreview",
        "summary": "Get application preview",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Application preview details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationSummaryQuery"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "submitApplicationPreview",
        "summary": "Submit application preview",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplicationSummaryViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects after application submission"
          }
        }
      }
    },
    "/applications/{applicationId}/application-submitted": {
      "get": {
        "operationId": "getApplicationSubmitted",
        "summary": "Get application submitted details",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Application submitted details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationSubmittedQueryResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "handleApplicationSubmittedPost",
        "summary": "Handle actions after application is submitted",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplicationSubmittedViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to appropriate flow after submission handling"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetIndexQuery": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "vacancyReference": {
            "type": "string"
          },
          "vacancyTitle": {
            "type": "string"
          },
          "employerName": {
            "type": "string"
          },
          "closingDate": {
            "type": "string",
            "format": "date"
          },
          "closedDate": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "ApplicationSummaryViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "isConsentProvided": {
            "type": "boolean"
          },
          "employerName": {
            "type": "string"
          },
          "vacancyTitle": {
            "type": "string"
          },
          "closedDate": {
            "type": "string",
            "format": "date"
          },
          "disabilityConfidence": {
            "type": "boolean"
          }
        }
      },
      "GetApplicationSummaryQuery": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "candidateId": {
            "type": "string",
            "format": "uuid"
          },
          "employerName": {
            "type": "string"
          },
          "vacancyTitle": {
            "type": "string"
          }
        }
      },
      "GetApplicationSubmittedQueryResponse": {
        "type": "object",
        "properties": {
          "vacancyTitle": {
            "type": "string"
          },
          "employerName": {
            "type": "string"
          },
          "hasAnsweredEqualityQuestions": {
            "type": "boolean"
          },
          "closingDate": {
            "type": "string",
            "format": "date"
          },
          "closedDate": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "ApplicationSubmittedViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "vacancyInfo": {
            "type": "object",
            "properties": {
              "vacancyTitle": {
                "type": "string"
              },
              "employerName": {
                "type": "string"
              }
            }
          },
          "answerEqualityQuestions": {
            "type": "boolean"
          },
          "closedDate": {
            "type": "string",
            "format": "date"
          },
          "isVacancyClosedEarly": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
