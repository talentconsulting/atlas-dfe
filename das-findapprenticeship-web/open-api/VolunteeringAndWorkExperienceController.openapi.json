            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VolunteeringAndWorkExperiencesQueryResult"
                }
              }
            }
          },
          "302": {
            "description": "Redirect to summary page"
          }
        }
