{
  "openapi": "3.1.0",
  "info": {
    "title": "Find an Apprenticeship API",
    "version": "1.0.0",
    "description": "API documentation for managing apprentice applications, including skills and strengths."
  },
  "paths": {
    "/apply/{applicationId}/skillsandstrengths/": {
      "get": {
        "operationId": "getSkillsAndStrengths",
        "description": "Retrieve expected skills and strengths for an application.",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier of the application."
          }
        ],
        "responses": {
          "200": {
            "description": "A successful response containing the skills and strengths for the application.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SkillsAndStrengthsViewModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "faaUser": []
          }
        ]
      },
      "post": {
        "operationId": "updateSkillsAndStrengths",
        "description": "Update the skills and strengths for an application.",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier of the application."
          }
        ],
        "requestBody": {
          "description": "Updated skills and strengths data.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SkillsAndStrengthsViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Skills and strengths updated successfully."
          },
          "400": {
            "description": "Invalid input provided.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "null"
                }
              }
            }
          }
        },
        "security": [
          {
            "faaUser": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "SkillsAndStrengthsViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the application."
          },
          "skillsAndStrengths": {
            "type": "string",
            "description": "Text describing skills and strengths."
          },
          "employer": {
            "type": "string",
            "description": "Employer associated with the application."
          },
          "expectedSkillsAndStrengths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of expected skills and strengths."
          },
          "isSectionComplete": {
            "type": "boolean",
            "description": "Indicates if the section is marked as complete."
          },
          "autoSave": {
            "type": "boolean",
            "description": "Indicates whether the updates are auto-saved."
          }
        },
        "required": [
          "applicationId"
        ]
      }
    },
    "securitySchemes": {
      "faaUser": {
        "type": "oauth2",
        "description": "OAuth2 security scheme for FAA users.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://auth.example.com/oauth/authorize",
            "tokenUrl": "https://auth.example.com/oauth/token",
            "scopes": {
              "profile": "Access user profile"
            }
          }
        }
      }
    }
  }
}
