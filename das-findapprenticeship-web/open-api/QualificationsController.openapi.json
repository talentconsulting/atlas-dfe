{
  "openapi": "3.1.0",
  "info": {
    "title": "Qualifications API",
    "version": "1.0.0",
    "description": "API for managing qualification-related operations in apprenticeship applications."
  },
  "paths": {
    "/apply/{applicationId}/qualifications": {
      "get": {
        "summary": "Get qualifications for an application",
        "description": "Fetch the list of qualifications for a given application and candidate.",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of qualifications.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QualificationsViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Update or add qualifications for an application",
        "description": "Update or add qualifications to an application based on the provided model.",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QualificationsViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation was successful."
          },
          "400": {
            "description": "Invalid request body."
          }
        }
      }
    },
    "/apply/{applicationId}/qualifications/add/select-type": {
      "get": {
        "summary": "Select qualification type to add",
        "description": "Retrieve the list of qualification types to select one for addition.",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of qualification types.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddQualificationSelectTypeViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Submit selected qualification type",
        "description": "Submit the selected qualification type for an application.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddQualificationSelectTypeViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Qualification type was successfully submitted."
          },
          "400": {
            "description": "Invalid request body."
          }
        }
      }
    },
    "/apply/{applicationId}/qualifications/{qualificationReferenceId}/modify": {
      "get": {
        "summary": "Modify an existing qualification",
        "description": "Retrieve details for modifying a qualification within an application.",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "qualificationReferenceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Details of the qualification to modify.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddQualificationViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Submit qualification modifications",
        "description": "Submit updates made to a specific qualification in an application.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddQualificationViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Qualification update was successful."
          },
          "400": {
            "description": "Invalid request body."
          }
        }
      }
    },
    "/apply/{applicationId}/qualifications/delete/{qualificationReferenceId}": {
      "get": {
        "summary": "Confirm deletion of a qualification",
        "description": "Retrieve details for confirming the deletion of a qualification.",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "qualificationReferenceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Details of the qualifications to be deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteQualificationsViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Delete a qualification",
        "description": "Delete a specific qualification from an application.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteQualificationsViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Qualification deletion was successful."
          },
          "400": {
            "description": "Invalid request body."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "QualificationsViewModel": {
        "type": "object",
        "required": [
          "applicationId"
        ],
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "doYouWantToAddAnyQualifications": {
            "type": "boolean",
            "nullable": true
          },
          "isSectionCompleted": {
            "type": "boolean",
            "nullable": true
          },
          "qualificationGroups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QualificationGroup"
            }
          },
          "showQualifications": {
            "type": "boolean"
          }
        }
      },
      "QualificationGroup": {
        "type": "object",
        "properties": {
          "qualificationReferenceId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "allowMultipleAdd": {
            "type": "boolean"
          },
          "showAdditionalInformation": {
            "type": "boolean"
          },
          "showLevel": {
            "type": "boolean",
            "nullable": true
          },
          "qualifications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Qualification"
            }
          }
        }
      },
      "Qualification": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "subject": {
            "type": "string"
          },
          "grade": {
            "type": "string"
          },
          "additionalInformation": {
            "type": "string"
          },
          "isPredicted": {
            "type": "boolean",
            "nullable": true
          },
          "qualificationOrder": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        }
      },
      "AddQualificationSelectTypeViewModel": {
        "type": "object",
        "required": [
          "applicationId"
        ],
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "qualificationReferenceId": {
            "type": "string",
            "format": "uuid"
          },
          "qualifications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QualificationType"
            }
          },
          "hasAddedQualifications": {
            "type": "boolean"
          }
        }
      },
      "QualificationType": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "AddQualificationViewModel": {
        "type": "object",
        "required": [
          "applicationId",
          "qualificationReferenceId"
        ],
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "qualificationReferenceId": {
            "type": "string",
            "format": "uuid"
          },
          "qualificationDisplayTypeViewModel": {
            "type": "object",
            "nullable": true
          },
          "subjects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubjectViewModel"
            }
          },
          "courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CourseDataListItem"
            }
          },
          "isApprenticeship": {
            "type": "boolean"
          },
          "singleQualificationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "qualificationType": {
            "type": "string"
          },
          "backLinkUrl": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "SubjectViewModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "level": {
            "type": "string",
            "nullable": true
          },
          "additionalInformation": {
            "type": "string",
            "nullable": true
          },
          "grade": {
            "type": "string",
            "nullable": true
          },
          "isPredicted": {
            "type": "boolean",
            "nullable": true
          },
          "qualificationOrder": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "isDeleted": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "CourseDataListItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "DeleteQualificationsViewModel": {
        "type": "object",
        "required": [
          "applicationId",
          "qualificationReferenceId"
        ],
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "qualificationReferenceId": {
            "type": "string",
            "format": "uuid"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "displayName": {
            "type": "string"
          },
          "showAdditionalInformation": {
            "type": "boolean"
          },
          "qualifications": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "subject": {
                  "type": "string"
                },
                "grade": {
                  "type": "string"
                },
                "level": {
                  "type": "string"
                },
                "additionalInformation": {
                  "type": "string"
                },
                "isPredicted": {
                  "type": "boolean",
                  "nullable": true
                },
                "qualificationOrder": {
                  "type": "integer",
                  "format": "int32",
                  "nullable": true
                }
              }
            }
          }
        }
      }
    }
  }
}
