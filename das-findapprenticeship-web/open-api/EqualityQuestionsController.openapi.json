{
  "openapi": "3.1.0",
  "info": {
    "title": "Equality Questions API",
    "version": "1.0.0"
  },
  "paths": {
    "/equality-questions/gender": {
      "get": {
        "operationId": "GetGenderQuestions",
        "parameters": [
          {
            "name": "applicationId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "isEdit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Gender questions page rendered"
          }
        },
        "tags": [
          "Equality Questions"
        ]
      },
      "post": {
        "operationId": "PostGenderQuestions",
        "parameters": [
          {
            "name": "applicationId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EqualityQuestionsGenderViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Processed gender questions submission"
          }
        },
        "tags": [
          "Equality Questions"
        ]
      }
    },
    "/equality-questions/ethnic-group": {
      "get": {
        "operationId": "GetEthnicGroupQuestions",
        "parameters": [
          {
            "name": "applicationId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "isEdit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "clear",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ethnic group questions page rendered"
          }
        },
        "tags": [
          "Equality Questions"
        ]
      },
      "post": {
        "operationId": "PostEthnicGroupQuestions",
        "parameters": [
          {
            "name": "applicationId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EqualityQuestionsEthnicGroupViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Processed ethnic group questions submission"
          }
        },
        "tags": [
          "Equality Questions"
        ]
      }
    },
    "/equality-questions/ethnic-group/{subgroup}": {
      "get": {
        "operationId": "GetEthnicSubGroupQuestions",
        "parameters": [
          {
            "name": "subgroup",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "white",
                "mixed",
                "asian",
                "black",
                "other"
              ]
            }
          },
          {
            "name": "applicationId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "isEdit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ethnic subgroup questions page rendered"
          }
        },
        "tags": [
          "Equality Questions"
        ]
      },
      "post": {
        "operationId": "PostEthnicSubGroupQuestions",
        "parameters": [
          {
            "name": "applicationId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EqualityQuestionEthnicSubGroupViewModelBase"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Processed ethnic subgroup questions submission"
          }
        },
        "tags": [
          "Equality Questions"
        ]
      }
    },
    "/equality-questions/edit": {
      "get": {
        "operationId": "EditEqualityQuestions",
        "responses": {
          "302": {
            "description": "Redirect to summary page"
          }
        },
        "tags": [
          "Equality Questions"
        ]
      }
    },
    "/equality-questions/summary": {
      "get": {
        "operationId": "GetSummaryQuestions",
        "parameters": [
          {
            "name": "applicationId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Summary questions page rendered"
          }
        },
        "tags": [
          "Equality Questions"
        ]
      },
      "post": {
        "operationId": "PostSummaryQuestions",
        "parameters": [
          {
            "name": "applicationId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EqualityQuestionsSummaryViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect based on application status"
          }
        },
        "tags": [
          "Equality Questions"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "EqualityQuestionsGenderViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "isEdit": {
            "type": "boolean"
          },
          "sex": {
            "type": "string",
            "nullable": true
          },
          "isGenderIdentifySameSexAtBirth": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "EqualityQuestionsEthnicGroupViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "ethnicGroup": {
            "type": "string",
            "nullable": true
          },
          "isEdit": {
            "type": "boolean"
          }
        }
      },
      "EqualityQuestionEthnicSubGroupViewModelBase": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "isEdit": {
            "type": "boolean"
          },
          "ethnicGroup": {
            "type": "string"
          },
          "ethnicSubGroup": {
            "type": "string",
            "nullable": true
          },
          "otherEthnicSubGroupAnswer": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "EqualityQuestionsSummaryViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "sex": {
            "type": "string",
            "nullable": true
          },
          "isGenderIdentifySameSexAtBirth": {
            "type": "string",
            "nullable": true
          },
          "ethnicGroup": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
