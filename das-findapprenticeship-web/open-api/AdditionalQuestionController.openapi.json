{
  "openapi": "3.1.0",
  "info": {
    "title": "Additional Question API",
    "version": "1.0.0"
  },
  "paths": {
    "/apply/{applicationId}/additional-question/{additionalQuestion}/{additionalQuestionId}": {
      "get": {
        "summary": "Retrieve additional question details",
        "operationId": "GetAdditionalQuestion",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "additionalQuestion",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "additionalQuestionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        },
        "security": [
          {
            "oauth2": []
          }
        ]
      },
      "post": {
        "summary": "Submit additional question answer",
        "operationId": "PostAdditionalQuestionAnswer",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "additionalQuestion",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "additionalQuestionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/AddAdditionalQuestionViewModel"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddAdditionalQuestionViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to application route",
            "headers": {
              "Location": {
                "description": "Redirect URL",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "400": {
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "oauth2": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AddAdditionalQuestionViewModel": {
        "type": "object",
        "properties": {
          "ApplicationId": {
            "type": "string",
            "format": "uuid"
          },
          "AdditionalQuestionLabel": {
            "type": "string",
            "nullable": true
          },
          "AdditionalQuestionAnswer": {
            "type": "string",
            "nullable": true
          },
          "IsSectionCompleted": {
            "type": "boolean",
            "nullable": true
          }
        },
        "required": [
          "ApplicationId"
        ]
      }
    },
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/auth",
            "tokenUrl": "https://example.com/token",
            "scopes": {
              "read": "Read access",
              "write": "Write access"
            }
          }
        }
      }
    }
  }
}
