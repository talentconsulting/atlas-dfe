{
  "openapi": "3.1.0",
  "info": {
    "title": "User Controller API",
    "version": "1.0.0",
    "description": "API endpoints for user management, including account creation, editing personal details, and account deletion."
  },
  "paths": {
    "/create-account": {
      "get": {
        "operationId": "CreateAccount",
        "summary": "Start the account creation process.",
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account creation page rendered."
          },
          "302": {
            "description": "Redirect to another route if the account already exists."
          }
        }
      }
    },
    "/user-name": {
      "get": {
        "operationId": "GetUserName",
        "summary": "Retrieve and view the user's name details.",
        "parameters": [
          {
            "name": "journeyPath",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "CreateAccount",
                "ConfirmAccountDetails",
                "Settings"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User name details page rendered."
          }
        }
      },
      "post": {
        "operationId": "UpdateUserName",
        "summary": "Update the user's name.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NameViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Name updated successfully."
          },
          "400": {
            "description": "Validation errors occurred."
          }
        }
      }
    },
    "/date-of-birth": {
      "get": {
        "operationId": "GetDateOfBirth",
        "summary": "Retrieve and view the user's date of birth.",
        "parameters": [
          {
            "name": "journeyPath",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "CreateAccount",
                "ConfirmAccountDetails",
                "Settings"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Date of birth page rendered."
          }
        }
      },
      "post": {
        "operationId": "UpdateDateOfBirth",
        "summary": "Update the user's date of birth.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DateOfBirthViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Date of birth updated successfully."
          },
          "400": {
            "description": "Validation errors occurred."
          }
        }
      }
    },
    "/postcode-address": {
      "get": {
        "operationId": "GetPostcodeAddress",
        "summary": "Retrieve and view the user's postcode and address.",
        "parameters": [
          {
            "name": "postcode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "journeyPath",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "CreateAccount",
                "ConfirmAccountDetails",
                "Settings"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Address retrieval page rendered."
          }
        }
      },
      "post": {
        "operationId": "UpdatePostcodeAddress",
        "summary": "Validate and redirect based on a postcode.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostcodeAddressViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation passed and redirection initiated."
          },
          "400": {
            "description": "Validation errors occurred."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NameViewModel": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "journeyPath": {
            "type": "string",
            "enum": [
              "CreateAccount",
              "ConfirmAccountDetails",
              "Settings"
            ]
          }
        },
        "required": [
          "firstName",
          "lastName"
        ]
      },
      "DateOfBirthViewModel": {
        "type": "object",
        "properties": {
          "dateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "journeyPath": {
            "type": "string",
            "enum": [
              "CreateAccount",
              "ConfirmAccountDetails",
              "Settings"
            ]
          }
        },
        "required": [
          "dateOfBirth"
        ]
      },
      "PostcodeAddressViewModel": {
        "type": "object",
        "properties": {
          "postcode": {
            "type": "string"
          },
          "journeyPath": {
            "type": "string",
            "enum": [
              "CreateAccount",
              "ConfirmAccountDetails",
              "Settings"
            ]
          }
        },
        "required": [
          "postcode"
        ]
      }
    }
  }
}
