@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_rat_api, "Request Apprentice Training") {
  Container(c_request_apprentice_training, "Request Apprentice Training", "API")
}

System_Ext(d_cloud_service_azure_key_vault, "Azure Key Vault", "Azure.Identity")
SystemDb_Ext(d_database_sql_server_database, "SQL Server Database", "Microsoft.EntityFrameworkCore.SqlServer")
SystemQueue_Ext(d_message_broker_azure_service_bus, "Azure Service Bus", "NServiceBus")

Rel(c_request_apprentice_training, d_cloud_service_azure_key_vault, "Uses", "Azure.Identity")
Rel(c_request_apprentice_training, d_database_sql_server_database, "Reads from and writes to", "Microsoft.EntityFrameworkCore.SqlServer")
Rel(c_request_apprentice_training, d_message_broker_azure_service_bus, "Publishes messages to and consumes messages from", "NServiceBus")

@enduml
