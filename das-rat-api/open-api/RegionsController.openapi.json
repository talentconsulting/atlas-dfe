{
  "openapi": "3.1.0",
  "info": {
    "title": "Regions API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/regions/": {
      "get": {
        "operationId": "GetRegions",
        "summary": "Retrieve all regions.",
        "responses": {
          "200": {
            "description": "A list of regions.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Region"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    },
    "/api/regions/closest": {
      "get": {
        "operationId": "GetClosestRegion",
        "summary": "Retrieve the closest region based on geographic coordinates.",
        "parameters": [
          {
            "name": "latitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            },
            "description": "The latitude of the location."
          },
          {
            "name": "longitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            },
            "description": "The longitude of the location."
          }
        ],
        "responses": {
          "200": {
            "description": "The closest region.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Region"
                }
              }
            }
          },
          "400": {
            "description": "Validation or other error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Region": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    }
  }
}
