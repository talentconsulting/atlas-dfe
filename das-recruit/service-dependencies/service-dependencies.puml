@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_recruit, "Recruit") {
  Container(c_recruit, "Recruit", "Component")
  Container(c_recruit_employer_web, "Recruit Employer Web", "Web Application")
  Container(c_recruit_provider_web, "Recruit Provider Web", "Web Application")
}

SystemDb_Ext(d_configuration_store_azure_app_configuration, "Azure App Configuration", "Azure Table Storage")
System_Ext(d_http_api_outer_api, "Outer API", "HttpClient")
System_Ext(d_identity_provider_dfe_sign_in, "DfE Sign-in")
System_Ext(d_identity_provider_microsoft_entra_id, "Microsoft Entra ID")
SystemQueue_Ext(d_message_broker_azure_storage_queue, "Azure Storage Queue")
System_Ext(d_telemetry_application_insights, "Application Insights", "Application Insights")

Rel(c_recruit_employer_web, d_configuration_store_azure_app_configuration, "Reads configuration from", "Azure Table Storage")
Rel(c_recruit_provider_web, d_configuration_store_azure_app_configuration, "Reads configuration from", "Azure Table Storage")
Rel(c_recruit, d_http_api_outer_api, "Calls the API of", "HttpClient")
Rel(c_recruit_provider_web, d_identity_provider_dfe_sign_in, "Authenticates with")
Rel(c_recruit_employer_web, d_identity_provider_microsoft_entra_id, "Authenticates with")
Rel(c_recruit, d_message_broker_azure_storage_queue, "Publishes messages to and consumes messages from")
Rel(c_recruit_employer_web, d_telemetry_application_insights, "Sends telemetry to", "Application Insights")
Rel(c_recruit_provider_web, d_telemetry_application_insights, "Sends telemetry to", "Application Insights")

@enduml
