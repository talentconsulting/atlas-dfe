@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_recruit, "Recruit") {
  Container(c_employer, "Recruit", "Web Application")
  Container(c_provider, "Recruit Provider", "Web Application")
}

SystemDb_Ext(d_cache_stackexchange_redis, "StackExchange Redis", "redis")
System_Ext(d_cloud_service_azure_key_vault, "Azure Key Vault", "azure-keyvault")
System_Ext(d_http_api_outer_api, "Outer API", "http")
SystemQueue_Ext(d_message_broker_azure_service_bus, "Azure Service Bus", "azure-service-bus")

Rel(c_employer, d_cache_stackexchange_redis, "Caches data in", "redis")
Rel(c_employer, d_cloud_service_azure_key_vault, "Uses", "azure-keyvault")
Rel(c_employer, d_http_api_outer_api, "Calls the API of", "http")
Rel(c_provider, d_http_api_outer_api, "Calls the API of", "http")
Rel(c_provider, d_message_broker_azure_service_bus, "Publishes messages to and consumes messages from", "azure-service-bus")

@enduml
