  "paths": {
    "/services/{employerAccountId}/account-home": {
      "get": {
        "operationId": "getAccountHome",
        "description": "Redirects the employer to the account home page.",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 6
            },
            "description": "The employer account ID."
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the account home page."
          }
        }
      }
    },
