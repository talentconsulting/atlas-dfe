{
  "openapi": "3.1.0",
  "info": {
    "title": "EmployerVacancy API",
    "version": "1.0.0"
  },
  "paths": {
    "/{employerAccountId}/employer-create-vacancy": {
      "get": {
        "operationId": "CreateVacancy",
        "summary": "Create a new vacancy for an employer",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ukprn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "programmeId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to a route based on vacancy creation conditions"
          }
        }
      }
    },
    "/{employerAccountId}/employer-manage-vacancy": {
      "get": {
        "operationId": "ManageVacancy",
        "summary": "Manage existing vacancies for an employer",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the list of all vacancies for the employer"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TrainingProviderSummary": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "string"
          }
        }
      },
      "IApprenticeshipProgramme": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          }
        }
      }
    }
  }
}
