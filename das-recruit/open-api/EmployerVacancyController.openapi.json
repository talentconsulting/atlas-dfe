{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Vacancy API",
    "version": "1.0.0"
  },
  "paths": {
    "/{employerAccountId}/employer-create-vacancy": {
      "get": {
        "operationId": "EmployerCreateVacancy_Get",
        "summary": "Create a new vacancy for the employer.",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The account ID of the employer."
          },
          {
            "name": "ukprn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "UKPRN (UK Provider Reference Number)."
          },
          {
            "name": "programmeId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Programme ID."
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to another route based on the provided data."
          }
        }
      }
    },
    "/{employerAccountId}/employer-manage-vacancy": {
      "get": {
        "operationId": "EmployerManageVacancy_Get",
        "summary": "Manage an existing vacancy for the employer.",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The account ID of the employer."
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to another route based on the provided data."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
