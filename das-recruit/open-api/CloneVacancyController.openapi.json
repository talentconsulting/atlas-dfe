{
  "openapi": "3.1.0",
  "info": {
    "title": "Clone Vacancy API",
    "version": "1.0.0"
  },
  "paths": {
    "/{EmployerAccountId}/vacancies/{VacancyId}/clone": {
      "get": {
        "operationId": "CloneVacancy_Get",
        "summary": "Redirects based on vacancy clone eligibility.",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to an appropriate route for cloning."
          }
        }
      }
    },
    "/{EmployerAccountId}/vacancies/{VacancyId}/clone-dates-question": {
      "get": {
        "operationId": "CloneVacancyDatesQuestion_Get",
        "summary": "Displays question to confirm cloning with existing dates.",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the view for clone vacancy dates question."
          }
        }
      },
      "post": {
        "operationId": "CloneVacancyDatesQuestion_Post",
        "summary": "Processes user's confirmation on cloning with existing dates.",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CloneVacancyDatesQuestionEditModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to next step based on user confirmation."
          },
          "400": {
            "description": "Validation errors.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/{EmployerAccountId}/vacancies/{VacancyId}/clone-with-dates": {
      "get": {
        "operationId": "CloneVacancyWithNewDates_Get",
        "summary": "Displays form for cloning vacancy with new dates.",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the view for cloning with new dates."
          }
        }
      },
      "post": {
        "operationId": "CloneVacancyWithNewDates_Post",
        "summary": "Processes form submission for cloning vacancy with new dates.",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CloneVacancyWithNewDatesEditModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to next step based on successful submission."
          },
          "400": {
            "description": "Validation errors.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VacancyRouteModel": {
        "type": "object",
        "properties": {
          "EmployerAccountId": {
            "type": "string"
          },
          "VacancyId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "EmployerAccountId",
          "VacancyId"
        ]
      },
      "CloneVacancyDatesQuestionEditModel": {
        "allOf": [
          {
            "$ref": "#/components/schemas/VacancyRouteModel"
          },
          {
            "type": "object",
            "properties": {
              "HasConfirmedClone": {
                "type": "boolean",
                "nullable": true
              }
            }
          }
        ]
      },
      "CloneVacancyWithNewDatesEditModel": {
        "allOf": [
          {
            "$ref": "#/components/schemas/VacancyRouteModel"
          },
          {
            "type": "object",
            "properties": {
              "ClosingDay": {
                "type": "string"
              },
              "ClosingMonth": {
                "type": "string"
              },
              "ClosingYear": {
                "type": "string"
              },
              "ClosingDate": {
                "type": "string"
              },
              "StartDay": {
                "type": "string"
              },
              "StartMonth": {
                "type": "string"
              },
              "StartYear": {
                "type": "string"
              },
              "StartDate": {
                "type": "string"
              }
            }
          }
        ]
      }
    }
  }
}
