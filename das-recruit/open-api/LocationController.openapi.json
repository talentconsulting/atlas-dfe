{
  "openapi": "3.1.0",
  "info": {
    "title": "Location API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{EmployerAccountId}/vacancies/{VacancyId}/add-one-location": {
      "get": {
        "operationId": "AddOneLocation_Get",
        "summary": "Retrieve the form for adding a single location to the vacancy",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Employer account ID"
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Vacancy ID"
          },
          {
            "name": "wizard",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Indicates whether the wizard mode is active"
          }
        ],
        "responses": {
          "200": {
            "description": "Form to add a single location",
            "content": {
              "text/html": {}
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "operationId": "AddOneLocation_Post",
        "summary": "Submit the form to add a single location to the vacancy",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Employer account ID"
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Vacancy ID"
          },
          {
            "name": "wizard",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Indicates whether the wizard mode is active"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/AddOneLocationEditModel"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddOneLocationEditModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Form submission completed successfully",
            "content": {
              "text/html": {}
            }
          },
          "400": {
            "description": "Validation errors occurred during input submission"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddOneLocationEditModel": {
        "type": "object",
        "properties": {
          "EmployerAccountId": {
            "type": "string",
            "description": "Employer account ID"
          },
          "VacancyId": {
            "type": "string",
            "format": "uuid",
            "description": "Vacancy ID"
          },
          "SelectedLocation": {
            "type": "string",
            "description": "Address of the selected location"
          },
          "Review": {
            "$ref": "#/components/schemas/ReviewSummaryViewModel"
          }
        },
        "required": [
          "EmployerAccountId",
          "VacancyId",
          "SelectedLocation"
        ]
      },
      "ReviewSummaryViewModel": {
        "type": "object",
        "properties": {
          "HasBeenReviewed": {
            "type": "boolean",
            "description": "Indicates whether the vacancy has been reviewed"
          },
          "ReviewerComments": {
            "type": "string",
            "description": "Comments added by the reviewer"
          },
          "FieldIndicators": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReviewFieldIndicatorViewModel"
            },
            "description": "Field indicators for the review"
          }
        }
      },
      "ReviewFieldIndicatorViewModel": {
        "type": "object",
        "properties": {
          "ReviewFieldIdentifier": {
            "type": "string",
            "description": "Unique identifier for the review field"
          },
          "IsChangeRequested": {
            "type": "boolean",
            "description": "Indicates whether a change has been requested for this field"
          }
        }
      }
    }
  }
}
