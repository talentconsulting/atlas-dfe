{
  "openapi": "3.1.0",
  "info": {
    "title": "ApplicationReview",
    "version": "1.0.0"
  },
  "paths": {
    "/{EmployerAccountId}/{VacancyId}/{ApplicationReviewId}": {
      "get": {
        "operationId": "getApplicationReview",
        "summary": "Retrieve application review details.",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "ApplicationReviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Details of the application review",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationReview"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "postApplicationReview",
        "summary": "Submit changes to application review.",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "ApplicationReviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplicationReviewEditModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Changes successfully saved"
          }
        }
      }
    },
    "/{EmployerAccountId}/{VacancyId}/{ApplicationReviewId}/feedback": {
      "get": {
        "operationId": "getApplicationReviewFeedback",
        "summary": "Retrieve feedback for an application review.",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "ApplicationReviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Feedback details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationReviewFeedbackViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "postApplicationReviewFeedback",
        "summary": "Update feedback for an application review.",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "ApplicationReviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplicationReviewFeedbackViewModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Feedback successfully saved"
          }
        }
      }
    },
    "/{EmployerAccountId}/{VacancyId}/{ApplicationReviewId}/status": {
      "get": {
        "operationId": "getApplicationReviewStatusConfirmation",
        "summary": "Get confirmation details for changing application review status.",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "ApplicationReviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Status confirmation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationReviewStatusConfirmationEditModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "postApplicationReviewStatusConfirmation",
        "summary": "Confirm and save changes to application review status.",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "ApplicationReviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplicationReviewStatusConfirmationEditModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Status changes successfully saved"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApplicationReview": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "candidateId": {
            "type": "string",
            "format": "uuid"
          },
          "vacancyReference": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string",
            "enum": [
              "New",
              "Successful",
              "Unsuccessful",
              "Shared",
              "InReview",
              "Interviewing",
              "EmployerInterviewing",
              "EmployerUnsuccessful",
              "PendingShared",
              "PendingToMakeUnsuccessful",
              "AllShared"
            ]
          },
          "candidateFeedback": {
            "type": "string"
          }
        }
      },
      "ApplicationReviewEditModel": {
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "New",
              "Successful",
              "Unsuccessful",
              "Shared",
              "InReview",
              "Interviewing",
              "EmployerInterviewing",
              "EmployerUnsuccessful",
              "PendingShared",
              "PendingToMakeUnsuccessful",
              "AllShared"
            ],
            "nullable": true
          },
          "candidateFeedback": {
            "type": "string",
            "nullable": true
          },
          "isApplicationSharedByProvider": {
            "type": "boolean"
          }
        }
      },
      "ApplicationReviewFeedbackViewModel": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "friendlyId": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "New",
              "Successful",
              "Unsuccessful",
              "Shared",
              "InReview",
              "Interviewing",
              "EmployerInterviewing",
              "EmployerUnsuccessful",
              "PendingShared",
              "PendingToMakeUnsuccessful",
              "AllShared"
            ],
            "nullable": true
          }
        }
      },
      "ApplicationReviewStatusConfirmationEditModel": {
        "type": "object",
        "properties": {
          "notifyCandidate": {
            "type": "boolean",
            "nullable": true
          },
          "outcome": {
            "type": "string",
            "enum": [
              "New",
              "Successful",
              "Unsuccessful",
              "Shared",
              "InReview",
              "Interviewing",
              "EmployerInterviewing",
              "EmployerUnsuccessful",
              "PendingShared",
              "PendingToMakeUnsuccessful",
              "AllShared"
            ],
            "nullable": true
          },
          "candidateFeedback": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
