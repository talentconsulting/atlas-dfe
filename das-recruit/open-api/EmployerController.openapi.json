{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer API",
    "version": "1.0.0"
  },
  "paths": {
    "/{EmployerAccountId}/{VacancyId}/employer": {
      "get": {
        "operationId": "Employer_Get",
        "summary": "Get employer details associated with a vacancy",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "searchTerm",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "wizard",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "true"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/html": {
                "examples": {
                  "defaultView": {
                    "description": "Employer view data rendered"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "Employer_Post",
        "summary": "Submit employer details for a vacancy",
        "parameters": [
          {
            "name": "wizard",
            "in": "query",
            "required": true,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/EmployerEditModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to the next step based on the wizard state"
          }
        }
      }
    },
    "/{EmployerAccountId}/{VacancyId}/employer-cancel": {
      "get": {
        "operationId": "Employer_Cancel",
        "summary": "Cancel creation of employer details for a vacancy",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "wizard",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to another route after cancelling"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EmployerEditModel": {
        "type": "object",
        "properties": {
          "SelectedOrganisationId": {
            "type": "string",
            "description": "The ID of the selected organisation"
          },
          "SearchTerm": {
            "type": "string",
            "description": "The search term used for filtering organisations"
          },
          "Page": {
            "type": "integer",
            "description": "The current page number for pagination"
          },
          "EmployerAccountId": {
            "type": "string",
            "description": "The ID of the employer account"
          },
          "VacancyId": {
            "type": "string",
            "format": "uuid",
            "description": "The ID of the vacancy"
          }
        },
        "required": [
          "SelectedOrganisationId",
          "EmployerAccountId",
          "VacancyId"
        ]
      }
    }
  }
}
