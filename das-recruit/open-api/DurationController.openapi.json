{
  "openapi": "3.1.0",
  "info": {
    "title": "DurationController API",
    "version": "1.0.0",
    "description": "API endpoints for managing Duration."
  },
  "paths": {
    "/accounts/{EmployerAccountId}/vacancies/{VacancyId}/duration": {
      "get": {
        "operationId": "GetDuration",
        "summary": "Retrieve the duration view model for a vacancy.",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique identifier for the employer account."
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the vacancy."
          },
          {
            "name": "wizard",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "true"
            },
            "description": "Controls the presentation mode of the duration wizard."
          }
        ],
        "responses": {
          "200": {
            "description": "The duration view model retrieved successfully.",
            "content": {
              "text/html": {}
            }
          }
        }
      },
      "post": {
        "operationId": "PostDuration",
        "summary": "Submit the duration edit model for a vacancy.",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique identifier for the employer account."
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the vacancy."
          },
          {
            "name": "wizard",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Indicates whether the user is completing the wizard flow."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DurationEditModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Redirects to the next page based on wizard completion or validation errors.",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DurationEditModel": {
        "type": "object",
        "properties": {
          "EmployerAccountId": {
            "type": "string",
            "description": "Unique identifier for the employer account."
          },
          "VacancyId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the vacancy."
          },
          "Duration": {
            "type": "string",
            "description": "Expected duration in units."
          },
          "DurationUnit": {
            "type": "string",
            "enum": [
              "Week",
              "Month",
              "Year"
            ],
            "description": "Unit for the duration."
          },
          "WorkingWeekDescription": {
            "type": "string",
            "description": "Description of the working week."
          },
          "WeeklyHours": {
            "type": "string",
            "description": "Hours per week as a decimal value."
          }
        },
        "required": [
          "EmployerAccountId",
          "VacancyId"
        ]
      }
    }
  }
}
