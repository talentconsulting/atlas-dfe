{
  "openapi": "3.1.0",
  "info": {
    "title": "Cookie Manager API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{accountId}/dismiss-outage-message": {
      "post": {
        "operationId": "DismissOutageMessage",
        "summary": "Dismiss the outage message.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z0-9]{6}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "returnUrl": {
                    "type": "string",
                    "format": "uri-reference"
                  }
                },
                "required": [
                  "returnUrl"
                ]
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to the returnUrl or vacancies route."
          }
        }
      }
    },
    "/accounts/{accountId}/dismiss-cloning-method-changing-message": {
      "post": {
        "operationId": "DismissCloningMethodChangingMessage",
        "summary": "Dismiss the cloning method changing message.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z0-9]{6}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "returnUrl": {
                    "type": "string",
                    "format": "uri-reference"
                  }
                },
                "required": [
                  "returnUrl"
                ]
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to the returnUrl or vacancies route."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ReturnUrl": {
        "type": "string",
        "format": "uri-reference"
      }
    }
  }
}
