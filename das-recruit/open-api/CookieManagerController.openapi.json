{
  "openapi": "3.1.0",
  "info": {
    "title": "Cookie Manager API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{accountId}/dismiss-outage-message": {
      "post": {
        "operationId": "dismissOutageMessage",
        "description": "Dismiss the outage message by setting a cookie and redirecting to the provided URL.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Unique account identifier."
            }
          },
          {
            "name": "returnUrl",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "The URL to redirect to after dismissing the message."
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the specified return URL or fallback route."
          }
        }
      }
    },
    "/accounts/{accountId}/dismiss-cloning-method-changing-message": {
      "post": {
        "operationId": "dismissCloningMethodChangingMessage",
        "description": "Dismiss the cloning method changing message by setting a cookie and redirecting to the provided URL.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Unique account identifier."
            }
          },
          {
            "name": "returnUrl",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "The URL to redirect to after dismissing the message."
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the specified return URL or fallback route."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "dismissMessageInput": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "description": "Unique account identifier."
          },
          "returnUrl": {
            "type": "string",
            "description": "The URL to redirect to."
          }
        },
        "required": [
          "accountId",
          "returnUrl"
        ]
      }
    }
  }
}
