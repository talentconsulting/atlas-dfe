{
  "openapi": "3.1.0",
  "info": {
    "title": "Enter Location Manually API",
    "version": "1.0.0"
  },
  "paths": {
    "/{EmployerAccountId}/vacancies/{VacancyId}/enter-location": {
      "get": {
        "operationId": "EnterLocationManually_Get",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Origin",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/MultipleLocationsJourneyOrigin"
            }
          },
          {
            "name": "Wizard",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Render the view with location form",
            "content": {
              "application/json": {}
            }
          },
          "400": {
            "description": "Invalid model state or parameters"
          }
        }
      },
      "post": {
        "operationId": "EnterLocationManually_Post",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnterLocationManuallyEditModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to appropriate route for location handling"
          },
          "400": {
            "description": "Validation errors or invalid postcode"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddLocationJourneyModel": {
        "type": "object",
        "properties": {
          "Origin": {
            "$ref": "#/components/schemas/MultipleLocationsJourneyOrigin"
          },
          "Wizard": {
            "type": "boolean"
          },
          "EmployerAccountId": {
            "type": "string"
          },
          "VacancyId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "EnterLocationManuallyEditModel": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/AddLocationJourneyModel"
          }
        ],
        "properties": {
          "AddressLine1": {
            "type": "string"
          },
          "AddressLine2": {
            "type": "string"
          },
          "City": {
            "type": "string"
          },
          "Postcode": {
            "type": "string"
          }
        }
      },
      "MultipleLocationsJourneyOrigin": {
        "type": "string",
        "enum": [
          "One",
          "Many"
        ]
      }
    }
  }
}
