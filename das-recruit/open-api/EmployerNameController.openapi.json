{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Name API",
    "version": "1.0.0"
  },
  "paths": {
    "/{EmployerAccountId}/vacancies/{VacancyId}/employer-name": {
      "get": {
        "operationId": "EmployerName_Get",
        "summary": "Retrieve Employer Name page data.",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "wizard",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employer Name page data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployerNameViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirects to the Employer endpoint if necessary."
          }
        }
      },
      "post": {
        "operationId": "EmployerName_Post",
        "summary": "Submit changes to Employer Name.",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmployerNameEditModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to the About Employer endpoint with possible continuation."
          },
          "400": {
            "description": "Validation errors occurred.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployerNameViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/{EmployerAccountId}/vacancies/{VacancyId}/employer-name-cancel": {
      "get": {
        "operationId": "EmployerName_Cancel",
        "summary": "Cancel Employer Name changes and redirect.",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "wizard",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to the appropriate endpoint."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EmployerNameEditModel": {
        "type": "object",
        "properties": {
          "SelectedEmployerIdentityOption": {
            "type": "string",
            "enum": [
              "RegisteredName",
              "ExistingTradingName",
              "NewTradingName",
              "Anonymous"
            ],
            "nullable": true
          },
          "NewTradingName": {
            "type": "string",
            "nullable": true
          },
          "AnonymousName": {
            "type": "string",
            "nullable": true
          },
          "AnonymousReason": {
            "type": "string",
            "nullable": true
          },
          "VacancyId": {
            "type": "string",
            "format": "uuid"
          },
          "EmployerAccountId": {
            "type": "string"
          },
          "IsTaskList": {
            "type": "boolean"
          }
        },
        "required": [
          "VacancyId",
          "EmployerAccountId"
        ]
      },
      "EmployerNameViewModel": {
        "type": "object",
        "properties": {
          "NewTradingName": {
            "type": "string",
            "nullable": true
          },
          "SelectedEmployerIdentityOption": {
            "type": "string",
            "enum": [
              "RegisteredName",
              "ExistingTradingName",
              "NewTradingName",
              "Anonymous"
            ],
            "nullable": true
          },
          "AnonymousName": {
            "type": "string",
            "nullable": true
          },
          "AnonymousReason": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
