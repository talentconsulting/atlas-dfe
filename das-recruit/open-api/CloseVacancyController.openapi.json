{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Vacancy Management API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{EmployerAccountId}/vacancies/{VacancyId}/close": {
      "get": {
        "operationId": "CloseVacancy_Get",
        "summary": "Get closure confirmation for a vacancy.",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The closure confirmation view is returned."
          }
        }
      },
      "post": {
        "operationId": "CloseVacancy_Post",
        "summary": "Submit closure confirmation for a vacancy.",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CloseEditModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects based on confirmation status or success."
          },
          "400": {
            "description": "Invalid request body."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VacancyRouteModel": {
        "type": "object",
        "properties": {
          "EmployerAccountId": {
            "type": "string"
          },
          "VacancyId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CloseEditModel": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/VacancyRouteModel"
          }
        ],
        "properties": {
          "ConfirmClose": {
            "type": "boolean",
            "nullable": true,
            "description": "Indicates whether the user confirms vacancy closure."
          }
        }
      }
    }
  }
}
