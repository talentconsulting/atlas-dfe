{
  "openapi": "3.1.0",
  "info": {
    "title": "Custom Wage API",
    "version": "1.0.0",
    "description": "API for managing custom wage-related operations on vacancies."
  },
  "paths": {
    "/{EmployerAccountId}/vacancies/{VacancyId}/custom-wage": {
      "get": {
        "tags": [
          "Custom Wage"
        ],
        "summary": "Get Custom Wage Page",
        "operationId": "getCustomWage",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The account ID of the employer."
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the vacancy."
          },
          {
            "name": "wizard",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "true"
            },
            "description": "Indicator for wizard mode."
          }
        ],
        "responses": {
          "200": {
            "description": "Custom Wage page retrieved successfully.",
            "content": {
              "text/html": {
                "example": "HTML content for the custom wage view."
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      },
      "post": {
        "tags": [
          "Custom Wage"
        ],
        "summary": "Submit Custom Wage Information",
        "operationId": "postCustomWage",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The account ID of the employer."
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the vacancy."
          },
          {
            "name": "wizard",
            "in": "query",
            "required": true,
            "schema": {
              "type": "boolean"
            },
            "description": "Indicator for wizard mode."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomWageEditModel"
              }
            }
          },
          "description": "The custom wage details to submit."
        },
        "responses": {
          "302": {
            "description": "Redirects to the Add Extra Information endpoint upon successful data submission.",
            "headers": {
              "Location": {
                "description": "The URL of the redirection endpoint.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CustomWageEditModel": {
        "type": "object",
        "properties": {
          "EmployerAccountId": {
            "type": "string",
            "description": "The account ID of the employer."
          },
          "VacancyId": {
            "type": "string",
            "format": "uuid",
            "description": "The ID of the vacancy."
          },
          "FixedWageYearlyAmount": {
            "type": "string",
            "description": "The fixed yearly wage amount.",
            "pattern": "^[0-9]+(\\.[0-9]+)?$",
            "errorMessage": "Fixed wage must be a number."
          }
        },
        "required": [
          "EmployerAccountId",
          "VacancyId",
          "FixedWageYearlyAmount"
        ]
      }
    }
  }
}
