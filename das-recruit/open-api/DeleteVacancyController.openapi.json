{
  "openapi": "3.1.0",
  "info": {
    "title": "Delete Vacancy API",
    "version": "1.0.0",
    "description": "API for managing the deletion of vacancies in the Employer Web application."
  },
  "paths": {
    "/{EmployerAccountId}/{VacancyId}/delete": {
      "get": {
        "operationId": "getDeleteVacancyConfirmationView",
        "summary": "Retrieve delete confirmation view.",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "deleteVacancy",
        "summary": "Delete the vacancy based on confirmation inputs.",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteEditModel"
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteEditModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirection based on deletion settings."
          },
          "200": {
            "description": "Vacancy successfully deleted."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DeleteEditModel": {
        "type": "object",
        "properties": {
          "EmployerAccountId": {
            "type": "string",
            "description": "ID of the employer's account."
          },
          "VacancyId": {
            "type": "string",
            "format": "uuid",
            "description": "ID of the vacancy."
          },
          "ConfirmDeletion": {
            "type": "boolean",
            "description": "Indicates whether deletion is confirmed."
          },
          "Status": {
            "type": "string",
            "description": "Current status of the vacancy.",
            "enum": [
              "Draft",
              "Review",
              "Rejected",
              "Submitted",
              "Referred",
              "Live",
              "Closed",
              "Approved",
              "Archived"
            ]
          }
        },
        "required": [
          "EmployerAccountId",
          "VacancyId",
          "ConfirmDeletion"
        ]
      }
    }
  }
}
