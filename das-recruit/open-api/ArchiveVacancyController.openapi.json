{
  "openapi": "3.1.0",
  "info": {
    "title": "Archive Vacancy API",
    "version": "1.0.0",
    "description": "API for archiving vacancies in the recruitment system."
  },
  "paths": {
    "/{EmployerAccountId}/vacancies/{VacancyId}/archive": {
      "get": {
        "operationId": "getArchiveVacancyConfirmation",
        "summary": "Get archive vacancy confirmation view",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Archive vacancy confirmation view returned."
          }
        }
      },
      "post": {
        "operationId": "archiveVacancy",
        "summary": "Archive a vacancy",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArchiveEditModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Vacancy archived successfully."
          },
          "400": {
            "description": "Request invalid."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArchiveEditModel": {
        "type": "object",
        "properties": {
          "ConfirmArchive": {
            "type": "boolean",
            "description": "User confirmation for archiving the vacancy."
          },
          "Status": {
            "type": "string",
            "enum": [
              "Draft",
              "Review",
              "Rejected",
              "Submitted",
              "Referred",
              "Live",
              "Closed",
              "Approved",
              "Archived"
            ],
            "description": "The status of the vacancy."
          },
          "EmployerAccountId": {
            "type": "string",
            "description": "Employer account ID associated with the vacancy."
          },
          "VacancyId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the vacancy."
          }
        },
        "required": [
          "ConfirmArchive",
          "EmployerAccountId",
          "VacancyId"
        ]
      }
    }
  }
}
