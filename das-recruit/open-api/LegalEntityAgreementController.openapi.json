{
  "openapi": "3.1.0",
  "info": {
    "title": "Legal Entity Agreement API",
    "version": "1.0.0"
  },
  "paths": {
    "/{EmployerAccountId}/{VacancyId}/legal-entity-agreement": {
      "get": {
        "summary": "Legal Entity Agreement Soft Stop",
        "operationId": "LegalEntityAgreementSoftStop",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "wizard",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect based on legal entity agreement status"
          },
          "200": {
            "description": "Soft stop page rendered",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/{EmployerAccountId}/{VacancyId}/legal-entity-agreement-stop": {
      "get": {
        "summary": "Legal Entity Agreement Hard Stop",
        "operationId": "LegalEntityAgreementHardStop",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "wizard",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to dashboard or render hard stop page"
          },
          "200": {
            "description": "Hard stop page rendered",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TaskListViewModel": {
        "type": "object",
        "properties": {
          "wizard": {
            "type": "boolean",
            "description": "Indicates if the user is in task list mode"
          }
        }
      },
      "VacancyRouteModel": {
        "type": "object",
        "properties": {
          "EmployerAccountId": {
            "type": "string",
            "description": "Employer's account identifier"
          },
          "VacancyId": {
            "type": "string",
            "format": "uuid",
            "description": "Vacancy identifier"
          }
        }
      }
    }
  }
}
