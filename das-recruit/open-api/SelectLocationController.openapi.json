{
  "openapi": "3.1.0",
  "info": {
    "title": "Select Location API",
    "version": "1.0.0",
    "description": "API for selecting and managing location data related to vacancies."
  },
  "paths": {
    "/{EmployerAccountId}/vacancies/{VacancyId}/select-location": {
      "get": {
        "tags": [
          "Select Location"
        ],
        "summary": "Retrieve the location selection options for a vacancy.",
        "operationId": "getSelectLocation",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Origin",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/MultipleLocationsJourneyOrigin"
            }
          },
          {
            "name": "Wizard",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of the locations.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectLocationViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirect to the Add Location screen if postcode is missing."
          },
          "400": {
            "description": "Bad Request - Validation Errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntityValidationResult"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Select Location"
        ],
        "summary": "Submit a selected location for a vacancy.",
        "operationId": "postSelectLocation",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectLocationEditModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully added the selected address to the vacancy's list of locations.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectLocationViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirect to the Add Location screen if postcode is missing."
          },
          "400": {
            "description": "Bad Request - Validation Errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntityValidationResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VacancyRouteModel": {
        "type": "object",
        "properties": {
          "EmployerAccountId": {
            "type": "string"
          },
          "VacancyId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "EmployerAccountId",
          "VacancyId"
        ]
      },
      "AddLocationJourneyModel": {
        "allOf": [
          {
            "$ref": "#/components/schemas/VacancyRouteModel"
          },
          {
            "type": "object",
            "properties": {
              "Origin": {
                "$ref": "#/components/schemas/MultipleLocationsJourneyOrigin"
              },
              "Wizard": {
                "type": "boolean",
                "default": true
              }
            }
          }
        ]
      },
      "SelectLocationEditModel": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AddLocationJourneyModel"
          },
          {
            "type": "object",
            "properties": {
              "SelectedLocation": {
                "type": "string",
                "description": "The selected address.",
                "nullable": true
              }
            },
            "required": [
              "SelectedLocation"
            ]
          }
        ]
      },
      "SelectLocationViewModel": {
        "type": "object",
        "properties": {
          "ApprenticeshipTitle": {
            "type": "string"
          },
          "EmployerAccountId": {
            "type": "string"
          },
          "Locations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "Origin": {
            "$ref": "#/components/schemas/MultipleLocationsJourneyOrigin"
          },
          "PageInfo": {
            "type": "object"
          },
          "Postcode": {
            "type": "string"
          },
          "VacancyId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "MultipleLocationsJourneyOrigin": {
        "type": "string",
        "enum": [
          "One",
          "Many"
        ]
      },
      "EntityValidationResult": {
        "type": "object",
        "properties": {
          "HasErrors": {
            "type": "boolean"
          },
          "Errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntityValidationError"
            }
          }
        }
      },
      "EntityValidationError": {
        "type": "object",
        "properties": {
          "RuleId": {
            "type": "integer"
          },
          "PropertyName": {
            "type": "string"
          },
          "ErrorMessage": {
            "type": "string"
          },
          "ErrorCode": {
            "type": "string"
          }
        }
      }
    }
  }
}
