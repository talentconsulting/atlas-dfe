{
  "openapi": "3.1.0",
  "info": {
    "title": "Manage Notifications API",
    "version": "1.0.0"
  },
  "paths": {
    "/{employerAccountId}/notifications-manage": {
      "get": {
        "summary": "Retrieve notification settings",
        "operationId": "ManageNotifications_Get",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "updated",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      },
      "post": {
        "summary": "Update notification preferences",
        "operationId": "ManageNotifications_Post",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManageNotificationsEditModelEx"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect on success"
          },
          "400": {
            "description": "Validation errors"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ManageNotificationsRouteModel": {
        "type": "object",
        "properties": {
          "EmployerAccountId": {
            "type": "string"
          }
        },
        "required": [
          "EmployerAccountId"
        ]
      },
      "ManageNotificationsEditModel": {
        "type": "object",
        "properties": {
          "IsVacancyRejectedSelected": {
            "type": "boolean"
          },
          "IsVacancySentForEmployerReviewSelected": {
            "type": "boolean"
          },
          "IsVacancyClosingSoonSelected": {
            "type": "boolean"
          },
          "IsApplicationSubmittedSelected": {
            "type": "boolean"
          },
          "NotificationFrequency": {
            "$ref": "#/components/schemas/NotificationFrequency"
          },
          "NotificationScope": {
            "$ref": "#/components/schemas/NotificationScope"
          },
          "HasAnySubscription": {
            "type": "boolean",
            "readOnly": true
          }
        }
      },
      "ManageNotificationsEditModelEx": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ManageNotificationsEditModel"
          },
          {
            "type": "object",
            "properties": {
              "VacancyApprovedOrRejectedValue": {
                "type": "string"
              },
              "ApplicationSubmittedValue": {
                "type": "string"
              },
              "ApplicationSubmittedFrequencyValue": {
                "type": "string"
              }
            }
          }
        ]
      },
      "NotificationFrequency": {
        "type": "string",
        "enum": [
          "Immediately",
          "Daily",
          "Weekly"
        ]
      },
      "NotificationScope": {
        "type": "string",
        "enum": [
          "UserSubmittedVacancies",
          "OrganisationVacancies"
        ]
      }
    }
  }
}
