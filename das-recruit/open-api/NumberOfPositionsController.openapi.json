{
  "openapi": "3.1.0",
  "info": {
    "title": "Number of Positions API",
    "version": "1.0.0"
  },
  "paths": {
    "/{EmployerAccountId}/vacancies/{VacancyId}/number-of-positions": {
      "get": {
        "operationId": "GetNumberOfPositions",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "wizard",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "true"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the number of positions view model.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "PostNumberOfPositions",
        "parameters": [
          {
            "name": "wizard",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/NumberOfPositionsEditModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to the next step based on wizard flag.",
            "content": {}
          },
          "400": {
            "description": "Validation errors occurred.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NumberOfPositionsEditModel": {
        "type": "object",
        "properties": {
          "EmployerAccountId": {
            "type": "string"
          },
          "VacancyId": {
            "type": "string",
            "format": "uuid"
          },
          "NumberOfPositions": {
            "type": "string"
          }
        },
        "required": [
          "EmployerAccountId",
          "VacancyId",
          "NumberOfPositions"
        ]
      }
    }
  }
}
