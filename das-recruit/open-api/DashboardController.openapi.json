{
  "openapi": "3.1.0",
  "info": {
    "title": "Dashboard API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{employerAccountId}": {
      "get": {
        "operationId": "getDashboard",
        "summary": "Retrieve dashboard information for a specific employer account.",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique identifier for the employer account."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardViewModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DashboardViewModel": {
        "type": "object",
        "properties": {
          "fromMaHome": {
            "type": "boolean",
            "description": "Indicates if the user was referred from the MA home back link."
          }
        }
      }
    }
  }
}
