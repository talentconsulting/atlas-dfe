{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Recruitment API",
    "version": "1.0.0"
  },
  "paths": {
    "/vacancies/{vacancyId}/title": {
      "get": {
        "summary": "Get Vacancy Title",
        "operationId": "Title_Get",
        "parameters": [
          {
            "name": "vacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "wizard",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Title view returned."
          }
        }
      },
      "post": {
        "summary": "Post Vacancy Title",
        "operationId": "Title_Post",
        "parameters": [
          {
            "name": "vacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "wizard",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TitleEditModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Vacancy title successfully posted."
          },
          "400": {
            "description": "Validation error."
          }
        }
      }
    },
    "/create-vacancy": {
      "get": {
        "summary": "Create Vacancy Wizard",
        "operationId": "CreateVacancy_Get",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Create vacancy wizard view returned."
          }
        }
      },
      "post": {
        "summary": "Post Create Vacancy",
        "operationId": "CreateVacancy_Post",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TitleEditModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Vacancy creation successful."
          },
          "400": {
            "description": "Validation error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TitleEditModel": {
        "type": "object",
        "properties": {
          "EmployerAccountId": {
            "type": "string"
          },
          "VacancyId": {
            "type": "string",
            "format": "uuid"
          },
          "Title": {
            "type": "string"
          },
          "ReferredUkprn": {
            "type": "string"
          },
          "ReferredFromMa": {
            "type": "boolean"
          },
          "ReferredProgrammeId": {
            "type": "string"
          }
        }
      }
    }
  }
}
