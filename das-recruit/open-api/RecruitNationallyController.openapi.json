{
  "openapi": "3.1.0",
  "info": {
    "title": "Recruit Nationally API",
    "version": "1.0.0"
  },
  "paths": {
    "/{EmployerAccountId}/vacancies/{VacancyId}/location-information": {
      "get": {
        "operationId": "RecruitNationally_Get",
        "summary": "Get recruiting nationally location information for a vacancy.",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "wizard",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecruitNationallyViewModel"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or binding errors"
          },
          "404": {
            "description": "Vacancy not found or unauthorized access"
          }
        }
      },
      "post": {
        "operationId": "RecruitNationally_Post",
        "summary": "Update recruiting nationally location information for a vacancy.",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "wizard",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecruitNationallyEditModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to the next step in the wizard or the check-your-answers screen",
            "headers": {
              "Location": {
                "description": "Redirect URL",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "400": {
            "description": "Validation error occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntityValidationResult"
                }
              }
            }
          },
          "404": {
            "description": "Vacancy not found or unauthorized access"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RecruitNationallyViewModel": {
        "type": "object",
        "properties": {
          "ApprenticeshipTitle": {
            "type": "string"
          },
          "EmployerAccountId": {
            "type": "string"
          },
          "AdditionalInformation": {
            "type": "string"
          },
          "PageInfo": {
            "$ref": "#/components/schemas/PartOnePageInfoViewModel"
          },
          "VacancyId": {
            "type": "string",
            "format": "uuid"
          },
          "Review": {
            "$ref": "#/components/schemas/ReviewSummaryViewModel"
          }
        }
      },
      "RecruitNationallyEditModel": {
        "type": "object",
        "properties": {
          "EmployerAccountId": {
            "type": "string"
          },
          "VacancyId": {
            "type": "string",
            "format": "uuid"
          },
          "AdditionalInformation": {
            "type": "string"
          }
        },
        "required": [
          "EmployerAccountId",
          "VacancyId",
          "AdditionalInformation"
        ]
      },
      "PartOnePageInfoViewModel": {
        "type": "object",
        "properties": {
          "HasCompletedPartOne": {
            "type": "boolean"
          },
          "HasStartedPartTwo": {
            "type": "boolean"
          },
          "IsWizard": {
            "type": "boolean"
          },
          "SubmitButtonText": {
            "type": "string"
          }
        }
      },
      "ReviewSummaryViewModel": {
        "type": "object",
        "properties": {
          "HasBeenReviewed": {
            "type": "boolean"
          },
          "ReviewerComments": {
            "type": "string"
          },
          "FieldIndicators": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReviewFieldIndicatorViewModel"
            }
          }
        }
      },
      "ReviewFieldIndicatorViewModel": {
        "type": "object",
        "properties": {
          "FieldIdentifier": {
            "type": "string"
          },
          "IsChangeRequested": {
            "type": "boolean"
          }
        }
      },
      "EntityValidationResult": {
        "type": "object",
        "properties": {
          "HasErrors": {
            "type": "boolean"
          },
          "Errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntityValidationError"
            }
          }
        }
      },
      "EntityValidationError": {
        "type": "object",
        "properties": {
          "Code": {
            "type": "string"
          },
          "FieldName": {
            "type": "string"
          },
          "Message": {
            "type": "string"
          }
        }
      }
    }
  }
}
