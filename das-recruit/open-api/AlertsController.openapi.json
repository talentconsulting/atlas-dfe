{
  "openapi": "3.1.0",
  "info": {
    "title": "Alerts API",
    "version": "1.0.0"
  },
  "paths": {
    "/{employerAccountId}/dismiss-alert": {
      "post": {
        "operationId": "DismissAlert",
        "summary": "Dismiss an alert for an employer account",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlertDismissalEditModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to another URL based on the returnUrl or dashboard route"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AlertDismissalEditModel": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "AlertType": {
            "type": "string"
          },
          "ReturnUrl": {
            "type": "string"
          },
          "EmployerAccountId": {
            "type": "string"
          }
        },
        "required": [
          "Ukprn",
          "AlertType",
          "EmployerAccountId"
        ]
      },
      "AlertType": {
        "type": "string",
        "enum": [
          "TransferredVacanciesBlockedProvider",
          "TransferredVacanciesEmployerRevokedPermission",
          "ClosedVacanciesBlockedProvider",
          "ClosedVacanciesWithdrawnByQa"
        ]
      }
    }
  }
}
