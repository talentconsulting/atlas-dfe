{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Web API",
    "version": "1.0.0",
    "description": "API for managing employer vacancies and locations."
  },
  "paths": {
    "/{EmployerAccountId}/{VacancyId}/add-location": {
      "get": {
        "operationId": "AddLocation_Get",
        "summary": "Retrieve the 'Add Location' page for a vacancy.",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Employer account identifier."
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Vacancy identifier."
          },
          {
            "name": "Origin",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/MultipleLocationsJourneyOrigin"
            },
            "description": "Origin of the journey, e.g., One or Many."
          },
          {
            "name": "Wizard",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            },
            "description": "Indicates whether wizard mode is enabled."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the 'Add Location' page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddLocationViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "AddLocation_Post",
        "summary": "Submit a location to be added to a vacancy.",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Employer account identifier."
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Vacancy identifier."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddLocationEditModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Successfully added the location. Redirected to the 'Select an Address' page."
          },
          "400": {
            "description": "Validation errors occurred."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddLocationJourneyModel": {
        "type": "object",
        "properties": {
          "Origin": {
            "$ref": "#/components/schemas/MultipleLocationsJourneyOrigin"
          },
          "Wizard": {
            "type": "boolean"
          }
        }
      },
      "AddLocationEditModel": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AddLocationJourneyModel"
          },
          {
            "type": "object",
            "properties": {
              "Postcode": {
                "type": "string",
                "nullable": false
              }
            }
          }
        ]
      },
      "AddLocationViewModel": {
        "type": "object",
        "properties": {
          "ApprenticeshipTitle": {
            "type": "string"
          },
          "EmployerAccountId": {
            "type": "string"
          },
          "Origin": {
            "$ref": "#/components/schemas/MultipleLocationsJourneyOrigin"
          },
          "PageInfo": {
            "type": "object",
            "additionalProperties": true
          },
          "Postcode": {
            "type": "string"
          },
          "VacancyId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "MultipleLocationsJourneyOrigin": {
        "type": "string",
        "enum": [
          "One",
          "Many"
        ]
      }
    }
  }
}
