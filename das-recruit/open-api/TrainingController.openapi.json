{
  "openapi": "3.1.0",
  "info": {
    "title": "Training Controller API",
    "description": "API endpoints for managing training courses related to vacancies.",
    "version": "1.0.0"
  },
  "paths": {
    "/account/{EmployerAccountId}/vacancy/{VacancyId}/training": {
      "get": {
        "operationId": "getTraining",
        "summary": "Retrieve training details for a vacancy.",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "wizard",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "true"
            }
          },
          {
            "name": "clear",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hasTraining",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "programmeId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of training details.",
            "content": {
              "application/json": {}
            }
          },
          "302": {
            "description": "Redirection to first-time training setup."
          },
          "404": {
            "description": "Training course not found."
          }
        }
      },
      "post": {
        "operationId": "postTraining",
        "summary": "Submit training details for a vacancy.",
        "parameters": [
          {
            "name": "wizard",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrainingEditModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Training successfully updated.",
            "content": {
              "application/json": {}
            }
          },
          "404": {
            "description": "Training programme not found."
          }
        }
      }
    },
    "/account/{EmployerAccountId}/vacancy/{VacancyId}/training-first-vacancy": {
      "get": {
        "operationId": "getTrainingFirstVacancy",
        "summary": "Retrieve guidance for setting up training for the first vacancy.",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of guidance.",
            "content": {
              "application/json": {}
            }
          }
        }
      },
      "post": {
        "operationId": "postTrainingFirstVacancy",
        "summary": "Submit training details for the first vacancy setup.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrainingFirstVacancyEditModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Training details successfully submitted.",
            "content": {
              "application/json": {}
            }
          },
          "302": {
            "description": "Redirects based on selection of training."
          }
        }
      }
    },
    "/account/{EmployerAccountId}/vacancy/{VacancyId}/training-help": {
      "get": {
        "operationId": "getTrainingHelp",
        "summary": "Provide help for choosing training courses.",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of training help.",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/account/{EmployerAccountId}/vacancy/{VacancyId}/training-confirm": {
      "get": {
        "operationId": "getTrainingConfirm",
        "summary": "Get confirmation of selected training programme.",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "programmeId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "wizard",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of confirmation details.",
            "content": {
              "application/json": {}
            }
          },
          "404": {
            "description": "Training programme not found."
          }
        }
      },
      "post": {
        "operationId": "postTrainingConfirm",
        "summary": "Confirm training programme selection.",
        "parameters": [
          {
            "name": "wizard",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmTrainingEditModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Training programme successfully confirmed.",
            "content": {
              "application/json": {}
            }
          },
          "400": {
            "description": "Validation errors occurred."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VacancyRouteModel": {
        "type": "object",
        "properties": {
          "EmployerAccountId": {
            "type": "string"
          },
          "VacancyId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "EmployerAccountId",
          "VacancyId"
        ]
      },
      "TrainingEditModel": {
        "type": "object",
        "properties": {
          "EmployerAccountId": {
            "type": "string"
          },
          "VacancyId": {
            "type": "string",
            "format": "uuid"
          },
          "SelectedProgrammeId": {
            "type": "string"
          }
        },
        "required": [
          "EmployerAccountId",
          "VacancyId",
          "SelectedProgrammeId"
        ]
      },
      "TrainingFirstVacancyEditModel": {
        "type": "object",
        "properties": {
          "EmployerAccountId": {
            "type": "string"
          },
          "VacancyId": {
            "type": "string",
            "format": "uuid"
          },
          "HasFoundTraining": {
            "type": "boolean",
            "nullable": true
          }
        },
        "required": [
          "EmployerAccountId",
          "VacancyId",
          "HasFoundTraining"
        ]
      },
      "ConfirmTrainingEditModel": {
        "type": "object",
        "properties": {
          "EmployerAccountId": {
            "type": "string"
          },
          "VacancyId": {
            "type": "string",
            "format": "uuid"
          },
          "ProgrammeId": {
            "type": "string"
          }
        },
        "required": [
          "EmployerAccountId",
          "VacancyId",
          "ProgrammeId"
        ]
      }
    }
  }
}
