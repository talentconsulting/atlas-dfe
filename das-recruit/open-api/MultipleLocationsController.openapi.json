{
  "openapi": "3.1.0",
  "info": {
    "title": "Multiple Locations Management",
    "version": "1.0.0",
    "description": "API for managing multiple locations associated with job vacancies."
  },
  "paths": {
    "/location-availability": {
      "get": {
        "operationId": "getLocationAvailability",
        "parameters": [
          {
            "name": "wizard",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Location Availability View Model returned successfully."
          }
        }
      },
      "post": {
        "operationId": "postLocationAvailability",
        "parameters": [
          {
            "name": "wizard",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LocationAvailabilityEditModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Location Availability updated successfully."
          }
        }
      }
    },
    "/add-many-locations": {
      "get": {
        "operationId": "getAddMoreThanOneLocation",
        "parameters": [
          {
            "name": "wizard",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Add More Than One Location View Model returned successfully."
          }
        }
      },
      "post": {
        "operationId": "postAddMoreThanOneLocation",
        "parameters": [
          {
            "name": "wizard",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddMoreThanOneLocationEditModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Locations updated successfully."
          }
        }
      }
    },
    "/add-many-locations/add-new-location": {
      "post": {
        "operationId": "postAddNewLocationJourney",
        "parameters": [
          {
            "name": "wizard",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddMoreThanOneLocationEditModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Redirected to Add Location wizard."
          }
        }
      }
    },
    "/confirm-locations": {
      "get": {
        "operationId": "getConfirmLocations",
        "parameters": [
          {
            "name": "wizard",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Confirm Locations View Model returned successfully."
          }
        }
      },
      "post": {
        "operationId": "postConfirmLocations",
        "parameters": [
          {
            "name": "wizard",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Redirected based on wizard state."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LocationAvailabilityEditModel": {
        "type": "object",
        "properties": {
          "EmployerAccountId": {
            "type": "string"
          },
          "VacancyId": {
            "type": "string",
            "format": "uuid"
          },
          "SelectedAvailability": {
            "type": "string",
            "enum": [
              "OneLocation",
              "MultipleLocations",
              "AcrossEngland"
            ]
          }
        },
        "required": [
          "EmployerAccountId",
          "VacancyId",
          "SelectedAvailability"
        ]
      },
      "AddMoreThanOneLocationEditModel": {
        "type": "object",
        "properties": {
          "EmployerAccountId": {
            "type": "string"
          },
          "VacancyId": {
            "type": "string",
            "format": "uuid"
          },
          "SelectedLocations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "EmployerAccountId",
          "VacancyId",
          "SelectedLocations"
        ]
      }
    }
  }
}
