{
  "openapi": "3.1.0",
  "info": {
    "title": "Edit Vacancy Dates",
    "version": "1.0.0",
    "description": "API for managing the editing of vacancy dates in the Employer module."
  },
  "paths": {
    "/{EmployerAccountId}/{VacancyId}/edit-dates": {
      "get": {
        "operationId": "getEditVacancyDates",
        "summary": "Get Edit Vacancy Dates",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "The employer's account ID."
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "The ID of the vacancy."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with the vacancy dates data.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string",
                  "description": "HTML content for the edit dates view."
                }
              }
            }
          },
          "400": {
            "description": "Bad request, possibly due to invalid inputs."
          }
        }
      },
      "post": {
        "operationId": "postEditVacancyDates",
        "summary": "Submit Edited Vacancy Dates",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "The employer's account ID."
            }
          },
          {
            "name": "VacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "The ID of the vacancy."
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EditVacancyDatesEditModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect response upon successful submission.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri",
                  "description": "URL to redirect the user after successful submission."
                }
              }
            }
          },
          "400": {
            "description": "Bad request, possibly due to invalid inputs."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VacancyRouteModel": {
        "type": "object",
        "properties": {
          "EmployerAccountId": {
            "type": "string",
            "description": "The employer's account ID."
          },
          "VacancyId": {
            "type": "string",
            "format": "uuid",
            "description": "The ID of the vacancy."
          }
        }
      },
      "EditVacancyDatesEditModel": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/VacancyRouteModel"
          }
        ],
        "properties": {
          "ClosingDay": {
            "type": "string",
            "description": "Day of the closing date."
          },
          "ClosingMonth": {
            "type": "string",
            "description": "Month of the closing date."
          },
          "ClosingYear": {
            "type": "string",
            "description": "Year of the closing date."
          },
          "ClosingDate": {
            "type": "string",
            "nullable": true,
            "description": "The closing date formatted as dd/mm/yyyy."
          },
          "StartDay": {
            "type": "string",
            "description": "Day of the start date."
          },
          "StartMonth": {
            "type": "string",
            "description": "Month of the start date."
          },
          "StartYear": {
            "type": "string",
            "description": "Year of the start date."
          },
          "StartDate": {
            "type": "string",
            "nullable": true,
            "description": "The start date formatted as dd/mm/yyyy."
          },
          "Title": {
            "type": "string",
            "description": "The title of the vacancy."
          }
        }
      }
    }
  }
}
