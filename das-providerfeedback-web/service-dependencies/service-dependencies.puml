@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_providerfeedback_web, "Provider Feedback") {
  Container(c_provider_feedback, "Provider Feedback", "Web Application")
}

SystemDb_Ext(d_cache_redis, "Redis", "Redis")
SystemDb_Ext(d_configuration_store_azure_table_storage_configuration, "Azure Table Storage configuration")
System_Ext(d_http_api_provider_feedback_outer, "Provider Feedback Outer", "HttpClient")
System_Ext(d_identity_provider_dfe_sign_in, "DfE Sign-in")
System_Ext(d_telemetry_application_insights, "Application Insights")

Rel(c_provider_feedback, d_cache_redis, "Caches data in", "Redis")
Rel(c_provider_feedback, d_configuration_store_azure_table_storage_configuration, "Reads configuration from")
Rel(c_provider_feedback, d_http_api_provider_feedback_outer, "Calls the API of", "HttpClient")
Rel(c_provider_feedback, d_identity_provider_dfe_sign_in, "Authenticates with")
Rel(c_provider_feedback, d_telemetry_application_insights, "Sends telemetry to")

@enduml
