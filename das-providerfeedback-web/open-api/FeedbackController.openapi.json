{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Feedback API",
    "version": "1.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "operationId": "GetProviderFeedbackAnnual",
        "summary": "Retrieve provider feedback annual details",
        "description": "Fetch annual feedback details for a provider based on their UKPRN.",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "Bearer token for authorization",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderFeedbackAnnualViewModel"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProviderFeedbackAnnualViewModel": {
        "type": "object",
        "properties": {
          "ShowReviewNotice": {
            "type": "boolean"
          },
          "ReviewNoticeDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "ShowReviewNotice",
          "ReviewNoticeDate"
        ]
      }
    }
  }
}
