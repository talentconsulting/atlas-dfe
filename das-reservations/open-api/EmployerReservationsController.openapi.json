{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Reservations API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{employerAccountId}/reservations/start": {
      "get": {
        "operationId": "GetEmployerStart",
        "tags": [
          "EmployerReservations"
        ],
        "summary": "Get the starting page for employer reservations",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response rendering the employer start HTML page"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/accounts/{employerAccountId}/reservations/select-legal-entity/{id}": {
      "get": {
        "operationId": "GetEmployerSelectLegalEntity",
        "tags": [
          "EmployerReservations"
        ],
        "summary": "Get the page for selecting a legal entity",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response rendering the legal entity selection HTML page"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "operationId": "PostEmployerSelectLegalEntity",
        "tags": [
          "EmployerReservations"
        ],
        "summary": "Submit the selected legal entity",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid",
              "nullable": true
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmLegalEntityViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response processing the selected legal entity"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/accounts/{employerAccountId}/reservations/{id}/select-course": {
      "get": {
        "operationId": "GetEmployerSelectCourse",
        "tags": [
          "EmployerReservations"
        ],
        "summary": "Get the page for selecting a course for a reservation",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response rendering the course selection HTML page"
          }
        }
      },
      "post": {
        "operationId": "PostEmployerSelectCourse",
        "tags": [
          "EmployerReservations"
        ],
        "summary": "Submit the selected course for a reservation",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostSelectCourseViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response processing the selected course"
          },
          "400": {
            "description": "Validation error"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/accounts/{employerAccountId}/reservations/{id}/course-guidance": {
      "get": {
        "operationId": "GetEmployerCourseGuidance",
        "tags": [
          "EmployerReservations"
        ],
        "summary": "Get the page for course guidance",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response rendering the course guidance HTML page"
          }
        }
      }
    },
    "/accounts/{employerAccountId}/reservations/owner-sign-agreement": {
      "get": {
        "operationId": "GetEmployerOwnerSignAgreement",
        "tags": [
          "EmployerReservations"
        ],
        "summary": "Get the page for employer owner to sign the agreement",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response rendering the owner agreement HTML page"
          }
        }
      }
    },
    "/accounts/{employerAccountId}/reservations/transactor-sign-agreement": {
      "get": {
        "operationId": "GetEmployerTransactorSignAgreement",
        "tags": [
          "EmployerReservations"
        ],
        "summary": "Get the page for employer transactor to sign the agreement",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response rendering the transactor agreement HTML page"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConfirmLegalEntityViewModel": {
        "type": "object",
        "properties": {
          "LegalEntity": {
            "type": "string"
          }
        },
        "required": [
          "LegalEntity"
        ]
      },
      "PostSelectCourseViewModel": {
        "type": "object",
        "properties": {
          "SelectedCourseId": {
            "type": "string"
          },
          "ApprenticeTrainingKnown": {
            "type": "boolean",
            "nullable": true
          }
        },
        "required": [
          "ApprenticeTrainingKnown"
        ]
      },
      "ReservationsRouteModel": {
        "type": "object",
        "properties": {
          "UkPrn": {
            "type": "integer",
            "format": "uint32",
            "nullable": true
          },
          "EmployerAccountId": {
            "type": "string"
          },
          "PublicHashedEmployerAccountId": {
            "type": "string"
          },
          "Id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "AccountLegalEntityPublicHashedId": {
            "type": "string"
          },
          "FromReview": {
            "type": "boolean",
            "nullable": true
          },
          "IsFromManage": {
            "type": "boolean",
            "nullable": true
          },
          "IsFromSelect": {
            "type": "boolean",
            "nullable": true
          },
          "PreviousPage": {
            "type": "string"
          },
          "CohortReference": {
            "type": "string",
            "nullable": true
          },
          "ProviderId": {
            "type": "integer",
            "format": "uint32",
            "nullable": true
          },
          "JourneyData": {
            "type": "string",
            "nullable": true
          },
          "SearchTerm": {
            "type": "string",
            "nullable": true
          },
          "SortField": {
            "type": "string",
            "nullable": true
          },
          "ReverseSort": {
            "type": "boolean"
          },
          "UseLearnerData": {
            "type": "boolean",
            "nullable": true
          }
        },
        "required": [
          "EmployerAccountId"
        ]
      }
    }
  }
}
