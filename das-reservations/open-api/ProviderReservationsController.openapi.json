{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Reservations API",
    "version": "1.0.0"
  },
  "paths": {
    "/{ukPrn}/reservations": {
      "get": {
        "operationId": "ProviderIndex",
        "description": "Displays the provider reservations index.",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "isFromManage",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the reservations view."
          },
          "302": {
            "description": "Redirects to another route."
          }
        },
        "security": [
          {
            "providerAccountAuth": []
          }
        ]
      }
    },
    "/{ukPrn}/reservations/start": {
      "get": {
        "operationId": "ProviderStart",
        "description": "Displays the provider reservations start page.",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "isFromManage",
            "in": "query",
            "required": true,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the start view."
          }
        },
        "security": [
          {
            "providerAccountAuth": []
          }
        ]
      }
    },
    "/{ukPrn}/reservations/choose-employer": {
      "get": {
        "operationId": "ProviderChooseEmployer",
        "description": "Displays the page to choose an employer.",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "reverseSort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "sortField",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "searchTerm",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the choose employer view."
          }
        },
        "security": [
          {
            "providerAccountAuth": []
          }
        ]
      }
    },
    "/{ukPrn}/reservations/choose-employer-search": {
      "get": {
        "operationId": "ProviderChooseEmployerSearch",
        "description": "Provides JSON search results for employers.",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "searchTerm",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns JSON search results.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "providerAccountAuth": []
          }
        ]
      }
    },
    "/{ukPrn}/reservations/confirm-employer/{id}": {
      "get": {
        "operationId": "ProviderConfirmEmployer",
        "description": "Displays the confirmation view for an employer.",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the confirm employer view."
          }
        },
        "security": [
          {
            "providerAccountAuth": []
          }
        ]
      },
      "post": {
        "operationId": "ProviderProcessConfirmEmployer",
        "description": "Processes the confirmation of an employer.",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmEmployerViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects the user after processing."
          },
          "400": {
            "description": "Validation error occurred."
          }
        },
        "security": [
          {
            "providerAccountAuth": []
          }
        ]
      }
    },
    "/{ukPrn}/reservations/employer-agreement-not-signed/{id}": {
      "get": {
        "operationId": "ProviderEmployerAgreementNotSigned",
        "description": "Displays the employer agreement not signed view.",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the employer agreement not signed view."
          }
        },
        "security": [
          {
            "providerAccountAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ConfirmEmployerViewModel": {
        "type": "object",
        "properties": {
          "UkPrn": {
            "type": "integer",
            "format": "int64"
          },
          "AccountPublicHashedId": {
            "type": "string"
          },
          "AccountName": {
            "type": "string"
          },
          "AccountLegalEntityPublicHashedId": {
            "type": "string"
          },
          "AccountLegalEntityName": {
            "type": "string"
          },
          "Confirm": {
            "type": "boolean"
          },
          "Id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "UkPrn"
        ]
      },
      "ReservationsRouteModel": {
        "type": "object",
        "properties": {
          "UkPrn": {
            "type": "integer",
            "format": "int64"
          },
          "EmployerAccountId": {
            "type": "string"
          },
          "PublicHashedEmployerAccountId": {
            "type": "string"
          },
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "AccountLegalEntityPublicHashedId": {
            "type": "string"
          },
          "FromReview": {
            "type": "boolean"
          },
          "IsFromManage": {
            "type": "boolean"
          },
          "IsFromSelect": {
            "type": "boolean"
          },
          "PreviousPage": {
            "type": "string"
          },
          "CohortReference": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "JourneyData": {
            "type": "string"
          },
          "SearchTerm": {
            "type": "string"
          },
          "SortField": {
            "type": "string"
          },
          "ReverseSort": {
            "type": "boolean"
          },
          "UseLearnerData": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
      "providerAccountAuth": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}
