{
  "openapi": "3.1.0",
  "info": {
    "title": "Reservations API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{employerAccountId}/reservations/manage": {
      "get": {
        "summary": "Manages reservations for an employer account.",
        "operationId": "EmployerManageReservations",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employer reservations view"
          }
        }
      }
    },
    "/{ukPrn}/reservations/manage": {
      "get": {
        "summary": "Manages reservations for a provider.",
        "operationId": "ProviderManageReservations",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "SearchTerm",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SortField",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ReverseSort",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider reservations view"
          },
          "403": {
            "description": "Unauthorized operation for provider"
          }
        }
      }
    },
    "/{ukPrn}/reservations/{id}/delete": {
      "get": {
        "summary": "Prepares information for deleting a reservation for a provider.",
        "operationId": "ProviderGetDeleteReservation",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reservation delete view"
          }
        }
      },
      "post": {
        "summary": "Deletes a reservation for a provider.",
        "operationId": "ProviderPostDeleteReservation",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect after deletion"
          },
          "400": {
            "description": "Validation error during deletion"
          },
          "500": {
            "description": "Server error during deletion"
          }
        }
      }
    },
    "/accounts/{employerAccountId}/reservations/{id}/delete": {
      "get": {
        "summary": "Prepares information for deleting a reservation for an employer.",
        "operationId": "EmployerGetDeleteReservation",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reservation delete view"
          }
        }
      },
      "post": {
        "summary": "Deletes a reservation for an employer.",
        "operationId": "EmployerPostDeleteReservation",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect after deletion"
          },
          "400": {
            "description": "Validation error during deletion"
          },
          "500": {
            "description": "Server error during deletion"
          }
        }
      }
    },
    "/{ukPrn}/reservations/{id}/delete-completed": {
      "post": {
        "summary": "Handles the actions after a reservation deletion for a provider.",
        "operationId": "ProviderPostDeleteCompletedReservation",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteCompletedViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect after completion"
          },
          "400": {
            "description": "Validation error during completion"
          }
        }
      }
    },
    "/accounts/{employerAccountId}/reservations/{id}/delete-completed": {
      "post": {
        "summary": "Handles the actions after a reservation deletion for an employer.",
        "operationId": "EmployerPostDeleteCompletedReservation",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteCompletedViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect after completion"
          },
          "400": {
            "description": "Validation error during completion"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ReservationsRouteModel": {
        "type": "object",
        "properties": {
          "UkPrn": {
            "type": "integer"
          },
          "EmployerAccountId": {
            "type": "string"
          },
          "PublicHashedEmployerAccountId": {
            "type": "string"
          },
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "AccountLegalEntityPublicHashedId": {
            "type": "string"
          },
          "FromReview": {
            "type": "boolean"
          },
          "IsFromManage": {
            "type": "boolean"
          },
          "IsFromSelect": {
            "type": "boolean"
          },
          "PreviousPage": {
            "type": "string"
          },
          "CohortReference": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer"
          },
          "JourneyData": {
            "type": "string"
          },
          "SearchTerm": {
            "type": "string"
          },
          "SortField": {
            "type": "string"
          },
          "ReverseSort": {
            "type": "boolean"
          },
          "UseLearnerData": {
            "type": "boolean"
          }
        }
      },
      "DeleteViewModel": {
        "type": "object",
        "properties": {
          "UkPrn": {
            "type": "integer"
          },
          "Delete": {
            "type": "boolean"
          },
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "StartDateDescription": {
            "type": "string"
          },
          "CourseDescription": {
            "type": "string"
          },
          "AccountLegalEntityName": {
            "type": "string"
          },
          "LearningType": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "DeleteCompletedViewModel": {
        "type": "object",
        "properties": {
          "Manage": {
            "type": "boolean"
          }
        },
        "required": [
          "Manage"
        ]
      }
    }
  }
}
