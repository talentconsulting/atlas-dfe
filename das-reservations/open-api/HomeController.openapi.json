{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA.DAS.Reservations API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/signout": {
      "get": {
        "operationId": "EmployerSignOut",
        "parameters": [
          {
            "name": "autoSignOut",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful sign-out"
          }
        }
      }
    },
    "/signout": {
      "get": {
        "operationId": "ProviderSignOut",
        "parameters": [
          {
            "name": "autoSignOut",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful sign-out"
          }
        }
      }
    },
    "/service/signout": {
      "get": {
        "operationId": "ServiceSignOut",
        "parameters": [
          {
            "name": "autoSignOut",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful sign-out"
          }
        }
      }
    },
    "/p-signed-out": {
      "get": {
        "operationId": "ProviderSignedOut",
        "responses": {
          "200": {
            "description": "Provider signed out successfully"
          }
        }
      }
    },
    "/signoutcleanup": {
      "get": {
        "operationId": "SignOutCleanup",
        "responses": {
          "204": {
            "description": "Successful sign-out cookie cleanup"
          }
        }
      }
    },
    "/{employerAccountId}/service/password/change": {
      "get": {
        "operationId": "EmployerChangePassword",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userCancelled",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to employer index route"
          }
        }
      }
    },
    "/{employerAccountId}/service/email/change": {
      "get": {
        "operationId": "EmployerChangeEmail",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userCancelled",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to employer index route"
          }
        }
      }
    },
    "/{ukPrn}/notAvailable": {
      "get": {
        "operationId": "ProviderFeatureNotAvailable",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider feature not available page"
          }
        }
      }
    },
    "/accounts/{employerAccountId}/notAvailable": {
      "get": {
        "operationId": "EmployerFeatureNotAvailable",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employer feature not available page"
          }
        }
      }
    },
    "/dashboard": {
      "get": {
        "operationId": "Dashboard",
        "responses": {
          "301": {
            "description": "Redirects permanently to the dashboard URL"
          }
        }
      }
    },
    "/SignIn-Stub": {
      "get": {
        "operationId": "SigninStubGet",
        "responses": {
          "200": {
            "description": "Returns the SignIn Stub View"
          }
        }
      },
      "post": {
        "operationId": "SigninStubPost",
        "responses": {
          "302": {
            "description": "Redirects to the signed-in-stub route"
          }
        }
      }
    },
    "/signed-in-stub": {
      "get": {
        "operationId": "SignedInStub",
        "responses": {
          "200": {
            "description": "Returns the signed-in-stub page"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ReservationsRouteModel": {
        "type": "object",
        "description": "Model for route parameters specific to reservations",
        "properties": {}
      }
    }
  }
}
