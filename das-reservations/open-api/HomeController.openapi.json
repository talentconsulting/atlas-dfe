{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS Reservations Web API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/signout": {
      "get": {
        "operationId": "EmployerSignOut",
        "parameters": [
          {
            "name": "autoSignOut",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully signed out."
          }
        }
      }
    },
    "/signout": {
      "get": {
        "operationId": "ProviderSignOut",
        "parameters": [
          {
            "name": "autoSignOut",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully signed out."
          }
        }
      }
    },
    "/service/signout": {
      "get": {
        "operationId": "ServiceSignOut",
        "parameters": [
          {
            "name": "autoSignOut",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully signed out."
          }
        }
      }
    },
    "/p-signed-out": {
      "get": {
        "operationId": "ProviderSignedOut",
        "responses": {
          "200": {
            "description": "Provider signed out or redirected to dashboard.",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/signoutcleanup": {
      "get": {
        "operationId": "SignOutCleanup",
        "responses": {
          "204": {
            "description": "Cookies were deleted successfully."
          }
        }
      }
    },
    "/{employerAccountId}/service/password/change": {
      "get": {
        "operationId": "EmployerChangePassword",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userCancelled",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirected successfully."
          }
        }
      }
    },
    "/{employerAccountId}/service/email/change": {
      "get": {
        "operationId": "EmployerChangeEmail",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userCancelled",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirected successfully."
          }
        }
      }
    },
    "/{ukPrn}/notAvailable": {
      "get": {
        "operationId": "ProviderFeatureNotAvailable",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Feature not available view rendered.",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/accounts/{employerAccountId}/notAvailable": {
      "get": {
        "operationId": "EmployerFeatureNotAvailable",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Feature not available view rendered.",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/dashboard": {
      "get": {
        "operationId": "DashboardRedirect",
        "responses": {
          "301": {
            "description": "Redirected to permanent dashboard URL."
          }
        }
      }
    },
    "/SignIn-Stub": {
      "get": {
        "operationId": "SigninStub",
        "responses": {
          "200": {
            "description": "Signin stub view rendered."
          }
        }
      },
      "post": {
        "operationId": "SigninStubPost",
        "responses": {
          "302": {
            "description": "Redirected successfully to the signed-in stub route."
          }
        }
      }
    },
    "/signed-in-stub": {
      "get": {
        "operationId": "SignedInStub",
        "responses": {
          "200": {
            "description": "Signed-in stub view rendered."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AutoSignOutViewModel": {
        "type": "object",
        "properties": {
          "dashboardUrl": {
            "type": "string"
          }
        }
      },
      "ReservationsRouteModel": {
        "type": "object",
        "properties": {
          "employerAccountId": {
            "type": "string"
          }
        },
        "required": [
          "employerAccountId"
        ]
      },
      "StubAuthUserDetails": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "id"
        ]
      }
    }
  }
}
