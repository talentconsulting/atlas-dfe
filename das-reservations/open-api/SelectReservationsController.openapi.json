{
  "openapi": "3.1.0",
  "info": {
    "title": "Select Reservations API",
    "version": "1.0.0"
  },
  "paths": {
    "/{ukPrn}/reservations/{accountLegalEntityPublicHashedId}/select": {
      "get": {
        "summary": "Select a reservation (provider route)",
        "operationId": "GetProviderReservationSelection",
        "security": [
          {
            "OAuth2": []
          }
        ],
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "accountLegalEntityPublicHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response returning the reservation selection view."
          },
          "500": {
            "description": "Server error."
          }
        }
      },
      "post": {
        "summary": "Submit reservation selection (provider route)",
        "operationId": "PostProviderReservationSelection",
        "security": [
          {
            "OAuth2": []
          }
        ],
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "accountLegalEntityPublicHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectReservationViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully submitted reservation."
          },
          "400": {
            "description": "Validation error."
          },
          "500": {
            "description": "Server error."
          }
        }
      }
    },
    "/accounts/{employerAccountId}/reservations/{accountLegalEntityPublicHashedId}/select": {
      "get": {
        "summary": "Select a reservation (employer route)",
        "operationId": "GetEmployerReservationSelection",
        "security": [
          {
            "OAuth2": []
          }
        ],
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accountLegalEntityPublicHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response returning the reservation selection view."
          },
          "500": {
            "description": "Server error."
          }
        }
      },
      "post": {
        "summary": "Submit reservation selection (employer route)",
        "operationId": "PostEmployerReservationSelection",
        "security": [
          {
            "OAuth2": []
          }
        ],
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accountLegalEntityPublicHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectReservationViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully submitted reservation."
          },
          "400": {
            "description": "Validation error."
          },
          "500": {
            "description": "Server error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SelectReservationViewModel": {
        "type": "object",
        "properties": {
          "CohortReference": {
            "type": "string"
          },
          "TransferSenderId": {
            "type": "string"
          },
          "EncodedPledgeApplicationId": {
            "type": "string"
          },
          "JourneyData": {
            "type": "string"
          },
          "SelectedReservationId": {
            "type": "string",
            "format": "uuid"
          },
          "AvailableReservations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailableReservationViewModel"
            }
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "BackLink": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer"
          },
          "MoreReservationsAvailable": {
            "type": "boolean"
          },
          "ApprenticeshipSessionKey": {
            "type": "string",
            "format": "uuid"
          },
          "BeforeProviderSelected": {
            "type": "boolean"
          }
        }
      },
      "AvailableReservationViewModel": {
        "type": "object",
        "properties": {
          "ReservationId": {
            "type": "string",
            "format": "uuid"
          },
          "CourseDescription": {
            "type": "string"
          },
          "TrainingDateDescription": {
            "type": "string"
          },
          "CreatedDateDescription": {
            "type": "string"
          }
        }
      }
    }
  }
}
