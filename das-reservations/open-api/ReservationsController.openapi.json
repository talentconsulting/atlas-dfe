  "components": {
    "schemas": {
      "FundingRestrictionNotificationViewModel": {
        "type": "object",
        "properties": {
          "RuleId": {
            "type": "integer",
            "format": "int64"
          },
          "TypeOfRule": {
            "$ref": "#/components/schemas/RuleType"
          },
          "RestrictionStartDate": {
            "type": "string",
            "format": "date-time"
          },
          "BackLink": {
            "type": "string"
          },
          "RouteName": {
            "type": "string"
          },
          "IsProvider": {
            "type": "boolean"
          },
          "PostRouteName": {
            "type": "string"
          },
          "MarkRuleAsRead": {
            "type": "boolean"
          }
        },
        "required": [
          "RuleId",
          "TypeOfRule",
          "RouteName",
          "MarkRuleAsRead"
        ]
      },
      "CompletedViewModel": {
        "type": "object",
        "properties": {
          "WhatsNext": {
            "$ref": "#/components/schemas/CompletedReservationWhatsNext"
          },
          "TrainingDateDescription": {
            "type": "string"
          },
          "CourseDescription": {
            "type": "string"
          },
          "LearningType": {
            "type": "string"
          },
          "AccountLegalEntityName": {
            "type": "string"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "CourseId": {
            "type": "string"
          },
          "UkPrn": {
            "type": "integer",
            "format": "int64"
          },
          "CohortRef": {
            "type": "string"
          },
          "JourneyData": {
            "type": "string"
          },
          "UseLearnerData": {
            "type": "boolean"
          },
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "AccountLegalEntityPublicHashedId": {
            "type": "string"
          },
          "FindApprenticeshipTrainingUrl": {
            "type": "string"
          },
          "AddAnApprenticeUrl": {
            "type": "string"
          },
          "HomepageUrl": {
            "type": "string"
          },
          "RecruitUrl": {
            "type": "string"
          }
        },
        "required": [
          "WhatsNext",
          "Id",
          "AccountLegalEntityPublicHashedId"
        ]
      },
      "RuleType": {
        "type": "string",
        "enum": [
          "None",
          "CourseRule",
          "GlobalRule"
        ]
      },
      "CompletedReservationWhatsNext": {
        "type": "string",
        "enum": [
          "Homepage",
          "RecruitAnApprentice",
          "AddAnApprentice",
          "FindApprenticeshipTraining"
        ]
      }
    }
  }
