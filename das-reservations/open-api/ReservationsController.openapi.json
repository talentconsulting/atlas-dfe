  "components": {
    "schemas": {
      "ApprenticeshipTrainingFormModel": {
        "type": "object",
        "properties": {
          "StartDate": {
            "type": "string",
            "description": "The start date of the apprenticeship training."
          },
          "SelectedCourseId": {
            "type": "string",
            "description": "The ID of the selected course."
          },
          "AccountLegalEntityPublicHashedId": {
            "type": "string",
            "description": "The public hashed ID of the account legal entity."
          },
          "CohortRef": {
            "type": "string",
            "description": "The reference for the cohort."
          },
          "FromReview": {
            "type": "boolean",
            "description": "Flag indicating if the form was submitted from the review page."
          }
        }
      },
      "FundingRestrictionNotificationViewModel": {
        "type": "object",
        "properties": {
          "RuleId": {
            "type": "integer",
            "description": "The ID of the rule being notified."
          },
          "TypeOfRule": {
            "type": "string",
            "description": "The type of rule being notified."
          },
          "MarkRuleAsRead": {
            "type": "boolean",
            "description": "Flag indicating if the rule notification should be marked as read."
          },
          "RouteName": {
            "type": "string",
            "description": "The name of the route to redirect after the notification has been read."
          }
        }
      },
      "PostReviewViewModel": {
        "type": "object",
        "properties": {
          "TrainingDate": {
            "$ref": "#/components/schemas/TrainingDateModel",
            "description": "The training date selected or reviewed."
          },
          "CourseDescription": {
            "type": "string",
            "description": "The description of the selected course."
          },
          "AccountLegalEntityName": {
            "type": "string",
            "description": "The name of the associated account legal entity."
          },
          "AccountLegalEntityPublicHashedId": {
            "type": "string",
            "description": "The public hashed ID of the associated account legal entity."
          },
          "LearningType": {
            "type": "string",
            "description": "The type of learning involved."
          }
        }
      },
      "TrainingDateModel": {
        "type": "object",
        "properties": {
          "StartDate": {
            "type": "string",
            "format": "date-time",
            "description": "Start date of the training."
          },
          "EndDate": {
            "type": "string",
            "format": "date-time",
            "description": "End date of the training."
          }
        }
      }
    }
  }
}
