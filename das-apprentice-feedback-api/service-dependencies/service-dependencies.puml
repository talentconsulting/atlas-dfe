@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_apprentice_feedback_api, "Apprentice Feedback") {
  Container(c_apprentice_feedback, "Apprentice Feedback", "API")
}

SystemDb_Ext(d_configuration_store_azure_app_configuration, "Azure App Configuration")
SystemDb_Ext(d_database_apprentice_feedback_database, "Apprentice Feedback Database", "SQL Server")
System_Ext(d_identity_provider_microsoft_entra_id, "Microsoft Entra ID")
SystemQueue_Ext(d_message_broker_azure_service_bus, "Azure Service Bus", "Azure Service Bus")
System_Ext(d_telemetry_application_insights, "Application Insights")

Rel(c_apprentice_feedback, d_configuration_store_azure_app_configuration, "Reads configuration from")
Rel(c_apprentice_feedback, d_database_apprentice_feedback_database, "Reads from and writes to", "SQL Server")
Rel(c_apprentice_feedback, d_identity_provider_microsoft_entra_id, "Authenticates with")
Rel(c_apprentice_feedback, d_message_broker_azure_service_bus, "Publishes messages to and consumes messages from", "Azure Service Bus")
Rel(c_apprentice_feedback, d_telemetry_application_insights, "Sends telemetry to")

@enduml
