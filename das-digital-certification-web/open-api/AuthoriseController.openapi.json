{
  "openapi": "3.1.0",
  "info": {
    "title": "Authorise API",
    "version": "1.0.0"
  },
  "paths": {
    "/authorise/need-more-information": {
      "get": {
        "operationId": "NeedMoreInformation",
        "summary": "Displays the need-more-information page",
        "security": [
          {
            "VerifiedAndNotUlnAuthorised": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully rendered the Need More Information page."
          },
          "302": {
            "description": "Redirected to the Not Found page."
          }
        }
      },
      "post": {
        "operationId": "NeedMoreInformationContinue",
        "summary": "Proceeds from the need-more-information page",
        "security": [
          {
            "VerifiedAndNotUlnAuthorised": []
          }
        ],
        "responses": {
          "302": {
            "description": "Redirected to the Know Your ULN page."
          }
        }
      }
    },
    "/authorise/know-your-uln": {
      "get": {
        "operationId": "KnowYourUlnGet",
        "summary": "Displays the know-your-uln page",
        "security": [
          {
            "VerifiedAndNotUlnAuthorised": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully rendered the Know Your ULN page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowYourUlnViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "KnowYourUlnPost",
        "summary": "Handles submission for the know-your-uln page",
        "security": [
          {
            "VerifiedAndNotUlnAuthorised": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KnowYourUlnViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirected based on match outcome.",
            "content": {}
          }
        }
      }
    },
    "/authorise/select-course": {
      "get": {
        "operationId": "SelectCourseGet",
        "summary": "Displays the select-course page",
        "security": [
          {
            "VerifiedAndNotUlnAuthorised": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully rendered the Select Course page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectCourseViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirected to the Not Found page."
          }
        }
      },
      "post": {
        "operationId": "SelectCoursePost",
        "summary": "Handles submission for the select-course page",
        "security": [
          {
            "VerifiedAndNotUlnAuthorised": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectCourseViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirected based on match outcome."
          }
        }
      }
    },
    "/authorise/select-provider": {
      "get": {
        "operationId": "SelectProviderGet",
        "summary": "Displays the select-provider page",
        "security": [
          {
            "VerifiedAndNotUlnAuthorised": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully rendered the Select Provider page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectProviderViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirected to the Not Found page."
          }
        }
      },
      "post": {
        "operationId": "SelectProviderPost",
        "summary": "Handles submission for the select-provider page",
        "security": [
          {
            "VerifiedAndNotUlnAuthorised": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectProviderViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirected to the Check Answers page."
          }
        }
      }
    },
    "/authorise/know-year": {
      "get": {
        "operationId": "KnowYearGet",
        "summary": "Displays the know-year page",
        "security": [
          {
            "VerifiedAndNotUlnAuthorised": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully rendered the Know Year page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowYearViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirected to the Need More Information page."
          }
        }
      },
      "post": {
        "operationId": "KnowYearPost",
        "summary": "Handles submission for the know-year page",
        "security": [
          {
            "VerifiedAndNotUlnAuthorised": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KnowYearViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirected based on the user's selection."
          }
        }
      }
    },
    "/authorise/check-answers": {
      "get": {
        "operationId": "CheckAnswersGet",
        "summary": "Displays the check-answers page",
        "security": [
          {
            "VerifiedAndNotUlnAuthorised": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully rendered the Check Answers page."
          },
          "302": {
            "description": "Redirected to the Need More Information page."
          }
        }
      },
      "post": {
        "operationId": "CheckAnswersPost",
        "summary": "Handles submission for the check-answers page",
        "security": [
          {
            "VerifiedAndNotUlnAuthorised": []
          }
        ],
        "responses": {
          "302": {
            "description": "Redirected based on match outcome."
          }
        }
      }
    },
    "/authorise/cannot-match": {
      "get": {
        "operationId": "CannotMatch",
        "summary": "Displays the cannot-match page",
        "responses": {
          "200": {
            "description": "Successfully rendered the Cannot Match page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CannotMatchViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirected to certificates list or access denied page."
          }
        }
      }
    },
    "/authorise/not-found": {
      "get": {
        "operationId": "NotFoundPage",
        "summary": "Displays the not-found page",
        "responses": {
          "200": {
            "description": "Successfully rendered the Not Found page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CannotMatchViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirected to certificates list or access denied page."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "KnowYearViewModel": {
        "type": "object",
        "properties": {
          "knowYear": {
            "type": "boolean",
            "nullable": true
          },
          "yearCompleted": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "providerSelected": {
            "type": "boolean"
          },
          "isReturningToCheck": {
            "type": "boolean"
          },
          "isShortJourney": {
            "type": "boolean"
          }
        },
        "required": [
          "providerSelected",
          "isReturningToCheck",
          "isShortJourney"
        ]
      },
      "KnowYourUlnViewModel": {
        "type": "object",
        "properties": {
          "knowUln": {
            "type": "boolean",
            "nullable": true
          },
          "uln": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "isReturningToCheck": {
            "type": "boolean"
          },
          "isShortJourney": {
            "type": "boolean"
          }
        },
        "required": [
          "isReturningToCheck",
          "isShortJourney"
        ]
      },
      "SelectCourseViewModel": {
        "type": "object",
        "properties": {
          "selectedCourseCode": {
            "type": "string",
            "nullable": true
          },
          "courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CourseOption"
            },
            "nullable": true
          },
          "isReturningToCheck": {
            "type": "boolean"
          },
          "isShortJourney": {
            "type": "boolean"
          }
        },
        "required": [
          "isReturningToCheck",
          "isShortJourney"
        ],
        "components": {
          "CourseOption": {
            "type": "object",
            "properties": {
              "courseCode": {
                "type": "string"
              },
              "courseName": {
                "type": "string"
              },
              "courseLevel": {
                "type": "string",
                "nullable": true
              },
              "certificateType": {
                "$ref": "#/components/schemas/CertificateType"
              }
            },
            "required": [
              "courseCode",
              "courseName",
              "certificateType"
            ]
          }
        }
      },
      "SelectProviderViewModel": {
        "type": "object",
        "properties": {
          "selectedProviderName": {
            "type": "string",
            "nullable": true
          },
          "selectedProviderUnknown": {
            "type": "boolean",
            "nullable": true
          },
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderOption"
            },
            "nullable": true
          },
          "isReturningToCheck": {
            "type": "boolean"
          },
          "isShortJourney": {
            "type": "boolean"
          }
        },
        "required": [
          "isReturningToCheck",
          "isShortJourney"
        ],
        "components": {
          "ProviderOption": {
            "type": "object",
            "properties": {
              "ukprn": {
                "type": "integer",
                "format": "int64",
                "nullable": true
              },
              "providerName": {
                "type": "string"
              }
            },
            "required": [
              "providerName"
            ]
          }
        }
      },
      "CannotMatchViewModel": {
        "type": "object",
        "properties": {
          "referenceNumber": {
            "type": "string"
          }
        },
        "required": [
          "referenceNumber"
        ]
      },
      "CertificateType": {
        "type": "string",
        "enum": [
          "Unknown",
          "Standard",
          "Framework"
        ]
      }
    },
    "securitySchemes": {
      "VerifiedAndNotUlnAuthorised": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
