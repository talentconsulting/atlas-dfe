{
  "openapi": "3.1.0",
  "info": {
    "title": "Digital Certificates API - Locations Controller",
    "version": "1.0.0"
  },
  "paths": {
    "/locations": {
      "get": {
        "summary": "Search locations by term",
        "description": "Returns a list of locations matching the search term.",
        "operationId": "getLocations",
        "parameters": [
          {
            "name": "searchTerm",
            "in": "query",
            "required": false,
            "description": "The term to search for locations.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of matching locations.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "locations": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Location"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "PolicyNames.IsVerified": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Location": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the location."
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "securitySchemes": {
      "PolicyNames.IsVerified": {
        "type": "oauth2",
        "description": "Policy for verified access.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/auth",
            "tokenUrl": "https://example.com/token",
            "scopes": {}
          }
        }
      }
    }
  }
}
