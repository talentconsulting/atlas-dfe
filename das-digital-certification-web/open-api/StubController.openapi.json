{
  "openapi": "3.1.0",
  "info": {
    "title": "StubController API",
    "version": "1.0.0",
    "description": "API for handling stub-based authentication flows in DAS Digital Certificates."
  },
  "paths": {
    "/stub/sign-in-stub": {
      "get": {
        "operationId": "getSignInStub",
        "summary": "Render the sign-in stub view.",
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "The URL to which the user will be redirected after signing in."
          }
        ],
        "responses": {
          "200": {
            "description": "The sign-in stub view rendered.",
            "content": {
              "text/html": {}
            }
          }
        }
      },
      "post": {
        "operationId": "postSignInStub",
        "summary": "Handle sign-in stub submissions.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/SignInStubViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to another route.",
            "headers": {
              "Location": {
                "description": "The route to which the user is redirected after processing the sign-in stub.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/stub/signed-in-stub": {
      "get": {
        "operationId": "getSignedInStub",
        "summary": "Render the signed-in stub view.",
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "The URL to which the user will proceed after being signed in."
          }
        ],
        "responses": {
          "200": {
            "description": "The signed-in stub view rendered.",
            "content": {
              "text/html": {}
            }
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "SignInStubViewModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "nullable": true,
            "description": "ID of the stub user."
          },
          "Email": {
            "type": "string",
            "nullable": true,
            "description": "Email address of the stub user."
          },
          "Phone": {
            "type": "string",
            "nullable": true,
            "description": "Phone number of the stub user."
          },
          "UserFile": {
            "type": "string",
            "format": "binary",
            "nullable": true,
            "description": "File uploaded by the stub user."
          },
          "ReturnUrl": {
            "type": "string",
            "nullable": true,
            "description": "The URL to redirect to after sign-in."
          }
        }
      },
      "Name": {
        "type": "object",
        "properties": {
          "ValidSince": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "The date from which the name is valid."
          },
          "ValidUntil": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "The date until which the name is valid."
          },
          "FamilyName": {
            "type": "string",
            "description": "Family name of the user."
          },
          "GivenNames": {
            "type": "string",
            "description": "Given names of the user."
          }
        },
        "required": [
          "FamilyName",
          "GivenNames"
        ]
      }
    },
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "name": ".AspNetCore.Cookies",
        "in": "cookie"
      }
    }
  }
}
