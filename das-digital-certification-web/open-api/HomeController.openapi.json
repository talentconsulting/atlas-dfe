{
  "openapi": "3.1.0",
  "info": {
    "title": "Digital Certificates API",
    "version": "1.0.0"
  },
  "paths": {
    "/start-page": {
      "get": {
        "operationId": "StartPageRouteGet",
        "summary": "Start Page",
        "description": "Displays the start page or redirects to the external start page if configured.",
        "responses": {
          "302": {
            "description": "Redirects to an external start page URL if specified."
          },
          "200": {
            "description": "Start page.",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/check": {
      "get": {
        "operationId": "CheckRouteGet",
        "summary": "Check",
        "description": "Displays a check view for authorized users.",
        "security": [
          {
            "Authorization": []
          }
        ],
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "/"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Check page.",
            "content": {
              "text/html": {}
            }
          }
        }
      },
      "post": {
        "operationId": "CheckRoutePost",
        "summary": "Check Continue",
        "description": "Handles form submissions and redirects users accordingly.",
        "security": [
          {
            "Authorization": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "returnUrl": {
                    "type": "string",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to verify identity service."
          }
        }
      }
    },
    "/verified": {
      "get": {
        "operationId": "VerifiedRouteGet",
        "summary": "Verified",
        "description": "Redirects verified users to a certificates list.",
        "security": [
          {
            "Authorization": []
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to the certificates list route."
          }
        }
      }
    },
    "/cookies": {
      "get": {
        "operationId": "CookiesRouteGet",
        "summary": "Cookies",
        "description": "Displays cookie preferences and consent status.",
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cookies view.",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/help": {
      "get": {
        "operationId": "HelpRouteGet",
        "summary": "Help",
        "description": "Displays a help page with a back URL.",
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Help page.",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/cookie-details": {
      "get": {
        "operationId": "CookieDetailsRouteGet",
        "summary": "Cookie Details",
        "description": "Displays cookie details.",
        "responses": {
          "200": {
            "description": "Cookie details view.",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/accessibility-statement": {
      "get": {
        "operationId": "AccessibilityStatementRouteGet",
        "summary": "Accessibility Statement",
        "description": "Displays an accessibility statement with a back URL.",
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Accessibility statement page.",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/error": {
      "get": {
        "operationId": "ErrorRouteGet",
        "summary": "Error",
        "description": "Handles application errors and logs exceptions.",
        "responses": {
          "500": {
            "description": "Error page with a problem reference.",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/error/session-expired": {
      "get": {
        "operationId": "AntiforgeryRouteGet",
        "summary": "Session Expired",
        "description": "Displays an antiforgery error page.",
        "responses": {
          "200": {
            "description": "Session expired page.",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Name": {
        "type": "object",
        "properties": {
          "ValidSince": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "ValidUntil": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "FamilyName": {
            "type": "string"
          },
          "GivenNames": {
            "type": "string"
          }
        },
        "required": [
          "FamilyName",
          "GivenNames"
        ]
      }
    }
  }
}
