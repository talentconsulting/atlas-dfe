{
  "openapi": "3.1.0",
  "info": {
    "title": "Digital Certificates API",
    "version": "1.0.0",
    "description": "API for managing digital certification operations, including certificate sharing, delivery request, and related services."
  },
  "paths": {
    "/certificates/list": {
      "get": {
        "operationId": "CertificatesListRouteGet",
        "summary": "Retrieve list of certificates.",
        "security": [
          {
            "DigitalCertificatesPolicyNames.IsUlnAuthorised": []
          }
        ],
        "responses": {
          "200": {
            "description": "Certificate list fetched successfully."
          }
        }
      }
    },
    "/certificates/{certificateId}/standard": {
      "get": {
        "operationId": "CertificateStandardRouteGet",
        "summary": "Fetch standard certificate details.",
        "parameters": [
          {
            "name": "certificateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "DigitalCertificatesPolicyNames.IsCertificateOwner": []
          }
        ],
        "responses": {
          "200": {
            "description": "Standard certificate details retrieved successfully."
          }
        }
      }
    },
    "/certificates/{certificateId}/framework": {
      "get": {
        "operationId": "CertificateFrameworkRouteGet",
        "summary": "Fetch framework certificate details.",
        "parameters": [
          {
            "name": "certificateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "DigitalCertificatesPolicyNames.IsCertificateOwner": []
          }
        ],
        "responses": {
          "200": {
            "description": "Framework certificate details retrieved successfully."
          }
        }
      }
    },
    "/certificates/{certificateId}/standard/download": {
      "get": {
        "operationId": "DownloadCertificateStandardPdfRouteGet",
        "summary": "Download standard certificate as PDF.",
        "parameters": [
          {
            "name": "certificateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "DigitalCertificatesPolicyNames.IsCertificateOwner": []
          }
        ],
        "responses": {
          "200": {
            "description": "Standard certificate PDF downloaded successfully."
          }
        }
      }
    },
    "/certificates/{certificateId}/framework/download": {
      "get": {
        "operationId": "DownloadCertificateFrameworkPdfRouteGet",
        "summary": "Download framework certificate as PDF.",
        "parameters": [
          {
            "name": "certificateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "DigitalCertificatesPolicyNames.IsCertificateOwner": []
          }
        ],
        "responses": {
          "200": {
            "description": "Framework certificate PDF downloaded successfully."
          }
        }
      }
    },
    "/certificates/{certificateId}/delivery-request/add-address": {
      "get": {
        "operationId": "AddAddressRouteGet",
        "summary": "Get form for adding a new delivery address.",
        "parameters": [
          {
            "name": "certificateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "backRoute",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "DigitalCertificatesPolicyNames.IsCertificateOwner": []
          }
        ],
        "responses": {
          "200": {
            "description": "Form fetched successfully."
          }
        }
      },
      "post": {
        "operationId": "AddAddressRoutePost",
        "summary": "Add a new delivery address.",
        "parameters": [
          {
            "name": "certificateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddAddressManualViewModel"
              }
            }
          }
        },
        "security": [
          {
            "DigitalCertificatesPolicyNames.IsCertificateOwner": []
          }
        ],
        "responses": {
          "200": {
            "description": "Address added successfully."
          }
        }
      }
    },
    "/certificates/{certificateId}/delivery-request/select-address": {
      "get": {
        "operationId": "SelectAddressRouteGet",
        "summary": "Get form for selecting a delivery address.",
        "parameters": [
          {
            "name": "certificateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "DigitalCertificatesPolicyNames.IsCertificateOwner": []
          }
        ],
        "responses": {
          "200": {
            "description": "Form fetched successfully."
          }
        }
      },
      "post": {
        "operationId": "SelectAddressRoutePost",
        "summary": "Submit selected delivery address.",
        "parameters": [
          {
            "name": "certificateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectAddressViewModel"
              }
            }
          }
        },
        "security": [
          {
            "DigitalCertificatesPolicyNames.IsCertificateOwner": []
          }
        ],
        "responses": {
          "200": {
            "description": "Address selected successfully."
          }
        }
      }
    },
    "/certificates/{certificateId}/contact/create": {
      "post": {
        "operationId": "ContactUsForCertificateCreateRoutePost",
        "summary": "Create a contact request for a certificate.",
        "parameters": [
          {
            "name": "certificateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "DigitalCertificatesPolicyNames.IsCertificateOwner": []
          }
        ],
        "responses": {
          "200": {
            "description": "Contact request created successfully."
          }
        }
      }
    },
    "/certificates/{certificateId}/sharing/{sharingId}/send-email": {
      "post": {
        "operationId": "ShareByEmailRoutePost",
        "summary": "Send certificate sharing via email.",
        "parameters": [
          {
            "name": "certificateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "sharingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShareByEmailViewModel"
              }
            }
          }
        },
        "security": [
          {
            "DigitalCertificatesPolicyNames.IsCertificateOwner": []
          }
        ],
        "responses": {
          "200": {
            "description": "Email sharing request processed successfully."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddAddressManualViewModel": {
        "type": "object",
        "properties": {
          "certificateId": {
            "type": "string",
            "format": "uuid"
          },
          "courseName": {
            "type": "string",
            "nullable": true
          },
          "givenNames": {
            "type": "string",
            "nullable": true
          },
          "familyName": {
            "type": "string",
            "nullable": true
          },
          "backRoute": {
            "type": "string",
            "nullable": true
          },
          "organisation": {
            "type": "string",
            "nullable": true
          },
          "addressLine1": {
            "type": "string",
            "nullable": true
          },
          "addressLine2": {
            "type": "string",
            "nullable": true
          },
          "townOrCity": {
            "type": "string",
            "nullable": true
          },
          "county": {
            "type": "string",
            "nullable": true
          },
          "postcode": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "SelectAddressViewModel": {
        "type": "object",
        "properties": {
          "certificateId": {
            "type": "string",
            "format": "uuid"
          },
          "courseName": {
            "type": "string",
            "nullable": true
          },
          "givenNames": {
            "type": "string",
            "nullable": true
          },
          "familyName": {
            "type": "string",
            "nullable": true
          },
          "searchTerm": {
            "type": "string",
            "nullable": true
          },
          "selectedAddress": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ShareByEmailViewModel": {
        "type": "object",
        "properties": {
          "emailAddress": {
            "type": "string",
            "nullable": true
          }
        }
      }
    },
    "securitySchemes": {
      "DigitalCertificatesPolicyNames.IsCertificateOwner": {
        "type": "http",
        "scheme": "bearer"
      },
      "DigitalCertificatesPolicyNames.IsUlnAuthorised": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
