@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_digital_certification_web, "Digital Certificates") {
  Container(c_digital_certificates, "Digital Certificates", "Web Application")
}

SystemDb_Ext(d_cache_redis_cache, "Redis Cache", "StackExchange.Redis")
SystemDb_Ext(d_cache_redis_data_protection, "Redis Data Protection", "StackExchange.Redis")
System_Ext(d_cloud_service_azure_monitor, "Azure Monitor", "Azure.Monitor.OpenTelemetry.AspNetCore")
System_Ext(d_http_api_digital_certificates_outer_api, "Digital Certificates Outer API", "RestEase")
SystemDb_Ext(d_object_storage_azure_blob_storage, "Azure Blob Storage", "Azure.Storage.Blobs")

Rel(c_digital_certificates, d_cache_redis_cache, "Caches data in", "StackExchange.Redis")
Rel(c_digital_certificates, d_cache_redis_data_protection, "Caches data in", "StackExchange.Redis")
Rel(c_digital_certificates, d_cloud_service_azure_monitor, "Uses", "Azure.Monitor.OpenTelemetry.AspNetCore")
Rel(c_digital_certificates, d_http_api_digital_certificates_outer_api, "Calls the API of", "RestEase")
Rel(c_digital_certificates, d_object_storage_azure_blob_storage, "Stores objects in", "Azure.Storage.Blobs")

@enduml
