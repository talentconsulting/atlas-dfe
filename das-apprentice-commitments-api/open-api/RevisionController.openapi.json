{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Commitments API",
    "version": "1.0.0",
    "description": "API for managing apprentice commitments, revisions, and confirmations."
  },
  "paths": {
    "/apprentices/{apprenticeId}/apprenticeships/{apprenticeshipId}/revisions/{revisionId}": {
      "patch": {
        "summary": "Update a revision for an apprenticeship",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the apprentice"
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Unique identifier for the apprenticeship"
          },
          {
            "name": "revisionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Unique identifier for the revision"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonPatchDocument_Revision"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Revision successfully updated"
          },
          "400": {
            "description": "Invalid request"
          }
        }
      },
      "get": {
        "summary": "Retrieve details of a single revision for an apprenticeship",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the apprentice"
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Unique identifier for the apprenticeship"
          },
          {
            "name": "revisionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Unique identifier for the revision"
          }
        ],
        "responses": {
          "200": {
            "description": "Revision retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Revision"
                }
              }
            }
          },
          "404": {
            "description": "Revision not found"
          }
        }
      }
    },
    "/apprentices/{apprenticeId}/apprenticeships/{apprenticeshipId}/revisions/{revisionId}/confirmations": {
      "patch": {
        "summary": "Confirm details related to a revision",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the apprentice"
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Unique identifier for the apprenticeship"
          },
          {
            "name": "revisionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Unique identifier for the revision"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Confirmations"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Details successfully confirmed"
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Revision": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "apprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "employerCorrect": {
            "type": "boolean"
          },
          "trainingProviderCorrect": {
            "type": "boolean"
          },
          "apprenticeshipDetailsCorrect": {
            "type": "boolean"
          },
          "rolesAndResponsibilitiesConfirmations": {
            "$ref": "#/components/schemas/RolesAndResponsibilitiesConfirmations"
          },
          "howApprenticeshipDeliveredCorrect": {
            "type": "boolean"
          },
          "confirmedOn": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Confirmations": {
        "type": "object",
        "properties": {
          "employerCorrect": {
            "type": "boolean",
            "nullable": true
          },
          "trainingProviderCorrect": {
            "type": "boolean",
            "nullable": true
          },
          "apprenticeshipDetailsCorrect": {
            "type": "boolean",
            "nullable": true
          },
          "rolesAndResponsibilitiesConfirmations": {
            "$ref": "#/components/schemas/RolesAndResponsibilitiesConfirmations"
          },
          "howApprenticeshipDeliveredCorrect": {
            "type": "boolean",
            "nullable": true
          },
          "apprenticeshipCorrect": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "RolesAndResponsibilitiesConfirmations": {
        "type": "string",
        "enum": [
          "None",
          "ApprenticeRolesAndResponsibilitiesConfirmed",
          "EmployerRolesAndResponsibilitiesConfirmed",
          "ProviderRolesAndResponsibilitiesConfirmed"
        ]
      },
      "JsonPatchDocument_Revision": {
        "type": "object",
        "properties": {
          "operations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "enum": [
                    "add",
                    "remove",
                    "replace",
                    "move",
                    "copy",
                    "test"
                  ]
                },
                "path": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "from": {
                  "type": "string"
                }
              },
              "required": [
                "op",
                "path"
              ]
            }
          }
        }
      }
    }
  }
}
