{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Commitments API",
    "version": "1.0.0"
  },
  "paths": {
    "/registrations/{registrationId}": {
      "get": {
        "summary": "Get registration by ID",
        "operationId": "getRegistration",
        "parameters": [
          {
            "name": "registrationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the registration"
          }
        ],
        "responses": {
          "200": {
            "description": "Registration details",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Registration not found"
          }
        }
      }
    },
    "/registration/registration-details/{registrationId}": {
      "get": {
        "summary": "Get detailed registration by ID",
        "operationId": "getRegistrationById",
        "parameters": [
          {
            "name": "registrationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the registration"
          }
        ],
        "responses": {
          "200": {
            "description": "Detailed registration information",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Registration not found"
          }
        }
      }
    },
    "/registrations/reminders": {
      "get": {
        "summary": "Get registrations needing reminders",
        "operationId": "getRegistrationsNeedingReminders",
        "parameters": [
          {
            "name": "invitationCutOffTime",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Cut-off time for reminders"
          }
        ],
        "responses": {
          "200": {
            "description": "List of registrations needing reminders",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/registrations": {
      "get": {
        "summary": "Get registrations by account details",
        "operationId": "getRegistrationsByAccountDetails",
        "parameters": [
          {
            "name": "firstName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "First name of the apprentice"
          },
          {
            "name": "lastName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Last name of the apprentice"
          },
          {
            "name": "dateOfBirth",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Date of birth of the apprentice"
          }
        ],
        "responses": {
          "200": {
            "description": "Registrations matching account details",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/registrations/email": {
      "get": {
        "summary": "Get registration by email",
        "operationId": "getRegistrationByEmail",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "email"
            },
            "description": "Email address of the apprentice"
          }
        ],
        "responses": {
          "200": {
            "description": "Registration details",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Registration not found"
          }
        }
      }
    },
    "/registrations/{apprenticeId}/reminder": {
      "post": {
        "summary": "Mark registration reminder as sent",
        "operationId": "registrationReminderSent",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the apprentice"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationReminderSentRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Reminder marked as sent successfully"
          }
        }
      }
    },
    "/registrations/{apprenticeId}/firstseen": {
      "post": {
        "summary": "Mark registration as first seen",
        "operationId": "registrationFirstSeen",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the apprentice"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationFirstSeenRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Registration marked as first seen successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RegistrationFirstSeenRequest": {
        "type": "object",
        "properties": {
          "SeenOn": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the registration was first seen"
          }
        },
        "required": [
          "SeenOn"
        ]
      },
      "RegistrationReminderSentRequest": {
        "type": "object",
        "properties": {
          "SentOn": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the reminder was sent"
          }
        },
        "required": [
          "SentOn"
        ]
      }
    }
  }
}
