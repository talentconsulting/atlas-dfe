{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Commitments API",
    "version": "1.0.0",
    "description": "API for apprenticeship registrations and commitments."
  },
  "paths": {
    "/apprenticeships": {
      "post": {
        "summary": "Create an apprenticeship from registration",
        "operationId": "createApprenticeship",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApprenticeshipFromRegistrationCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Apprenticeship created successfully"
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/apprentices/{id}/apprenticeships": {
      "get": {
        "summary": "Get apprenticeships for an apprentice",
        "operationId": "getApprenticeApprenticeships",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of apprenticeships",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/apprentices/{apprenticeId}/apprenticeships/{apprenticeshipId}": {
      "get": {
        "summary": "Get details of an apprenticeship",
        "operationId": "getApprenticeship",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Apprenticeship details",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Apprenticeship not found"
          }
        }
      },
      "patch": {
        "summary": "Patch an apprenticeship",
        "operationId": "patchApprenticeship",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "changes": {
                    "$ref": "#/components/schemas/JsonPatchDocument"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Patch applied successfully"
          }
        }
      }
    },
    "/apprentices/{apprenticeId}/apprenticeships/{apprenticeshipId}/confirmed/latest": {
      "get": {
        "summary": "Get latest confirmed apprenticeship",
        "operationId": "getLatestConfirmedApprenticeship",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Details of the latest confirmed apprenticeship",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Apprenticeship not found"
          }
        }
      }
    },
    "/apprentices/{apprenticeId}/apprenticeships/{apprenticeshipId}/revisions": {
      "get": {
        "summary": "Get apprenticeship revisions",
        "operationId": "getApprenticeshipRevisions",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of apprenticeship revisions",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Revisions not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateApprenticeshipFromRegistrationCommand": {
        "type": "object",
        "properties": {
          "RegistrationId": {
            "type": "string",
            "format": "uuid"
          },
          "ApprenticeId": {
            "type": "string",
            "format": "uuid"
          },
          "LastName": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "RegistrationId",
          "ApprenticeId",
          "LastName",
          "DateOfBirth"
        ]
      },
      "JsonPatchDocument": {
        "type": "object",
        "properties": {
          "operations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "value": {}
              },
              "required": [
                "op",
                "path"
              ]
            }
          }
        }
      }
    }
  }
}
