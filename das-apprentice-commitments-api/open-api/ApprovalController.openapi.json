{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Commitments API",
    "description": "API for managing apprentice commitments",
    "version": "1.0.0"
  },
  "paths": {
    "/approvals": {
      "post": {
        "summary": "Create a new apprenticeship registration",
        "operationId": "apprenticeshipCreated",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRegistrationCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Apprenticeship registration successfully created"
          }
        }
      },
      "put": {
        "summary": "Change registration details for an apprenticeship",
        "operationId": "changeOfCircumstances",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeRegistrationCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Apprenticeship registration successfully updated"
          }
        }
      }
    },
    "/approvals/stopped": {
      "post": {
        "summary": "Stop an apprenticeship",
        "operationId": "stoppedApprenticeship",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StoppedApprenticeshipCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Apprenticeship successfully stopped"
          }
        }
      }
    },
    "/approvals/{commitmentsApprenticeshipId}/registration": {
      "get": {
        "summary": "Retrieve registration details for a specific apprenticeship",
        "operationId": "getApprovalsRegistration",
        "parameters": [
          {
            "name": "commitmentsApprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the commitments apprenticeship"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved registration details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "404": {
            "description": "Registration details not found for the provided apprenticeship ID"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateRegistrationCommand": {
        "type": "object",
        "properties": {
          "RegistrationId": {
            "type": "string",
            "format": "uuid"
          },
          "CommitmentsApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "CommitmentsApprovedOn": {
            "type": "string",
            "format": "date-time"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "EmployerName": {
            "type": "string"
          },
          "EmployerAccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "TrainingProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "TrainingProviderName": {
            "type": "string"
          },
          "DeliveryModel": {
            "$ref": "#/components/schemas/DeliveryModel"
          },
          "CourseName": {
            "type": "string"
          },
          "CourseLevel": {
            "type": "integer"
          },
          "CourseDuration": {
            "type": "integer"
          },
          "CourseOption": {
            "type": "string",
            "nullable": true
          },
          "PlannedStartDate": {
            "type": "string",
            "format": "date-time"
          },
          "PlannedEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "EmploymentEndDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "RecognisePriorLearning": {
            "type": "boolean",
            "nullable": true
          },
          "DurationReducedByHours": {
            "type": "integer",
            "format": "int16",
            "nullable": true
          },
          "DurationReducedBy": {
            "type": "integer",
            "format": "int16",
            "nullable": true
          },
          "ApprenticeshipType": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "ChangeRegistrationCommand": {
        "type": "object",
        "properties": {
          "CommitmentsContinuedApprenticeshipId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "CommitmentsApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "CommitmentsApprovedOn": {
            "type": "string",
            "format": "date-time"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "EmployerName": {
            "type": "string"
          },
          "EmployerAccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "TrainingProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "TrainingProviderName": {
            "type": "string"
          },
          "DeliveryModel": {
            "$ref": "#/components/schemas/DeliveryModel"
          },
          "CourseName": {
            "type": "string"
          },
          "CourseLevel": {
            "type": "integer"
          },
          "CourseDuration": {
            "type": "integer"
          },
          "CourseOption": {
            "type": "string",
            "nullable": true
          },
          "PlannedStartDate": {
            "type": "string",
            "format": "date-time"
          },
          "PlannedEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "EmploymentEndDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "RecognisePriorLearning": {
            "type": "boolean",
            "nullable": true
          },
          "DurationReducedByHours": {
            "type": "integer",
            "format": "int16",
            "nullable": true
          },
          "DurationReducedBy": {
            "type": "integer",
            "format": "int16",
            "nullable": true
          },
          "ApprenticeshipType": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "StoppedApprenticeshipCommand": {
        "type": "object",
        "properties": {
          "CommitmentsApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "CommitmentsStoppedOn": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DeliveryModel": {
        "type": "string",
        "enum": [
          "Regular",
          "PortableFlexiJob",
          "FlexiJobAgency"
        ]
      }
    }
  }
}
