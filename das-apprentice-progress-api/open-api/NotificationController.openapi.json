{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Progress API",
    "version": "1.0.0"
  },
  "paths": {
    "/notifications/apprenticeship-progress/{apprenticeIdentifier}/": {
      "post": {
        "summary": "Create apprenticeship progress for an apprentice",
        "parameters": [
          {
            "name": "apprenticeIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Progress created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddApprenticeshipProgressCommand"
                }
              }
            }
          }
        }
      }
    },
    "/notifications/apprenticeship-progress/{apprenticeIdentifier}": {
      "get": {
        "summary": "Get apprentice progress by apprentice ID",
        "parameters": [
          {
            "name": "apprenticeIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Apprentice progress data retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipProgressNotificationsByIdQuery"
                }
              }
            }
          }
        }
      }
    },
    "/notifications/progress-notification/{notificationId}": {
      "get": {
        "summary": "Get progress notification by ID",
        "parameters": [
          {
            "name": "notificationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Progress notification data retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProgressNotificationsByIdQuery"
                }
              }
            }
          }
        }
      }
    },
    "/notifications/progress-notification-to-check": {
      "get": {
        "summary": "Get progress notifications to check",
        "responses": {
          "200": {
            "description": "Progress notifications retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProgressNotificationsToCheckQuery"
                }
              }
            }
          }
        }
      }
    },
    "/notifications/updateProgressNotificationStatus/{notificationId}/{apprenticeProgressId}": {
      "patch": {
        "summary": "Update progress notification status",
        "parameters": [
          {
            "name": "notificationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "apprenticeProgressId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Progress notification status updated successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddApprenticeshipProgressCommand": {
        "type": "object",
        "properties": {
          "ApprenticeIdentifier": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "GetApprenticeshipProgressNotificationsByIdQuery": {
        "type": "object",
        "properties": {
          "ApprenticeIdentifier": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "GetProgressNotificationsByIdQuery": {
        "type": "object",
        "properties": {
          "NotificationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "GetProgressNotificationsToCheckQuery": {
        "type": "object",
        "properties": {},
        "description": "Properties not detailed in the source provided."
      },
      "UpdateProgressNotificationStatusCommand": {
        "type": "object",
        "properties": {
          "NotificationId": {
            "type": "string",
            "format": "uuid"
          },
          "ApprenticeProgressId": {
            "type": "integer"
          }
        }
      }
    }
  }
}
