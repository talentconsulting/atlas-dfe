{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Progress API",
    "version": "1.0"
  },
  "paths": {
    "/apprenticeships/{apprenticeshipIdentifier}/ksbs/": {
      "post": {
        "summary": "Add or update KSB progress",
        "parameters": [
          {
            "name": "apprenticeshipIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprenticeKsbProgressData"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "KSB progress successfully added or updated"
          }
        }
      }
    },
    "/apprenticeships/{apprenticeshipIdentifier}/ksbs/{ksbProgressId}/taskid/{taskId}": {
      "delete": {
        "summary": "Remove task from KSB progress",
        "parameters": [
          {
            "name": "apprenticeshipIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "ksbProgressId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task successfully removed from KSB progress"
          }
        }
      }
    },
    "/apprenticeships/{apprenticeshipIdentifier}/ksbsguids": {
      "get": {
        "summary": "Get KSBs by apprenticeship ID and GUID list",
        "parameters": [
          {
            "name": "apprenticeshipIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "guids",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching KSBs returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array"
                }
              }
            }
          },
          "404": {
            "description": "No KSBs found for the provided identifiers"
          }
        }
      }
    },
    "/apprenticeships/{apprenticeshipIdentifier}/ksbs": {
      "get": {
        "summary": "Get KSBs by apprenticeship ID",
        "parameters": [
          {
            "name": "apprenticeshipIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "KSBs retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array"
                }
              }
            }
          },
          "404": {
            "description": "No KSBs found for the given apprenticeship ID"
          }
        }
      }
    },
    "/apprenticeships/{apprenticeshipIdentifier}/ksbs/taskid/{taskId}": {
      "get": {
        "summary": "Get KSB progress for specific task",
        "parameters": [
          {
            "name": "apprenticeshipIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "KSB progress linked to the task retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array"
                }
              }
            }
          },
          "404": {
            "description": "No KSB progress found for the given task ID"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApprenticeKsbProgressData": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer"
          },
          "KSBProgressType": {
            "type": "integer",
            "nullable": true
          },
          "KSBId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "KsbKey": {
            "type": "string"
          },
          "Note": {
            "type": "string",
            "maxLength": 1000,
            "pattern": "^[^<>]*$"
          },
          "CurrentStatus": {
            "type": "integer",
            "nullable": true
          }
        }
      }
    }
  }
}
