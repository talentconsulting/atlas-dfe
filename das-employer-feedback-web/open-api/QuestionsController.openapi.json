{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Feedback API",
    "version": "1.0.0"
  },
  "paths": {
    "/landing": {
      "get": {
        "operationId": "StartFeedbackGet",
        "summary": "Start the feedback process",
        "parameters": [
          {
            "name": "encodedAccountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Encoded account identifier"
            }
          },
          {
            "name": "accountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "description": "Decoded account identifier"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Feedback landing view rendered"
          }
        }
      }
    },
    "/question-one": {
      "get": {
        "operationId": "QuestionOneGet",
        "summary": "Retrieve Question One (Strengths)",
        "parameters": [
          {
            "name": "encodedAccountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Encoded account identifier"
            }
          },
          {
            "name": "returnToReviewAnswers",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Flag indicating return to review answers"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Question One view rendered"
          }
        }
      },
      "post": {
        "operationId": "QuestionOnePost",
        "summary": "Submit answers for Question One",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionOneStrengthsViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to the next question, review answers, or current view"
          }
        }
      }
    },
    "/question-two": {
      "get": {
        "operationId": "QuestionTwoGet",
        "summary": "Retrieve Question Two (Weaknesses)",
        "parameters": [
          {
            "name": "encodedAccountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Encoded account identifier"
            }
          },
          {
            "name": "returnToReviewAnswers",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Flag indicating return to review answers"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Question Two view rendered"
          }
        }
      },
      "post": {
        "operationId": "QuestionTwoPost",
        "summary": "Submit answers for Question Two",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionTwoWeaknessesViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to the next question, review answers, or current view"
          }
        }
      }
    },
    "/question-three": {
      "get": {
        "operationId": "QuestionThreeGet",
        "summary": "Retrieve Question Three (Rating)",
        "parameters": [
          {
            "name": "encodedAccountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Encoded account identifier"
            }
          },
          {
            "name": "returnToReviewAnswers",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Flag indicating return to review answers"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Question Three view rendered"
          }
        }
      },
      "post": {
        "operationId": "QuestionThreePost",
        "summary": "Submit answers for Question Three",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionThreeRatingViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to review answers or current view"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountModel": {
        "type": "object",
        "properties": {
          "encodedAccountId": {
            "type": "string",
            "description": "Encoded account identifier"
          },
          "accountId": {
            "type": "integer",
            "description": "Decoded account identifier"
          }
        }
      },
      "QuestionRequestModel": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AccountModel"
          }
        ],
        "type": "object",
        "properties": {
          "returnToReviewAnswers": {
            "type": "boolean",
            "description": "Flag indicating return to review answers"
          }
        }
      },
      "QuestionOneStrengthsViewModel": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AccountModel"
          }
        ],
        "type": "object",
        "properties": {
          "providerName": {
            "type": "string",
            "description": "Provider name"
          },
          "attributes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderAttributeModel"
            },
            "description": "List of provider attributes"
          },
          "returnToReviewAnswers": {
            "type": "boolean",
            "description": "Flag indicating return to review answers"
          }
        }
      },
      "QuestionTwoWeaknessesViewModel": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AccountModel"
          }
        ],
        "type": "object",
        "properties": {
          "providerName": {
            "type": "string",
            "description": "Provider name"
          },
          "attributes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderAttributeModel"
            },
            "description": "List of provider attributes"
          },
          "returnToReviewAnswers": {
            "type": "boolean",
            "description": "Flag indicating return to review answers"
          }
        }
      },
      "QuestionThreeRatingViewModel": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AccountModel"
          }
        ],
        "type": "object",
        "properties": {
          "rating": {
            "$ref": "#/components/schemas/ProviderRating",
            "description": "Provider rating"
          },
          "providerName": {
            "type": "string",
            "description": "Provider name"
          },
          "returnToReviewAnswers": {
            "type": "boolean",
            "description": "Flag indicating return to review answers"
          }
        }
      },
      "ProviderAttributeModel": {
        "type": "object",
        "properties": {
          "attributeId": {
            "type": "integer",
            "description": "Attribute identifier"
          },
          "name": {
            "type": "string",
            "description": "Attribute name"
          },
          "good": {
            "type": "boolean",
            "description": "Whether the attribute is good"
          },
          "bad": {
            "type": "boolean",
            "description": "Whether the attribute is bad"
          }
        }
      },
      "ProviderRating": {
        "type": "string",
        "enum": [
          "VeryPoor",
          "Poor",
          "Good",
          "Excellent"
        ],
        "description": "Rating of the provider"
      }
    }
  }
}
