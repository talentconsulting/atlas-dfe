{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Feedback API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers": {
      "get": {
        "operationId": "ProviderSearchGet",
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/FeedbackSource"
            }
          },
          {
            "name": "PageIndex",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderSearchViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "ProviderSearchPost",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderSearchViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to provider search."
          }
        }
      }
    },
    "/providers/sort": {
      "get": {
        "operationId": "SortProvidersGet",
        "parameters": [
          {
            "name": "SortColumn",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/SortColumn"
            }
          },
          {
            "name": "SortOrder",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/SortOrder"
            }
          },
          {
            "name": "EncodedAccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to sorted provider search."
          }
        }
      }
    },
    "/providers/clearfilters": {
      "get": {
        "operationId": "ClearFiltersGet",
        "parameters": [
          {
            "name": "EncodedAccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to provider search with filters cleared."
          }
        }
      }
    },
    "/providers/{providerId}": {
      "get": {
        "operationId": "ProviderConfirmGet",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "EncodedAccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider confirmation details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderConfirmViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "ProviderConfirmPost",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderConfirmViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects based on confirmation outcome."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProviderSearchRequestModel": {
        "type": "object",
        "properties": {
          "FeedbackSource": {
            "$ref": "#/components/schemas/FeedbackSource"
          },
          "PageIndex": {
            "type": "integer",
            "default": 1
          }
        }
      },
      "ProviderSearchSortRequestModel": {
        "type": "object",
        "properties": {
          "EncodedAccountId": {
            "type": "string"
          },
          "SortColumn": {
            "$ref": "#/components/schemas/SortColumn"
          },
          "SortOrder": {
            "$ref": "#/components/schemas/SortOrder"
          }
        }
      },
      "ProviderSearchViewModel": {
        "type": "object",
        "properties": {
          "SelectedProviderName": {
            "type": "string"
          },
          "ProviderNameFilter": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "Providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EmployerTrainingProvider"
            }
          },
          "SortColumn": {
            "$ref": "#/components/schemas/SortColumn"
          },
          "SortOrder": {
            "$ref": "#/components/schemas/SortOrder"
          },
          "EncodedAccountId": {
            "type": "string"
          }
        }
      },
      "EmployerTrainingProvider": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer"
          },
          "ProviderName": {
            "type": "string"
          },
          "FeedbackStatus": {
            "type": "string"
          },
          "DateSubmitted": {
            "type": "string",
            "format": "date-time"
          },
          "CanSubmitFeedback": {
            "type": "boolean"
          }
        }
      },
      "ProviderConfirmRequestModel": {
        "type": "object",
        "properties": {
          "EncodedAccountId": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer"
          }
        }
      },
      "ProviderConfirmViewModel": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer"
          },
          "ProviderName": {
            "type": "string"
          },
          "Confirmed": {
            "type": "boolean"
          },
          "EncodedAccountId": {
            "type": "string"
          }
        }
      },
      "FeedbackSource": {
        "type": "string",
        "enum": [
          "Email",
          "AdHoc"
        ]
      },
      "SortColumn": {
        "type": "string",
        "enum": [
          "Default",
          "FeedbackStatus",
          "DateSubmitted"
        ]
      },
      "SortOrder": {
        "type": "string",
        "enum": [
          "Ascending",
          "Descending"
        ]
      },
      "AccountModel": {
        "type": "object",
        "properties": {
          "EncodedAccountId": {
            "type": "string"
          },
          "AccountId": {
            "type": "integer"
          }
        }
      }
    }
  }
}
