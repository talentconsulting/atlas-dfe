{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Feedback API",
    "version": "1.0.0"
  },
  "paths": {
    "/error/{id}": {
      "get": {
        "operationId": "ErrorGet",
        "summary": "Handles errors and displays appropriate error views.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": false,
            "description": "The error code. If not specified, defaults to 500.",
            "schema": {
              "type": "integer",
              "nullable": true
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Page not found error view."
          },
          "500": {
            "description": "Internal server error view.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorViewModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorViewModel": {
        "type": "object",
        "properties": {
          "RequestId": {
            "type": "string",
            "nullable": true
          },
          "ShowRequestId": {
            "type": "boolean"
          }
        },
        "required": [
          "RequestId",
          "ShowRequestId"
        ]
      }
    }
  }
}
