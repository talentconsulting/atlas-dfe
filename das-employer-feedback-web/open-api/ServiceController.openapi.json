{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Feedback Service API",
    "version": "1.0.0"
  },
  "paths": {
    "/service/signout": {
      "get": {
        "operationId": "SignoutGet",
        "summary": "Signs out the user and clears session entries.",
        "responses": {
          "302": {
            "description": "Redirect after successful sign-out."
          }
        }
      }
    },
    "/service/signoutcleanup": {
      "get": {
        "operationId": "SignOutCleanup",
        "summary": "Deletes authentication cookies as part of sign-out cleanup.",
        "responses": {
          "204": {
            "description": "No content, indicating the cleanup was successful."
          }
        }
      }
    },
    "/service/signin-stub": {
      "get": {
        "operationId": "SignInStubGet",
        "summary": "Displays the stub sign-in page.",
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "HTML view displaying the sign-in stub form."
          }
        }
      },
      "post": {
        "operationId": "SignInStubPost",
        "summary": "Handles the stub sign-in process and redirects the user.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInStubViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to the signed-in stub page."
          }
        }
      }
    },
    "/service/signed-in-stub": {
      "get": {
        "operationId": "SignedInStubGet",
        "summary": "Displays the signed-in stub page.",
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "HTML view displaying the signed-in stub page."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SignInStubViewModel": {
        "type": "object",
        "properties": {
          "StubEmail": {
            "type": "string"
          },
          "StubId": {
            "type": "string"
          },
          "ReturnUrl": {
            "type": "string"
          }
        },
        "required": [
          "StubEmail",
          "StubId",
          "ReturnUrl"
        ]
      },
      "SignedInStubViewModel": {
        "type": "object",
        "properties": {
          "StubEmail": {
            "type": "string"
          },
          "StubId": {
            "type": "string"
          },
          "ReturnUrl": {
            "type": "string"
          }
        },
        "required": [
          "StubEmail",
          "StubId",
          "ReturnUrl"
        ]
      },
      "EmployerUserAccountItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    }
  }
}
