{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Feedback API",
    "version": "1.0.0"
  },
  "paths": {
    "/review-answers": {
      "get": {
        "operationId": "reviewAnswersGet",
        "summary": "Get Review Answers",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewAnswersViewModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "PolicyNames.NoneRole": []
          }
        ]
      },
      "post": {
        "operationId": "reviewAnswersPost",
        "summary": "Submit Review Answers",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewAnswersViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect"
          }
        },
        "security": [
          {
            "PolicyNames.NoneRole": []
          }
        ]
      }
    },
    "/feedback-confirmation": {
      "get": {
        "operationId": "feedbackConfirmationGet",
        "summary": "Get Feedback Confirmation",
        "parameters": [
          {
            "name": "encodedAccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "PolicyNames.NoneRole": []
          }
        ]
      }
    },
    "/feedback-submitted": {
      "get": {
        "operationId": "feedbackAlreadySubmittedGet",
        "summary": "Get Feedback Already Submitted",
        "parameters": [
          {
            "name": "encodedAccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "PolicyNames.NoneRole": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AccountModel": {
        "type": "object",
        "properties": {
          "encodedAccountId": {
            "type": "string"
          },
          "accountId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "encodedAccountId",
          "accountId"
        ]
      },
      "ReviewAnswersViewModel": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/AccountModel"
          }
        ],
        "properties": {
          "survey": {
            "$ref": "#/components/schemas/SurveyModel"
          },
          "fatSiteUrl": {
            "type": "string"
          }
        },
        "required": [
          "survey",
          "fatSiteUrl"
        ]
      },
      "SurveyModel": {
        "type": "object",
        "properties": {
          "userRef": {
            "type": "string",
            "format": "uuid"
          },
          "ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "accountId": {
            "type": "integer",
            "format": "int64"
          },
          "encodedAccountId": {
            "type": "string"
          },
          "attributes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderAttributeModel"
            }
          },
          "rating": {
            "$ref": "#/components/schemas/ProviderRating"
          },
          "providerName": {
            "type": "string"
          },
          "feedbackSource": {
            "$ref": "#/components/schemas/FeedbackSource"
          }
        },
        "required": [
          "userRef",
          "ukprn",
          "accountId",
          "attributes",
          "providerName",
          "feedbackSource"
        ]
      },
      "ProviderAttributeModel": {
        "type": "object",
        "properties": {
          "attributeId": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "good": {
            "type": "boolean"
          },
          "bad": {
            "type": "boolean"
          }
        },
        "required": [
          "attributeId",
          "name",
          "good",
          "bad"
        ]
      },
      "ProviderRating": {
        "type": "string",
        "enum": [
          "VeryPoor",
          "Poor",
          "Good",
          "Excellent"
        ]
      },
      "FeedbackSource": {
        "type": "string",
        "enum": [
          "Email",
          "AdHoc"
        ]
      }
    }
  }
}
