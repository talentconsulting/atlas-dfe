@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_employer_feedback_web, "Employer Feedback") {
  Container(c_employer_feedback_web, "Employer Feedback", "Web Application")
}

SystemDb_Ext(d_cache_data_protection_keys_redis, "Data Protection Keys Redis", "StackExchange.Redis")
SystemDb_Ext(d_cache_redis, "Redis", "StackExchange.Redis")
System_Ext(d_cloud_service_application_insights, "Application Insights", "Azure Application Insights")

Rel(c_employer_feedback_web, d_cache_data_protection_keys_redis, "Caches data in", "StackExchange.Redis")
Rel(c_employer_feedback_web, d_cache_redis, "Caches data in", "StackExchange.Redis")
Rel(c_employer_feedback_web, d_cloud_service_application_insights, "Uses", "Azure Application Insights")

@enduml
