{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Incentives API",
    "version": "1.0.0"
  },
  "paths": {
    "/withdrawals": {
      "post": {
        "summary": "Withdrawal Incentive Application",
        "operationId": "WithdrawalIncentiveApplication",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WithdrawApplicationRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Error": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/withdrawal-reinstatements": {
      "post": {
        "summary": "Reinstate Incentive Application",
        "operationId": "ReinstateIncentiveApplication",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReinstateApplicationRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "WithdrawApplicationRequest": {
        "type": "object",
        "properties": {
          "WithdrawalType": {
            "$ref": "#/components/schemas/WithdrawalType"
          },
          "Applications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Application"
            }
          },
          "ServiceRequest": {
            "$ref": "#/components/schemas/ServiceRequest"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "EmailAddress": {
            "type": "string"
          }
        },
        "required": [
          "WithdrawalType",
          "Applications",
          "ServiceRequest",
          "AccountId",
          "EmailAddress"
        ]
      },
      "ReinstateApplicationRequest": {
        "type": "object",
        "properties": {
          "Applications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Application"
            }
          }
        },
        "required": [
          "Applications"
        ]
      },
      "Application": {
        "type": "object",
        "properties": {
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "ULN": {
            "type": "integer",
            "format": "int64"
          },
          "ServiceRequest": {
            "$ref": "#/components/schemas/ServiceRequest"
          }
        },
        "required": [
          "AccountLegalEntityId",
          "ULN",
          "ServiceRequest"
        ]
      },
      "ServiceRequest": {
        "type": "object",
        "properties": {
          "TaskId": {
            "type": "string"
          },
          "DecisionReference": {
            "type": "string"
          },
          "TaskCreatedDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "TaskId",
          "DecisionReference"
        ]
      },
      "WithdrawalType": {
        "type": "string",
        "enum": [
          "Employer",
          "Compliance"
        ]
      }
    }
  }
}
