{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Incentives API",
    "description": "API for managing commands in the Employer Incentives system.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/commands/{type}": {
      "post": {
        "summary": "Run a command by type",
        "description": "Executes a command based on the provided type identifier and command text.",
        "parameters": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Type of the command to execute."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "string"
              },
              "example": "\"{\\\"SomeCommandProperty\\\": \\\"Value\\\"}\""
            }
          },
          "description": "The command payload in JSON format."
        },
        "responses": {
          "200": {
            "description": "Command executed successfully."
          },
          "400": {
            "description": "Invalid request or command type."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
