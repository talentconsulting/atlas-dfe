@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_aan_hub_jobs, "Aan Hub") {
  Container(c_aan_hub_jobs, "Aan Hub Jobs", "Background Job")
}

SystemDb_Ext(d_database_aan_sql_database, "Aan SQL Database", "SQL Server")
System_Ext(d_http_api_aan_outer, "Aan Outer", "RestEase")
System_Ext(d_http_api_apprentice_accounts, "Apprentice Accounts", "RestEase")

Rel(c_aan_hub_jobs, d_database_aan_sql_database, "Reads from and writes to", "SQL Server")
Rel(c_aan_hub_jobs, d_http_api_aan_outer, "Calls the API of", "RestEase")
Rel(c_aan_hub_jobs, d_http_api_apprentice_accounts, "Calls the API of", "RestEase")

@enduml
