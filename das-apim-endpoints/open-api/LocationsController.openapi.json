{
  "openapi": "3.1.0",
  "info": {
    "title": "Locations API",
    "version": "1.0.0",
    "description": "API for managing locations and addresses."
  },
  "paths": {
    "/locations": {
      "get": {
        "summary": "Get addresses by query",
        "operationId": "GetAddresses",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The search query for addresses."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with list of addresses",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GetAddressesQueryResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/locations/search": {
      "get": {
        "summary": "Search locations by query",
        "operationId": "GetLocationsBySearch",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The search query for locations."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with list of locations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GetLocationsBySearchQueryResponse"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAddressesQueryResponse": {
        "type": "object",
        "additionalProperties": true
      },
      "GetLocationsBySearchQueryResponse": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
