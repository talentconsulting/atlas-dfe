{
  "openapi": "3.1.0",
  "info": {
    "title": "AdminAan Locations API",
    "version": "1.0.0"
  },
  "paths": {
    "/locations": {
      "get": {
        "operationId": "getAddresses",
        "summary": "Get addresses by query",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAddressesQueryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/locations/search": {
      "get": {
        "operationId": "getLocationsBySearch",
        "summary": "Search locations by query",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetLocationsBySearchQueryResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAddressesQueryResponse": {
        "type": "object"
      },
      "GetLocationsBySearchQueryResponse": {
        "type": "object"
      }
    }
  }
}
