{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Restricted Courses API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/restricted-apprenticeships": {
      "get": {
        "summary": "Get provider restricted apprenticeships",
        "description": "Retrieve a list of restricted apprenticeships for the specified provider (UKPRN).",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique identifier of the provider (UKPRN)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProviderRestrictedApprenticeshipsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/providers/{ukprn}/not-restricted-apprenticeships": {
      "get": {
        "summary": "Get provider not restricted apprenticeships",
        "description": "Retrieve a list of apprenticeships that are not restricted for the specified provider (UKPRN).",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique identifier of the provider (UKPRN)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProviderNotRestrictedApprenticeshipsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/providers/{ukprn}/restricted-apprenticeships/{larsCode}/change": {
      "post": {
        "summary": "Update a provider restricted apprenticeship",
        "description": "Update the details of a restricted apprenticeship for the specified provider and LARS code.",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique identifier of the provider (UKPRN)."
          },
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "LARS code of the restricted apprenticeship."
          }
        ],
        "requestBody": {
          "description": "UpdateProviderRestrictedApprenticeshipModel containing update information.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProviderRestrictedApprenticeshipModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No content"
          }
        }
      }
    },
    "/providers/{ukprn}/restricted-apprenticeships/{larsCode}/remove": {
      "post": {
        "summary": "Remove a provider restricted apprenticeship",
        "description": "Remove a restricted apprenticeship for the specified provider and LARS code.",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique identifier of the provider (UKPRN)."
          },
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "LARS code of the restricted apprenticeship."
          }
        ],
        "requestBody": {
          "description": "RemoveProviderRestrictedApprenticeshipModel containing removal information.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RemoveProviderRestrictedApprenticeshipModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No content"
          }
        }
      }
    },
    "/providers/{ukprn}/restricted-apprenticeships/{larsCode}/add": {
      "post": {
        "summary": "Add a provider restricted apprenticeship",
        "description": "Add a restricted apprenticeship for the specified provider and LARS code.",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique identifier of the provider (UKPRN)."
          },
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "LARS code of the restricted apprenticeship."
          }
        ],
        "requestBody": {
          "description": "AddProviderRestrictedApprenticeshipModel containing addition information.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddProviderRestrictedApprenticeshipModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No content"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetProviderRestrictedApprenticeshipsResponse": {
        "type": "object",
        "properties": {
          "courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RestrictedApprenticeshipModel"
            }
          }
        }
      },
      "GetProviderNotRestrictedApprenticeshipsResponse": {
        "type": "object",
        "properties": {
          "courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NotRestrictedApprenticeshipModel"
            }
          }
        }
      },
      "RestrictedApprenticeshipModel": {
        "type": "object",
        "properties": {
          "larsCode": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "level": {
            "type": "integer"
          },
          "lastDateStarts": {
            "type": "string",
            "format": "date-time"
          },
          "isClosedToNewStarts": {
            "type": "boolean"
          }
        }
      },
      "NotRestrictedApprenticeshipModel": {
        "type": "object",
        "properties": {
          "larsCode": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "level": {
            "type": "integer"
          }
        }
      },
      "UpdateProviderRestrictedApprenticeshipModel": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "userDisplayName": {
            "type": "string"
          },
          "lastDateStarts": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "userId",
          "userDisplayName"
        ]
      },
      "RemoveProviderRestrictedApprenticeshipModel": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "userDisplayName": {
            "type": "string"
          }
        },
        "required": [
          "userId",
          "userDisplayName"
        ]
      },
      "AddProviderRestrictedApprenticeshipModel": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "userDisplayName": {
            "type": "string"
          },
          "lastDateStarts": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "userId",
          "userDisplayName"
        ]
      }
    }
  }
}
