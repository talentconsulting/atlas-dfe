          {
            "name": "sectionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "pageId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the page preview",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPageByIdQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/forms/{formVersionId}/sections/{sectionId}/pages/{pageId}/MoveUp": {
      "put": {
        "summary": "Move a page up in order",
        "parameters": [
