{
  "openapi": "3.1.0",
  "info": {
    "title": "Files API",
    "version": "1.0.0",
    "description": "API for file operations"
  },
  "paths": {
    "/api/files/create": {
      "post": {
        "operationId": "createFile",
        "summary": "Create File Metadata",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFileMetadataCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseMediatrResponse_EmptyResponse_"
                }
              }
            }
          }
        }
      }
    },
    "/api/files/{fileId}": {
      "delete": {
        "operationId": "deleteFile",
        "summary": "Delete File Metadata",
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseMediatrResponse_EmptyResponse_"
                }
              }
            }
          }
        }
      }
    },
    "/api/files": {
      "post": {
        "operationId": "getFiles",
        "summary": "Retrieve File Metadata",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetFileMetadataQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseMediatrResponse_GetFileMetadataQueryResponse_"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateFileMetadataCommand": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "FileCategory": {
            "$ref": "#/components/schemas/FileCategory"
          },
          "ApplicationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "MessageId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "QuestionId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "FileName": {
            "type": "string"
          },
          "ContentType": {
            "type": "string"
          },
          "BlobContainer": {
            "type": "string"
          },
          "BlobPath": {
            "type": "string"
          },
          "UploadedBy": {
            "type": "string"
          }
        }
      },
      "DeleteFileMetadataCommand": {
        "type": "object",
        "properties": {
          "FileId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "GetFileMetadataQuery": {
        "type": "object",
        "properties": {
          "FileCategories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FileCategory"
            },
            "nullable": true
          },
          "FileId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "ApplicationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "MessageId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "QuestionId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        }
      },
      "GetFileMetadataQueryResponse": {
        "type": "object",
        "properties": {
          "Files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FileMetadataDto"
            }
          }
        }
      },
      "FileMetadataDto": {
        "type": "object",
        "properties": {}
      },
      "BaseMediatrResponse_GetFileMetadataQueryResponse_": {
        "type": "object",
        "properties": {
          "Success": {
            "type": "boolean"
          },
          "ErrorMessage": {
            "type": "string",
            "nullable": true
          },
          "ErrorCode": {
            "type": "string",
            "nullable": true
          },
          "Value": {
            "$ref": "#/components/schemas/GetFileMetadataQueryResponse"
          }
        }
      },
      "BaseMediatrResponse_EmptyResponse_": {
        "type": "object",
        "properties": {
          "Success": {
            "type": "boolean"
          },
          "ErrorMessage": {
            "type": "string",
            "nullable": true
          },
          "ErrorCode": {
            "type": "string",
            "nullable": true
          },
          "Value": {
            "$ref": "#/components/schemas/EmptyResponse"
          }
        }
      },
      "EmptyResponse": {
        "type": "object",
        "properties": {}
      },
      "FileCategory": {
        "type": "string",
        "enum": [
          "Unknown",
          "MessageAttachment",
          "QuestionUpload",
          "Pldns",
          "DefundingList",
          "ApprovedFunding",
          "ArchivedFunding",
          "FundingOutput",
          "RolloverCandidateImport",
          "RolloverCandidateSubmitted"
        ]
      }
    }
  }
}
