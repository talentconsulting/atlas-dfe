{
  "openapi": "3.1.0",
  "info": {
    "title": "AdminAan API",
    "version": "1.0.0"
  },
  "paths": {
    "/Schools/find/{searchTerm}": {
      "get": {
        "summary": "Find schools by search term",
        "operationId": "GetSchools",
        "parameters": [
          {
            "name": "searchTerm",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Term used to search schools"
          }
        ],
        "responses": {
          "200": {
            "description": "List of schools matching the search term",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetSchoolsQueryResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetSchoolsQueryResult": {
        "type": "object",
        "properties": {
          "Schools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/School"
            }
          }
        }
      },
      "School": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string",
            "description": "Name of the school"
          },
          "Urn": {
            "type": "string",
            "description": "Unique Reference Number of the school"
          }
        },
        "required": [
          "Name",
          "Urn"
        ]
      }
    }
  }
}
