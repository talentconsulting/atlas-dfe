{
  "openapi": "3.1.0",
  "info": {
    "title": "Providers Allowed List API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/allowedlist": {
      "get": {
        "operationId": "getAllowedList",
        "summary": "Get allowed list of providers",
        "parameters": [
          {
            "name": "sortColumn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "The column to sort the allowed list by"
          },
          {
            "name": "sortOrder",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "Ascending",
                "Descending"
              ],
              "default": "Ascending"
            },
            "description": "The sort order for the allowed list"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with the list of allowed providers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GetProvidersAllowedListQueryResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request due to invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetProvidersAllowedListQueryResponse": {
        "type": "object",
        "properties": {
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AllowedProvider"
            }
          }
        }
      },
      "AllowedProvider": {
        "type": "object",
        "properties": {
          "ukprn": {
            "type": "integer",
            "description": "Unique Provider Reference Number"
          },
          "startDateTime": {
            "type": "string",
            "format": "date-time",
            "description": "Start date and time for the provider"
          },
          "endDateTime": {
            "type": "string",
            "format": "date-time",
            "description": "End date and time for the provider"
          },
          "addedDateTime": {
            "type": "string",
            "format": "date-time",
            "description": "The date and time the provider was added (optional)"
          }
        }
      }
    }
  }
}
