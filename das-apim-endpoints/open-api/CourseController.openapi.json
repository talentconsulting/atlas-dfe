{
  "openapi": "3.1.0",
  "info": {
    "title": "Admin RoATP Course API",
    "version": "1.0.0",
    "description": "API for managing courses and provider restrictions in the Admin RoATP platform."
  },
  "paths": {
    "/courses": {
      "get": {
        "summary": "Get all courses",
        "operationId": "getAllCourses",
        "responses": {
          "200": {
            "description": "List of all courses",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllCoursesQueryResult"
                }
              }
            }
          }
        }
      }
    },
    "/courses/{larsCode}/providers/allowed": {
      "get": {
        "summary": "Get allowed providers by course",
        "operationId": "getAllowedProvidersByCourse",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Details of restricted course",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestrictedCourseDetailsModel"
                }
              }
            }
          },
          "404": {
            "description": "Course not found"
          }
        }
      }
    },
    "/courses/{larsCode}/providers/not-allowed": {
      "get": {
        "summary": "Get providers not allowed by course",
        "operationId": "getProvidersNotAllowedByCourse",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Details of restricted course",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestrictedCourseDetailsModel"
                }
              }
            }
          },
          "404": {
            "description": "Course not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAllCoursesQueryResult": {
        "type": "object",
        "properties": {
          "Courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CourseModel"
            }
          }
        }
      },
      "RestrictedCourseDetailsModel": {
        "type": "object",
        "properties": {
          "LarsCode": {
            "type": "string"
          },
          "IfateReferenceNumber": {
            "type": "string"
          },
          "CourseName": {
            "type": "string"
          },
          "Level": {
            "type": "integer"
          },
          "Route": {
            "type": "string"
          },
          "LearningType": {
            "$ref": "#/components/schemas/LearningType"
          },
          "CourseType": {
            "$ref": "#/components/schemas/CourseType"
          },
          "IsActiveAvailable": {
            "type": "boolean"
          },
          "LastDateStarts": {
            "type": "string",
            "format": "date-time"
          },
          "IsCourseRestricted": {
            "type": "boolean"
          },
          "Providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderModel"
            }
          }
        }
      },
      "CourseModel": {
        "type": "object",
        "properties": {
          "LarsCode": {
            "type": "string"
          },
          "CourseType": {
            "$ref": "#/components/schemas/CourseType"
          },
          "LearningType": {
            "$ref": "#/components/schemas/LearningType"
          },
          "Title": {
            "type": "string"
          },
          "Level": {
            "type": "integer"
          },
          "LastDateStarts": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProviderModel": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer"
          },
          "ProviderName": {
            "type": "string"
          },
          "LastDateStarts": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LearningType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "FoundationApprenticeship",
          "ApprenticeshipUnit"
        ]
      },
      "CourseType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "ShortCourse"
        ]
      }
    }
  }
}
