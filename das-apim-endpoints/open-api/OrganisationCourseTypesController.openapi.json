{
  "openapi": "3.1.0",
  "info": {
    "title": "AdminRoatp Organisation Course Types API",
    "version": "1.0.0",
    "description": "API for managing organisation course types within AdminRoatp."
  },
  "paths": {
    "/organisations/{ukprn}/course-types": {
      "put": {
        "summary": "Update organisation course types",
        "description": "Updates the course types associated with an organisation identified by UKPRN.",
        "operationId": "UpdateOrganisationCourseTypes",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "description": "The UKPRN of the organisation.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateOrganisationCourseTypeModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content - The update was successful."
          },
          "400": {
            "description": "Bad Request - Invalid input provided.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UpdateOrganisationCourseTypeModel": {
        "type": "object",
        "properties": {
          "CourseTypeIds": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "List of course type IDs to associate with the organisation."
          },
          "UserId": {
            "type": "string",
            "description": "The ID of the user making the update."
          },
          "UserDisplayName": {
            "type": "string",
            "description": "The display name of the user making the update."
          }
        },
        "required": [
          "CourseTypeIds",
          "UserId",
          "UserDisplayName"
        ]
      }
    }
  }
}
