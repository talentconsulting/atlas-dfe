{
  "openapi": "3.1.0",
  "info": {
    "title": "Restricted Courses API",
    "version": "1.0.0"
  },
  "paths": {
    "/restricted-courses": {
      "get": {
        "summary": "Get all restricted courses",
        "operationId": "GetRestrictedCourses",
        "parameters": [
          {
            "name": "restricted",
            "in": "query",
            "required": true,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with restricted courses",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllRestrictedCoursesResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Add a restricted course",
        "operationId": "AddRestrictedCourse",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddRestrictedCourseCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Restricted course successfully added"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAllRestrictedCoursesResponse": {
        "type": "object",
        "properties": {
          "Courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RestrictedCourseModel"
            }
          }
        },
        "required": [
          "Courses"
        ]
      },
      "AddRestrictedCourseCommand": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "LarsCode": {
            "type": "string"
          }
        },
        "required": [
          "UserId",
          "UserDisplayName",
          "LarsCode"
        ]
      },
      "RestrictedCourseModel": {
        "type": "object",
        "properties": {
          "LarsCode": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Level": {
            "type": "integer"
          },
          "LearningType": {
            "type": "string"
          }
        },
        "required": [
          "LarsCode",
          "Title",
          "Level",
          "LearningType"
        ]
      }
    }
  }
}
