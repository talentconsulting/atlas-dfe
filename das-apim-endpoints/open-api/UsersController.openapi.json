{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS Admin API",
    "description": "API for managing user-related operations in SFA DAS Admin.",
    "version": "1.0.0"
  },
  "paths": {
    "/users/{userId}/unlock": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Unlock a user account",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "The ID of the user to unlock",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UnlockUserRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content - The user was successfully unlocked."
          },
          "400": {
            "description": "Bad Request - The request data was invalid."
          },
          "500": {
            "description": "Internal Server Error - An error occurred while unlocking the user."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UnlockUserRequest": {
        "type": "object",
        "required": [
          "Username",
          "UserActionId"
        ],
        "properties": {
          "Username": {
            "type": "string",
            "description": "The username of the user to unlock."
          },
          "UserActionId": {
            "type": "integer",
            "format": "int64",
            "description": "The identifier for the user action triggering the unlock."
          }
        }
      }
    }
  }
}
