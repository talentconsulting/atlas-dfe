{
  "openapi": "3.1.0",
  "info": {
    "title": "Admins API",
    "description": "API for handling admin member operations.",
    "version": "1.0.0"
  },
  "paths": {
    "/Admins": {
      "post": {
        "summary": "Lookup an admin member or create one if not found.",
        "operationId": "lookupOrCreateAdmin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetAdminMemberRequestModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response, returns the admin member details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAdminMemberResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAdminMemberRequestModel": {
        "type": "object",
        "properties": {
          "Email": {
            "type": "string",
            "format": "email",
            "description": "Email address of the admin member."
          },
          "FirstName": {
            "type": "string",
            "description": "First name of the admin member."
          },
          "LastName": {
            "type": "string",
            "description": "Last name of the admin member."
          }
        },
        "required": [
          "Email",
          "FirstName",
          "LastName"
        ]
      },
      "GetAdminMemberResult": {
        "type": "object",
        "properties": {
          "MemberId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier of the admin member."
          },
          "Status": {
            "type": "string",
            "description": "Current status of the admin member."
          }
        },
        "required": [
          "MemberId",
          "Status"
        ]
      }
    }
  }
}
