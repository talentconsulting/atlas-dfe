{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Course Types API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/course-types/{courseType}/restrict": {
      "post": {
        "operationId": "RestrictProvider",
        "summary": "Restrict a provider for a specific course type.",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "UK Provider Reference Number"
          },
          {
            "name": "courseType",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CourseType"
            },
            "description": "Type of the course"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RestrictProviderModel"
              }
            }
          },
          "description": "Request payload to restrict the provider for the course type."
        },
        "responses": {
          "204": {
            "description": "No content. The provider was successfully restricted."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CourseType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "ShortCourse"
        ]
      },
      "RestrictProviderModel": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string",
            "description": "ID of the user restricting the provider"
          },
          "UserDisplayName": {
            "type": "string",
            "description": "Display name of the user restricting the provider"
          }
        },
        "required": [
          "UserId",
          "UserDisplayName"
        ]
      }
    }
  }
}
