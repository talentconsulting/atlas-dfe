{
  "openapi": "3.1.0",
  "info": {
    "title": "AdminAan Regions API",
    "description": "API for managing regions in AdminAan.",
    "version": "1.0.0"
  },
  "paths": {
    "/Regions": {
      "get": {
        "operationId": "getRegions",
        "summary": "Retrieve all regions",
        "description": "Fetches a list of regions.",
        "tags": [
          "Regions"
        ],
        "responses": {
          "200": {
            "description": "Successful response with list of regions.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRegionsQueryResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetRegionsQueryResult": {
        "type": "object",
        "properties": {
          "Regions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Region"
            }
          }
        }
      },
      "Region": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "description": "The unique identifier of the region."
          },
          "Area": {
            "type": "string",
            "description": "The name of the region area."
          },
          "Ordering": {
            "type": "integer",
            "description": "The ordering sequence for the region."
          }
        },
        "required": [
          "Id",
          "Area",
          "Ordering"
        ]
      }
    }
  }
}
