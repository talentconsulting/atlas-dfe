{
  "openapi": "3.1.0",
  "info": {
    "title": "Admin Aan API",
    "version": "1.0.0"
  },
  "paths": {
    "/Calendars": {
      "get": {
        "summary": "Get Calendars",
        "operationId": "GeCalendars",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Calendar"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Calendar": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "example": 1
          },
          "CalendarName": {
            "type": "string",
            "example": "Training Events"
          },
          "EffectiveFrom": {
            "type": "string",
            "format": "date-time",
            "example": "2023-03-01T00:00:00Z"
          },
          "EffectiveTo": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": null
          },
          "Ordering": {
            "type": "integer",
            "example": 1
          }
        },
        "required": [
          "Id",
          "CalendarName",
          "EffectiveFrom",
          "Ordering"
        ]
      }
    }
  }
}
