{
  "openapi": "3.1.0",
  "info": {
    "title": "AdminRoatp",
    "version": "1.0.0",
    "description": "API endpoints for managing organisations in the AdminRoatp system."
  },
  "paths": {
    "/Organisations": {
      "post": {
        "summary": "Create a new organisation",
        "operationId": "PostOrganisation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostOrganisationCommand"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Organisation created successfully"
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    },
    "/Organisations/{ukprn}": {
      "get": {
        "summary": "Get a specific organisation by UKPRN",
        "operationId": "GetOrganisation",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Organisation retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetOrganisationQueryResult"
                }
              }
            }
          },
          "404": {
            "description": "Organisation not found"
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update organisation fields using JSON-Patch",
        "operationId": "PatchOrganisation",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "X-RequestingUserId",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-RequestingUserName",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/JsonPatchDocument_PatchOrganisationModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Organisation updated successfully"
          }
        }
      }
    },
    "/Organisations/{ukprn}/ukrlp-data": {
      "get": {
        "summary": "Get UKRLP data for a specific organisation",
        "operationId": "GetUkrlp",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "UKRLP data retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetUkrlpQueryResult"
                }
              }
            }
          },
          "404": {
            "description": "UKRLP data not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetOrganisationsQueryResult": {
        "type": "object",
        "properties": {
          "organisations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrganisationSummary"
            }
          }
        }
      },
      "OrganisationSummary": {
        "type": "object",
        "properties": {
          "ukprn": {
            "type": "integer"
          },
          "legalName": {
            "type": "string"
          }
        }
      },
      "GetOrganisationQueryResult": {
        "type": "object",
        "properties": {
          "organisationId": {
            "type": "string",
            "format": "uuid"
          },
          "ukprn": {
            "type": "integer"
          },
          "legalName": {
            "type": "string"
          },
          "tradingName": {
            "type": "string"
          },
          "companyNumber": {
            "type": "string"
          },
          "charityNumber": {
            "type": "string"
          },
          "providerType": {
            "$ref": "#/components/schemas/ProviderType"
          },
          "organisationTypeId": {
            "type": "integer"
          },
          "organisationType": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/OrganisationStatus"
          },
          "applicationDeterminedDate": {
            "type": "string",
            "format": "date-time"
          },
          "removedReasonId": {
            "type": "integer"
          },
          "removedReason": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "lastUpdatedDate": {
            "type": "string",
            "format": "date-time"
          },
          "allowedCourseTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AllowedCourseTypeModel"
            }
          }
        }
      },
      "AllowedCourseTypeModel": {
        "type": "object",
        "properties": {
          "courseType": {
            "$ref": "#/components/schemas/CourseType"
          },
          "isRestricted": {
            "type": "boolean"
          },
          "restrictedCount": {
            "type": "integer"
          },
          "allowedCount": {
            "type": "integer"
          }
        }
      },
      "CourseType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "ShortCourse"
        ]
      },
      "ProviderType": {
        "type": "string"
      },
      "OrganisationStatus": {
        "type": "string"
      },
      "GetUkrlpQueryResult": {
        "type": "object",
        "properties": {
          "legalName": {
            "type": "string"
          },
          "tradingName": {
            "type": "string"
          },
          "charityNumber": {
            "type": "string"
          },
          "companyNumber": {
            "type": "string"
          }
        }
      },
      "PostOrganisationCommand": {
        "type": "object",
        "properties": {
          "ukprn": {
            "type": "integer"
          },
          "legalName": {
            "type": "string"
          },
          "tradingName": {
            "type": "string"
          },
          "companyNumber": {
            "type": "string"
          },
          "charityNumber": {
            "type": "string"
          },
          "providerType": {
            "$ref": "#/components/schemas/ProviderType"
          },
          "organisationTypeId": {
            "type": "integer"
          },
          "requestingUserId": {
            "type": "string"
          },
          "requestingUserDisplayName": {
            "type": "string"
          },
          "deliversApprenticeships": {
            "type": "boolean"
          },
          "deliversApprenticeshipUnits": {
            "type": "boolean"
          }
        }
      },
      "JsonPatchDocument_PatchOrganisationModel": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "enum": [
                "add",
                "remove",
                "replace",
                "move",
                "copy",
                "test"
              ]
            },
            "path": {
              "type": "string"
            },
            "value": {
              "type": "any"
            },
            "from": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
