{
  "openapi": "3.1.0",
  "info": {
    "title": "Organisations API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/Organisations": {
      "get": {
        "summary": "Retrieve a list of organisations",
        "operationId": "GetOrganisations",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response with list of organisations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetOrganisationsQueryResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new organisation",
        "operationId": "PostOrganisation",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostOrganisationCommand"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Organisation created successfully"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/api/Organisations/{ukprn}": {
      "get": {
        "summary": "Retrieve details of a specific organisation",
        "operationId": "GetOrganisation",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response containing organisation details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetOrganisationQueryResult"
                }
              }
            }
          },
          "404": {
            "description": "Organisation not found"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update details of a specific organisation",
        "operationId": "PatchOrganisation",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "X-RequestingUserId",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-RequestingUserName",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/JsonPatchDocumentPatchOrganisationModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Organisation successfully updated"
          }
        }
      }
    },
    "/api/Organisations/{ukprn}/ukrlp-data": {
      "get": {
        "summary": "Retrieve UKRLP details for a specific organisation",
        "operationId": "GetUkrlp",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response containing UKRLP details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetUkrlpQueryResult"
                }
              }
            }
          },
          "404": {
            "description": "UKRLP data not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetOrganisationsQueryResult": {
        "type": "object",
        "properties": {
          "organisations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrganisationSummary"
            }
          }
        }
      },
      "OrganisationSummary": {
        "type": "object",
        "properties": {
          "ukprn": {
            "type": "integer"
          },
          "legalName": {
            "type": "string"
          }
        }
      },
      "PostOrganisationCommand": {
        "type": "object",
        "properties": {
          "ukprn": {
            "type": "integer"
          },
          "legalName": {
            "type": "string"
          },
          "tradingName": {
            "type": "string",
            "nullable": true
          },
          "companyNumber": {
            "type": "string",
            "nullable": true
          },
          "charityNumber": {
            "type": "string",
            "nullable": true
          },
          "providerType": {
            "$ref": "#/components/schemas/ProviderType"
          },
          "organisationTypeId": {
            "type": "integer"
          },
          "requestingUserId": {
            "type": "string"
          },
          "requestingUserDisplayName": {
            "type": "string"
          },
          "deliversApprenticeships": {
            "type": "boolean"
          },
          "deliversApprenticeshipUnits": {
            "type": "boolean"
          }
        }
      },
      "GetOrganisationQueryResult": {
        "type": "object",
        "properties": {
          "organisationId": {
            "type": "string",
            "format": "uuid"
          },
          "ukprn": {
            "type": "integer"
          },
          "legalName": {
            "type": "string"
          },
          "tradingName": {
            "type": "string",
            "nullable": true
          },
          "companyNumber": {
            "type": "string",
            "nullable": true
          },
          "charityNumber": {
            "type": "string",
            "nullable": true
          },
          "providerType": {
            "$ref": "#/components/schemas/ProviderType"
          },
          "organisationTypeId": {
            "type": "integer"
          },
          "organisationType": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/OrganisationStatus"
          },
          "applicationDeterminedDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "removedReasonId": {
            "type": "integer",
            "nullable": true
          },
          "removedReason": {
            "type": "string",
            "nullable": true
          },
          "startDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "lastUpdatedDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "allowedCourseTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AllowedCourseTypeModel"
            }
          }
        }
      },
      "AllowedCourseTypeModel": {
        "type": "object",
        "properties": {
          "courseType": {
            "$ref": "#/components/schemas/CourseType"
          },
          "isRestricted": {
            "type": "boolean",
            "nullable": true
          },
          "restrictedCount": {
            "type": "integer",
            "nullable": true
          },
          "allowedCount": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "GetUkrlpQueryResult": {
        "type": "object",
        "properties": {
          "legalName": {
            "type": "string",
            "nullable": true
          },
          "tradingName": {
            "type": "string",
            "nullable": true
          },
          "charityNumber": {
            "type": "string",
            "nullable": true
          },
          "companyNumber": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "JsonPatchDocumentPatchOrganisationModel": {
        "type": "object",
        "additionalProperties": true
      },
      "ProviderType": {
        "type": "string",
        "enum": [
          "FE",
          "HE",
          "OnDemand",
          "EmployerProvider"
        ]
      },
      "OrganisationStatus": {
        "type": "string",
        "enum": [
          "Active",
          "Suspended",
          "Closed",
          "Removed"
        ]
      },
      "CourseType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "ShortCourse"
        ]
      }
    }
  }
}
