{
  "openapi": "3.1.0",
  "info": {
    "title": "Admin ROATP API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/courses-tobe-allowed": {
      "get": {
        "summary": "Get provider available courses",
        "operationId": "GetProviderAvailableCourses",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "courseType",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/CourseType"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestrictedCourseDetailsModel"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CourseType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "ShortCourse"
        ],
        "description": "Type of course"
      },
      "RestrictedCourseDetailsModel": {
        "type": "object",
        "properties": {
          "LarsCode": {
            "type": "string"
          },
          "IfateReferenceNumber": {
            "type": "string"
          },
          "CourseName": {
            "type": "string"
          },
          "Level": {
            "type": "integer"
          },
          "Route": {
            "type": "string"
          },
          "LearningType": {
            "$ref": "#/components/schemas/LearningType"
          },
          "CourseType": {
            "$ref": "#/components/schemas/CourseType"
          },
          "IsActiveAvailable": {
            "type": "boolean"
          },
          "LastDateStarts": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "IsCourseRestricted": {
            "type": "boolean"
          },
          "Providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderModel"
            }
          }
        }
      },
      "LearningType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "FoundationApprenticeship",
          "ApprenticeshipUnit"
        ],
        "description": "Learning type of the course"
      },
      "ProviderModel": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer"
          },
          "ProviderName": {
            "type": "string"
          },
          "LastDateStarts": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      }
    }
  }
}
