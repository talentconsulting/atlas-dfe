{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Courses API",
    "version": "1.0.0",
    "description": "API for managing provider courses."
  },
  "paths": {
    "/providers/{ukprn}/courses/{larsCode}": {
      "get": {
        "tags": [
          "Provider Courses"
        ],
        "summary": "Get Provider Course",
        "description": "Retrieves the details of a provider course using UKPRN and LARS code.",
        "operationId": "GetProviderCourse",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "UKPRN (Unique Provider Reference Number)"
          },
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "LARS code of the course"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with course data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProviderCourseResponse"
                }
              }
            }
          },
          "404": {
            "description": "Course not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetProviderCourseResponse": {
        "type": "object",
        "properties": {
          "ProviderCourseId": {
            "type": "integer"
          },
          "StandardUId": {
            "type": "string"
          },
          "IfateReferenceNumber": {
            "type": "string"
          },
          "LarsCode": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Level": {
            "type": "integer"
          },
          "ApprovalBody": {
            "type": "string"
          },
          "Route": {
            "type": "string"
          },
          "StandardInfoUrl": {
            "type": "string"
          },
          "ContactUsPhoneNumber": {
            "type": "string"
          },
          "ContactUsEmail": {
            "type": "string"
          },
          "IsApprovedByRegulator": {
            "type": "boolean",
            "nullable": true
          },
          "IsRegulatedForProvider": {
            "type": "boolean"
          },
          "HasLocations": {
            "type": "boolean"
          },
          "HasOnlineDeliveryOption": {
            "type": "boolean"
          }
        },
        "required": [
          "ProviderCourseId",
          "StandardUId",
          "IfateReferenceNumber",
          "LarsCode",
          "Title",
          "Level",
          "ApprovalBody",
          "Route",
          "StandardInfoUrl",
          "ContactUsPhoneNumber",
          "ContactUsEmail",
          "IsRegulatedForProvider",
          "HasLocations",
          "HasOnlineDeliveryOption"
        ]
      }
    }
  }
}
