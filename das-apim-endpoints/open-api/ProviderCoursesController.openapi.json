{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Courses API",
    "version": "1.0.0",
    "description": "API for managing provider courses in the RoATP system."
  },
  "paths": {
    "/providers/{ukprn}/courses/{larsCode}": {
      "get": {
        "summary": "Get Provider Course",
        "description": "Retrieve details of a specific provider course using UKPRN and LARS Code.",
        "tags": [
          "Provider Courses"
        ],
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "description": "UK Provider Reference Number",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "description": "LARS Code of the course",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider Course details found successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProviderCourseResponse"
                }
              }
            }
          },
          "404": {
            "description": "Provider Course not found."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetProviderCourseResponse": {
        "type": "object",
        "properties": {
          "ProviderCourseId": {
            "type": "integer",
            "example": 12345
          },
          "StandardUId": {
            "type": "string",
            "example": "STD123"
          },
          "IfateReferenceNumber": {
            "type": "string",
            "example": "REF456"
          },
          "LarsCode": {
            "type": "string",
            "example": "LARS123"
          },
          "Title": {
            "type": "string",
            "example": "Example Course Title"
          },
          "Level": {
            "type": "integer",
            "example": 3
          },
          "ApprovalBody": {
            "type": "string",
            "example": "Approval Body Name"
          },
          "Route": {
            "type": "string",
            "example": "Health and Science"
          },
          "StandardInfoUrl": {
            "type": "string",
            "format": "uri",
            "example": "https://example.com/info"
          },
          "ContactUsPhoneNumber": {
            "type": "string",
            "example": "08001234567"
          },
          "ContactUsEmail": {
            "type": "string",
            "format": "email",
            "example": "contact@example.com"
          },
          "IsApprovedByRegulator": {
            "type": "boolean",
            "nullable": true,
            "example": true
          },
          "IsRegulatedForProvider": {
            "type": "boolean",
            "example": false
          },
          "HasLocations": {
            "type": "boolean",
            "example": true
          },
          "HasOnlineDeliveryOption": {
            "type": "boolean",
            "example": false
          }
        }
      }
    }
  }
}
