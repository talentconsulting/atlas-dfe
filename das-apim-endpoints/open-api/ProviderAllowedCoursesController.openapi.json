{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Allowed Courses API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/allowed-courses/{larsCode}": {
      "get": {
        "summary": "Get details of a provider allowed course",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProviderAllowedCourseDetailsResponse"
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/providers/{ukprn}/allowed-courses": {
      "get": {
        "summary": "Get allowed courses for a provider",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "courseType",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/CourseType"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProviderAllowedCoursesResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddProviderAllowedCourseModel": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "LastDateStarts": {
            "type": "string",
            "format": "date-time"
          },
          "IsStartRestricted": {
            "type": "boolean"
          }
        },
        "required": [
          "UserId",
          "UserDisplayName",
          "IsStartRestricted"
        ]
      },
      "PutProviderAllowedCourseModel": {
        "type": "object",
        "properties": {
          "LastDateStarts": {
            "type": "string",
            "format": "date-time"
          },
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          }
        },
        "required": [
          "UserId",
          "UserDisplayName"
        ]
      },
      "CourseType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "ShortCourse"
        ]
      },
      "GetProviderAllowedCoursesResponse": {
        "type": "object",
        "properties": {
          "AllowedCourses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderAllowedCourseModel"
            }
          }
        }
      },
      "GetProviderAllowedCourseDetailsResponse": {
        "type": "object",
        "properties": {
          "LastDateStarts": {
            "type": "string",
            "format": "date-time"
          },
          "IsCourseRestricted": {
            "type": "boolean"
          },
          "IsClosedToNewStarts": {
            "type": "boolean"
          },
          "IsActive": {
            "type": "boolean"
          }
        }
      },
      "ProviderAllowedCourseModel": {
        "type": "object",
        "properties": {
          "LarsCode": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Level": {
            "type": "integer"
          },
          "LastDateStarts": {
            "type": "string",
            "format": "date-time"
          },
          "IsClosedToNewStarts": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
