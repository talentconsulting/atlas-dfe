{
  "openapi": "3.1.0",
  "info": {
    "title": "Application Messages API",
    "version": "1.0.0",
    "description": "API for managing application messages."
  },
  "paths": {
    "/api/applications/{applicationId}/messages": {
      "get": {
        "summary": "Get messages by application ID",
        "operationId": "GetApplicationMessagesByIdAsync",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "userType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationMessagesByApplicationIdQueryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "summary": "Create a new application message",
        "operationId": "CreateApplicationMessageAsync",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApplicationMessageCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateApplicationMessageCommandResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/applications/messages/{messageId}": {
      "get": {
        "summary": "Get message by ID",
        "operationId": "GetMessageByIdAsync",
        "parameters": [
          {
            "name": "messageId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationMessageByIdQueryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/applications/{applicationId}/messages/read": {
      "put": {
        "summary": "Mark all messages as read",
        "operationId": "MarkAllMessagesAsRead",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MarkAllMessagesAsReadCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetApplicationMessagesByApplicationIdQueryResponse": {
        "type": "object",
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApplicationMessage"
            }
          }
        }
      },
      "ApplicationMessage": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "format": "uuid"
          },
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "messageText": {
            "type": "string"
          },
          "messageType": {
            "type": "string"
          },
          "messageHeader": {
            "type": "string"
          },
          "sharedWithDfe": {
            "type": "boolean"
          },
          "sharedWithOfqual": {
            "type": "boolean"
          },
          "sharedWithSkillsEngland": {
            "type": "boolean"
          },
          "sharedWithAwardingOrganisation": {
            "type": "boolean"
          },
          "sentByName": {
            "type": "string"
          },
          "sentByEmail": {
            "type": "string"
          },
          "sentAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GetApplicationMessageByIdQueryResponse": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "format": "uuid"
          },
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "messageText": {
            "type": "string"
          },
          "messageType": {
            "type": "string"
          },
          "messageHeader": {
            "type": "string"
          },
          "sharedWithDfe": {
            "type": "boolean"
          },
          "sharedWithOfqual": {
            "type": "boolean"
          },
          "sharedWithSkillsEngland": {
            "type": "boolean"
          },
          "sharedWithAwardingOrganisation": {
            "type": "boolean"
          },
          "sentByName": {
            "type": "string"
          },
          "sentByEmail": {
            "type": "string"
          },
          "sentAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateApplicationMessageCommand": {
        "type": "object",
        "required": [
          "applicationId",
          "messageText",
          "messageType",
          "userType"
        ],
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "messageText": {
            "type": "string"
          },
          "messageType": {
            "type": "string"
          },
          "userType": {
            "type": "string"
          },
          "sentByName": {
            "type": "string"
          },
          "sentByEmail": {
            "type": "string"
          }
        }
      },
      "CreateApplicationMessageCommandResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "notifications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NotificationDefinition"
            }
          },
          "emailSent": {
            "type": "boolean"
          }
        }
      },
      "MarkAllMessagesAsReadCommand": {
        "type": "object",
        "required": [
          "applicationId",
          "userType"
        ],
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "userType": {
            "type": "string"
          }
        }
      },
      "EmptyResponse": {
        "type": "object",
        "additionalProperties": false
      },
      "NotificationDefinition": {
        "type": "object",
        "properties": {
          "templateName": {
            "type": "string"
          },
          "recipientKind": {
            "type": "string",
            "enum": [
              "QfauMailbox",
              "OfqualMailbox",
              "SkillsEnglandMailbox",
              "DirectEmail"
            ]
          },
          "emailAddress": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
