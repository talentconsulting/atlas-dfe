{
  "openapi": "3.1.0",
  "info": {
    "title": "Admin Aan Profiles API",
    "version": "1.0.0"
  },
  "paths": {
    "/Profiles/{userType}": {
      "get": {
        "summary": "Get user profiles",
        "description": "Retrieves profiles for the specified user type.",
        "operationId": "GetProfiles",
        "parameters": [
          {
            "name": "userType",
            "in": "path",
            "required": true,
            "description": "The type of user.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProfilesResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Profiles"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "GetProfilesResponse": {
        "type": "object",
        "properties": {
          "Profiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Profile"
            }
          }
        }
      },
      "Profile": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64",
            "description": "The unique identifier of the profile."
          },
          "Description": {
            "type": "string",
            "description": "A description of the profile."
          },
          "Category": {
            "type": "string",
            "description": "The category of the profile."
          },
          "Ordering": {
            "type": "integer",
            "description": "The ordering number for display purposes."
          }
        }
      }
    }
  }
}
