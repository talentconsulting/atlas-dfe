{
  "openapi": "3.1.0",
  "info": {
    "title": "Applications API",
    "version": "1.0.0",
    "description": "API for managing applications and forms."
  },
  "paths": {
    "/api/applications/forms": {
      "get": {
        "summary": "Get all application forms",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationFormsQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/applications/forms/{formVersionId}/sections/{sectionId}/pages/{pageOrder}": {
      "get": {
        "summary": "Get a page of a section by its order",
        "parameters": [
          {
            "name": "formVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "sectionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "pageOrder",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationPageByIdQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/applications/{applicationId}/metadata": {
      "get": {
        "summary": "Get application metadata by its ID",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationMetadataByIdQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/applications/forms/{formVersionId}": {
      "get": {
        "summary": "Get form version details by its ID",
        "parameters": [
          {
            "name": "formVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationFormByIdQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/applications/organisations/{organisationId}": {
      "get": {
        "summary": "Get applications by organisation ID",
        "parameters": [
          {
            "name": "organisationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationsByOrganisationIdQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/applications/{applicationId}": {
      "get": {
        "summary": "Get application details by ID",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Application details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationByIdQueryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "delete": {
        "summary": "Delete application by ID",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "userType",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Application deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/applications/{applicationId}/submit": {
      "put": {
        "summary": "Submit application by ID",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitApplicationCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Application submitted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/applications/{applicationId}/withdraw": {
      "post": {
        "summary": "Withdraw application by ID",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WithdrawApplicationCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Application withdrawn",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/applications": {
      "post": {
        "summary": "Create a new application",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApplicationCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Application created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateApplicationCommandResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetApplicationFormsQueryResponse": {
        "type": "object",
        "properties": {
          "Forms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Id": {
                  "type": "string",
                  "format": "uuid"
                },
                "Title": {
                  "type": "string"
                },
                "Description": {
                  "type": "string"
                },
                "DescriptionHTML": {
                  "type": "string"
                },
                "Order": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "GetApplicationPageByIdQueryResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Title": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          },
          "Order": {
            "type": "integer"
          },
          "TotalSectionPages": {
            "type": "integer"
          },
          "Questions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "GetApplicationMetadataByIdQueryResponse": {
        "type": "object",
        "properties": {
          "ApplicationId": {
            "type": "string",
            "format": "uuid"
          },
          "FormVersionId": {
            "type": "string",
            "format": "uuid"
          },
          "OrganisationId": {
            "type": "string",
            "format": "uuid"
          },
          "Reference": {
            "type": "integer"
          }
        }
      },
      "GetApplicationFormByIdQueryResponse": {
        "type": "object",
        "properties": {
          "FormTitle": {
            "type": "string"
          },
          "Sections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Id": {
                  "type": "string",
                  "format": "uuid"
                },
                "Title": {
                  "type": "string"
                },
                "Order": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "GetApplicationsByOrganisationIdQueryResponse": {
        "type": "object",
        "properties": {
          "Applications": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Id": {
                  "type": "string",
                  "format": "uuid"
                },
                "Name": {
                  "type": "string"
                },
                "CreatedDate": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      },
      "GetApplicationByIdQueryResponse": {
        "type": "object",
        "properties": {
          "ApplicationId": {
            "type": "string",
            "format": "uuid"
          },
          "FormVersionId": {
            "type": "string",
            "format": "uuid"
          },
          "OrganisationId": {
            "type": "string",
            "format": "uuid"
          },
          "Name": {
            "type": "string"
          },
          "Owner": {
            "type": "string"
          },
          "Reference": {
            "type": "integer"
          },
          "QualificationNumber": {
            "type": "string"
          },
          "Status": {
            "type": "string"
          }
        }
      },
      "EmptyResponse": {
        "type": "object"
      },
      "SubmitApplicationCommand": {
        "type": "object",
        "properties": {
          "ApplicationId": {
            "type": "string",
            "format": "uuid"
          },
          "SubmittedBy": {
            "type": "string"
          },
          "SubmittedByEmail": {
            "type": "string"
          }
        }
      },
      "WithdrawApplicationCommand": {
        "type": "object",
        "properties": {
          "ApplicationId": {
            "type": "string",
            "format": "uuid"
          },
          "WithdrawnBy": {
            "type": "string"
          },
          "WithdrawnByEmail": {
            "type": "string"
          }
        }
      },
      "CreateApplicationCommand": {
        "type": "object",
        "properties": {
          "Title": {
            "type": "string"
          },
          "Owner": {
            "type": "string"
          },
          "FormVersionId": {
            "type": "string",
            "format": "uuid"
          },
          "QualificationNumber": {
            "type": "string"
          },
          "OrganisationId": {
            "type": "string",
            "format": "uuid"
          },
          "OrganisationName": {
            "type": "string"
          },
          "OrganisationUkprn": {
            "type": "string"
          }
        }
      },
      "CreateApplicationCommandResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "IsQanValid": {
            "type": "boolean"
          },
          "QanValidationMessage": {
            "type": "string"
          }
        }
      }
    }
  }
}
