  "components": {
    "schemas": {
      "GetApplicationsForReviewQuery": {
        "type": "object",
        "properties": {
          "applicationSearch": {
            "type": "string"
          },
          "awardingOrganisationSearch": {
            "type": "string"
          },
          "reviewerSearch": {
            "type": "string"
          },
          "unassignedOnly": {
            "type": "boolean"
          },
          "applicationStatuses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reviewUser": {
            "type": "string"
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "applicationsWithNewMessages": {
            "type": "boolean"
          }
        }
      },
      "GetApplicationsForReviewQueryResponse": {
        "type": "object",
        "properties": {
          "applications": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "applicationReviewId": {
                  "type": "string",
                  "format": "uuid"
                },
                "name": {
                  "type": "string"
                },
                "lastUpdated": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "availableReviewers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string"
                },
                "firstName": {
                  "type": "string"
                },
                "lastName": {
                  "type": "string"
                }
              }
            }
          },
          "totalRecordsCount": {
            "type": "integer"
          }
        }
      },
      "UpdateApplicationReviewSharingCommand": {
        "type": "object",
        "properties": {
          "applicationReviewUserType": {
            "type": "string"
          },
          "shareApplication": {
            "type": "boolean"
          },
          "applicationReviewId": {
            "type": "string",
            "format": "uuid"
          },
          "userType": {
            "type": "string"
          },
          "sentByName": {
            "type": "string"
          },
          "sentByEmail": {
            "type": "string"
          }
        }
      },
      "EmptyResponse": {
        "type": "object"
      },
      "GetApplicationForReviewByIdQueryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "applicationReviewId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "lastUpdated": {
            "type": "string",
            "format": "date-time"
          },
          "reference": {
            "type": "integer"
          }
        }
      }
    }
  }
}
