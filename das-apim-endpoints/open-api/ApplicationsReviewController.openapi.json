{
  "openapi": "3.1.0",
  "info": {
    "title": "Aodp Applications Review API",
    "version": "1.0.0",
    "description": "API for handling applications review processes."
  },
  "paths": {
    "/api/application-reviews": {
      "post": {
        "summary": "Get application reviews",
        "operationId": "GetApplicationReviews",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetApplicationsForReviewQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationsForReviewQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/application-reviews/{applicationReviewId}/share": {
      "put": {
        "summary": "Update application review sharing",
        "operationId": "UpdateApplicationReviewSharing",
        "parameters": [
          {
            "name": "applicationReviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateApplicationReviewSharingCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/application-reviews/{applicationReviewId}": {
      "get": {
        "summary": "Get application review details by ID",
        "operationId": "GetApplicationForReviewById",
        "parameters": [
          {
            "name": "applicationReviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationForReviewByIdQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/application-reviews/{applicationReviewId}/share-status": {
      "get": {
        "summary": "Get application review sharing status by ID",
        "operationId": "GetApplicationReviewSharingStatusById",
        "parameters": [
          {
            "name": "applicationReviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationReviewSharingStatusByIdQueryHandler"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/application-reviews/{applicationReviewId}/feedback/{userType}": {
      "get": {
        "summary": "Get feedback for an application review by ID",
        "operationId": "GetFeedbackForApplicationReviewById",
        "parameters": [
          {
            "name": "applicationReviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "userType",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetFeedbackForApplicationReviewByIdQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/application-reviews/{applicationReviewId}/qfau-feedback-review": {
      "get": {
        "summary": "Get QFAU feedback review confirmation details",
        "operationId": "GetQfauFeedbackForApplicationReviewConfirmationById",
        "parameters": [
          {
            "name": "applicationReviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetQfauFeedbackForApplicationReviewConfirmationQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/application-reviews/{applicationReviewId}/form-answers": {
      "get": {
        "summary": "Get application form answers by review ID",
        "operationId": "GetApplicationFormDetailsByIdAsync",
        "parameters": [
          {
            "name": "applicationReviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationFormAnswersByReviewIdQueryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/application-reviews/bulk-action": {
      "put": {
        "summary": "Perform a bulk application action",
        "operationId": "BulkApplicationAction",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkApplicationActionCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkApplicationActionCommandResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/application-reviews/{applicationReviewId}/export-data": {
      "get": {
        "summary": "Get application export data by ID",
        "operationId": "GetApplicationExportData",
        "parameters": [
          {
            "name": "applicationReviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationExportDataQueryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetApplicationsForReviewQuery": {
        "type": "object",
        "properties": {
          "applicationSearch": {
            "type": "string"
          },
          "awardingOrganisationSearch": {
            "type": "string"
          },
          "reviewerSearch": {
            "type": "string"
          },
          "unassignedOnly": {
            "type": "boolean"
          },
          "applicationStatuses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reviewUser": {
            "type": "string"
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "applicationsWithNewMessages": {
            "type": "boolean"
          }
        }
      },
      "GetApplicationsForReviewQueryResponse": {
        "type": "object",
        "properties": {
          "applications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Application"
            }
          },
          "availableReviewers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Reviewer"
            }
          },
          "totalRecordsCount": {
            "type": "integer"
          }
        }
      },
      "Application": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "applicationReviewId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "lastUpdated": {
            "type": "string",
            "format": "date-time"
          },
          "reference": {
            "type": "integer"
          }
        }
      },
      "Reviewer": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          }
        }
      },
      "UpdateApplicationReviewSharingCommand": {
        "type": "object",
        "properties": {
          "applicationReviewUserType": {
            "type": "string"
          },
          "shareApplication": {
            "type": "boolean"
          },
          "applicationReviewId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "EmptyResponse": {
        "type": "object"
      },
      "GetApplicationForReviewByIdQueryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "applicationReviewId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "GetApplicationReviewSharingStatusByIdQueryHandler": {
        "type": "object"
      },
      "GetFeedbackForApplicationReviewByIdQueryResponse": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "GetQfauFeedbackForApplicationReviewConfirmationQueryResponse": {
        "type": "object"
      },
      "BulkApplicationActionCommand": {
        "type": "object",
        "properties": {
          "applicationReviewIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "actionType": {
            "type": "string"
          },
          "userType": {
            "type": "string"
          }
        }
      },
      "BulkApplicationActionCommandResponse": {
        "type": "object",
        "properties": {
          "requestedCount": {
            "type": "integer"
          },
          "updatedCount": {
            "type": "integer"
          },
          "errorCount": {
            "type": "integer"
          }
        }
      },
      "GetApplicationFormAnswersByReviewIdQueryResponse": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "GetApplicationExportDataQueryResponse": {
        "type": "object",
        "properties": {
          "applicationFormStructure": {
            "type": "object"
          }
        }
      }
    }
  }
}
