@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_learner_data_api, "Learner Data") {
  Container(c_learner_data, "Learner Data", "API")
}

SystemDb_Ext(d_cache_redis, "Redis", "StackExchange.Redis")
SystemDb_Ext(d_configuration_store_azure_table_storage_configuration, "Azure Table Storage configuration")
SystemDb_Ext(d_database_sql_server, "SQL Server", "Entity Framework Core")
System_Ext(d_identity_provider_microsoft_entra_id, "Microsoft Entra ID")
SystemQueue_Ext(d_message_broker_azure_service_bus, "Azure Service Bus", "Azure Service Bus")
System_Ext(d_telemetry_application_insights, "Application Insights")

Rel(c_learner_data, d_cache_redis, "Caches data in", "StackExchange.Redis")
Rel(c_learner_data, d_configuration_store_azure_table_storage_configuration, "Reads configuration from")
Rel(c_learner_data, d_database_sql_server, "Reads from and writes to", "Entity Framework Core")
Rel(c_learner_data, d_identity_provider_microsoft_entra_id, "Authenticates with")
Rel(c_learner_data, d_message_broker_azure_service_bus, "Publishes messages to and consumes messages from", "Azure Service Bus")
Rel(c_learner_data, d_telemetry_application_insights, "Sends telemetry to")

@enduml
