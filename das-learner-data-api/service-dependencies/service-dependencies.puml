@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_learner_data_api, "Learner Data") {
  Container(c_learner_data, "Learner Data", "API")
}

SystemDb_Ext(d_cache_redis, "Redis", "StackExchange.Redis")
System_Ext(d_cloud_service_azure_key_vault, "Azure Key Vault", "Azure.Identity")
SystemDb_Ext(d_database_sql_server, "SQL Server", "Entity Framework Core")
SystemQueue_Ext(d_message_broker_azure_service_bus, "Azure Service Bus", "NServiceBus")

Rel(c_learner_data, d_cache_redis, "Caches data in", "StackExchange.Redis")
Rel(c_learner_data, d_cloud_service_azure_key_vault, "Uses", "Azure.Identity")
Rel(c_learner_data, d_database_sql_server, "Reads from and writes to", "Entity Framework Core")
Rel(c_learner_data, d_message_broker_azure_service_bus, "Publishes messages to and consumes messages from", "NServiceBus")

@enduml
