{
  "openapi": "3.1.0",
  "info": {
    "title": "Authorization API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/authorization/access-cohort": {
      "get": {
        "operationId": "CanAccessCohort",
        "summary": "Check access to cohort",
        "parameters": [
          {
            "name": "CohortId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "Party",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Party"
            }
          },
          {
            "name": "PartyId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Access check result",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/api/authorization/access-apprenticeship": {
      "get": {
        "operationId": "CanAccessApprenticeship",
        "summary": "Check access to apprenticeship",
        "parameters": [
          {
            "name": "ApprenticeshipId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "Party",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Party"
            }
          },
          {
            "name": "PartyId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Access check result",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/api/authorization/features/providers/{providerId}/apprentice-email-required": {
      "get": {
        "operationId": "ApprenticeEmailRequired",
        "summary": "Check if apprentice email feature is required for a provider",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Email is required for provider",
            "content": {
              "application/json": {}
            }
          },
          "404": {
            "description": "Email is not required for provider"
          }
        }
      }
    },
    "/api/authorization/email-optional": {
      "get": {
        "operationId": "OptionalEmail",
        "summary": "Check if email is optional for employer and provider pair",
        "parameters": [
          {
            "name": "employerid",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "providerId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Email is optional",
            "content": {
              "application/json": {}
            }
          },
          "404": {
            "description": "Email is not optional"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Party": {
        "type": "string",
        "enum": [
          "None",
          "Employer",
          "Provider",
          "TransferSender"
        ],
        "description": "Party involved in the request."
      }
    }
  }
}
