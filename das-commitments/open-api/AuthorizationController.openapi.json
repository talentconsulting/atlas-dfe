{
  "openapi": "3.1.0",
  "info": {
    "title": "Authorization API",
    "version": "1.0.0",
    "description": "API for checking authorization related to cohorts, apprenticeships, and features."
  },
  "paths": {
    "/api/authorization/access-cohort": {
      "get": {
        "summary": "Check access to cohort",
        "operationId": "CanAccessCohort",
        "parameters": [
          {
            "name": "CohortId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "Party",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Party"
            }
          },
          {
            "name": "PartyId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/authorization/access-apprenticeship": {
      "get": {
        "summary": "Check access to apprenticeship",
        "operationId": "CanAccessApprenticeship",
        "parameters": [
          {
            "name": "ApprenticeshipId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "Party",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Party"
            }
          },
          {
            "name": "PartyId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/authorization/features/providers/{providerId}/apprentice-email-required": {
      "get": {
        "summary": "Check if apprentice email is required for provider",
        "operationId": "ApprenticeEmailRequired",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Feature is enabled for provider",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Feature is disabled for provider"
          }
        }
      }
    },
    "/api/authorization/email-optional": {
      "get": {
        "summary": "Check email optional for employer and provider",
        "operationId": "OptionalEmail",
        "parameters": [
          {
            "name": "employerid",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "providerId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Email is optional for employer and provider",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Email is not optional for employer and provider"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Party": {
        "type": "integer",
        "description": "Party identifier",
        "enum": [
          0,
          1,
          2,
          4
        ]
      }
    }
  }
}
