{
  "openapi": "3.1.0",
  "info": {
    "title": "CommitmentsV2 API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/learners": {
      "get": {
        "operationId": "GetAllLearners",
        "summary": "Retrieve all learners.",
        "parameters": [
          {
            "name": "sinceTime",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter learners changed since this time."
          },
          {
            "name": "batch_number",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "The batch number to retrieve."
          },
          {
            "name": "batch_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1000
            },
            "description": "The number of learners in each batch."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved learners.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllLearnersResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "GetAllLearnersResponse": {
        "type": "object",
        "properties": {
          "BatchNumber": {
            "type": "integer",
            "description": "The current batch number."
          },
          "BatchSize": {
            "type": "integer",
            "description": "The number of learners in each batch."
          },
          "TotalNumberOfBatches": {
            "type": "integer",
            "description": "The total number of batches."
          },
          "Learners": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Learner"
            }
          }
        }
      },
      "Learner": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer",
            "description": "The identifier of the apprenticeship."
          },
          "FirstName": {
            "type": "string",
            "description": "The first name of the learner."
          },
          "LastName": {
            "type": "string",
            "description": "The last name of the learner."
          },
          "ULN": {
            "type": "string",
            "description": "The Unique Learner Number."
          },
          "TrainingCode": {
            "type": "string",
            "description": "The code of the training program."
          },
          "TrainingCourseVersion": {
            "type": "string",
            "description": "The version of the training course."
          },
          "TrainingCourseVersionConfirmed": {
            "type": "boolean",
            "description": "Whether the course version is confirmed."
          },
          "TrainingCourseOption": {
            "type": "string",
            "description": "The training course option chosen."
          },
          "StandardUId": {
            "type": "string",
            "description": "The Standard UID for the course."
          },
          "StartDate": {
            "type": "string",
            "format": "date-time",
            "description": "The start date of the apprenticeship."
          },
          "EndDate": {
            "type": "string",
            "format": "date-time",
            "description": "The end date of the apprenticeship."
          },
          "CreatedOn": {
            "type": "string",
            "format": "date-time",
            "description": "The datetime when the learner record was created."
          },
          "UpdatedOn": {
            "type": "string",
            "format": "date-time",
            "description": "The datetime when the learner record was last updated."
          },
          "StopDate": {
            "type": "string",
            "format": "date-time",
            "description": "The stop date of the apprenticeship."
          },
          "PauseDate": {
            "type": "string",
            "format": "date-time",
            "description": "The pause date of the apprenticeship."
          },
          "CompletionDate": {
            "type": "string",
            "format": "date-time",
            "description": "The completion date of the apprenticeship."
          },
          "UKPRN": {
            "type": "integer",
            "description": "The UK Provider Reference Number."
          },
          "LearnRefNumber": {
            "type": "string",
            "description": "The learner reference number."
          },
          "PaymentStatus": {
            "$ref": "#/components/schemas/PaymentStatus"
          },
          "EmployerAccountId": {
            "type": "integer",
            "description": "The employer account ID associated with the learner."
          },
          "EmployerName": {
            "type": "string",
            "description": "The name of the employer."
          }
        }
      },
      "PaymentStatus": {
        "type": "string",
        "description": "The payment status of the learner.",
        "enum": [
          "Active",
          "Paused",
          "Withdrawn",
          "Completed"
        ]
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
