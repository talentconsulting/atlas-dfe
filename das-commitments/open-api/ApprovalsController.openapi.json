{
  "openapi": "3.1.0",
  "info": {
    "title": "Approvals API",
    "version": "v1"
  },
  "paths": {
    "/approvals/{learningKey}": {
      "put": {
        "tags": [
          "Approvals"
        ],
        "summary": "Update Approval Information",
        "description": "Updates approval-related data for a given learning key.",
        "operationId": "PutApprovals",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The unique identifier for the learning data."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CocApprovalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Changes successfully processed and approval request canceled.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PutApprovalsResponse"
                }
              }
            }
          },
          "201": {
            "description": "Changes successfully processed and new approval request created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PutApprovalsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Mismatch between route and body learning key or other bad request.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "LearningKey in route does not match LearningKey in body"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "An unexpected error occurred."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CocApprovalRequest": {
        "type": "object",
        "properties": {
          "LearningKey": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the learning."
          },
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64",
            "description": "Identifier for the apprenticeship."
          },
          "LearningType": {
            "type": "string",
            "description": "Type of learning."
          },
          "UKPRN": {
            "type": "string",
            "description": "UK Provider Reference Number."
          },
          "ULN": {
            "type": "string",
            "description": "Unique Learner Number."
          },
          "ApprovedUri": {
            "type": "string",
            "description": "URI for approved learning data."
          },
          "Changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CocApprovalFieldChange"
            },
            "description": "List of field changes for the approval."
          },
          "NewPrices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceRecord"
            },
            "description": "New pricing records."
          }
        },
        "required": [
          "LearningKey",
          "Changes"
        ]
      },
      "CocApprovalFieldChange": {
        "type": "object",
        "properties": {
          "ChangeType": {
            "type": "string",
            "description": "The type of change."
          },
          "Data": {
            "$ref": "#/components/schemas/CocData",
            "description": "Old and new data regarding the change."
          }
        }
      },
      "CocData": {
        "type": "object",
        "properties": {
          "Old": {
            "type": "string",
            "description": "The old value."
          },
          "New": {
            "type": "string",
            "description": "The new value."
          }
        }
      },
      "PriceRecord": {
        "type": "object",
        "properties": {
          "TrainingPrice": {
            "type": "number",
            "format": "decimal",
            "description": "The training price."
          },
          "AssessmentPrice": {
            "type": "number",
            "format": "decimal",
            "description": "The assessment price."
          },
          "EffectiveFrom": {
            "type": "string",
            "format": "date-time",
            "description": "Effective starting date for the pricing."
          }
        }
      },
      "PutApprovalsResponse": {
        "type": "object",
        "properties": {
          "Changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprovalFieldChange"
            },
            "description": "Mapped changes after processing."
          },
          "NewPrices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceRecord"
            },
            "description": "New pricing records after processing."
          }
        }
      },
      "ApprovalFieldChange": {
        "type": "object",
        "properties": {
          "ChangeType": {
            "type": "string",
            "description": "Type of change."
          },
          "ApprovalStatus": {
            "type": "string",
            "description": "The status of the approval."
          },
          "Reason": {
            "type": "string",
            "description": "Reason for the change."
          },
          "Data": {
            "$ref": "#/components/schemas/CocData",
            "description": "Data associated with the change."
          }
        }
      }
    }
  }
}
