{
  "openapi": "3.1.0",
  "info": {
    "title": "Approvals API",
    "version": "1.0.0"
  },
  "paths": {
    "/approvals/{learningKey}": {
      "put": {
        "tags": [
          "Approvals"
        ],
        "summary": "Update approvals for a specific learning key.",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The unique identifier for the learning key."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CocApprovalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Approvals updated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PutApprovalsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid LearningKey or request body.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "201": {
            "description": "Approvals created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PutApprovalsResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CocApprovalRequest": {
        "type": "object",
        "properties": {
          "LearningKey": {
            "type": "string",
            "format": "uuid",
            "description": "The unique identifier for the learning key."
          },
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64",
            "description": "Identifier for the apprenticeship."
          },
          "LearningType": {
            "type": "string",
            "description": "Type of learning associated with the approval."
          },
          "UKPRN": {
            "type": "string",
            "description": "UK Provider Reference Number."
          },
          "ULN": {
            "type": "string",
            "description": "Unique Learner Number."
          },
          "ApprovedUri": {
            "type": "string",
            "description": "URI used for the approval process."
          },
          "Changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CocApprovalFieldChange"
            }
          },
          "NewPrices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceRecord"
            }
          }
        },
        "required": [
          "LearningKey",
          "Changes"
        ]
      },
      "CocApprovalFieldChange": {
        "type": "object",
        "properties": {
          "ChangeType": {
            "type": "string",
            "description": "Type of change in the field."
          },
          "Data": {
            "$ref": "#/components/schemas/CocData"
          }
        }
      },
      "CocData": {
        "type": "object",
        "properties": {
          "Old": {
            "type": "string",
            "description": "Previous value."
          },
          "New": {
            "type": "string",
            "description": "Updated value."
          }
        }
      },
      "PriceRecord": {
        "type": "object",
        "properties": {
          "TrainingPrice": {
            "type": "number",
            "format": "decimal",
            "description": "Price for training."
          },
          "AssessmentPrice": {
            "type": "number",
            "format": "decimal",
            "description": "Price for assessment."
          },
          "EffectiveFrom": {
            "type": "string",
            "format": "date-time",
            "description": "Start date for the price record."
          }
        }
      },
      "PutApprovalsResponse": {
        "type": "object",
        "properties": {
          "Changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprovalFieldChange"
            }
          },
          "NewPrices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceRecord"
            }
          }
        }
      },
      "ApprovalFieldChange": {
        "type": "object",
        "properties": {
          "ChangeType": {
            "type": "string",
            "description": "Type of change."
          },
          "ApprovalStatus": {
            "type": "string",
            "description": "Approval status of the change."
          },
          "Reason": {
            "type": "string",
            "description": "Reason for approval or denial."
          },
          "Data": {
            "$ref": "#/components/schemas/CocData"
          }
        }
      }
    }
  }
}
