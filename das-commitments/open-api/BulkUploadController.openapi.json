{
  "openapi": "3.1.0",
  "info": {
    "title": "Bulk Upload API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/{providerId}/bulkupload": {
      "post": {
        "operationId": "AddDraftApprenticeships",
        "summary": "Add draft apprenticeships via bulk upload",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUploadAddDraftApprenticeshipsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft apprenticeships added successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/{providerId}/bulkupload/addandapprove": {
      "post": {
        "operationId": "AddAndApproveDraftApprenticeships",
        "summary": "Add and approve draft apprenticeships via bulk upload",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUploadAddAndApproveDraftApprenticeshipsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft apprenticeships added and approved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/{providerId}/bulkupload/validate": {
      "post": {
        "operationId": "ValidateBulkUpload",
        "summary": "Validate bulk upload request",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUploadValidateApiRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/{providerId}/bulkupload/logs": {
      "post": {
        "operationId": "AddFileUploadLog",
        "summary": "Add file upload log entry",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddFileUploadLogRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File upload log entry added successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/{providerId}/bulkupload/logs/{logId}/error": {
      "put": {
        "operationId": "UpdateLogErrorContent",
        "summary": "Update log error content for a specific log",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "logId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FileUploadLogUpdateWithErrorContentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Error content updated successfully"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AddFileUploadLogRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "FileName": {
            "type": "string"
          },
          "RplCount": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "RowCount": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "FileContent": {
            "type": "string"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "BulkUploadAddDraftApprenticeshipsRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "LogId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "BulkUploadDraftApprenticeships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkUploadAddDraftApprenticeshipRequest"
            }
          }
        }
      },
      "BulkUploadAddDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "LegalEntityId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "AgreementId": {
            "type": "string"
          },
          "CohortId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "CohortRef": {
            "type": "string"
          },
          "UserId": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "CourseCode": {
            "type": "string"
          },
          "StartDateAsString": {
            "type": "string"
          },
          "EndDateAsString": {
            "type": "string"
          },
          "OriginatorReference": {
            "type": "string"
          },
          "ReservationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "DateOfBirthAsString": {
            "type": "string"
          },
          "Uln": {
            "type": "string"
          },
          "ProviderRef": {
            "type": "string"
          },
          "RowNumber": {
            "type": "integer",
            "format": "int32"
          },
          "CostAsString": {
            "type": "string"
          },
          "EPAOrgId": {
            "type": "string"
          },
          "RecognisePriorLearningAsString": {
            "type": "string"
          },
          "DurationReducedByAsString": {
            "type": "string"
          },
          "PriceReducedByAsString": {
            "type": "string"
          },
          "TrainingTotalHoursAsString": {
            "type": "string"
          },
          "TrainingHoursReductionAsString": {
            "type": "string"
          },
          "IsDurationReducedByRPLAsString": {
            "type": "string"
          },
          "MinimumAgeAtApprenticeshipStart": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "MaximumAgeAtApprenticeshipStart": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "TrainingPrice": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "EndPointAssessmentPrice": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "ActualStartDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "LearnerDataId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          }
        }
      },
      "BulkUploadAddAndApproveDraftApprenticeshipsRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "LogId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "BulkUploadAddAndApproveDraftApprenticeships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkUploadAddDraftApprenticeshipRequest"
            }
          }
        }
      },
      "BulkUploadValidateApiRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "CsvRecords": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkUploadAddDraftApprenticeshipRequest"
            }
          },
          "BulkReservationValidationResults": {
            "$ref": "#/components/schemas/BulkReservationValidationResults"
          },
          "ProviderStandardsData": {
            "$ref": "#/components/schemas/ProviderStandardResults"
          },
          "OtjTrainingHours": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "nullable": true
            }
          }
        }
      },
      "BulkReservationValidationResults": {
        "type": "object",
        "properties": {
          "ValidationErrors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkReservationValidation"
            }
          }
        }
      },
      "BulkReservationValidation": {
        "type": "object",
        "properties": {
          "Reason": {
            "type": "string"
          },
          "RowNumber": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ProviderStandardResults": {
        "type": "object",
        "properties": {
          "IsMainProvider": {
            "type": "boolean"
          },
          "Standards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderStandard"
            }
          }
        }
      },
      "ProviderStandard": {
        "type": "object",
        "properties": {
          "CourseCode": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          },
          "Level": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        }
      },
      "FileUploadLogUpdateWithErrorContentRequest": {
        "type": "object",
        "properties": {
          "ErrorContent": {
            "type": "string"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
