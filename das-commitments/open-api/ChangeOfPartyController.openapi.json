{
  "openapi": "3.1.0",
  "info": {
    "title": "Change of Party API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/apprenticeships/{apprenticeshipId}/change-of-party-requests": {
      "get": {
        "summary": "Get all change of party requests for an apprenticeship",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetChangeOfPartyRequestsResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new change of party request for an apprenticeship",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateChangeOfPartyRequestRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/change-of-provider-chain": {
      "get": {
        "summary": "Get change of provider chain for an apprenticeship",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetChangeOfProviderChainResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/change-of-employer-chain": {
      "get": {
        "summary": "Get change of employer chain for an apprenticeship",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetChangeOfEmployerChainResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateChangeOfPartyRequestRequest": {
        "type": "object",
        "properties": {
          "ChangeOfPartyRequestType": {
            "$ref": "#/components/schemas/ChangeOfPartyRequestType"
          },
          "NewPartyId": {
            "type": "integer",
            "format": "int64"
          },
          "NewPrice": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "NewStartDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "NewEndDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "NewEmploymentEndDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "NewEmploymentPrice": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "DeliveryModel": {
            "$ref": "#/components/schemas/DeliveryModel"
          },
          "HasOverlappingTrainingDates": {
            "type": "boolean",
            "default": false
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "ChangeOfPartyRequestType": {
        "type": "string",
        "enum": [
          "ChangeEmployer",
          "ChangeProvider"
        ]
      },
      "DeliveryModel": {
        "type": "string",
        "enum": [
          "Regular",
          "PortableFlexiJob",
          "FlexiJobAgency"
        ]
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string"
          }
        }
      },
      "GetChangeOfPartyRequestsResponse": {
        "type": "object",
        "properties": {
          "Requests": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "GetChangeOfProviderChainResponse": {
        "type": "object",
        "properties": {
          "Chain": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "GetChangeOfEmployerChainResponse": {
        "type": "object",
        "properties": {
          "Chain": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
