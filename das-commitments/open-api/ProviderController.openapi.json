{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/providers": {
      "get": {
        "operationId": "GetAllProviders",
        "summary": "Retrieve all providers",
        "responses": {
          "200": {
            "description": "A list of providers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllProvidersResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/providers/{providerId}": {
      "get": {
        "operationId": "GetProvider",
        "summary": "Retrieve a specific provider by ID",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the provider to retrieve"
          }
        ],
        "responses": {
          "200": {
            "description": "The details of the provider",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProviderResponse"
                }
              }
            }
          },
          "404": {
            "description": "Provider not found"
          }
        }
      }
    },
    "/api/providers/{providerId}/commitmentagreements": {
      "get": {
        "operationId": "GetCommitmentAgreements",
        "summary": "Retrieve the commitment agreements for a specific provider",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the provider whose commitment agreements are to be retrieved"
          }
        ],
        "responses": {
          "200": {
            "description": "The provider's commitment agreements",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProviderCommitmentAgreementResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAllProvidersResponse": {
        "type": "object",
        "properties": {
          "Providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Provider"
            }
          }
        }
      },
      "Provider": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "Name": {
            "type": "string"
          }
        },
        "required": [
          "Ukprn",
          "Name"
        ]
      },
      "GetProviderResponse": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "Name": {
            "type": "string"
          }
        },
        "required": [
          "ProviderId",
          "Name"
        ]
      },
      "GetProviderCommitmentAgreementResponse": {
        "type": "object",
        "properties": {
          "ProviderCommitmentAgreement": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderCommitmentAgreement"
            }
          }
        }
      },
      "ProviderCommitmentAgreement": {
        "type": "object",
        "properties": {
          "LegalEntityName": {
            "type": "string"
          },
          "AccountLegalEntityPublicHashedId": {
            "type": "string"
          }
        },
        "required": [
          "LegalEntityName",
          "AccountLegalEntityPublicHashedId"
        ]
      }
    }
  }
}
