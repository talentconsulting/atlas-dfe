{
  "openapi": "3.1.0",
  "info": {
    "title": "Draft Apprenticeship API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/cohorts/{cohortId}/draft-apprenticeships": {
      "get": {
        "summary": "Get all draft apprenticeships for a cohort",
        "operationId": "getDraftApprenticeships",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDraftApprenticeshipsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Draft apprenticeships not found for the given cohort"
          }
        }
      },
      "post": {
        "summary": "Add a draft apprenticeship to a cohort",
        "operationId": "addDraftApprenticeship",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft apprenticeship successfully added",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddDraftApprenticeshipResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}": {
      "get": {
        "summary": "Get details of a specific draft apprenticeship",
        "operationId": "getDraftApprenticeship",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDraftApprenticeshipResponse"
                }
              }
            }
          },
          "404": {
            "description": "Draft apprenticeship not found"
          }
        }
      },
      "put": {
        "summary": "Update a specific draft apprenticeship",
        "operationId": "updateDraftApprenticeship",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft apprenticeship successfully updated"
          }
        }
      },
      "post": {
        "summary": "Delete a specific draft apprenticeship",
        "operationId": "deleteDraftApprenticeship",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft apprenticeship successfully deleted"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}/prior-learning-summary": {
      "get": {
        "summary": "Get prior learning summary for a draft apprenticeship",
        "operationId": "getDraftApprenticeshipPriorLearningSummary",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDraftApprenticeshipPriorLearningSummaryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Prior learning summary not found"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}/recognise-prior-learning": {
      "post": {
        "summary": "Recognise prior learning for a draft apprenticeship",
        "operationId": "recognisePriorLearning",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecognisePriorLearningRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Prior learning successfully recognised"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}/prior-learning-data": {
      "post": {
        "summary": "Update RPL (Recognising Prior Learning) data",
        "operationId": "updateRplData",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PriorLearningDataRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPL data successfully updated"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}/email": {
      "put": {
        "summary": "Add/Update an apprenticeship email",
        "operationId": "addApprenticeshipEmail",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftApprenticeshipAddEmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email successfully added/updated"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{draftApprenticeshipId}/reference": {
      "put": {
        "summary": "Set reference for a draft apprenticeship",
        "operationId": "setApprenticeshipReference",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "draftApprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftApprenticeshipSetReferenceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reference successfully set"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "Uln": {
            "type": "string"
          },
          "CourseCode": {
            "type": "string"
          },
          "Cost": {
            "type": "integer"
          },
          "StartDate": {
            "type": "string",
            "format": "date"
          },
          "EndDate": {
            "type": "string",
            "format": "date"
          },
          "ReservationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "AddDraftApprenticeshipResponse": {
        "type": "object",
        "properties": {
          "DraftApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "UpdateDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "Uln": {
            "type": "string"
          },
          "CourseCode": {
            "type": "string"
          },
          "Cost": {
            "type": "integer"
          },
          "StartDate": {
            "type": "string",
            "format": "date"
          },
          "EndDate": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "DeleteDraftApprenticeshipRequest": {
        "type": "object"
      },
      "DraftApprenticeshipAddEmailRequest": {
        "type": "object",
        "properties": {
          "Email": {
            "type": "string"
          },
          "Party": {
            "$ref": "#/components/schemas/Party"
          }
        }
      },
      "DraftApprenticeshipSetReferenceRequest": {
        "type": "object",
        "properties": {
          "Reference": {
            "type": "string"
          },
          "Party": {
            "$ref": "#/components/schemas/Party"
          }
        }
      },
      "GetDraftApprenticeshipsResponse": {
        "type": "object",
        "properties": {
          "DraftApprenticeships": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "GetDraftApprenticeshipResponse": {
        "type": "object",
        "properties": {
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "CourseCode": {
            "type": "string"
          }
        }
      },
      "GetDraftApprenticeshipPriorLearningSummaryResponse": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "CohortId": {
            "type": "integer",
            "format": "int64"
          },
          "TrainingTotalHours": {
            "type": "integer"
          },
          "DurationReducedByHours": {
            "type": "integer"
          },
          "PriceReducedBy": {
            "type": "integer"
          },
          "PercentageOfPriorLearning": {
            "type": "number",
            "format": "float"
          },
          "MinimumPercentageReduction": {
            "type": "number",
            "format": "float"
          },
          "MinimumPriceReduction": {
            "type": "integer"
          },
          "FundingBandMaximum": {
            "type": "integer"
          }
        }
      },
      "RecognisePriorLearningRequest": {
        "type": "object",
        "properties": {
          "RecognisePriorLearning": {
            "type": "boolean"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "PriorLearningDataRequest": {
        "type": "object",
        "properties": {
          "TrainingTotalHours": {
            "type": "integer"
          },
          "DurationReducedByHours": {
            "type": "integer"
          },
          "PriceReducedBy": {
            "type": "integer"
          },
          "IsDurationReducedByRpl": {
            "type": "boolean"
          },
          "MinimumOffTheJobTrainingHoursRequired": {
            "type": "integer"
          }
        }
      },
      "Party": {
        "type": "string",
        "enum": [
          "None",
          "Employer",
          "Provider",
          "TransferSender"
        ]
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string"
          }
        }
      }
    }
  }
}
