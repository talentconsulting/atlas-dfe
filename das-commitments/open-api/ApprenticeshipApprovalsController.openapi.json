{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprenticeship Approvals API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/apprenticeships/{apprenticeshipId}/approvals": {
      "get": {
        "summary": "Get Apprenticeship Approval",
        "operationId": "GetApprenticeshipApproval",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response containing the apprenticeship approval details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not Found. No apprenticeship approval details exist for the given ID"
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      },
      "post": {
        "summary": "Process Apprenticeship Approval",
        "operationId": "PostApprenticeshipApproval",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProcessApprenticeshipApprovalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully processed the apprenticeship approval"
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ProcessApprenticeshipApprovalRequest": {
        "type": "object",
        "properties": {
          "ApplyChanges": {
            "type": "boolean",
            "description": "Indicates whether changes should be applied"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "ApplyChanges",
          "UserInfo"
        ]
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string",
            "description": "ID of the user performing the operation"
          },
          "UserDisplayName": {
            "type": "string",
            "description": "Display name of the user"
          },
          "UserEmail": {
            "type": "string",
            "description": "Email of the user"
          }
        },
        "required": [
          "UserId",
          "UserDisplayName",
          "UserEmail"
        ]
      }
    }
  }
}
