{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprenticeships REST API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/apprenticeships/{apprenticeshipId}": {
      "get": {
        "summary": "Retrieve specific apprenticeship details",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/apprenticeships": {
      "get": {
        "summary": "Retrieve a list of apprenticeships",
        "parameters": [
          {
            "in": "query",
            "name": "request",
            "description": "Query parameters for filtering",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/GetApprenticeshipsRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of apprenticeships",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/apprenticeships/filters": {
      "get": {
        "summary": "Get available filter values for apprenticeships",
        "parameters": [
          {
            "in": "query",
            "name": "request",
            "description": "Filter context",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/GetApprenticeshipFiltersRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Filter values",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/apprenticeships/details/editenddate": {
      "post": {
        "summary": "Edit apprenticeship end date",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EditEndDateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "End date updated successfully"
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/stop": {
      "post": {
        "summary": "Stop an apprenticeship",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StopApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Apprenticeship stopped successfully"
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/payments": {
      "patch": {
        "summary": "Patch apprenticeship payments",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchApprenticeshipPaymentsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payments updated successfully"
          }
        }
      }
    },
    "/api/apprenticeships/details/pause": {
      "post": {
        "summary": "Pause an apprenticeship",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PauseApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Apprenticeship paused successfully"
          }
        }
      }
    },
    "/api/apprenticeships/details/resume": {
      "post": {
        "summary": "Resume an apprenticeship",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResumeApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Apprenticeship resumed successfully"
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/stopdate": {
      "put": {
        "summary": "Update apprenticeship stop date",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprenticeshipStopDateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stop date updated successfully"
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/resendinvitation": {
      "post": {
        "summary": "Resend invitation for apprenticeship",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveDataRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Invitation sent successfully"
          }
        }
      }
    },
    "/api/apprenticeships/edit/validate": {
      "post": {
        "summary": "Validate apprenticeship edit",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateApprenticeshipForEditRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation successful"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/apprenticeships/edit": {
      "post": {
        "summary": "Edit apprenticeship details",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EditApprenticeshipApiRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Edit successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EditApprenticeshipResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/apprenticeships/uln/validate": {
      "post": {
        "summary": "Validate Unique Learner Number overlap",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateUlnOverlapRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation successful"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/invalid-ilr-changes": {
      "post": {
        "summary": "Acknowledge invalid ILR changes",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcknowledgeInvalidIlrChangesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Acknowledgement successful"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetApprenticeshipResponse": {
        "type": "object"
      },
      "GetApprenticeshipsRequest": {
        "$ref": "#/components/schemas/GetAllProvidersResponse"
      },
      "GetApprenticeshipsResponse": {
        "type": "object"
      },
      "GetApprenticeshipFiltersRequest": {
        "type": "object"
      },
      "EditEndDateRequest": {
        "type": "object"
      },
      "StopApprenticeshipRequest": {
        "type": "object"
      },
      "PatchApprenticeshipPaymentsRequest": {
        "type": "object"
      },
      "PauseApprenticeshipRequest": {
        "type": "object"
      },
      "ResumeApprenticeshipRequest": {
        "type": "object"
      },
      "ApprenticeshipStopDateRequest": {
        "type": "object"
      },
      "SaveDataRequest": {
        "type": "object"
      },
      "ValidateApprenticeshipForEditRequest": {
        "type": "object"
      },
      "EditApprenticeshipApiRequest": {
        "type": "object"
      },
      "EditApprenticeshipResponse": {
        "type": "object"
      },
      "ValidateUlnOverlapRequest": {
        "type": "object"
      },
      "AcknowledgeInvalidIlrChangesRequest": {
        "type": "object"
      }
    }
  }
}
