{
  "openapi": "3.1.0",
  "info": {
    "title": "Account Legal Entity API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/AccountLegalEntity/{AccountLegalEntityId}": {
      "get": {
        "summary": "Get Account Legal Entity",
        "description": "Retrieves account legal entity details by ID.",
        "operationId": "GetAccountLegalEntity",
        "parameters": [
          {
            "name": "AccountLegalEntityId",
            "in": "path",
            "required": true,
            "description": "Unique identifier for the Account Legal Entity.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account Legal Entity details retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountLegalEntityResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Validation errors."
          },
          "404": {
            "description": "Not Found - Account Legal Entity does not exist."
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AccountLegalEntityResponse": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64",
            "description": "The ID of the account associated with the legal entity."
          },
          "MaLegalEntityId": {
            "type": "integer",
            "format": "int64",
            "description": "The ID of the legal entity."
          },
          "AccountName": {
            "type": "string",
            "description": "The name of the account."
          },
          "LegalEntityName": {
            "type": "string",
            "description": "The name of the legal entity."
          },
          "LevyStatus": {
            "type": "string",
            "description": "The levy status of the employer.",
            "enum": [
              "NonLevy",
              "Levy"
            ]
          }
        },
        "required": [
          "AccountId",
          "MaLegalEntityId",
          "AccountName",
          "LegalEntityName",
          "LevyStatus"
        ]
      }
    },
    "securitySchemes": {
      "Authorization": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT authorization for accessing the API."
      }
    }
  }
}
