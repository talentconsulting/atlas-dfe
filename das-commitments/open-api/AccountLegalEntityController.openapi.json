{
  "openapi": "3.1.0",
  "info": {
    "title": "Account Legal Entity API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/AccountLegalEntity/{accountLegalEntityId}": {
      "get": {
        "summary": "Get Account Legal Entity",
        "operationId": "GetAccountLegalEntity",
        "parameters": [
          {
            "name": "accountLegalEntityId",
            "in": "path",
            "required": true,
            "description": "The ID of the account legal entity",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account legal entity retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountLegalEntityResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "404": {
            "description": "Account legal entity not found"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AccountLegalEntityResponse": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "MaLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountName": {
            "type": "string"
          },
          "LegalEntityName": {
            "type": "string"
          },
          "LevyStatus": {
            "$ref": "#/components/schemas/ApprenticeshipEmployerType"
          }
        },
        "required": [
          "AccountId",
          "MaLegalEntityId",
          "AccountName",
          "LegalEntityName",
          "LevyStatus"
        ]
      },
      "ApprenticeshipEmployerType": {
        "type": "string",
        "enum": [
          "NonLevy",
          "Levy"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
