{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA.DAS.CommitmentsV2 API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/test/provider": {
      "get": {
        "summary": "Get Provider Secure Endpoint",
        "operationId": "GetProvider",
        "responses": {
          "200": {
            "description": "Successful response with a string message."
          }
        },
        "security": [
          {
            "ProviderAuth": []
          }
        ]
      }
    },
    "/api/test/employer": {
      "get": {
        "summary": "Get Employer Secure Endpoint",
        "operationId": "GetEmployer",
        "responses": {
          "200": {
            "description": "Successful response with a string message."
          }
        },
        "security": [
          {
            "EmployerAuth": []
          }
        ]
      }
    },
    "/api/test": {
      "get": {
        "summary": "Get Secure Endpoint",
        "operationId": "Get",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with a string message."
          }
        },
        "security": [
          {
            "GlobalAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Provider": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "Name": {
            "type": "string"
          }
        },
        "required": [
          "Ukprn",
          "Name"
        ]
      },
      "GetAllProvidersResponse": {
        "type": "object",
        "properties": {
          "Providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Provider"
            }
          }
        },
        "required": [
          "Providers"
        ]
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string"
          }
        },
        "required": [
          "UserId",
          "UserDisplayName",
          "UserEmail"
        ]
      },
      "ChangeOfPartyRequest": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          },
          "ChangeOfPartyType": {
            "type": "string"
          },
          "OriginatingParty": {
            "type": "string"
          },
          "Status": {
            "type": "string"
          },
          "EmployerName": {
            "type": "string"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          },
          "Price": {
            "type": "integer",
            "format": "int32"
          },
          "CohortId": {
            "type": "integer",
            "format": "int64"
          },
          "WithParty": {
            "type": "string"
          },
          "NewApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "Id",
          "ChangeOfPartyType",
          "OriginatingParty",
          "Status"
        ]
      }
    },
    "securitySchemes": {
      "ProviderAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Provider authorization via bearer token."
      },
      "EmployerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Employer authorization via bearer token."
      },
      "GlobalAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Global authorization via bearer token."
      }
    }
  }
}
