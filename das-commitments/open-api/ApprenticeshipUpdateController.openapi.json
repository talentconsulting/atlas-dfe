{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprenticeship Updates API",
    "description": "API for managing apprenticeship updates.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/apprenticeships/{apprenticeshipId}/updates": {
      "get": {
        "summary": "Retrieve apprenticeship updates",
        "operationId": "getApprenticeshipUpdates",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "description": "The ID of the apprenticeship",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Filter by update status",
            "schema": {
              "$ref": "#/components/schemas/ApprenticeshipUpdateStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipUpdatesResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/updates/accept-apprenticeship-update": {
      "post": {
        "summary": "Accept apprenticeship updates",
        "operationId": "acceptApprenticeshipUpdates",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "description": "The ID of the apprenticeship",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptApprenticeshipUpdatesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success Response"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/updates/reject-apprenticeship-update": {
      "post": {
        "summary": "Reject apprenticeship updates",
        "operationId": "rejectApprenticeshipUpdates",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "description": "The ID of the apprenticeship",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RejectApprenticeshipUpdatesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success Response"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/updates/undo-apprenticeship-update": {
      "post": {
        "summary": "Undo apprenticeship updates",
        "operationId": "undoApprenticeshipUpdates",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "description": "The ID of the apprenticeship",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UndoApprenticeshipUpdatesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success Response"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ApprenticeshipUpdateStatus": {
        "type": "string",
        "enum": [
          "Pending",
          "Approved",
          "Rejected",
          "Deleted",
          "Superceded",
          "Expired"
        ]
      },
      "GetApprenticeshipUpdatesResponse": {
        "type": "object",
        "properties": {
          "apprenticeshipUpdates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "format": "int64"
                },
                "apprenticeshipId": {
                  "type": "integer",
                  "format": "int64"
                },
                "originatingParty": {
                  "$ref": "#/components/schemas/Party"
                },
                "firstName": {
                  "type": "string"
                },
                "lastName": {
                  "type": "string"
                },
                "email": {
                  "type": "string",
                  "format": "email"
                },
                "deliveryModel": {
                  "$ref": "#/components/schemas/DeliveryModel"
                },
                "employmentEndDate": {
                  "type": "string",
                  "format": "date"
                },
                "employmentPrice": {
                  "type": "integer"
                },
                "trainingType": {
                  "$ref": "#/components/schemas/ProgrammeType"
                },
                "trainingCode": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "option": {
                  "type": "string"
                },
                "trainingName": {
                  "type": "string"
                },
                "cost": {
                  "type": "number",
                  "format": "float"
                },
                "startDate": {
                  "type": "string",
                  "format": "date"
                },
                "endDate": {
                  "type": "string",
                  "format": "date"
                },
                "dateOfBirth": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          }
        }
      },
      "AcceptApprenticeshipUpdatesRequest": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "integer",
            "format": "int64"
          },
          "accountId": {
            "type": "integer",
            "format": "int64"
          },
          "apprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "userInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "RejectApprenticeshipUpdatesRequest": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "integer",
            "format": "int64"
          },
          "accountId": {
            "type": "integer",
            "format": "int64"
          },
          "apprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "userInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "UndoApprenticeshipUpdatesRequest": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "integer",
            "format": "int64"
          },
          "accountId": {
            "type": "integer",
            "format": "int64"
          },
          "apprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "userInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "userDisplayName": {
            "type": "string"
          },
          "userEmail": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "Party": {
        "type": "string",
        "enum": [
          "Employer",
          "Provider",
          "TransferSender",
          "None"
        ]
      },
      "DeliveryModel": {
        "type": "string",
        "enum": [
          "Regular",
          "PortableFlexiJob",
          "FlexiJobAgency"
        ]
      },
      "ProgrammeType": {
        "type": "string",
        "enum": [
          "Standard",
          "Framework"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
