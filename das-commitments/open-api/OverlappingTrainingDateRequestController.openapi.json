{
  "openapi": "3.1.0",
  "info": {
    "title": "Overlapping Training Date Request API",
    "version": "1.0.0",
    "description": "API for managing overlapping training date requests."
  },
  "paths": {
    "/api/overlapping-training-date-request/{providerId}/create": {
      "post": {
        "summary": "Create Overlapping Training Date Request",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the provider."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOverlappingTrainingDateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateOverlappingTrainingDateResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/overlapping-training-date-request/{providerId}/validate": {
      "post": {
        "summary": "Validate Draft Apprenticeship",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the provider."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation successful"
          }
        }
      }
    },
    "/api/overlapping-training-date-request/{providerId}/validateChangeOfEmployerOverlap": {
      "post": {
        "summary": "Validate Change of Employer Overlap",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the provider."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateChangeOfEmployerOverlapRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation successful"
          }
        }
      }
    },
    "/api/overlapping-training-date-request/{providerId}/validateUlnOverlap": {
      "get": {
        "summary": "Validate ULN Overlap on Start Date",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the provider."
          },
          {
            "name": "uln",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique Learner Number (ULN)."
          },
          {
            "name": "startDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Start date."
          },
          {
            "name": "endDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "End date."
          }
        ],
        "responses": {
          "200": {
            "description": "Details of validation results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateUlnOverlapOnStartDateResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/overlapping-training-date-request/{draftApprenticeshipId}/getOverlapRequest": {
      "get": {
        "summary": "Get Pending Overlapping Training Date Request",
        "parameters": [
          {
            "name": "draftApprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the draft apprenticeship."
          }
        ],
        "responses": {
          "200": {
            "description": "Details of the requested overlap",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetOverlapRequestsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/overlapping-training-date-request/{apprenticeshipId}": {
      "get": {
        "summary": "Get Overlapping Training Date Request",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the apprenticeship."
          }
        ],
        "responses": {
          "200": {
            "description": "Details of the training date request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetOverlappingTrainingDateRequestResponce"
                }
              }
            }
          }
        }
      }
    },
    "/api/overlapping-training-date-request/resolve": {
      "post": {
        "summary": "Resolve Overlapping Training Date Request",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResolveApprenticeshipOverlappingTrainingDateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resolution successful"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateOverlappingTrainingDateRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "DraftApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "ProviderId",
          "DraftApprenticeshipId",
          "UserInfo"
        ]
      },
      "CreateOverlappingTrainingDateResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "Id"
        ]
      },
      "ValidateDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          },
          "CohortId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "UserId": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "Uln": {
            "type": "string"
          },
          "CourseCode": {
            "type": "string"
          },
          "DeliveryModel": {
            "type": "string",
            "enum": [
              "Regular",
              "PortableFlexiJob",
              "FlexiJobAgency"
            ],
            "nullable": true
          },
          "Cost": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "TrainingPrice": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "EndPointAssessmentPrice": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "StartDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "ActualStartDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "EndDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "OriginatorReference": {
            "type": "string",
            "nullable": true
          },
          "ReservationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "EmploymentPrice": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "EmploymentEndDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "IgnoreStartDateOverlap": {
            "type": "boolean"
          },
          "LearnerDataId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          }
        },
        "required": [
          "Id",
          "ProviderId",
          "UserId",
          "FirstName",
          "LastName",
          "Email",
          "Uln",
          "CourseCode",
          "IgnoreStartDateOverlap"
        ]
      },
      "ValidateChangeOfEmployerOverlapRequest": {
        "type": "object",
        "properties": {
          "Uln": {
            "type": "string"
          },
          "StartDate": {
            "type": "string",
            "format": "date"
          },
          "EndDate": {
            "type": "string",
            "format": "date"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "Uln",
          "StartDate",
          "EndDate",
          "ProviderId"
        ]
      },
      "ValidateUlnOverlapOnStartDateResponse": {
        "type": "object",
        "properties": {
          "HasOverlapWithApprenticeshipId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "HasStartDateOverlap": {
            "type": "boolean"
          },
          "HasOverlapWithIlrWithdrawnApprenticeship": {
            "type": "boolean"
          }
        },
        "required": [
          "HasStartDateOverlap",
          "HasOverlapWithIlrWithdrawnApprenticeship"
        ]
      },
      "GetOverlapRequestsResponse": {
        "type": "object",
        "properties": {
          "DraftApprenticeshipId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "PreviousApprenticeshipId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "CreatedOn": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "DraftApprenticeshipId",
          "PreviousApprenticeshipId",
          "CreatedOn"
        ]
      },
      "GetOverlappingTrainingDateRequestResponce": {
        "type": "object",
        "properties": {}
      },
      "ResolveApprenticeshipOverlappingTrainingDateRequest": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "ResolutionType": {
            "type": "string",
            "enum": [
              "CompletionDateEvent",
              "ApprenticeshipUpdate",
              "StopDateUpdate",
              "ApprenticeshipStopped",
              "DraftApprenticeshipUpdated",
              "DraftApprenticeshipDeleted",
              "ApprenticeshipIsStillActive",
              "ApprenticeshipEndDateUpdate",
              "ApprenticeshipStopDateIsCorrect",
              "ApprenticeshipEndDateIsCorrect",
              "CohortDeleted"
            ],
            "nullable": true
          }
        },
        "required": [
          "ApprenticeshipId",
          "ResolutionType"
        ]
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "UserId",
          "UserDisplayName",
          "UserEmail"
        ]
      }
    }
  }
}
