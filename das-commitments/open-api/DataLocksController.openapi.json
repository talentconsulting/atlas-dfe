{
  "openapi": "3.1.0",
  "info": {
    "title": "Commitments V2 - DataLocks",
    "version": "1.0.0"
  },
  "paths": {
    "/api/apprenticeships/{apprenticeshipId}/datalocks": {
      "get": {
        "summary": "Retrieve data locks for the specified apprenticeship",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the apprenticeship"
          }
        ],
        "responses": {
          "200": {
            "description": "Data locks retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDataLocksResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/datalocksummaries": {
      "get": {
        "summary": "Retrieve data lock summaries for the specified apprenticeship",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the apprenticeship"
          }
        ],
        "responses": {
          "200": {
            "description": "Data lock summaries retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDataLockSummariesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/datalocks/accept-changes": {
      "post": {
        "summary": "Accept changes for data locks",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the apprenticeship"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptDataLocksRequestChangesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Changes accepted successfully"
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/datalocks/reject-changes": {
      "post": {
        "summary": "Reject changes for data locks",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the apprenticeship"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RejectDataLocksRequestChangesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Changes rejected successfully"
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/datalocks/triage": {
      "post": {
        "summary": "Triage data locks for the specified apprenticeship",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the apprenticeship"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TriageDataLocksRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Data locks triaged successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetDataLocksResponse": {
        "type": "object",
        "properties": {
          "dataLocks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DataLockStatus"
            }
          }
        }
      },
      "GetDataLockSummariesResponse": {
        "type": "object",
        "properties": {
          "dataLockSummaries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DataLockStatusSummary"
            }
          }
        }
      },
      "AcceptDataLocksRequestChangesRequest": {
        "type": "object",
        "properties": {
          "apprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "userInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "RejectDataLocksRequestChangesRequest": {
        "type": "object",
        "properties": {
          "apprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "userInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "TriageDataLocksRequest": {
        "type": "object",
        "properties": {
          "apprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "triageStatus": {
            "$ref": "#/components/schemas/TriageStatus"
          },
          "userInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "userDisplayName": {
            "type": "string"
          },
          "userEmail": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "DataLockStatus": {
        "type": "object",
        "properties": {
          "dataLockEventId": {
            "type": "integer",
            "format": "int64"
          },
          "dataLockEventDatetime": {
            "type": "string",
            "format": "date-time"
          },
          "priceEpisodeIdentifier": {
            "type": "string"
          },
          "apprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "ilrTrainingCourseCode": {
            "type": "string"
          },
          "ilrActualStartDate": {
            "type": "string",
            "format": "date-time"
          },
          "ilrEffectiveFromDate": {
            "type": "string",
            "format": "date-time"
          },
          "ilrPriceEffectiveToDate": {
            "type": "string",
            "format": "date-time"
          },
          "ilrTotalCost": {
            "type": "number",
            "format": "decimal"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "triageStatus": {
            "$ref": "#/components/schemas/TriageStatus"
          },
          "errorCode": {
            "$ref": "#/components/schemas/DataLockErrorCode"
          },
          "eventStatus": {
            "$ref": "#/components/schemas/EventStatus"
          }
        }
      },
      "DataLockStatusSummary": {
        "type": "object",
        "properties": {
          "triageStatus": {
            "$ref": "#/components/schemas/TriageStatus"
          },
          "errorCode": {
            "$ref": "#/components/schemas/DataLockErrorCode"
          },
          "isResolved": {
            "type": "boolean"
          }
        }
      },
      "TriageStatus": {
        "type": "string",
        "enum": [
          "Unknown",
          "Change",
          "Restart",
          "FixIlr"
        ]
      },
      "Status": {
        "type": "string",
        "enum": [
          "Unknown",
          "Pass",
          "Fail"
        ]
      },
      "DataLockErrorCode": {
        "type": "string",
        "enum": [
          "None",
          "Dlock01",
          "Dlock02",
          "Dlock03",
          "Dlock04",
          "Dlock05",
          "Dlock06",
          "Dlock07",
          "Dlock08",
          "Dlock09",
          "Dlock10"
        ]
      },
      "EventStatus": {
        "type": "string",
        "enum": [
          "None",
          "New",
          "Updated",
          "Removed"
        ]
      }
    }
  }
}
