{
  "openapi": "3.1.0",
  "info": {
    "title": "Commitments API",
    "version": "1.0.0",
    "description": "API for managing courses and related entities in the Commitments V2 project"
  },
  "paths": {
    "/api/courses": {
      "get": {
        "operationId": "GetAllCourses",
        "summary": "Retrieve all courses",
        "description": "Fetches all available courses.",
        "responses": {
          "200": {
            "description": "A list of courses",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllCoursesResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "Courses"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "GetAllCoursesResponse": {
        "type": "object",
        "properties": {
          "courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Course"
            }
          }
        },
        "required": [
          "courses"
        ]
      },
      "Course": {
        "type": "object",
        "properties": {
          "larsCode": {
            "type": "string",
            "description": "Unique identifier for the course."
          },
          "title": {
            "type": "string",
            "description": "The title of the course."
          },
          "level": {
            "type": "string",
            "description": "The level of the course."
          },
          "learningType": {
            "type": "string",
            "enum": [
              "Apprenticeship",
              "FoundationApprenticeship",
              "ApprenticeshipUnit"
            ],
            "description": "The learning type of the course."
          },
          "maxFunding": {
            "type": "integer",
            "description": "The maximum funding available for the course."
          },
          "effectiveFrom": {
            "type": "string",
            "format": "date-time",
            "description": "The effective start date of the course."
          },
          "effectiveTo": {
            "type": "string",
            "format": "date-time",
            "description": "The effective end date of the course, if applicable."
          }
        },
        "required": [
          "larsCode",
          "title",
          "level",
          "learningType",
          "maxFunding"
        ]
      }
    }
  }
}
