{
  "openapi": "3.1.0",
  "info": {
    "title": "Commitments V2 API",
    "version": "1.0.0",
    "description": "API documentation for Commitments V2."
  },
  "paths": {
    "/api/courses": {
      "get": {
        "summary": "Get All Courses",
        "operationId": "GetAllCourses",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "A list of all courses.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllCoursesResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAllCoursesResponse": {
        "type": "object",
        "properties": {
          "Courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Course"
            }
          }
        }
      },
      "Course": {
        "type": "object",
        "properties": {
          "LarsCode": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Level": {
            "type": "string"
          },
          "LearningType": {
            "type": "string",
            "enum": [
              "Apprenticeship",
              "FoundationApprenticeship",
              "ApprenticeshipUnit"
            ]
          },
          "MaxFunding": {
            "type": "integer",
            "format": "int32"
          },
          "EffectiveFrom": {
            "type": "string",
            "format": "date-time"
          },
          "EffectiveTo": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
