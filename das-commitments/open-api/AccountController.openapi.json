{
  "openapi": "3.1.0",
  "info": {
    "title": "Commitments API",
    "version": "1.0.0",
    "description": "API for managing commitments-related operations in the SFA system."
  },
  "paths": {
    "/api/accounts/{accountId}": {
      "get": {
        "summary": "Get Account Summary",
        "description": "Fetches an account summary for the specified account ID.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the account.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account summary response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/accounts/{accountId}/transfer-status": {
      "get": {
        "summary": "Get Account Transfer Status",
        "description": "Fetches transfer status for the specified account ID.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the account.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transfer status response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountTransferStatusResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/accounts/{accountId}/status": {
      "get": {
        "summary": "Get Account Status",
        "description": "Fetches the status of the specified account ID including additional filters.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the account.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "completionLag",
            "in": "query",
            "required": true,
            "description": "Completion lag filter.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "startLag",
            "in": "query",
            "required": true,
            "description": "Start lag filter.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "newStartWindow",
            "in": "query",
            "required": true,
            "description": "New start window filter.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account status response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountStatusResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/accounts/{accountId}/providers/approved": {
      "get": {
        "summary": "Get Approved Providers",
        "description": "Fetches approved providers for the specified account ID.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the account.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Approved providers response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprovedProvidersResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/accounts/{accountId}/provider-payments-priority": {
      "get": {
        "summary": "Get Provider Payments Priority",
        "description": "Fetches provider payments priority for the specified account ID.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the account.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider payments priority response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProviderPaymentsPriorityResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/accounts/{accountId}/summary": {
      "get": {
        "summary": "Get Employer Account Summary",
        "description": "Fetches an employer account summary for the specified account ID.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the account.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employer account summary response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipStatusSummaryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/accounts/{accountId}/pending-apprentice-changes": {
      "get": {
        "summary": "Get Pending Apprentice Changes",
        "description": "Fetches pending apprentice changes for the specified account ID.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the account.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pending apprentice changes response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipUpdatesResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/accounts/{accountId}/pending-learner-change-counts": {
      "get": {
        "summary": "Get Pending Learner Change Counts",
        "description": "Fetches pending learner change counts for the specified account ID.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the account.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pending learner change counts response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPendingLearnerChangeCountsForEmployerQueryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/accounts/{accountId}/update-provider-payments-priority": {
      "post": {
        "summary": "Update Provider Payments Priority",
        "description": "Updates provider payments priority for the specified account ID.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the account.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "description": "Priority update request payload.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProviderPaymentsPriorityRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Update successful."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AccountResponse": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "HasCohorts": {
            "type": "boolean"
          },
          "HasApprenticeships": {
            "type": "boolean"
          },
          "LevyStatus": {
            "$ref": "#/components/schemas/ApprenticeshipEmployerType"
          }
        },
        "required": [
          "AccountId",
          "HasCohorts",
          "HasApprenticeships",
          "LevyStatus"
        ]
      },
      "AccountStatusResponse": {
        "type": "object",
        "properties": {
          "Active": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountStatusProviderCourse"
            }
          },
          "Completed": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountStatusProviderCourse"
            }
          },
          "NewStart": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountStatusProviderCourse"
            }
          }
        }
      },
      "AccountStatusProviderCourse": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "CourseCode": {
            "type": "string"
          }
        },
        "required": [
          "Ukprn",
          "CourseCode"
        ]
      },
      "AccountTransferStatusResponse": {
        "type": "object",
        "properties": {
          "IsTransferSender": {
            "type": "boolean"
          },
          "IsTransferReceiver": {
            "type": "boolean"
          }
        }
      },
      "GetApprovedProvidersResponse": {
        "type": "object",
        "properties": {
          "ProviderIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          }
        }
      },
      "GetPendingLearnerChangeCountsForEmployerQueryResponse": {
        "type": "object",
        "properties": {
          "ManualPendingChangeCount": {
            "type": "integer"
          },
          "IlrPendingChangeCount": {
            "type": "integer"
          }
        }
      },
      "UpdateProviderPaymentsPriorityRequest": {
        "type": "object",
        "properties": {
          "ProviderPriorities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderPaymentPriorityUpdateItem"
            }
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "ProviderPriorities",
          "UserInfo"
        ]
      },
      "ProviderPaymentPriorityUpdateItem": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "PriorityOrder": {
            "type": "integer"
          }
        },
        "required": [
          "ProviderId",
          "PriorityOrder"
        ]
      },
      "GetApprenticeshipStatusSummaryResponse": {
        "type": "object",
        "properties": {}
      },
      "GetApprenticeshipUpdatesResponse": {
        "type": "object",
        "properties": {}
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string"
          }
        }
      },
      "ApprenticeshipEmployerType": {
        "type": "string",
        "enum": [
          "NonLevy",
          "Levy"
        ]
      }
    }
  }
}
