{
  "openapi": "3.1.0",
  "info": {
    "title": "Commitments API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/cohorts": {
      "get": {
        "summary": "Get Cohorts",
        "operationId": "GetCohorts",
        "parameters": [
          {
            "name": "AccountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "ProviderId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fetched cohorts successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCohortsResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Cohort",
        "operationId": "CreateCohort",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCohortRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created cohort successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCohortResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/create-with-other-party": {
      "post": {
        "summary": "Create Cohort with Other Party",
        "operationId": "CreateCohortWithOtherParty",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCohortWithOtherPartyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created cohort with other party successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCohortResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/create-empty-cohort": {
      "post": {
        "summary": "Create Empty Cohort",
        "operationId": "CreateEmptyCohort",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEmptyCohortRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created empty cohort successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCohortResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/{cohortId}": {
      "get": {
        "summary": "Get Cohort by ID",
        "operationId": "GetCohortById",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fetched cohort successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCohortResponse"
                }
              }
            }
          },
          "404": {
            "description": "Cohort not found."
          }
        }
      }
    },
    "/api/cohorts/{cohortId:long}/email-overlaps": {
      "get": {
        "summary": "Get Email Overlaps for Cohort",
        "operationId": "GetEmailOverlaps",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fetched email overlaps successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetEmailOverlapsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/accountIds": {
      "get": {
        "summary": "Get All Account IDs",
        "operationId": "GetAllAccountIds",
        "responses": {
          "200": {
            "description": "Fetched account IDs successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllCohortAccountIdsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/{cohortId:long}/send": {
      "post": {
        "summary": "Send Cohort",
        "operationId": "SendCohort",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendCohortRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cohort sent successfully."
          }
        }
      }
    },
    "/api/cohorts/{cohortId:long}/approve": {
      "post": {
        "summary": "Approve Cohort",
        "operationId": "ApproveCohort",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApproveCohortRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cohort approved successfully."
          }
        }
      }
    },
    "/api/cohorts/{cohortId:long}/delete": {
      "post": {
        "summary": "Delete Cohort",
        "operationId": "DeleteCohort",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserInfo"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Cohort deleted successfully."
          }
        }
      }
    },
    "/api/cohorts/{cohortId:long}/prior-learning-errors": {
      "get": {
        "summary": "Get Prior Learning Errors",
        "operationId": "GetPriorLearningErrors",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fetched prior learning errors successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCohortPriorLearningErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/support-status": {
      "get": {
        "summary": "Get Support Status",
        "operationId": "GetSupportStatus",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fetched support status successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Support status not found."
          }
        }
      }
    },
    "/api/cohorts/{cohortId:long}/approved-apprenticeships": {
      "get": {
        "summary": "Get Approved Apprenticeships",
        "operationId": "GetApprovedApprenticeships",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fetched approved apprenticeships successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetCohortsRequest": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          }
        }
      },
      "CreateCohortRequest": {
        "type": "object",
        "properties": {
          "RequestingParty": {
            "$ref": "#/components/schemas/Party",
            "nullable": true
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "Uln": {
            "type": "string"
          }
        }
      },
      "CreateCohortWithOtherPartyRequest": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "Message": {
            "type": "string"
          },
          "TransferSenderId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          }
        }
      },
      "CreateEmptyCohortRequest": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "CreateCohortResponse": {
        "type": "object",
        "properties": {
          "CohortId": {
            "type": "integer",
            "format": "int64"
          },
          "CohortReference": {
            "type": "string"
          }
        }
      },
      "GetCohortsResponse": {
        "type": "object",
        "properties": {
          "Cohorts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CohortSummary"
            }
          }
        }
      },
      "CohortSummary": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "LegalEntityName": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderName": {
            "type": "string"
          },
          "CohortId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "GetCohortResponse": {
        "type": "object",
        "properties": {
          "CohortId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "LegalEntityName": {
            "type": "string"
          }
        }
      },
      "GetEmailOverlapsResponse": {
        "type": "object",
        "properties": {
          "ApprenticeshipEmailOverlaps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprenticeshipEmailOverlap"
            }
          }
        }
      },
      "ApprenticeshipEmailOverlap": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          },
          "ErrorMessage": {
            "type": "string"
          }
        }
      },
      "GetAllCohortAccountIdsResponse": {
        "type": "object",
        "properties": {
          "AccountIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          }
        }
      },
      "SendCohortRequest": {
        "type": "object",
        "properties": {
          "RequestingParty": {
            "$ref": "#/components/schemas/Party",
            "nullable": true
          },
          "Message": {
            "type": "string"
          }
        }
      },
      "ApproveCohortRequest": {
        "type": "object",
        "properties": {
          "RequestingParty": {
            "$ref": "#/components/schemas/Party",
            "nullable": true
          },
          "Message": {
            "type": "string"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string"
          }
        }
      },
      "GetCohortPriorLearningErrorResponse": {
        "type": "object",
        "properties": {
          "DraftApprenticeshipIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          }
        }
      },
      "Party": {
        "type": "string",
        "enum": [
          "None",
          "Employer",
          "Provider",
          "TransferSender"
        ]
      }
    }
  }
}
