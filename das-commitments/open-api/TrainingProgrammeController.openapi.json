      "get": {
        "operationId": "getTrainingProgrammeVersionByCourseCodeAndVersion",
        "summary": "Get training programme version by course code and version",
        "parameters": [
          {
            "name": "courseCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
