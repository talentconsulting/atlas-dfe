{
  "openapi": "3.1.0",
  "info": {
    "title": "Training Programme API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/trainingprogramme/all": {
      "get": {
        "operationId": "GetAllTrainingProgrammes",
        "description": "Fetches all training programmes.",
        "responses": {
          "200": {
            "description": "Training programmes retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllTrainingProgrammesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    },
    "/api/trainingprogramme/standards": {
      "get": {
        "operationId": "GetAllTrainingProgrammeStandards",
        "description": "Fetches all training programme standards.",
        "responses": {
          "200": {
            "description": "Training programme standards retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllTrainingProgrammeStandardsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    },
    "/api/trainingprogramme/{id}": {
      "get": {
        "operationId": "GetTrainingProgramme",
        "description": "Fetches a specific training programme.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Training programme retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTrainingProgrammeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Training programme not found."
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    },
    "/api/trainingprogramme/{standardUId}/version": {
      "get": {
        "operationId": "GetTrainingProgrammeVersionByStandardUId",
        "description": "Fetches training programme version by standardUId.",
        "parameters": [
          {
            "name": "standardUId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Training programme version retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTrainingProgrammeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Training programme version not found."
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    },
    "/api/trainingprogramme/{courseCode}/version/{version}": {
      "get": {
        "operationId": "GetTrainingProgrammeVersionByCourseCodeAndVersion",
        "description": "Fetches training programme version by course code and version.",
        "parameters": [
          {
            "name": "courseCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Training programme version retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTrainingProgrammeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Training programme version not found."
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    },
    "/api/trainingprogramme/{id}/versions": {
      "get": {
        "operationId": "GetTrainingProgrammeVersions",
        "description": "Fetches all versions of a specific training programme.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Training programme versions retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTrainingProgrammeVersionsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Training programme versions not found."
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    },
    "/api/trainingprogramme/{standardUId}/newer-versions": {
      "get": {
        "operationId": "GetNewerTrainingProgrammeVersions",
        "description": "Fetches newer versions of a specific training programme.",
        "parameters": [
          {
            "name": "standardUId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Newer training programme versions retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetNewerTrainingProgrammeVersionsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    },
    "/api/trainingprogramme/calculate-version/{courseCode}": {
      "get": {
        "operationId": "GetCalculatedTrainingProgrammeVersion",
        "description": "Calculates and fetches a specific training programme version.",
        "parameters": [
          {
            "name": "courseCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Training programme version calculated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTrainingProgrammeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Training programme not found."
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAllTrainingProgrammesResponse": {
        "type": "object",
        "properties": {
          "trainingProgrammes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgramme"
            }
          }
        }
      },
      "GetAllTrainingProgrammeStandardsResponse": {
        "type": "object",
        "properties": {
          "trainingProgrammes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgramme"
            }
          }
        }
      },
      "GetTrainingProgrammeResponse": {
        "type": "object",
        "properties": {
          "trainingProgramme": {
            "$ref": "#/components/schemas/TrainingProgramme"
          }
        }
      },
      "GetTrainingProgrammeVersionsResponse": {
        "type": "object",
        "properties": {
          "trainingProgrammeVersions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgramme"
            }
          }
        }
      },
      "GetNewerTrainingProgrammeVersionsResponse": {
        "type": "object",
        "properties": {
          "newerVersions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgramme"
            }
          }
        }
      },
      "GetTrainingProgrammeVersionRequest": {
        "type": "object",
        "properties": {
          "startDate": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "startDate"
        ]
      },
      "TrainingProgramme": {
        "type": "object",
        "properties": {
          "courseCode": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "standardUId": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "nullable": true
          },
          "programmeType": {
            "$ref": "#/components/schemas/ProgrammeType"
          },
          "effectiveFrom": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "effectiveTo": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "standardPageUrl": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fundingPeriods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgrammeFundingPeriod"
            }
          },
          "versionEarliestStartDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "versionLatestStartDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          }
        }
      },
      "TrainingProgrammeFundingPeriod": {
        "type": "object",
        "properties": {
          "fundingCap": {
            "type": "integer"
          },
          "effectiveFrom": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "effectiveTo": {
            "type": "string",
            "format": "date",
            "nullable": true
          }
        }
      },
      "ProgrammeType": {
        "type": "string",
        "enum": [
          "Standard",
          "Framework"
        ]
      }
    }
  }
}
