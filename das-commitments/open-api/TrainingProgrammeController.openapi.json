      "get": {
        "operationId": "getCalculatedTrainingProgrammeVersion",
        "summary": "Get calculated training programme version by course code and optional parameters",
        "parameters": [
          {
            "name": "courseCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
