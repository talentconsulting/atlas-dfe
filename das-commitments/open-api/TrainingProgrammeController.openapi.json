  "components": {
    "schemas": {
      "TrainingProgramme": {
        "type": "object",
        "properties": {
          "courseCode": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "standardUId": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "nullable": true
          },
          "effectiveFrom": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "effectiveTo": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "fundingPeriods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgrammeFundingPeriod"
            }
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "TrainingProgrammeFundingPeriod": {
        "type": "object",
        "properties": {
          "fundingCap": {
            "type": "integer"
          },
          "effectiveFrom": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "effectiveTo": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "GetAllTrainingProgrammesResponse": {
        "type": "object",
        "properties": {
          "trainingProgrammes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgramme"
            }
          }
        }
      },
      "GetAllTrainingProgrammeStandardsResponse": {
        "type": "object",
        "properties": {
          "trainingProgrammes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgramme"
            }
          }
        }
      },
      "GetTrainingProgrammeResponse": {
        "type": "object",
        "properties": {
          "trainingProgramme": {
            "$ref": "#/components/schemas/TrainingProgramme"
          }
        }
      },
      "GetTrainingProgrammeVersionsResponse": {
        "type": "object",
        "properties": {
          "trainingProgrammeVersions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgramme"
            }
          }
        }
      },
      "GetNewerTrainingProgrammeVersionsResponse": {
        "type": "object",
        "properties": {
          "newerVersions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgramme"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://auth.example.com/oauth/authorize",
            "tokenUrl": "https://auth.example.com/oauth/token",
            "scopes": {}
          }
        }
      }
    }
  }
