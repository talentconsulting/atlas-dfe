@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_campaign_api, "Campaign") {
  Container(c_campaign, "Campaign", "API")
}

SystemDb_Ext(d_configuration_store_azure_table_storage_configuration, "Azure Table Storage configuration")
SystemDb_Ext(d_database_campaign_database, "Campaign Database", "Microsoft SQL Server")
System_Ext(d_identity_provider_microsoft_entra_id, "Microsoft Entra ID")
System_Ext(d_telemetry_application_insights, "Application Insights")

Rel(c_campaign, d_configuration_store_azure_table_storage_configuration, "Reads configuration from")
Rel(c_campaign, d_database_campaign_database, "Reads from and writes to", "Microsoft SQL Server")
Rel(c_campaign, d_identity_provider_microsoft_entra_id, "Authenticates with")
Rel(c_campaign, d_telemetry_application_insights, "Sends telemetry to")

@enduml
