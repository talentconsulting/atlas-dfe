@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_campaign_api, "Campaign") {
  Container(c_campaign, "Campaign", "API")
}

System_Ext(d_cloud_service_azure_table_storage, "Azure Table Storage", "Azure Table Storage")
SystemDb_Ext(d_database_sql_server, "SQL Server", "Entity Framework Core")

Rel(c_campaign, d_cloud_service_azure_table_storage, "Uses", "Azure Table Storage")
Rel(c_campaign, d_database_sql_server, "Reads from and writes to", "Entity Framework Core")

@enduml
