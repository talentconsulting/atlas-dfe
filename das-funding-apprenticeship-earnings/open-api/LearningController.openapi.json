{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprenticeship Earnings Inner API",
    "version": "1.0.0"
  },
  "paths": {
    "/learning": {
      "post": {
        "operationId": "CreateUnapprovedApprenticeshipLearning",
        "summary": "Create unapproved apprenticeship learning",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUnapprovedApprenticeshipLearningRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully created unapproved apprenticeship learning"
          },
          "500": {
            "description": "Error creating unapproved apprenticeship learning"
          }
        }
      }
    },
    "/learning/{learningKey}/english-and-maths": {
      "put": {
        "operationId": "SaveMathsAndEnglish",
        "summary": "Update English and Maths for an apprenticeship",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateEnglishAndMathsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully updated English and Maths",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateEnglishAndMathsResult"
                }
              }
            }
          },
          "500": {
            "description": "Error updating English and Maths"
          }
        }
      }
    },
    "/learning/{learningKey}/on-programme": {
      "put": {
        "operationId": "UpdateOnProgramme",
        "summary": "Update on-programme details for an apprenticeship",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateOnProgrammeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully updated on-programme details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateOnProgrammeResult"
                }
              }
            }
          },
          "500": {
            "description": "Error updating on-programme details"
          }
        }
      }
    },
    "/learning/{learningKey}/release-earnings": {
      "post": {
        "operationId": "ReleaseEarnings",
        "summary": "Release earnings for an apprenticeship",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReleaseEarningsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully released earnings"
          },
          "500": {
            "description": "Error releasing earnings"
          }
        }
      }
    },
    "/learning/{learningKey}": {
      "delete": {
        "operationId": "RemoveLearner",
        "summary": "Remove a learner by learning key",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully removed learner"
          },
          "500": {
            "description": "Error removing learner"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateUnapprovedApprenticeshipLearningRequest": {
        "type": "object",
        "properties": {
          "LearningKey": {
            "type": "string",
            "format": "uuid"
          },
          "EpisodeKey": {
            "type": "string",
            "format": "uuid"
          },
          "ApprovalsApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "Learner": {
            "$ref": "#/components/schemas/DraftApprenticeshipLearner"
          },
          "OnProgramme": {
            "$ref": "#/components/schemas/DraftApprenticeshipOnProgramme"
          },
          "CompletionDate": {
            "type": "string",
            "format": "date-time"
          },
          "WithdrawalDate": {
            "type": "string",
            "format": "date-time"
          },
          "PauseDate": {
            "type": "string",
            "format": "date-time"
          },
          "AchievementDate": {
            "type": "string",
            "format": "date-time"
          },
          "Prices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LearningEpisodePrice"
            }
          },
          "PeriodsInLearning": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprenticeshipPeriodInLearningItem"
            }
          },
          "EnglishAndMaths": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DraftEnglishAndMathsItem"
            }
          },
          "LearningSupport": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LearningSupportItem"
            }
          },
          "IsNewApprenticeshipLearner": {
            "type": "boolean"
          }
        },
        "required": [
          "LearningKey",
          "EpisodeKey",
          "ApprovalsApprenticeshipId",
          "Learner",
          "OnProgramme",
          "IsNewApprenticeshipLearner"
        ]
      },
      "DraftApprenticeshipLearner": {
        "type": "object",
        "properties": {
          "DateOfBirth": {
            "type": "string",
            "format": "date-time"
          },
          "Uln": {
            "type": "string"
          },
          "Care": {
            "$ref": "#/components/schemas/DraftCare"
          }
        },
        "required": [
          "DateOfBirth",
          "Uln",
          "Care"
        ]
      },
      "DraftApprenticeshipOnProgramme": {
        "type": "object",
        "properties": {
          "TrainingCode": {
            "type": "string"
          },
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "EmployerAccountId": {
            "type": "integer",
            "format": "int64"
          },
          "FundingEmployerAccountId": {
            "type": "integer",
            "format": "int64"
          },
          "LegalEntityName": {
            "type": "string"
          },
          "EmployerType": {
            "$ref": "#/components/schemas/EmployerType"
          },
          "FundingBandMaximum": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "TrainingCode",
          "Ukprn",
          "EmployerAccountId",
          "LegalEntityName",
          "EmployerType"
        ]
      },
      "UpdateEnglishAndMathsRequest": {
        "type": "object",
        "properties": {
          "EnglishAndMaths": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnglishAndMathsItem"
            }
          }
        },
        "required": [
          "EnglishAndMaths"
        ]
      },
      "UpdateOnProgrammeRequest": {
        "type": "object",
        "properties": {
          "ApprenticeshipEpisodeKey": {
            "type": "string",
            "format": "uuid"
          },
          "CompletionDate": {
            "type": "string",
            "format": "date-time"
          },
          "WithdrawalDate": {
            "type": "string",
            "format": "date-time"
          },
          "PauseDate": {
            "type": "string",
            "format": "date-time"
          },
          "AchievementDate": {
            "type": "string",
            "format": "date-time"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date-time"
          },
          "FundingBandMaximum": {
            "type": "integer",
            "format": "int32"
          },
          "IncludesFundingBandMaximumUpdate": {
            "type": "boolean"
          },
          "Prices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LearningEpisodePrice"
            }
          },
          "PeriodsInLearning": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PeriodInLearningItem"
            }
          },
          "Care": {
            "$ref": "#/components/schemas/Care"
          },
          "LearningSupport": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LearningSupportItem"
            }
          }
        },
        "required": [
          "ApprenticeshipEpisodeKey",
          "DateOfBirth",
          "IncludesFundingBandMaximumUpdate",
          "Care"
        ]
      },
      "ReleaseEarningsRequest": {
        "type": "object",
        "properties": {
          "LearnerKey": {
            "type": "string",
            "format": "uuid"
          },
          "LearnerRef": {
            "type": "string"
          },
          "ReleaseType": {
            "$ref": "#/components/schemas/ReleaseType"
          },
          "EnglishAndMathsCourseKeys": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "LearnerKey",
          "LearnerRef",
          "ReleaseType"
        ]
      },
      "EmployerType": {
        "type": "string",
        "enum": [
          "NonLevy",
          "Levy"
        ]
      },
      "ReleaseType": {
        "type": "string",
        "enum": [
          "All",
          "OnProgramme",
          "FunctionalSkill"
        ]
      },
      "UpdateEnglishAndMathsResult": {
        "type": "object"
      },
      "UpdateOnProgrammeResult": {
        "type": "object"
      },
      "DraftCare": {
        "type": "object",
        "properties": {
          "HasEHCP": {
            "type": "boolean"
          },
          "IsCareLeaver": {
            "type": "boolean"
          },
          "CareLeaverEmployerConsentGiven": {
            "type": "boolean"
          }
        },
        "required": [
          "HasEHCP",
          "IsCareLeaver",
          "CareLeaverEmployerConsentGiven"
        ]
      },
      "LearningSupportItem": {
        "type": "object",
        "properties": {
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "StartDate",
          "EndDate"
        ]
      },
      "EnglishAndMathsItem": {
        "type": "object",
        "properties": {
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          },
          "Course": {
            "type": "string"
          },
          "LearnAimRef": {
            "type": "string"
          },
          "Amount": {
            "type": "number",
            "format": "decimal"
          },
          "CombinedFundingAdjustmentPercentage": {
            "type": "number",
            "format": "decimal"
          },
          "PauseDate": {
            "type": "string",
            "format": "date-time"
          },
          "WithdrawalDate": {
            "type": "string",
            "format": "date-time"
          },
          "CompletionDate": {
            "type": "string",
            "format": "date-time"
          },
          "PeriodsInLearning": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PeriodsInLearningItem"
            }
          },
          "LearningSupport": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LearningSupportItem"
            }
          }
        },
        "required": [
          "StartDate",
          "EndDate",
          "Course",
          "LearnAimRef",
          "Amount"
        ]
      },
      "PeriodInLearningItem": {
        "type": "object",
        "properties": {
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          },
          "OriginalExpectedEndDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "StartDate",
          "OriginalExpectedEndDate"
        ]
      },
      "Care": {
        "type": "object",
        "properties": {
          "HasEHCP": {
            "type": "boolean"
          },
          "IsCareLeaver": {
            "type": "boolean"
          },
          "CareLeaverEmployerConsentGiven": {
            "type": "boolean"
          }
        },
        "required": [
          "HasEHCP",
          "IsCareLeaver",
          "CareLeaverEmployerConsentGiven"
        ]
      }
    }
  }
}
