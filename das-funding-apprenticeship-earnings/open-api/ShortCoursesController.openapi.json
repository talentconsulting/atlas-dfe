{
  "openapi": "3.1.0",
  "info": {
    "title": "Short Courses API",
    "version": "1.0.0"
  },
  "paths": {
    "/shortCourses": {
      "post": {
        "operationId": "CreateUnapprovedShortCourseLearning",
        "summary": "Create an unapproved short course learning entry.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUnapprovedShortCourseLearningRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully created the unapproved short course learning."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/fm99/{learningKey}/shortCourses": {
      "get": {
        "operationId": "GetFm99ShortCourseEarnings",
        "summary": "Retrieve FM99 short course earnings for a learning key.",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "ukprn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "collectionYear",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int16"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved short course earnings.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/{learningKey}/shortCourses/{episodeKey}/on-programme": {
      "put": {
        "operationId": "UpdateOnProgramme",
        "summary": "Update short course on-programme information.",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "episodeKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateShortCourseOnProgrammeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully updated short course on-programme.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/{learningKey}/shortCourses/{episodeKey}": {
      "get": {
        "operationId": "GetShortCourse",
        "summary": "Retrieve a specific short course by learning and episode keys.",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "episodeKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the short course.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "delete": {
        "operationId": "RemoveShortCourseLearning",
        "summary": "Delete a short course learning entry.",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "episodeKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "learnerKey",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "learnerRef",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully removed short course learning.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateUnapprovedShortCourseLearningRequest": {
        "type": "object",
        "properties": {
          "LearningKey": {
            "type": "string",
            "format": "uuid"
          },
          "EpisodeKey": {
            "type": "string",
            "format": "uuid"
          },
          "Learner": {
            "$ref": "#/components/schemas/Learner"
          },
          "LearningSupport": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LearningSupportItem"
            }
          },
          "OnProgramme": {
            "$ref": "#/components/schemas/OnProgramme"
          }
        }
      },
      "Learner": {
        "type": "object",
        "properties": {
          "DateOfBirth": {
            "type": "string",
            "format": "date-time"
          },
          "Uln": {
            "type": "string"
          }
        }
      },
      "LearningSupportItem": {
        "type": "object",
        "properties": {
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OnProgramme": {
        "type": "object",
        "properties": {
          "CourseCode": {
            "type": "string"
          },
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "WithdrawalDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "CompletionDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "ExpectedEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "Milestones": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Milestone"
            }
          },
          "TotalPrice": {
            "type": "number",
            "format": "decimal"
          }
        }
      },
      "Milestone": {
        "type": "integer",
        "enum": [
          1,
          2
        ]
      },
      "UpdateShortCourseOnProgrammeRequest": {
        "type": "object",
        "properties": {
          "WithdrawalDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "Milestones": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Milestone"
            }
          },
          "CompletionDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "ExpectedEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "LearnerKey": {
            "type": "string",
            "format": "uuid"
          },
          "LearnerRef": {
            "type": "string"
          }
        }
      }
    }
  }
}
