{
  "openapi": "3.1.0",
  "info": {
    "title": "Add Provider - Select Offer Apprenticeships API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/new/offer-apprenticeships": {
      "get": {
        "operationId": "SelectOfferApprenticeships_Index_Get",
        "summary": "Get view to select offering apprenticeships options",
        "responses": {
          "200": {
            "description": "View rendered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfferApprenticeshipsViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirects to another route based on session data"
          }
        }
      },
      "post": {
        "operationId": "SelectOfferApprenticeships_Index_Post",
        "summary": "Submit offering apprenticeships selection",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OfferApprenticeshipsSubmitModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation errors occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfferApprenticeshipsViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirects to another route based on session data"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OfferApprenticeshipsViewModel": {
        "type": "object",
        "properties": {
          "IsApprenticeshipsOffered": {
            "type": "boolean",
            "nullable": true
          },
          "ApprenticeshipsSelection": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprenticeshipsSelectionModel"
            }
          }
        }
      },
      "OfferApprenticeshipsSubmitModel": {
        "type": "object",
        "properties": {
          "IsApprenticeshipsOffered": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "ApprenticeshipsSelectionModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "boolean"
          },
          "Description": {
            "type": "string"
          },
          "IsSelected": {
            "type": "boolean"
          }
        },
        "required": [
          "Id",
          "Description"
        ]
      }
    }
  }
}
