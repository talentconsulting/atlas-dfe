{
  "openapi": "3.1.0",
  "info": {
    "title": "Restricted Course Details API",
    "version": "1.0.0"
  },
  "paths": {
    "/restricted-courses/{larsCode}": {
      "get": {
        "summary": "Retrieve details of a restricted course",
        "operationId": "GetRestrictedCourseDetails",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique identifier for the course (LARS Code)"
          },
          {
            "name": "SearchTerm",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Search term for filtering"
          },
          {
            "name": "DeliveryStatus",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/DeliveryStatus"
              }
            },
            "description": "Filter by delivery statuses"
          },
          {
            "name": "PageNumber",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Page number for pagination"
          }
        ],
        "responses": {
          "200": {
            "description": "Details of the restricted course",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestrictedCourseDetailsViewModel"
                }
              }
            }
          },
          "404": {
            "description": "Course not found"
          }
        },
        "security": [
          {
            "RoatpAdminTeamAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "GetRestrictedCourseDetailsRequestModel": {
        "type": "object",
        "properties": {
          "SearchTerm": {
            "type": "string"
          },
          "DeliveryStatus": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeliveryStatus"
            }
          },
          "PageNumber": {
            "type": "integer"
          },
          "HasSearchTermFilter": {
            "type": "boolean"
          },
          "HasDeliveryStatusFilter": {
            "type": "boolean"
          },
          "HasFilters": {
            "type": "boolean"
          }
        }
      },
      "DeliveryStatus": {
        "type": "string",
        "enum": [
          "OpenToNewStarts",
          "LastStartDateAdded",
          "ClosedToNewStarts"
        ],
        "description": "Status of course delivery"
      },
      "RestrictedCourseDetailsViewModel": {
        "type": "object",
        "properties": {
          "LarsCode": {
            "type": "string"
          },
          "CourseName": {
            "type": "string"
          },
          "Level": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Sector": {
            "type": "string"
          },
          "LearningType": {
            "type": "string"
          },
          "IsCourseRestricted": {
            "type": "boolean"
          },
          "RestrictedCourseDetailsPageUrl": {
            "type": "string"
          },
          "AddProviderUrl": {
            "type": "string"
          },
          "HasActiveFilters": {
            "type": "boolean"
          },
          "Filters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "SuccessBannerMessage": {
            "type": "string"
          },
          "TotalProviderCount": {
            "type": "integer"
          },
          "AllowedProviders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AllowedProviderViewModel"
            }
          },
          "Pagination": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "AllowedProviderViewModel": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "string"
          },
          "ProviderName": {
            "type": "string"
          },
          "HasLastDateStarts": {
            "type": "boolean"
          },
          "ChangeUrl": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "RoatpAdminTeamAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
