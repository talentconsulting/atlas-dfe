{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Details API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/new/details": {
      "get": {
        "operationId": "ProviderDetails_GetIndex",
        "summary": "Get provider details",
        "description": "Retrieves provider details from the session model.",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderDetailsViewModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProviderDetailsViewModel": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "string",
            "nullable": true
          },
          "LegalName": {
            "type": "string",
            "nullable": true
          },
          "TradingName": {
            "type": "string",
            "nullable": true
          },
          "CompanyNumber": {
            "type": "string",
            "nullable": true
          },
          "CharityNumber": {
            "type": "string",
            "nullable": true
          },
          "SelectProviderTypeUrl": {
            "type": "string",
            "format": "uri"
          },
          "SelectProviderUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "SelectProviderTypeUrl",
          "SelectProviderUrl"
        ]
      }
    }
  }
}
