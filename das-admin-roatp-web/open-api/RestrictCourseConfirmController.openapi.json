{
  "openapi": "3.1.0",
  "info": {
    "title": "RestrictCourseConfirm API",
    "description": "API handling course restriction operations, specifically confirming course restriction status.",
    "version": "1.0.0"
  },
  "paths": {
    "/restricted-courses/add/{larsCode}/confirm": {
      "get": {
        "summary": "Display course restriction confirmation form.",
        "operationId": "GetRestrictCourseConfirm",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to unrestricted course details if no session exists."
          },
          "200": {
            "description": "Returns the HTML view for the course restriction confirmation form."
          }
        },
        "security": [
          {
            "Role": [
              "RoatpAdminTeam"
            ]
          }
        ]
      },
      "post": {
        "summary": "Confirm course restriction and finalize the process.",
        "operationId": "PostRestrictCourseConfirm",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "No body content is required, action derives context from session service.",
          "required": false
        },
        "responses": {
          "302": {
            "description": "Redirect to unrestricted course if session is invalid or restricted course details upon successful operation."
          },
          "204": {
            "description": "No content. Indicates operation has been successfully completed."
          }
        },
        "security": [
          {
            "Role": [
              "RoatpAdminTeam"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AddRestrictedCourseRequest": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "LarsCode": {
            "type": "string"
          }
        }
      },
      "AddRestrictedCourseSessionModel": {
        "type": "object",
        "properties": {
          "LarsCode": {
            "type": "string"
          },
          "DisplayName": {
            "type": "string"
          }
        }
      },
      "RestrictCourseConfirmViewModel": {
        "type": "object",
        "properties": {
          "LarsCode": {
            "type": "string"
          },
          "DisplayName": {
            "type": "string"
          },
          "CancelUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "securitySchemes": {
      "Role": {
        "type": "apiKey",
        "name": "Role",
        "in": "header"
      }
    }
  }
}
