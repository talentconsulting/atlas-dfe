{
  "openapi": "3.1.0",
  "info": {
    "title": "Organisation Type Update API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/type": {
      "get": {
        "summary": "Get Organisation Type Update Page",
        "tags": [
          "Organisation Type Update"
        ],
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The UKPRN (UK Provider Reference Number) of the organisation."
          }
        ],
        "responses": {
          "200": {
            "description": "Organisation Type Update View",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganisationTypeUpdateViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirect to home route if organisation not found."
          }
        }
      },
      "post": {
        "summary": "Update Organisation Type",
        "tags": [
          "Organisation Type Update"
        ],
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The UKPRN (UK Provider Reference Number) of the organisation."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrganisationTypeUpdateViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to provider summary route after updating type."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OrganisationTypeUpdateViewModel": {
        "type": "object",
        "properties": {
          "LegalName": {
            "type": "string",
            "description": "The legal name of the organisation."
          },
          "OrganisationTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrganisationTypeModel"
            },
            "description": "List of organisation types available for selection."
          },
          "OrganisationTypeId": {
            "type": "integer",
            "description": "The ID of the selected organisation type."
          }
        },
        "required": [
          "LegalName",
          "OrganisationTypeId"
        ]
      },
      "OrganisationTypeModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "description": "The ID of the organisation type."
          },
          "Description": {
            "type": "string",
            "description": "A description of the organisation type."
          },
          "IsSelected": {
            "type": "boolean",
            "description": "Indicates whether the organisation type is currently selected."
          }
        },
        "required": [
          "Id",
          "Description"
        ]
      }
    }
  }
}
