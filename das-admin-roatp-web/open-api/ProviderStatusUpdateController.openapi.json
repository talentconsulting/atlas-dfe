{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Status Update API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/status": {
      "get": {
        "summary": "Get organisation statuses for updating",
        "operationId": "getProviderStatusUpdate",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique provider reference number"
          }
        ],
        "responses": {
          "200": {
            "description": "Status update view",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganisationStatusUpdateViewModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "roles": [
              "RoatpAdminTeam"
            ]
          }
        ]
      },
      "post": {
        "summary": "Update organisation status",
        "operationId": "postProviderStatusUpdate",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique provider reference number"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrganisationStatusUpdateViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to appropriate route based on status"
          }
        }
      }
    },
    "/providers/{ukprn}/status/confirmed": {
      "get": {
        "summary": "Provider status update confirmed",
        "operationId": "getProviderStatusUpdateConfirmed",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique provider reference number"
          }
        ],
        "responses": {
          "200": {
            "description": "View confirmation of provider status update",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderStatusConfirmationViewModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "roles": [
              "RoatpAdminTeam"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "OrganisationStatusUpdateViewModel": {
        "type": "object",
        "properties": {
          "OrganisationStatuses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrganisationStatusSelectionModel"
            }
          },
          "OrganisationStatus": {
            "$ref": "#/components/schemas/OrganisationStatus"
          }
        },
        "required": [
          "OrganisationStatuses",
          "OrganisationStatus"
        ]
      },
      "OrganisationStatusSelectionModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer"
          },
          "Description": {
            "type": "string"
          },
          "IsSelected": {
            "type": "boolean"
          }
        },
        "required": [
          "Id",
          "Description"
        ]
      },
      "OrganisationStatus": {
        "type": "integer",
        "enum": [
          0,
          1,
          2,
          3
        ],
        "description": "Organisation status values (Removed=0, Active=1, ActiveNoStarts=2, OnBoarding=3)"
      },
      "ProviderStatusConfirmationViewModel": {
        "type": "object",
        "properties": {
          "LegalName": {
            "type": "string"
          },
          "OrganisationStatus": {
            "$ref": "#/components/schemas/OrganisationStatus"
          },
          "Ukprn": {
            "type": "integer"
          },
          "StatusText": {
            "type": "string"
          },
          "ProviderSummaryLink": {
            "type": "string"
          },
          "SelectTrainingProviderLink": {
            "type": "string"
          },
          "AddNewTrainingProviderLink": {
            "type": "string"
          }
        },
        "required": [
          "LegalName",
          "OrganisationStatus",
          "Ukprn",
          "StatusText",
          "ProviderSummaryLink",
          "SelectTrainingProviderLink",
          "AddNewTrainingProviderLink"
        ]
      }
    }
  }
}
