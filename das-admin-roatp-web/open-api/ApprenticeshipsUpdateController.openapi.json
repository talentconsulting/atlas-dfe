{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprenticeships Update API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/apprenticeships": {
      "get": {
        "summary": "Get the apprenticeship offering status for a provider",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique identifier for the provider (UKPRN)"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfferApprenticeshipsViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirect to the home route if the organization or session data cannot be retrieved"
          }
        }
      },
      "post": {
        "summary": "Submit updates to the apprenticeship offering status for a provider",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique identifier for the provider (UKPRN)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OfferApprenticeshipsSubmitModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to the home route or apprenticeship units update route after processing"
          },
          "400": {
            "description": "Validation errors occurred in the submitted data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "field": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "field",
                          "message"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OfferApprenticeshipsViewModel": {
        "type": "object",
        "properties": {
          "IsApprenticeshipsOffered": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Indicates whether apprenticeships are offered by the provider"
          },
          "ApprenticeshipsSelection": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprenticeshipsSelectionModel"
            },
            "description": "List of options available for apprenticeship offering"
          }
        },
        "required": [
          "ApprenticeshipsSelection"
        ]
      },
      "OfferApprenticeshipsSubmitModel": {
        "type": "object",
        "properties": {
          "IsApprenticeshipsOffered": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Indicates whether apprenticeships are offered by the provider"
          }
        }
      },
      "ApprenticeshipsSelectionModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "boolean",
            "description": "Identifier for the selection option"
          },
          "Description": {
            "type": "string",
            "description": "Text describing the selection option"
          },
          "IsSelected": {
            "type": "boolean",
            "description": "Indicates whether this option is selected"
          }
        },
        "required": [
          "Id",
          "Description"
        ]
      }
    }
  }
}
