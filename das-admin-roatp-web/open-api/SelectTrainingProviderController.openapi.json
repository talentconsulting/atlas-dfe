{
  "openapi": "3.1.0",
  "info": {
    "title": "Select Training Provider API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers": {
      "get": {
        "tags": [
          "SelectTrainingProvider"
        ],
        "summary": "Renders the view for selecting a training provider",
        "operationId": "getSelectTrainingProvider",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "text/html": {
                "example": "<html>...</html>"
              }
            }
          }
        },
        "security": [
          {
            "RoatpAdminTeam": []
          }
        ]
      },
      "post": {
        "tags": [
          "SelectTrainingProvider"
        ],
        "summary": "Validates input and redirects to provider summary",
        "operationId": "postSelectTrainingProvider",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectTrainingProviderViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to provider summary based on the provided UKPRN"
          },
          "400": {
            "description": "Validation errors encountered",
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "field": "Ukprn",
                      "message": "UKPRN is invalid"
                    }
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "RoatpAdminTeam": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "RoatpAdminTeam": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "SelectTrainingProviderViewModel": {
        "type": "object",
        "properties": {
          "SearchTerm": {
            "type": "string",
            "nullable": true,
            "description": "Search term combining LegalName and UKPRN."
          },
          "LegalName": {
            "type": "string",
            "nullable": true,
            "description": "Legal Name of the training provider."
          },
          "Ukprn": {
            "type": "string",
            "nullable": true,
            "description": "Unique Identifier for the training provider."
          }
        }
      }
    }
  }
}
