{
  "openapi": "3.1.0",
  "info": {
    "title": "Add Restricted Course Last Start Date API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/restricted-courses/add/set-last-start-date": {
      "get": {
        "summary": "View the restricted course last start date form",
        "operationId": "GetRestrictedCourseLastStartDateForm",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Form to set last start date for a restricted course displayed successfully"
          },
          "302": {
            "description": "Redirects to provider restricted apprenticeships route if no session is found"
          }
        },
        "security": [
          {
            "RoatpAdminTeamRole": []
          }
        ]
      },
      "post": {
        "summary": "Submit the restricted course last start date",
        "operationId": "SubmitRestrictedCourseLastStartDate",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetLastDateStartsSubmitModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to provider restricted apprenticeships route if operation is successful"
          },
          "400": {
            "description": "Validation errors in the submitted data"
          }
        },
        "security": [
          {
            "RoatpAdminTeamRole": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "SetLastDateStartsSubmitModel": {
        "type": "object",
        "properties": {
          "Day": {
            "type": "string",
            "nullable": true
          },
          "Month": {
            "type": "string",
            "nullable": true
          },
          "Year": {
            "type": "string",
            "nullable": true
          },
          "LarsCode": {
            "type": "string",
            "nullable": true
          },
          "CourseLastDateStarts": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      }
    },
    "securitySchemes": {
      "RoatpAdminTeamRole": {
        "type": "http",
        "scheme": "bearer",
        "description": "Requires user to belong to the Roatp Admin Team role"
      }
    }
  }
}
