{
  "openapi": "3.1.0",
  "info": {
    "title": "Select Provider API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/new/select": {
      "get": {
        "operationId": "SelectProvider_Index_Get",
        "tags": [
          "SelectProvider"
        ],
        "responses": {
          "200": {
            "description": "Returns the Select Provider view model",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectProviderViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "SelectProvider_Index_Post",
        "tags": [
          "SelectProvider"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectProviderSubmitModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to a new page based on the existence of the provider"
          },
          "400": {
            "description": "Validation errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectProviderViewModel"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected errors"
          }
        }
      }
    },
    "/providers/new/not-found": {
      "get": {
        "operationId": "ProviderNotFoundInUkrlp_Get",
        "tags": [
          "SelectProvider"
        ],
        "responses": {
          "200": {
            "description": "Returns the view model for when a provider is not found in UKRLP",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderNotFoundInUkrlpViewModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SelectProviderViewModel": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "SelectProviderSubmitModel": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "string",
            "nullable": true
          }
        },
        "required": []
      },
      "ProviderNotFoundInUkrlpViewModel": {
        "type": "object",
        "properties": {
          "AddANewTrainingProviderUrl": {
            "type": "string"
          }
        }
      }
    }
  }
}
