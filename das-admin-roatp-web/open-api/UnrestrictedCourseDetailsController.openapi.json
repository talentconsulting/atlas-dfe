{
  "openapi": "3.1.0",
  "info": {
    "title": "Unrestricted Course Details API",
    "version": "1.0.0"
  },
  "paths": {
    "/unrestricted-courses/{larsCode}": {
      "get": {
        "summary": "Get Unrestricted Course Details",
        "operationId": "getUnrestrictedCourseDetails",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The unrestricted course details were successfully retrieved.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string",
                  "description": "HTML view rendered for the unrestricted course details."
                }
              }
            }
          },
          "404": {
            "description": "Course details not found."
          },
          "302": {
            "description": "Redirect to the restricted course details."
          }
        }
      },
      "post": {
        "summary": "Submit Restriction for a Course",
        "operationId": "postRestrictCourse",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RestrictCourseSubmitModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to the confirmation for restricting the course."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RestrictCourseSubmitModel": {
        "type": "object",
        "properties": {
          "LarsCode": {
            "type": "string",
            "nullable": true
          },
          "DisplayName": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
