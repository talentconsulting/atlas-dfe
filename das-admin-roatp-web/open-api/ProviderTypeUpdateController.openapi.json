{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Type Update API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/route": {
      "get": {
        "summary": "Get provider type update view.",
        "description": "Returns the provider type update view for a given UKPRN.",
        "operationId": "GetProviderTypeUpdate",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider type update view retrieved successfully.",
            "content": {
              "text/html": {}
            }
          },
          "302": {
            "description": "Redirect to home due to invalid UKPRN or error."
          }
        },
        "security": [
          {
            "roles": [
              "RoatpAdminTeam"
            ]
          }
        ]
      },
      "post": {
        "summary": "Update provider type.",
        "description": "Updates the provider type for the given UKPRN.",
        "operationId": "UpdateProviderType",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderTypeUpdateViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect after processing. Possible destinations include the home view, apprenticeships update view, or provider summary view depending on logic and input."
          }
        },
        "security": [
          {
            "roles": [
              "RoatpAdminTeam"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ProviderTypeUpdateViewModel": {
        "type": "object",
        "properties": {
          "ProviderTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderTypeSelectionModel"
            }
          },
          "ProviderTypeId": {
            "type": "integer"
          }
        },
        "required": [
          "ProviderTypes",
          "ProviderTypeId"
        ]
      },
      "ProviderTypeSelectionModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "description": "Unique identifier for the provider type."
          },
          "Description": {
            "type": "string",
            "description": "Description of the provider type."
          },
          "IsSelected": {
            "type": "boolean",
            "description": "Indicates whether this provider type is selected."
          }
        },
        "required": [
          "Id",
          "Description",
          "IsSelected"
        ]
      }
    },
    "securitySchemes": {
      "roles": {
        "type": "apiKey",
        "name": "Roles",
        "in": "header",
        "description": "Used for role-based security in authorization."
      }
    }
  }
}
