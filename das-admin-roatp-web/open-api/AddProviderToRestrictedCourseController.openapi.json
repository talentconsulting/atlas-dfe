{
  "openapi": "3.1.0",
  "info": {
    "title": "Add Provider to Restricted Course API",
    "version": "1.0.0"
  },
  "paths": {
    "/restricted-courses/{larsCode}/providers/add": {
      "get": {
        "operationId": "GetAddProviderToRestrictedCourseIndex",
        "summary": "Displays the form for adding a provider to a restricted course.",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The course identifier."
          }
        ],
        "responses": {
          "200": {
            "description": "The form to add a provider is displayed.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Course not found or not restricted."
          }
        }
      },
      "post": {
        "operationId": "PostAddProviderToRestrictedCourseIndex",
        "summary": "Processes the submission to add a provider to a restricted course.",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The course identifier."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/AddProviderToRestrictedCourseSubmitModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to a confirmation page for adding the provider to the restricted course."
          },
          "404": {
            "description": "Course or provider not found."
          },
          "400": {
            "description": "Validation errors occurred.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddProviderToRestrictedCourseSubmitModel": {
        "type": "object",
        "properties": {
          "SelectedUkprn": {
            "type": "string",
            "nullable": true,
            "description": "The UKPRN (UK Provider Reference Number) of the provider to be added."
          }
        },
        "required": []
      }
    }
  }
}
