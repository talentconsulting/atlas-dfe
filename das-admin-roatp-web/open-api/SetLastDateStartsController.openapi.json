{
  "openapi": "3.1.0",
  "info": {
    "title": "Set Last Date of Starts API",
    "version": "1.0.0"
  },
  "paths": {
    "/restricted-courses/{larsCode}/providers/{ukprn}/set-last-start-date": {
      "get": {
        "tags": [
          "SetLastDateStarts"
        ],
        "summary": "Get the last date of starts for a course provider",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "description": "The LARS code of the course",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "description": "UKPRN of the provider",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The view of the last start date page is shown"
          },
          "404": {
            "description": "The course or provider was not found"
          }
        }
      },
      "post": {
        "tags": [
          "SetLastDateStarts"
        ],
        "summary": "Set the last date of starts for a course provider",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "description": "The LARS code of the course",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "description": "UKPRN of the provider",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetLastDateStartsSubmitModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to the restricted course details page upon successful update"
          },
          "400": {
            "description": "Validation errors or invalid input data"
          },
          "404": {
            "description": "The session, course, or provider was not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SetLastDateStartsSubmitModel": {
        "type": "object",
        "properties": {
          "Day": {
            "type": "string",
            "nullable": true,
            "description": "Day component of the date"
          },
          "Month": {
            "type": "string",
            "nullable": true,
            "description": "Month component of the date"
          },
          "Year": {
            "type": "string",
            "nullable": true,
            "description": "Year component of the date"
          },
          "LarsCode": {
            "type": "string",
            "nullable": true,
            "description": "The LARS code of the course"
          },
          "CourseLastDateStarts": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "The last start date of the course"
          }
        },
        "required": []
      }
    }
  }
}
