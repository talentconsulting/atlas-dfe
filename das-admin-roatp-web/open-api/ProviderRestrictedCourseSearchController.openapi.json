{
  "openapi": "3.1.0",
  "info": {
    "title": "Manage Unrestricted Provider API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/restricted-courses/add": {
      "get": {
        "tags": [
          "Provider Restricted Course"
        ],
        "summary": "Retrieves list of not restricted apprenticeship courses for a provider.",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderRestrictedCourseSearchViewModel"
                }
              }
            }
          },
          "404": {
            "description": "Not Found - No courses or provider."
          }
        },
        "security": [
          {
            "roles": [
              "RoatpAdminTeam"
            ]
          }
        ]
      },
      "post": {
        "tags": [
          "Provider Restricted Course"
        ],
        "summary": "Submits a selected apprenticeship course to restrict for a provider.",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderRestrictedCourseSearchSubmitModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects based on the provider course existence."
          },
          "404": {
            "description": "Not Found - Either selected course or provider not found."
          }
        },
        "security": [
          {
            "roles": [
              "RoatpAdminTeam"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ProviderRestrictedCourseSearchSubmitModel": {
        "type": "object",
        "properties": {
          "SelectedLarsCode": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ProviderRestrictedCourseSearchViewModel": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer"
          },
          "SelectedLarsCode": {
            "type": "string",
            "nullable": true
          },
          "Courses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Text": {
                  "type": "string"
                },
                "Value": {
                  "type": "string"
                },
                "Selected": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "roles": {
        "type": "oauth2",
        "flows": {
          "implicit": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "scopes": {
              "RoatpAdminTeam": "Access for ROATP admin team"
            }
          }
        }
      }
    }
  }
}
