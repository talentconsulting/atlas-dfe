{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprenticeship Units Update API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/apprenticeship-units": {
      "get": {
        "operationId": "getApprenticeshipUnitsUpdate",
        "summary": "Retrieve apprenticeship units update information for a provider.",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/html": {}
            }
          },
          "302": {
            "description": "Redirect to home if organisation cannot be found."
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      },
      "post": {
        "operationId": "updateApprenticeshipUnits",
        "summary": "Update apprenticeship units for a provider.",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/ApprenticeshipUnitsUpdateViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to appropriate route based on outcome.",
            "headers": {
              "Location": {
                "description": "Redirection URL.",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "400": {
            "description": "Validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrors"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ApprenticeshipUnitsUpdateViewModel": {
        "type": "object",
        "properties": {
          "apprenticeshipUnitsSelection": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprenticeshipUnitsSelectionModel"
            }
          },
          "offersApprenticeships": {
            "type": "boolean"
          },
          "apprenticeshipUnitsSelectionId": {
            "type": "boolean",
            "nullable": true
          }
        },
        "required": [
          "offersApprenticeships"
        ]
      },
      "ApprenticeshipUnitsSelectionModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "isSelected": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "description"
        ]
      },
      "ValidationErrors": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "tokenUrl": "https://example.com/oauth/token",
            "scopes": {}
          }
        }
      }
    }
  }
}
