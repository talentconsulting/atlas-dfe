{
  "openapi": "3.1.0",
  "info": {
    "title": "Select Organisation Type API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/new/organisation-type": {
      "get": {
        "summary": "Retrieve organisation types",
        "operationId": "getOrganisationTypes",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganisationTypeViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Submit organisation type selection",
        "operationId": "submitOrganisationType",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrganisationTypeSubmitModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to provider details summary"
          },
          "400": {
            "description": "Validation errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganisationTypeViewModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OrganisationTypeViewModel": {
        "type": "object",
        "properties": {
          "LegalName": {
            "type": "string"
          },
          "OrganisationTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrganisationTypeModel"
            }
          },
          "OrganisationTypeId": {
            "type": "integer",
            "nullable": true
          }
        },
        "required": [
          "LegalName",
          "OrganisationTypes"
        ]
      },
      "OrganisationTypeSubmitModel": {
        "type": "object",
        "properties": {
          "OrganisationTypeId": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "OrganisationTypeModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer"
          },
          "Description": {
            "type": "string"
          },
          "IsSelected": {
            "type": "boolean"
          }
        },
        "required": [
          "Id",
          "Description",
          "IsSelected"
        ]
      }
    }
  }
}
