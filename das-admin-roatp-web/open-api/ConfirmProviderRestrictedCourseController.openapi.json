{
  "openapi": "3.1.0",
  "info": {
    "title": "Manage Unrestricted Provider API",
    "description": "API for managing unrestricted providers and their restricted courses.",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/restricted-courses/add/confirm": {
      "get": {
        "summary": "Display confirmation page for adding a restricted course",
        "operationId": "getConfirmProviderRestrictedCourse",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique identifier for the provider"
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to Provider Restricted Apprenticeships page if session is missing"
          },
          "200": {
            "description": "Confirmation page displayed",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Add a restricted course for the provider",
        "operationId": "postConfirmProviderRestrictedCourse",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique identifier for the provider"
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to Provider Restricted Apprenticeships page after adding the course"
          }
        },
        "requestBody": {
          "description": "Request to add a restricted apprenticeship",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddRestrictedApprenticeshipRequest"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddRestrictedApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string",
            "description": "ID of the user adding the course"
          },
          "UserDisplayName": {
            "type": "string",
            "description": "Display name of the user adding the course"
          },
          "LastDateStarts": {
            "type": "string",
            "format": "date",
            "description": "Last date starts for the restricted apprenticeship"
          }
        },
        "required": [
          "UserId",
          "UserDisplayName"
        ]
      }
    }
  }
}
