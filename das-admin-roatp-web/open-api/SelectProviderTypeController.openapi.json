{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Type Selection API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/new/provider-type": {
      "get": {
        "operationId": "getProviderTypeSelection",
        "summary": "Display provider type selection form",
        "responses": {
          "200": {
            "description": "Successful response with the provider type selection form",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectProviderTypeViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "submitProviderTypeSelection",
        "summary": "Submit selected provider type",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectProviderTypeSubmitModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects based on the selected provider type",
            "headers": {
              "Location": {
                "description": "The URL to redirect to",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "400": {
            "description": "Validation errors in submitted data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "errors"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SelectProviderTypeViewModel": {
        "type": "object",
        "properties": {
          "ProviderTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AddProviderTypeSelectionModel"
            }
          },
          "SelectedProviderTypeId": {
            "type": "integer",
            "nullable": true
          }
        },
        "required": [
          "ProviderTypes"
        ]
      },
      "SelectProviderTypeSubmitModel": {
        "type": "object",
        "properties": {
          "SelectedProviderTypeId": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "AddProviderTypeSelectionModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer"
          },
          "Description": {
            "type": "string"
          },
          "IsSelected": {
            "type": "boolean"
          }
        },
        "required": [
          "Id",
          "Description",
          "IsSelected"
        ]
      }
    }
  }
}
