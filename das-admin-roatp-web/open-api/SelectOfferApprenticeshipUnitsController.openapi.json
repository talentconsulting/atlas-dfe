{
  "openapi": "3.1.0",
  "info": {
    "title": "Select Offer Apprenticeship Units API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/new/offer-apprenticeship-units": {
      "get": {
        "summary": "Get the apprenticeship units selection page",
        "operationId": "GetOfferApprenticeshipUnits",
        "responses": {
          "200": {
            "description": "Success"
          },
          "302": {
            "description": "Redirect to home if provider type is supporting"
          }
        }
      },
      "post": {
        "summary": "Submit apprenticeship units selection",
        "operationId": "SubmitOfferApprenticeshipUnits",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OfferApprenticeshipUnitsSubmitModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation errors return with the view model",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfferApprenticeshipUnitsViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirect to summary or organisation type page based on session state"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OfferApprenticeshipUnitsViewModel": {
        "type": "object",
        "properties": {
          "IsApprenticeshipUnitsOffered": {
            "type": "boolean",
            "nullable": true
          },
          "ApprenticeshipUnitsSelection": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprenticeshipUnitsSelectionModel"
            }
          }
        }
      },
      "OfferApprenticeshipUnitsSubmitModel": {
        "type": "object",
        "properties": {
          "IsApprenticeshipUnitsOffered": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "ApprenticeshipUnitsSelectionModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "boolean"
          },
          "Description": {
            "type": "string"
          },
          "IsSelected": {
            "type": "boolean"
          }
        },
        "required": [
          "Id",
          "Description"
        ]
      }
    }
  }
}
