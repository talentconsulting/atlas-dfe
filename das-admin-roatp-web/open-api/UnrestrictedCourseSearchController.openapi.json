{
  "openapi": "3.1.0",
  "info": {
    "title": "Unrestricted Course Search API",
    "description": "API for handling unrestricted course searches in the Admin RoATP system.",
    "version": "1.0.0"
  },
  "paths": {
    "/unrestricted-courses/search": {
      "get": {
        "operationId": "getUnrestrictedCourses",
        "summary": "Retrieve unrestricted courses",
        "description": "Fetches a list of unrestricted courses and displays them.",
        "responses": {
          "200": {
            "description": "Success response with a list of courses rendered in the view.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "postUnrestrictedCourses",
        "summary": "Search for a specific unrestricted course",
        "description": "Validates the input and redirects to the details of a selected unrestricted course.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UnrestrictedCourseSearchSubmitModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirection to the unrestricted course details.",
            "headers": {
              "Location": {
                "description": "URL to the unrestricted course details.",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Validation errors in the input model.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UnrestrictedCourseSearchSubmitModel": {
        "type": "object",
        "properties": {
          "SelectedLarsCode": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
