{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Details Summary API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/new/provider-details-summary": {
      "get": {
        "operationId": "GetProviderDetailsSummary",
        "summary": "Retrieve provider details summary page.",
        "responses": {
          "200": {
            "description": "Provider details summary page rendered.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderDetailsSummaryViewModel"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "SubmitProviderDetailsSummary",
        "summary": "Submit provider details summary.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderDetailsSummaryViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to Add Provider Confirmation or back to summary page."
          }
        }
      }
    },
    "/providers/new/provider-added": {
      "get": {
        "operationId": "GetAddProviderConfirmation",
        "summary": "Retrieve add provider confirmation page.",
        "responses": {
          "200": {
            "description": "Add provider confirmation page rendered.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddProviderConfirmationViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirect to home page if organisation submission incomplete."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProviderDetailsSummaryViewModel": {
        "type": "object",
        "required": [
          "Ukprn",
          "ProviderTypeChangeLink",
          "OffersApprenticeshipsChangeLink",
          "OffersApprenticeshipUnitsChangeLink",
          "OrganisationTypeChangeLink",
          "ManageProviderLink"
        ],
        "properties": {
          "Ukprn": {
            "type": "integer",
            "example": 12345678
          },
          "LegalName": {
            "type": "string"
          },
          "TradingName": {
            "type": "string"
          },
          "ProviderRoute": {
            "type": "string"
          },
          "OffersApprenticeshipsText": {
            "type": "string"
          },
          "OffersApprenticeshipUnitsText": {
            "type": "string"
          },
          "OrganisationType": {
            "type": "string"
          },
          "IsSupportingProvider": {
            "type": "boolean"
          },
          "ProviderTypeChangeLink": {
            "type": "string",
            "example": "#"
          },
          "OffersApprenticeshipsChangeLink": {
            "type": "string",
            "example": "#"
          },
          "OffersApprenticeshipUnitsChangeLink": {
            "type": "string",
            "example": "#"
          },
          "OrganisationTypeChangeLink": {
            "type": "string",
            "example": "#"
          },
          "ManageProviderLink": {
            "type": "string",
            "example": "#"
          }
        }
      },
      "AddProviderSessionModel": {
        "type": "object",
        "required": [
          "Ukprn",
          "LegalName"
        ],
        "properties": {
          "Ukprn": {
            "type": "integer",
            "example": 12345678
          },
          "LegalName": {
            "type": "string"
          },
          "TradingName": {
            "type": "string"
          },
          "ProviderTypeId": {
            "type": "integer"
          },
          "OffersApprenticeships": {
            "type": "boolean"
          },
          "OffersApprenticeshipUnits": {
            "type": "boolean"
          },
          "OrganisationTypeId": {
            "type": "integer"
          },
          "OrganisationType": {
            "type": "string"
          },
          "RedirectedFromSummaryPage": {
            "type": "boolean"
          },
          "OrganisationSubmitted": {
            "type": "boolean"
          }
        }
      },
      "AddProviderConfirmationViewModel": {
        "type": "object",
        "required": [
          "LegalName",
          "DashboardLink"
        ],
        "properties": {
          "LegalName": {
            "type": "string"
          },
          "DashboardLink": {
            "type": "string"
          }
        }
      }
    }
  }
}
