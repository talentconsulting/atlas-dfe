{
  "openapi": "3.1.0",
  "info": {
    "title": "Course Restrictions API",
    "version": "1.0.0"
  },
  "paths": {
    "/restricted-courses/{larsCode}/providers/{ukprn}/change-restriction": {
      "get": {
        "summary": "Get the Change Course Restriction view",
        "operationId": "getChangeCourseRestrictionView",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The view was successfully retrieved"
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "post": {
        "summary": "Submit changes for Course Restriction",
        "operationId": "submitCourseRestrictionChanges",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeCourseRestrictionSubmitModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirection to the appropriate route"
          },
          "404": {
            "description": "Not found"
          },
          "400": {
            "description": "Invalid input data"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChangeCourseRestrictionSubmitModel": {
        "type": "object",
        "properties": {
          "SelectedOption": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
