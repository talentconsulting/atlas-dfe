{
  "openapi": "3.1.0",
  "info": {
    "title": "Removal Reason Update API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/removal-reason": {
      "get": {
        "summary": "Get removal reason details for a provider.",
        "operationId": "GetRemovalReasonDetails",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The UKPRN of the provider."
          }
        ],
        "responses": {
          "200": {
            "description": "Removal reason details retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RemovalReasonUpdateViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirect to home if unable to retrieve organisation details."
          }
        },
        "security": [
          {
            "roles": [
              "RoatpAdminTeam"
            ]
          }
        ]
      },
      "post": {
        "summary": "Update removal reason for a provider.",
        "operationId": "UpdateRemovalReason",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The UKPRN of the provider."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/RemovalReasonUpdateViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect based on patching status."
          }
        },
        "security": [
          {
            "roles": [
              "RoatpAdminTeam"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "RemovalReasonUpdateViewModel": {
        "type": "object",
        "properties": {
          "RemovedReasons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RemovalReasonModel"
            },
            "description": "List of removal reasons available for the provider."
          },
          "RemovalReasonId": {
            "type": "integer",
            "nullable": true,
            "description": "The ID of the selected removal reason."
          }
        },
        "required": [
          "RemovedReasons"
        ]
      },
      "RemovalReasonModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "description": "The unique identifier of the removal reason."
          },
          "Description": {
            "type": "string",
            "description": "The description of the removal reason."
          },
          "IsSelected": {
            "type": "boolean",
            "description": "Indicates whether this removal reason is selected."
          }
        },
        "required": [
          "Id",
          "Description"
        ]
      }
    },
    "securitySchemes": {
      "roles": {
        "type": "openIdConnect",
        "description": "Role-based authentication for RoATP Admin Team."
      }
    }
  }
}
