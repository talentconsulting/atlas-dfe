{
  "openapi": "3.1.0",
  "info": {
    "title": "Restricted Courses API",
    "version": "1.0.0"
  },
  "paths": {
    "/restricted-courses": {
      "get": {
        "summary": "Retrieve restricted courses",
        "description": "Fetches a paginated list of restricted courses based on filtering criteria.",
        "operationId": "getRestrictedCourses",
        "parameters": [
          {
            "name": "SearchTerm",
            "in": "query",
            "description": "Optional search term to filter courses.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "LearningType",
            "in": "query",
            "description": "List of learning types to filter courses.",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/LearningType"
              }
            }
          },
          {
            "name": "PageNumber",
            "in": "query",
            "description": "Page number for pagination.",
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A pageable list of restricted courses.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestrictedCoursesViewModel"
                }
              }
            }
          }
        },
        "tags": [
          "RestrictedCourses"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "LearningType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "ApprenticeshipUnit",
          "FoundationApprenticeship"
        ],
        "description": "The type of learning associated with a course."
      },
      "RestrictedCoursesViewModel": {
        "type": "object",
        "properties": {
          "HasActiveFilters": {
            "type": "boolean",
            "description": "Indicates if any filters are applied."
          },
          "Filters": {
            "type": "array",
            "description": "List of filters applied to the courses.",
            "items": {
              "type": "object"
            }
          },
          "TotalCount": {
            "type": "integer",
            "description": "Total number of courses matching filter criteria."
          },
          "Courses": {
            "type": "array",
            "description": "Paginated list of course items.",
            "items": {
              "$ref": "#/components/schemas/RestrictedCourseItemViewModel"
            }
          },
          "Pagination": {
            "type": "object",
            "description": "Pagination details for traversing data.",
            "properties": {
              "PageNumber": {
                "type": "integer"
              },
              "TotalPages": {
                "type": "integer"
              }
            }
          }
        }
      },
      "RestrictedCourseItemViewModel": {
        "type": "object",
        "description": "Details of an individual restricted course.",
        "properties": {
          "Id": {
            "type": "string",
            "description": "The unique identifier of the course."
          },
          "Title": {
            "type": "string",
            "description": "The title of the course."
          },
          "Level": {
            "type": "integer",
            "description": "The level of the course."
          }
        }
      }
    }
  }
}
