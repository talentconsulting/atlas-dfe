{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS Admin RoATP",
    "version": "1.0.0"
  },
  "paths": {
    "/RegisteredProviders": {
      "get": {
        "summary": "Fetch registered providers matching search query",
        "operationId": "getRegisteredProviders",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Search term to filter registered providers. At least 3 characters are required for matching."
          }
        ],
        "responses": {
          "200": {
            "description": "A list of matched organisations. Limited to 100 results.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrganisationModel"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OrganisationModel": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    }
  }
}
