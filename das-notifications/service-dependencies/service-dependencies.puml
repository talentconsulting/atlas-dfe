@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_notifications, "Notifications") {
  Container(c_notifications, "Notifications", "API")
  Container(c_notifications_message_handlers, "Notifications Message Handlers", "Background Job")
}

SystemDb_Ext(d_configuration_store_azure_table_storage_configuration, "Azure Table Storage Configuration")
SystemDb_Ext(d_database_sql_server, "SQL Server", "NServiceBus SQL Persistence")
System_Ext(d_identity_provider_microsoft_entra_id, "Microsoft Entra ID")
SystemQueue_Ext(d_message_broker_azure_service_bus, "Azure Service Bus", "NServiceBus")
System_Ext(d_telemetry_application_insights, "Application Insights")

Rel(c_notifications, d_configuration_store_azure_table_storage_configuration, "Reads configuration from")
Rel(c_notifications_message_handlers, d_configuration_store_azure_table_storage_configuration, "Reads configuration from")
Rel(c_notifications_message_handlers, d_database_sql_server, "Reads from and writes to", "NServiceBus SQL Persistence")
Rel(c_notifications, d_database_sql_server, "Reads from and writes to", "SqlClient")
Rel(c_notifications, d_identity_provider_microsoft_entra_id, "Authenticates with")
Rel(c_notifications_message_handlers, d_message_broker_azure_service_bus, "Publishes messages to and consumes messages from", "NServiceBus")
Rel(c_notifications, d_message_broker_azure_service_bus, "Publishes messages to and consumes messages from")
Rel(c_notifications_message_handlers, d_telemetry_application_insights, "Sends telemetry to")
Rel(c_notifications, d_telemetry_application_insights, "Sends telemetry to")

@enduml
