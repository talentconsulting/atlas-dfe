@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_apprentice_commitments_jobs, "Apprentice Commitments") {
  Container(c_apprentice_commitments_jobs_fake_server, "Apprentice Commitments Jobs Fake Server", "Background Job")
  Container(c_apprentice_commitments_jobs_functions, "Apprentice Commitments Jobs Functions", "Background Job")
}

System_Ext(d_http_api_apprentice_commitments_api, "Apprentice Commitments API", "HTTP")
SystemQueue_Ext(d_message_broker_azure_service_bus, "Azure Service Bus", "Azure Service Bus")

Rel(c_apprentice_commitments_jobs_functions, d_http_api_apprentice_commitments_api, "Calls the API of", "HTTP")
Rel(c_apprentice_commitments_jobs_functions, d_message_broker_azure_service_bus, "Publishes messages to and consumes messages from", "Azure Service Bus")

@enduml
