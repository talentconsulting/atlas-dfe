@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_apprentice_commitments_jobs, "Apprentice Commitments") {
  Container(c_apprentice_commitments_jobs_functions, "Apprentice Commitments Jobs Functions", "Background Job")
}

SystemDb_Ext(d_configuration_store_azure_table_storage_configuration, "Azure Table Storage configuration", "Azure Table Storage")
SystemQueue_Ext(d_message_broker_azure_service_bus, "Azure Service Bus", "Azure Service Bus")
System_Ext(d_telemetry_application_insights, "Application Insights")

Rel(c_apprentice_commitments_jobs_functions, d_configuration_store_azure_table_storage_configuration, "Reads configuration from", "Azure Table Storage")
Rel(c_apprentice_commitments_jobs_functions, d_message_broker_azure_service_bus, "Publishes messages to and consumes messages from", "Azure Service Bus")
Rel(c_apprentice_commitments_jobs_functions, d_telemetry_application_insights, "Sends telemetry to")

@enduml
