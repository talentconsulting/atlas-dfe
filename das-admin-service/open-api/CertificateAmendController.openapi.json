{
  "openapi": "3.1.0",
  "info": {
    "title": "Certificate Amend API",
    "version": "1.0.0"
  },
  "paths": {
    "/certificateamend/amendreason/{stdCode}/{uln}": {
      "get": {
        "summary": "Get amend reason form view",
        "operationId": "GetAmendReason",
        "parameters": [
          {
            "name": "stdCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "uln",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Amend reason view generated successfully"
          }
        }
      },
      "post": {
        "summary": "Submit amend reason",
        "operationId": "PostAmendReason",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CertificateAmendReasonViewModel"
              }
            }
          }
        },
        "responses": {
          "303": {
            "description": "Redirects based on the form submission"
          }
        }
      }
    },
    "/certificateamend/reprintreason/{stdCode}/{uln}": {
      "get": {
        "summary": "Get reprint reason form view",
        "operationId": "GetReprintReason",
        "parameters": [
          {
            "name": "stdCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "uln",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reprint reason view generated successfully"
          }
        }
      },
      "post": {
        "summary": "Submit reprint reason",
        "operationId": "PostReprintReason",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CertificateReprintReasonViewModel"
              }
            }
          }
        },
        "responses": {
          "303": {
            "description": "Redirects based on the form submission"
          }
        }
      }
    },
    "/certificateamend/check/{certificateId}": {
      "get": {
        "summary": "Load check view for a certificate",
        "operationId": "GetCheck",
        "parameters": [
          {
            "name": "certificateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "searchString",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Check view loaded successfully"
          }
        }
      },
      "post": {
        "summary": "Submit certificate check",
        "operationId": "PostCheck",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CertificateCheckViewModel"
              }
            }
          }
        },
        "responses": {
          "303": {
            "description": "Redirects based on form submission status"
          }
        }
      }
    },
    "/certificateamend/confirmreprint/{certificateId}": {
      "get": {
        "summary": "Confirm reprint for a certificate",
        "operationId": "GetConfirmReprint",
        "parameters": [
          {
            "name": "certificateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "uln",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "stdCode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "searchString",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reprint confirmation view loaded successfully"
          }
        }
      }
    },
    "/certificateamend/confirmamend/{certificateId}": {
      "get": {
        "summary": "Confirm amendment for a certificate",
        "operationId": "GetConfirmAmend",
        "parameters": [
          {
            "name": "certificateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "redirectToCheck",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "uln",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "stdCode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "searchString",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Amend confirmation view loaded successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CertificateAmendReasonViewModel": {
        "type": "object",
        "properties": {
          "IncidentNumber": {
            "type": "string"
          },
          "Reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "OtherReason": {
            "type": "string"
          },
          "Learner": {
            "type": "object",
            "description": "Learner details"
          }
        }
      },
      "CertificateReprintReasonViewModel": {
        "type": "object",
        "properties": {
          "IncidentNumber": {
            "type": "string"
          },
          "Reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "OtherReason": {
            "type": "string"
          },
          "Learner": {
            "type": "object",
            "description": "Learner details"
          }
        }
      },
      "CertificateCheckViewModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Uln": {
            "type": "integer"
          },
          "StandardCode": {
            "type": "integer"
          },
          "CertificateReference": {
            "type": "string"
          },
          "SearchString": {
            "type": "string"
          },
          "Page": {
            "type": "integer"
          },
          "FullName": {
            "type": "string"
          },
          "CanRequestReprint": {
            "type": "boolean"
          }
        }
      },
      "CertificateAmendConfirmViewModel": {
        "type": "object",
        "properties": {
          "CertificateId": {
            "type": "string",
            "format": "uuid"
          },
          "SearchString": {
            "type": "string"
          },
          "Page": {
            "type": "integer"
          },
          "Uln": {
            "type": "integer"
          },
          "StdCode": {
            "type": "integer"
          },
          "BackToCheckPage": {
            "type": "boolean"
          },
          "CertificateReference": {
            "type": "string"
          },
          "FullName": {
            "type": "string"
          }
        }
      },
      "CertificateReprintConfirmViewModel": {
        "type": "object",
        "properties": {
          "CertificateId": {
            "type": "string",
            "format": "uuid"
          },
          "SearchString": {
            "type": "string"
          },
          "Page": {
            "type": "integer"
          },
          "FullName": {
            "type": "string"
          },
          "CertificateReference": {
            "type": "string"
          },
          "NextBatchDate": {
            "type": "string",
            "format": "date"
          },
          "Status": {
            "type": "string"
          },
          "Uln": {
            "type": "integer"
          },
          "StdCode": {
            "type": "integer"
          }
        }
      }
    }
  }
}
