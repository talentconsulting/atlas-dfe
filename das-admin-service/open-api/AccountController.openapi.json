{
  "openapi": "3.1.0",
  "info": {
    "title": "AccountController API",
    "version": "1.0.0"
  },
  "paths": {
    "/Account/SignIn": {
      "get": {
        "operationId": "SignIn",
        "summary": "Initiates the sign-in process.",
        "responses": {
          "302": {
            "description": "Redirect to the appropriate authentication scheme challenge endpoint."
          }
        }
      }
    },
    "/Account/PostSignIn": {
      "get": {
        "operationId": "PostSignIn",
        "summary": "Handles actions after a user has signed in.",
        "responses": {
          "302": {
            "description": "Redirects to the dashboard or the invalid role page."
          }
        }
      }
    },
    "/Account/SignOut": {
      "get": {
        "operationId": "SignOut",
        "summary": "Initiates the sign-out process.",
        "responses": {
          "302": {
            "description": "Redirect to the signed-out callback."
          }
        }
      }
    },
    "/Account/SignedOut": {
      "get": {
        "operationId": "SignedOut",
        "summary": "Handles post sign-out actions.",
        "responses": {
          "302": {
            "description": "Redirects to the Home page."
          }
        }
      }
    },
    "/Account/AccessDenied": {
      "get": {
        "operationId": "AccessDenied",
        "summary": "Displays the Access Denied view.",
        "responses": {
          "200": {
            "description": "Rendering of the Access Denied view."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
