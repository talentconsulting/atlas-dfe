{
  "openapi": "3.1.0",
  "info": {
    "title": "ExternalApiController API",
    "version": "1.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Get list of users",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/UserDetails": {
      "get": {
        "summary": "Get user details",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/EnableUser": {
      "post": {
        "summary": "Enable a user",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to UserDetails"
          }
        }
      }
    },
    "/DisableUser": {
      "post": {
        "summary": "Disable a user",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to UserDetails"
          }
        }
      }
    },
    "/DeleteUser": {
      "post": {
        "summary": "Delete a user",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to Index"
          }
        }
      }
    },
    "/RenewPrimaryKey": {
      "post": {
        "summary": "Renew the primary subscription key",
        "parameters": [
          {
            "name": "subscriptionId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to UserDetails"
          }
        }
      }
    },
    "/RenewSecondaryKey": {
      "post": {
        "summary": "Renew the secondary subscription key",
        "parameters": [
          {
            "name": "subscriptionId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to UserDetails"
          }
        }
      }
    }
  },
  "components": {}
}
