{
  "openapi": "3.1.0",
  "info": {
    "title": "Certificate Version API",
    "version": "1.0.0"
  },
  "paths": {
    "/CertificateVersion/Version": {
      "get": {
        "operationId": "GetCertificateVersion",
        "summary": "Retrieve certificate version view",
        "parameters": [
          {
            "name": "certificateId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the certificate version view",
            "content": {
              "text/html": {}
            }
          }
        }
      },
      "post": {
        "operationId": "UpdateCertificateVersion",
        "summary": "Update certificate version",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CertificateVersionViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully updated the certificate version",
            "content": {
              "text/html": {}
            }
          },
          "400": {
            "description": "Validation errors occurred",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CertificateVersionViewModel": {
        "type": "object",
        "properties": {
          "Standards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StandardVersion"
            }
          },
          "PrivatelyFundedStatus": {
            "type": "string"
          },
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "FamilyName": {
            "type": "string"
          },
          "GivenNames": {
            "type": "string"
          },
          "Standard": {
            "type": "string"
          },
          "Username": {
            "type": "string"
          },
          "FullName": {
            "type": "string"
          },
          "Level": {
            "type": "integer"
          },
          "Version": {
            "type": "string"
          },
          "StandardUId": {
            "type": "string"
          },
          "StandardCode": {
            "type": "integer"
          },
          "IsPrivatelyFunded": {
            "type": "boolean"
          },
          "BackToCheckPage": {
            "type": "boolean"
          },
          "ReasonForChange": {
            "type": "string"
          },
          "RequiresReasonForChange": {
            "type": "boolean"
          }
        },
        "required": [
          "Id",
          "Version",
          "StandardCode",
          "Standards"
        ]
      },
      "StandardVersion": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Version": {
            "type": "string"
          },
          "Comment": {
            "type": "string"
          }
        }
      }
    }
  }
}
