                  "$ref": "#/components/schemas/CertificateAuditDetailsViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "AuditDetailsPost",
        "summary": "Submit audit details for certificate deletion.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CertificateAuditDetailsViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Redirects to confirmation page."
          }
        }
      }
    },
    "/check-your-answers": {
      "get": {
        "operationId": "ConfirmDeleteGet",
