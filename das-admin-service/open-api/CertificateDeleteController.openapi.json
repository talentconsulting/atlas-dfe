          "200": {
            "description": "Returns the confirmation page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateConfirmDeleteViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/successfully-deleted-this-certificate": {
      "post": {
        "operationId": "SuccessfulDeletePost",
        "summary": "Handle successful certificate deletion.",
