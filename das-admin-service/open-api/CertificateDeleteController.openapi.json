{
  "openapi": "3.1.0",
  "info": {
    "title": "Certificate Management API",
    "version": "1.0.0",
    "description": "API for managing certificate deletion and related workflows."
  },
  "paths": {
    "/confirm-delete-certificate": {
      "get": {
        "operationId": "ConfirmAndSubmitGet",
        "summary": "Load confirmation page for certificate deletion.",
        "parameters": [
          {
            "name": "CertificateId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "SearchString",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "IsDeleteConfirmed",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "IncidentNumber",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ReasonForChange",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the confirmation page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateSubmitDeleteViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "ConfirmAndSubmitPost",
        "summary": "Handle certificate deletion confirmation.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CertificateSubmitDeleteViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Redirects based on user confirmation."
          }
        }
      }
    },
    "/audit-details": {
      "get": {
        "operationId": "AuditDetailsGet",
