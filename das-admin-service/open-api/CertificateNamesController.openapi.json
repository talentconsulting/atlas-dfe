{
  "openapi": "3.1.0",
  "info": {
    "title": "Certificate Names API",
    "version": "1.0.0",
    "description": "API for handling certificate names amendments."
  },
  "paths": {
    "/certificate/givennames": {
      "get": {
        "summary": "Retrieve the given names for a certificate.",
        "parameters": [
          {
            "name": "certificateId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of given names.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateGivenNamesViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Update the given names for a certificate.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CertificateGivenNamesViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Given names successfully updated."
          }
        }
      }
    },
    "/certificate/familyname": {
      "get": {
        "summary": "Retrieve the family name for a certificate.",
        "parameters": [
          {
            "name": "certificateId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of family name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateFamilyNameViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Update the family name for a certificate.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CertificateFamilyNameViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Family name successfully updated."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CertificateGivenNamesViewModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "GivenNames": {
            "type": "string"
          },
          "FullName": {
            "type": "string"
          },
          "BackToCheckPage": {
            "type": "boolean"
          },
          "ReasonForChange": {
            "type": "string"
          },
          "RequiresReasonForChange": {
            "type": "boolean"
          }
        },
        "required": [
          "Id",
          "GivenNames",
          "BackToCheckPage",
          "ReasonForChange",
          "RequiresReasonForChange"
        ]
      },
      "CertificateFamilyNameViewModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "FamilyName": {
            "type": "string"
          },
          "FullName": {
            "type": "string"
          },
          "BackToCheckPage": {
            "type": "boolean"
          },
          "ReasonForChange": {
            "type": "string"
          },
          "RequiresReasonForChange": {
            "type": "boolean"
          }
        },
        "required": [
          "Id",
          "FamilyName",
          "BackToCheckPage",
          "ReasonForChange",
          "RequiresReasonForChange"
        ]
      }
    }
  }
}
