    "/reset-session": {
      "get": {
        "operationId": "ResetSession",
        "summary": "Reset the session settings for organisation applications.",
        "responses": {
          "302": {
            "description": "Redirects to OrganisationApplications page."
          }
        }
      }
    },
    "/": {
      "get": {
        "operationId": "Index",
        "summary": "Navigates to OrganisationApplications without resetting items per page settings.",
        "responses": {
          "302": {
            "description": "Redirects to OrganisationApplications page."
          }
        }
      }
    },
