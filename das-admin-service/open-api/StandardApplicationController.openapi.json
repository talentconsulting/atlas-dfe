{
  "openapi": "3.1.0",
  "info": {
    "title": "Standard Application API",
    "version": "1.0.0",
    "description": "API for managing standard applications within the Admin Service."
  },
  "paths": {
    "/apply/standards/applications/reset-session": {
      "get": {
        "tags": [
          "Applications"
        ],
        "summary": "Resets session settings",
        "operationId": "resetSession",
        "responses": {
          "302": {
            "description": "Redirects to standard applications."
          }
        }
      }
    },
    "/apply/standards/applications/index": {
      "get": {
        "tags": [
          "Applications"
        ],
        "summary": "Resets page index and redirects to applications.",
        "operationId": "index",
        "responses": {
          "302": {
            "description": "Redirects to standard applications."
          }
        }
      }
    },
    "/apply/standards/applications": {
      "get": {
        "tags": [
          "Applications"
        ],
        "summary": "Fetches standard applications for viewing.",
        "operationId": "getStandardApplications",
        "responses": {
          "200": {
            "description": "Applications list view.",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/apply/standards/applications/new/{pageIndex}": {
      "get": {
        "tags": [
          "Applications"
        ],
        "summary": "Change page of new applications.",
        "operationId": "changePageNewApplications",
        "parameters": [
          {
            "name": "pageIndex",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated applications page view.",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/apply/standards/applications/new/partial/{pageIndex}": {
      "get": {
        "tags": [
          "Applications"
        ],
        "summary": "Change page of new applications (partial view).",
        "operationId": "changePageNewApplicationsPartial",
        "parameters": [
          {
            "name": "pageIndex",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Partial page view.",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/apply/standards/applications/new/items/{itemsPerPage}": {
      "get": {
        "tags": [
          "Applications"
        ],
        "summary": "Change items per page for new applications.",
        "operationId": "changeApplicationsPerPageNewApplications",
        "parameters": [
          {
            "name": "itemsPerPage",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated applications view with adjusted items per page.",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/apply/standards/applications/new/items/partial/{itemsPerPage}": {
      "get": {
        "tags": [
          "Applications"
        ],
        "summary": "Change items per page for new applications (partial view).",
        "operationId": "changeApplicationsPerPageNewApplicationsPartial",
        "parameters": [
          {
            "name": "itemsPerPage",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Partial page view with adjusted items per page.",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/apply/standards/applications/new/sort": {
      "get": {
        "tags": [
          "Applications"
        ],
        "summary": "Sort new applications.",
        "operationId": "sortNewApplications",
        "parameters": [
          {
            "name": "sortColumn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sortDirection",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sorted applications view.",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/apply/standards/applications/new/sort/partial": {
      "get": {
        "tags": [
          "Applications"
        ],
        "summary": "Sort new applications (partial view).",
        "operationId": "sortNewApplicationsPartial",
        "parameters": [
          {
            "name": "sortColumn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sortDirection",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Partial sorted view.",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/apply/standards/applications/in-progress/{pageIndex}": {
      "get": {
        "tags": [
          "Applications"
        ],
        "summary": "Change page of in-progress applications.",
        "operationId": "changePageInProgressApplications",
        "parameters": [
          {
            "name": "pageIndex",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated in-progress applications view.",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/apply/standards/applications/in-progress/partial/{pageIndex}": {
      "get": {
        "tags": [
          "Applications"
        ],
        "summary": "Change page of in-progress applications (partial view).",
        "operationId": "changePageInProgressApplicationsPartial",
        "parameters": [
          {
            "name": "pageIndex",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Partial page view.",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApplicationsDashboardViewModel": {
        "type": "object",
        "description": "Represents a dashboard containing segmented applications.",
        "properties": {}
      },
      "ApplicationsViewModel": {
        "type": "object",
        "description": "Represents a paginated view of applications for a specific status.",
        "properties": {}
      },
      "PaginatedListApplicationSummaryItem": {
        "type": "object",
        "description": "Represents a paginated response with application summaries.",
        "properties": {}
      }
    }
  }
}
