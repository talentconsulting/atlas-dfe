@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_apprentice_accounts_web, "Apprentice Accounts") {
  Container(c_apprentice_accounts, "Apprentice Accounts", "Web Application")
  Container(c_apprentice_accounts_mockserver, "Apprentice Accounts MockServer", "Component")
}

SystemDb_Ext(d_configuration_store_azure_table_storage_configuration, "Azure Table Storage Configuration")
System_Ext(d_identity_provider_microsoft_entra_id, "Microsoft Entra ID")
System_Ext(d_telemetry_application_insights, "Application Insights")

Rel(c_apprentice_accounts, d_configuration_store_azure_table_storage_configuration, "Reads configuration from")
Rel(c_apprentice_accounts, d_identity_provider_microsoft_entra_id, "Authenticates with")
Rel(c_apprentice_accounts, d_telemetry_application_insights, "Sends telemetry to")

@enduml
