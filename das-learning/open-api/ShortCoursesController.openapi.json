{
  "openapi": "3.1.0",
  "info": {
    "title": "Short Courses API",
    "description": "API for managing short courses.",
    "version": "1.0.0"
  },
  "paths": {
    "/{ukprn}/academicyears/{academicYear}/shortCourses": {
      "get": {
        "summary": "Get paginated short courses for a provider within an academic year.",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "academicYear",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetShortCoursesByAcademicYearResponse"
                }
              }
            }
          }
        }
      }
    },
    "/{ukprn}/{collectionYear}/shortCourses": {
      "get": {
        "summary": "Get paginated short courses for earnings within a collection year.",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "collectionYear",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetShortCoursesForEarningsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/shortCourses": {
      "post": {
        "summary": "Create a new draft short course learner.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDraftShortCourseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateDraftShortCourseCommandResponse"
                }
              }
            }
          },
          "204": {
            "description": "No content returned because the creation resulted in no results."
          }
        }
      }
    },
    "/{ukprn}/shortCourses/{learnerKey}": {
      "delete": {
        "summary": "Remove a short course learner record.",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "learnerKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "academicYear",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RemoveShortCourseResult"
                }
              }
            }
          },
          "404": {
            "description": "Record not found."
          }
        }
      },
      "put": {
        "summary": "Update an existing short course learner record.",
        "parameters": [
          {
            "name": "learnerKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateShortCourseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateShortCourseResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetShortCoursesByAcademicYearResponse": {
        "type": "object",
        "properties": {
          "Page": {
            "type": "integer"
          },
          "TotalItems": {
            "type": "integer"
          },
          "PageSize": {
            "type": "integer"
          },
          "TotalPages": {
            "type": "integer"
          },
          "Items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShortCourseLearnerItem"
            }
          }
        }
      },
      "ShortCourseLearnerItem": {
        "type": "object",
        "properties": {
          "Uln": {
            "type": "string"
          },
          "Key": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "GetShortCoursesForEarningsResponse": {
        "type": "object",
        "properties": {
          "Page": {
            "type": "integer"
          },
          "TotalItems": {
            "type": "integer"
          },
          "PageSize": {
            "type": "integer"
          },
          "TotalPages": {
            "type": "integer"
          },
          "Items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetShortCoursesForEarningsItem"
            }
          }
        }
      },
      "GetShortCoursesForEarningsItem": {
        "type": "object",
        "properties": {
          "LearnerKey": {
            "type": "string",
            "format": "uuid"
          },
          "Learner": {
            "$ref": "#/components/schemas/GetShortCoursesForEarningsLearner"
          },
          "Episodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetShortCoursesForEarningsEpisode"
            }
          }
        }
      },
      "GetShortCoursesForEarningsLearner": {
        "type": "object",
        "properties": {
          "Uln": {
            "type": "string"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "GetShortCoursesForEarningsEpisode": {
        "type": "object",
        "properties": {
          "LearningKey": {
            "type": "string",
            "format": "uuid"
          },
          "CourseCode": {
            "type": "string"
          },
          "IsApproved": {
            "type": "boolean"
          },
          "Price": {
            "type": "number"
          },
          "LearnerRef": {
            "type": "string"
          },
          "EmployerType": {
            "type": "string",
            "enum": [
              "NonLevy",
              "Levy"
            ]
          }
        }
      },
      "CreateDraftShortCourseRequest": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "AcademicYear": {
            "type": "integer"
          },
          "LearnerUpdateDetails": {
            "$ref": "#/components/schemas/ShortCourseLearnerUpdateDetails"
          },
          "LearningSupport": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LearningSupportDetails"
            }
          },
          "OnProgramme": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OnProgramme"
            }
          }
        }
      },
      "ShortCourseLearnerUpdateDetails": {
        "type": "object",
        "properties": {
          "LearnerRef": {
            "type": "string"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "EmailAddress": {
            "type": "string",
            "nullable": true
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "Uln": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "LearningSupportDetails": {
        "type": "object",
        "properties": {
          "StartDate": {
            "type": "string",
            "format": "date"
          },
          "EndDate": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "OnProgramme": {
        "type": "object",
        "properties": {
          "CourseCode": {
            "type": "string"
          },
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "StartDate": {
            "type": "string",
            "format": "date"
          },
          "WithdrawalDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "WithdrawalReasonCode": {
            "type": "integer",
            "nullable": true
          },
          "CompletionDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "ExpectedEndDate": {
            "type": "string",
            "format": "date"
          },
          "Milestones": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ThirtyPercentLearningComplete",
                "LearningComplete"
              ]
            }
          },
          "Price": {
            "type": "number"
          },
          "LearningType": {
            "type": "string",
            "enum": [
              "Apprenticeship",
              "FoundationApprenticeship",
              "ApprenticeshipUnit"
            ]
          }
        }
      },
      "UpdateShortCourseRequest": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "AcademicYear": {
            "type": "integer"
          },
          "LearnerUpdateDetails": {
            "$ref": "#/components/schemas/ShortCourseLearnerUpdateDetails"
          },
          "OnProgramme": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OnProgramme"
            }
          }
        }
      },
      "CreateDraftShortCourseCommandResponse": {
        "type": "object",
        "properties": {
          "Results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShortCourseCommandResult"
            }
          }
        }
      },
      "RemoveShortCourseResult": {
        "type": "object",
        "properties": {
          "Results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RemoveShortCourseItemResult"
            }
          }
        }
      },
      "RemoveShortCourseItemResult": {
        "type": "object",
        "properties": {
          "RemovedEpisodeKey": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "UpdateShortCourseResponse": {
        "type": "object",
        "properties": {
          "Results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UpdateShortCourseItemResult"
            }
          }
        }
      },
      "UpdateShortCourseItemResult": {
        "type": "object",
        "properties": {
          "Changes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "WithdrawalDate",
                "Milestone",
                "CompletionDate",
                "LearnerRef",
                "Reinstated",
                "StartDate",
                "ExpectedEndDate",
                "ForceEarningsSync"
              ]
            }
          },
          "IsNewLearning": {
            "type": "boolean"
          },
          "IsNewEpisode": {
            "type": "boolean"
          },
          "IsIgnored": {
            "type": "boolean"
          },
          "IsRemoved": {
            "type": "boolean"
          }
        }
      },
      "ShortCourseCommandResult": {
        "type": "object",
        "properties": {
          "LearningKey": {
            "type": "string",
            "format": "uuid"
          },
          "LearnerKey": {
            "type": "string",
            "format": "uuid"
          },
          "Learner": {
            "$ref": "#/components/schemas/ShortCourseLearner"
          },
          "Episode": {
            "type": "object",
            "nullable": true
          }
        }
      },
      "ShortCourseLearner": {
        "type": "object",
        "properties": {
          "Uln": {
            "type": "string"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}
