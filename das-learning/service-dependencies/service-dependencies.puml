@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_learning, "Learning") {
  Container(c_learning, "Learning Command", "Component")
  Container(c_learning_api, "Learning", "API")
  Container(c_learning_functions, "Learning Functions", "Background Job")
  Container(c_learning_innerapi, "Learning InnerApi", "API")
}

SystemDb_Ext(d_configuration_store_azure_table_storage_configuration, "Azure Table Storage configuration", "Azure Table Storage")
SystemDb_Ext(d_database_learning_sql_database, "Learning Sql Database", "Microsoft SQL Server")
System_Ext(d_http_api_learning_outer, "Learning Outer", "HttpClient")
System_Ext(d_identity_provider_microsoft_entra_id, "Microsoft Entra ID", "Microsoft Identity Platform (Azure AD)")
SystemQueue_Ext(d_message_broker_azure_service_bus, "Azure Service Bus", "Azure Service Bus")
System_Ext(d_telemetry_application_insights, "Application Insights", "Azure Monitor")

Rel(c_learning_functions, d_configuration_store_azure_table_storage_configuration, "Reads configuration from", "Azure Table Storage")
Rel(c_learning_innerapi, d_configuration_store_azure_table_storage_configuration, "Reads configuration from", "Azure Table Storage")
Rel(c_learning_api, d_configuration_store_azure_table_storage_configuration, "Reads configuration from")
Rel(c_learning_functions, d_database_learning_sql_database, "Reads from and writes to", "Microsoft SQL Server")
Rel(c_learning, d_database_learning_sql_database, "Reads from and writes to", "SQL Server")
Rel(c_learning_innerapi, d_database_learning_sql_database, "Reads from and writes to", "SQL Server")
Rel(c_learning, d_http_api_learning_outer, "Calls the API of", "HttpClient")
Rel(c_learning_innerapi, d_identity_provider_microsoft_entra_id, "Authenticates with", "Microsoft Identity Platform (Azure AD)")
Rel(c_learning_functions, d_identity_provider_microsoft_entra_id, "Authenticates with")
Rel(c_learning_api, d_identity_provider_microsoft_entra_id, "Authenticates with")
Rel(c_learning_functions, d_message_broker_azure_service_bus, "Publishes messages to and consumes messages from", "Azure Service Bus")
Rel(c_learning_functions, d_telemetry_application_insights, "Sends telemetry to", "Azure Monitor")
Rel(c_learning_innerapi, d_telemetry_application_insights, "Sends telemetry to", "Azure Monitor")
Rel(c_learning_api, d_telemetry_application_insights, "Sends telemetry to")

@enduml
