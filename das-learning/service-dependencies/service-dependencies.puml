@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_learning, "Learning") {
  Container(c_learning_api, "Learning", "API")
  Container(c_learning_command, "Learning Command", "Component")
  Container(c_learning_dataaccess, "Learning DataAccess", "Component")
  Container(c_learning_functions, "Learning Functions", "Background Job")
  Container(c_learning_jobs, "Learning Jobs", "Background Job")
  Container(c_learning_testmessagepublisher, "Learning TestMessagePublisher", "Component")
}

System_Ext(d_cloud_service_azure_application_insights, "Azure Application Insights", "Azure Application Insights")
System_Ext(d_cloud_service_azure_table_storage, "Azure Table Storage", "Azure Table Storage")
SystemDb_Ext(d_database_learning_database, "Learning Database", "EntityFrameworkCore")
System_Ext(d_http_api_learning_outer, "Learning Outer", "HttpClient")
SystemQueue_Ext(d_message_broker_azure_service_bus, "Azure Service Bus", "NServiceBus")
SystemQueue_Ext(d_message_broker_service_bus, "Service Bus", "Azure Service Bus")

Rel(c_learning_functions, d_cloud_service_azure_application_insights, "Uses", "Azure Application Insights")
Rel(c_learning_functions, d_cloud_service_azure_table_storage, "Uses", "Azure Table Storage")
Rel(c_learning_api, d_cloud_service_azure_table_storage, "Uses", "Azure Table Storage")
Rel(c_learning_jobs, d_database_learning_database, "Reads from and writes to", "EntityFrameworkCore")
Rel(c_learning_dataaccess, d_database_learning_database, "Reads from and writes to", "SQL Server")
Rel(c_learning_api, d_database_learning_database, "Reads from and writes to", "Entity Framework")
Rel(c_learning_command, d_http_api_learning_outer, "Calls the API of", "HttpClient")
Rel(c_learning_testmessagepublisher, d_message_broker_azure_service_bus, "Publishes messages to and consumes messages from", "NServiceBus")
Rel(c_learning_functions, d_message_broker_service_bus, "Publishes messages to and consumes messages from", "Azure Service Bus")

@enduml
