@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_learning, "Learning") {
  Container(c_learning_api, "Learning", "API")
  Container(c_learning_command, "Learning Command", "Component")
  Container(c_learning_dataaccess, "Learning DataAccess", "Component")
  Container(c_learning_functions, "Learning Functions", "Background Job")
}

System_Ext(d_cloud_service_azure_table_storage, "Azure Table Storage", "Azure.Storage")
System_Ext(d_cloud_service_encoding_configuration, "Encoding Configuration")
SystemDb_Ext(d_database_learning, "Learning", "EntityFramework")
System_Ext(d_http_api_learning_outer, "Learning Outer", "HttpClient")
SystemQueue_Ext(d_message_broker_nservicebus, "NServiceBus", "Azure Service Bus")

Rel(c_learning_api, d_cloud_service_azure_table_storage, "Uses", "Azure.Storage")
Rel(c_learning_functions, d_cloud_service_azure_table_storage, "Uses", "Azure.Storage")
Rel(c_learning_command, d_cloud_service_encoding_configuration, "Uses")
Rel(c_learning_api, d_database_learning, "Reads from and writes to", "EntityFramework")
Rel(c_learning_dataaccess, d_database_learning, "Reads from and writes to", "SQL Server")
Rel(c_learning_command, d_http_api_learning_outer, "Calls the API of", "HttpClient")
Rel(c_learning_functions, d_message_broker_nservicebus, "Publishes messages to and consumes messages from", "Azure Service Bus")

@enduml
