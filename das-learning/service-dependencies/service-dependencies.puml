@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_learning, "Learning") {
  Container(c_learning, "Learning", "API")
  Container(c_learning_command, "Learning Command", "API")
  Container(c_learning_dataaccess, "Learning DataAccess", "Component")
  Container(c_learning_jobs, "Learning Jobs", "Background Job")
}

System_Ext(d_cloud_service_application_insights, "Application Insights", "Azure Application Insights")
System_Ext(d_cloud_service_azure_table_storage_for_configuration, "Azure Table Storage for Configuration", "Azure Table Storage")
SystemDb_Ext(d_database_learning_database, "Learning Database", "Entity Framework Core")
System_Ext(d_http_api_learning_outer_api, "Learning Outer API", "HttpClient")
SystemQueue_Ext(d_message_broker_nservicebus, "NServiceBus", "Azure Service Bus")

Rel(c_learning, d_cloud_service_application_insights, "Uses", "Azure Application Insights")
Rel(c_learning_jobs, d_cloud_service_application_insights, "Uses", "Azure Application Insights")
Rel(c_learning, d_cloud_service_azure_table_storage_for_configuration, "Uses", "Azure Table Storage")
Rel(c_learning_jobs, d_cloud_service_azure_table_storage_for_configuration, "Uses", "Azure Table Storage")
Rel(c_learning, d_database_learning_database, "Reads from and writes to", "Entity Framework Core")
Rel(c_learning_dataaccess, d_database_learning_database, "Reads from and writes to", "Microsoft.EntityFrameworkCore/SqlServer")
Rel(c_learning_command, d_http_api_learning_outer_api, "Calls the API of", "HttpClient")
Rel(c_learning, d_message_broker_nservicebus, "Publishes messages to and consumes messages from", "Azure Service Bus")

@enduml
