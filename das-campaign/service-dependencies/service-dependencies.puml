@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_campaign, "Campaign") {
  Container(c_campaign_mockserver, "Campaign Mock Server", "Component")
  Container(c_campaign_web, "Campaign", "Web Application")
}

SystemDb_Ext(d_cache_shared_redis, "Shared Redis", "StackExchange.Redis")
SystemDb_Ext(d_configuration_store_azure_app_configuration, "Azure App Configuration")
System_Ext(d_http_api_outer_api, "Outer Api", "HttpClient")
System_Ext(d_identity_provider_microsoft_entra_id, "Microsoft Entra ID")
System_Ext(d_telemetry_application_insights, "Application Insights")

Rel(c_campaign_web, d_cache_shared_redis, "Caches data in", "StackExchange.Redis")
Rel(c_campaign_web, d_configuration_store_azure_app_configuration, "Reads configuration from")
Rel(c_campaign_web, d_http_api_outer_api, "Calls the API of", "HttpClient")
Rel(c_campaign_web, d_identity_provider_microsoft_entra_id, "Authenticates with")
Rel(c_campaign_web, d_telemetry_application_insights, "Sends telemetry to")

@enduml
