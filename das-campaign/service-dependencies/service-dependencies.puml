@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_campaign, "Campaign") {
  Container(c_campaign_mockserver, "Campaign MockServer", "Component")
  Container(c_campaign_web, "Campaign", "Web Application")
}

SystemDb_Ext(d_cache_redis, "Redis", "StackExchange.Redis")
SystemDb_Ext(d_configuration_store_azure_table_storage_configuration, "Azure Table Storage configuration")
System_Ext(d_http_api_outer, "Outer", "HttpClient")
System_Ext(d_telemetry_application_insights, "Application Insights")

Rel(c_campaign_web, d_cache_redis, "Caches data in", "StackExchange.Redis")
Rel(c_campaign_web, d_configuration_store_azure_table_storage_configuration, "Reads configuration from")
Rel(c_campaign_web, d_http_api_outer, "Calls the API of", "HttpClient")
Rel(c_campaign_web, d_telemetry_application_insights, "Sends telemetry to")

@enduml
