@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_employercommitments_v2, "Employer Commitments") {
  Container(c_employer_commitments_web, "Employer Commitments", "Web Application")
}

SystemDb_Ext(d_cache_redis_cache, "Redis Cache", "StackExchange.Redis")
SystemDb_Ext(d_configuration_store_azure_table_storage_configuration, "Azure Table Storage Configuration")
System_Ext(d_http_api_approvals, "Approvals", "HttpClient")
System_Ext(d_http_api_commitment_permissions, "Commitment Permissions", "HttpClient")
System_Ext(d_http_api_commitments, "Commitments", "HttpClient")
System_Ext(d_identity_provider_gov_uk_one_login, "GOV.UK One Login")
System_Ext(d_telemetry_application_insights, "Application Insights")

Rel(c_employer_commitments_web, d_cache_redis_cache, "Caches data in", "StackExchange.Redis")
Rel(c_employer_commitments_web, d_configuration_store_azure_table_storage_configuration, "Reads configuration from")
Rel(c_employer_commitments_web, d_http_api_approvals, "Calls the API of", "HttpClient")
Rel(c_employer_commitments_web, d_http_api_commitment_permissions, "Calls the API of", "HttpClient")
Rel(c_employer_commitments_web, d_http_api_commitments, "Calls the API of", "HttpClient")
Rel(c_employer_commitments_web, d_identity_provider_gov_uk_one_login, "Authenticates with")
Rel(c_employer_commitments_web, d_telemetry_application_insights, "Sends telemetry to")

@enduml
