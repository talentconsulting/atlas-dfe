@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_employercommitments_v2, "Employer Commitments") {
  Container(c_employer_commitments, "Employer Commitments", "Web Application")
}

SystemDb_Ext(d_cache_redis, "Redis", "StackExchange.Redis")
System_Ext(d_http_api_approvals, "Approvals", "custom HTTP client")
System_Ext(d_http_api_commitment_permissions, "Commitment Permissions", "custom HTTP client")
System_Ext(d_http_api_commitments, "Commitments", "custom HTTP client")

Rel(c_employer_commitments, d_cache_redis, "Caches data in", "StackExchange.Redis")
Rel(c_employer_commitments, d_http_api_approvals, "Calls the API of", "custom HTTP client")
Rel(c_employer_commitments, d_http_api_commitment_permissions, "Calls the API of", "custom HTTP client")
Rel(c_employer_commitments, d_http_api_commitments, "Calls the API of", "custom HTTP client")

@enduml
