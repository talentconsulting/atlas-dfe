{
  "openapi": "3.1.0",
  "info": {
    "title": "Transfer Request API",
    "version": "1.0.0"
  },
  "paths": {
    "/{accountHashedId}/sender/transfers/{transferRequestHashedId}": {
      "get": {
        "summary": "Retrieve transfer request details for sender",
        "operationId": "GetTransferDetailsForSender",
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "transferRequestHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transfer request details retrieved for sender",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferRequestForSenderViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Update transfer request details for sender",
        "operationId": "UpdateTransferDetailsForSender",
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "transferRequestHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferRequestForSenderViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to confirmation view when transfer request is updated"
          }
        }
      }
    },
    "/{accountHashedId}/sender/transfers/{transferRequestHashedId}/confirmation": {
      "get": {
        "summary": "Retrieve transfer confirmation details",
        "operationId": "GetTransferConfirmation",
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "transferRequestHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transfer confirmation details retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferConfirmationViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Redirect based on transfer confirmation action",
        "operationId": "PostTransferConfirmation",
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "transferRequestHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferConfirmationViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect based on the selected option provided in the confirmation view"
          }
        }
      }
    },
    "/{accountHashedId}/receiver/transfers/{transferRequestHashedId}": {
      "get": {
        "summary": "Retrieve transfer request details for receiver",
        "operationId": "GetTransferDetailsForReceiver",
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "transferRequestHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transfer request details retrieved for receiver",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferRequestForReceiverViewModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TransferRequestRequest": {
        "type": "object",
        "properties": {
          "AccountHashedId": {
            "type": "string"
          },
          "AccountId": {
            "type": "integer"
          },
          "TransferRequestHashedId": {
            "type": "string"
          },
          "TransferRequestId": {
            "type": "integer"
          }
        }
      },
      "TransferRequestForSenderViewModel": {
        "type": "object",
        "properties": {
          "AccountHashedId": {
            "type": "string"
          },
          "TransferRequestHashedId": {
            "type": "string"
          },
          "TransferSenderHashedAccountId": {
            "type": "string"
          },
          "TransferReceiverPublicHashedAccountId": {
            "type": "string"
          },
          "TransferReceiverName": {
            "type": "string"
          }
        }
      },
      "TransferConfirmationRequest": {
        "type": "object",
        "properties": {
          "AccountHashedId": {
            "type": "string"
          },
          "AccountId": {
            "type": "integer"
          },
          "TransferRequestHashedId": {
            "type": "string"
          },
          "TransferRequestId": {
            "type": "integer"
          }
        }
      },
      "TransferConfirmationViewModel": {
        "type": "object",
        "properties": {
          "AccountHashedId": {
            "type": "string"
          },
          "TransferApprovalStatus": {
            "type": "string"
          },
          "TransferReceiverName": {
            "type": "string"
          },
          "SelectedOption": {
            "type": "string",
            "enum": [
              "Homepage",
              "TransfersDashboard"
            ]
          }
        }
      },
      "TransferRequestForReceiverViewModel": {
        "type": "object",
        "properties": {
          "AccountHashedId": {
            "type": "string"
          },
          "TransferRequestHashedId": {
            "type": "string"
          },
          "TotalCost": {
            "type": "number"
          },
          "FundingCap": {
            "type": "number"
          },
          "TrainingList": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingCourseSummaryViewModel"
            }
          },
          "TransferApprovalStatusDesc": {
            "type": "string"
          },
          "TransferApprovalStatus": {
            "type": "string"
          },
          "TransferApprovalSetBy": {
            "type": "string"
          },
          "TransferApprovalSetOn": {
            "type": "string",
            "format": "date-time"
          },
          "ShowFundingCapWarning": {
            "type": "boolean"
          }
        }
      },
      "TrainingCourseSummaryViewModel": {
        "type": "object",
        "properties": {
          "CourseTitle": {
            "type": "string"
          },
          "ApprenticeshipCount": {
            "type": "integer"
          }
        }
      }
    }
  }
}
