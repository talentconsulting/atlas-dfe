{
  "openapi": "3.1.0",
  "info": {
    "title": "Cohort Management API",
    "version": "1.0.0"
  },
  "paths": {
    "/{accountHashedId}/unapproved/{cohortReference}": {
      "get": {
        "summary": "Get cohort details",
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cohort details retrieved."
          }
        },
        "security": [
          {
            "HasEmployerTransactorOwnerAccount": []
          },
          {
            "AccessCohort": []
          }
        ]
      },
      "post": {
        "summary": "Update cohort details",
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Details of the cohort to update.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DetailsViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cohort updated successfully."
          }
        },
        "security": [
          {
            "HasEmployerTransactorOwnerAccount": []
          },
          {
            "AccessCohort": []
          }
        ]
      }
    },
    "/{accountHashedId}/unapproved/viewAgreement": {
      "get": {
        "summary": "View agreement",
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohortId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agreement URL returned."
          }
        }
      }
    },
    "/{accountHashedId}/unapproved/{cohortReference}/delete": {
      "get": {
        "summary": "View delete confirmation",
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Delete confirmation details."
          }
        },
        "security": [
          {
            "AccessCohort": []
          }
        ]
      },
      "post": {
        "summary": "Delete a cohort",
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Confirmation details to delete a cohort.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmDeleteViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cohort deleted successfully."
          }
        },
        "security": [
          {
            "AccessCohort": []
          }
        ]
      }
    },
    "/{accountHashedId}/unapproved/{cohortReference}/sent": {
      "get": {
        "summary": "View sent cohort",
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sent cohort details returned."
          }
        },
        "security": [
          {
            "AccessCohort": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "DetailsViewModel": {
        "type": "object",
        "properties": {
          "accountHashedId": {
            "type": "string"
          },
          "cohortReference": {
            "type": "string"
          },
          "selection": {
            "type": "string",
            "enum": [
              "Send",
              "Approve",
              "ViewEmployerAgreement",
              "Homepage"
            ]
          }
        }
      },
      "ConfirmDeleteViewModel": {
        "type": "object",
        "properties": {
          "accountHashedId": {
            "type": "string"
          },
          "cohortReference": {
            "type": "string"
          },
          "cohortId": {
            "type": "integer"
          },
          "providerName": {
            "type": "string"
          },
          "legalEntityName": {
            "type": "string"
          },
          "confirmDeletion": {
            "type": "boolean"
          }
        },
        "required": [
          "accountHashedId",
          "cohortReference",
          "cohortId"
        ]
      }
    },
    "securitySchemes": {
      "HasEmployerTransactorOwnerAccount": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization"
      },
      "AccessCohort": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization"
      }
    }
  }
}
