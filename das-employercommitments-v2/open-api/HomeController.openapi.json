{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Commitments V2 API",
    "version": "1.0.0"
  },
  "paths": {
    "/{accountHashedId}": {
      "get": {
        "summary": "Fetch Home Index View",
        "tags": [
          "Home"
        ],
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndexViewModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "PolicyNames.HasEmployerTransactorOwnerAccount": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "IndexRequest": {
        "type": "object",
        "properties": {
          "AccountHashedId": {
            "type": "string"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "AccountHashedId",
          "AccountId"
        ]
      },
      "IndexViewModel": {
        "type": "object"
      }
    },
    "securitySchemes": {
      "PolicyNames.HasEmployerTransactorOwnerAccount": {
        "type": "apiKey",
        "description": "Policy enforcing Employer Transactor Owner Account access",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}
