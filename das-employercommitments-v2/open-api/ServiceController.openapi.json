{
  "openapi": "3.1.0",
  "info": {
    "title": "ServiceController API",
    "version": "1.0.0"
  },
  "paths": {
    "/service/signout": {
      "get": {
        "operationId": "Service_SignOut",
        "summary": "Sign out the user",
        "responses": {
          "200": {
            "description": "Successful logout"
          }
        }
      }
    },
    "/service/signoutcleanup": {
      "get": {
        "operationId": "Service_SignOutCleanup",
        "summary": "Clean up authentication cookies",
        "responses": {
          "200": {
            "description": "Cookies successfully deleted"
          }
        }
      }
    },
    "/service/SignIn-Stub": {
      "get": {
        "operationId": "Service_SigninStub",
        "summary": "Display signin stub view",
        "responses": {
          "200": {
            "description": "SigninStub view displayed"
          }
        }
      },
      "post": {
        "operationId": "Service_SigninStubPost",
        "summary": "Perform signin for the stub user",
        "responses": {
          "302": {
            "description": "Redirected after successful signin"
          }
        }
      }
    },
    "/service/signed-in-stub": {
      "get": {
        "operationId": "Service_SignedInStub",
        "summary": "Display signed-in stub view",
        "security": [
          {
            "oauth2": []
          }
        ],
        "responses": {
          "200": {
            "description": "SignedInStub view displayed"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
