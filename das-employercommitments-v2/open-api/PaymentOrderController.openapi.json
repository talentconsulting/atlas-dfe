{
  "openapi": "3.1.0",
  "info": {
    "title": "PaymentOrderController API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{accountHashedId}/apprentices/manage/paymentorder": {
      "get": {
        "operationId": "getProviderPaymentOrder",
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "AccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/html": {}
            }
          }
        }
      },
      "post": {
        "operationId": "postProviderPaymentOrder",
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentOrderViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect on successful update",
            "headers": {
              "Location": {
                "description": "URL of the redirect target",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PaymentOrderRequest": {
        "type": "object",
        "properties": {
          "AccountHashedId": {
            "type": "string"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "AccountHashedId",
          "AccountId"
        ]
      },
      "PaymentOrderViewModel": {
        "type": "object",
        "properties": {
          "AccountHashedId": {
            "type": "string"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "PaymentOrderItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaymentOrderItem"
            }
          },
          "ProviderPaymentOrder": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "AccountHashedId",
          "AccountId"
        ]
      },
      "PaymentOrderItem": {
        "type": "object",
        "properties": {
          "ProviderName": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "Priority": {
            "type": "integer"
          }
        },
        "required": [
          "ProviderName",
          "ProviderId",
          "Priority"
        ]
      }
    }
  }
}
