{
  "openapi": "3.1.0",
  "info": {
    "title": "Draft Apprenticeship API",
    "version": "1.0.0",
    "description": "API for managing draft apprenticeships in DAS Employer Commitments V2."
  },
  "paths": {
    "/{AccountHashedId}/unapproved/{cohortReference}/apprentices/add": {
      "get": {
        "operationId": "AddNewDraftApprenticeship",
        "parameters": [
          {
            "in": "path",
            "name": "AccountHashedId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "cohortReference",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to SelectCourse."
          }
        }
      }
    },
    "/{AccountHashedId}/unapproved/{cohortReference}/apprentices/add/select-course": {
      "get": {
        "operationId": "GetSelectCourse",
        "parameters": [
          {
            "in": "path",
            "name": "AccountHashedId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "cohortReference",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "View SelectCourse page."
          }
        }
      },
      "post": {
        "operationId": "PostSelectCourse",
        "parameters": [
          {
            "in": "path",
            "name": "AccountHashedId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "cohortReference",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectCourseViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to SelectDeliveryModel."
          }
        }
      }
    },
    "/{AccountHashedId}/unapproved/{cohortReference}/apprentices/add/select-delivery-model": {
      "get": {
        "operationId": "GetSelectDeliveryModel",
        "parameters": [
          {
            "in": "path",
            "name": "AccountHashedId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "cohortReference",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "View SelectDeliveryModel page."
          },
          "302": {
            "description": "Redirect to AddDraftApprenticeshipDetails if delivery model selected."
          }
        }
      },
      "post": {
        "operationId": "PostSetDeliveryModel",
        "parameters": [
          {
            "in": "path",
            "name": "AccountHashedId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "cohortReference",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectDeliveryModelViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to AddDraftApprenticeshipDetails."
          }
        }
      }
    },
    "/{AccountHashedId}/unapproved/{cohortReference}/apprentices/add-another": {
      "get": {
        "operationId": "GetAddDraftApprenticeshipDetails",
        "parameters": [
          {
            "in": "path",
            "name": "AccountHashedId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "cohortReference",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "View AddDraftApprenticeshipDetails page."
          },
          "302": {
            "description": "Redirect to cohort details page in case of error."
          }
        }
      },
      "post": {
        "operationId": "PostAddDraftApprenticeshipDetails",
        "parameters": [
          {
            "in": "path",
            "name": "AccountHashedId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "cohortReference",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddDraftApprenticeshipViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to next step or cohort details."
          }
        }
      }
    },
    "/{AccountHashedId}/unapproved/{cohortReference}/apprentices/{DraftApprenticeshipHashedId}": {
      "get": {
        "operationId": "GetDraftApprenticeshipDetails",
        "parameters": [
          {
            "in": "path",
            "name": "AccountHashedId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "cohortReference",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "DraftApprenticeshipHashedId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "View draft apprenticeship details."
          }
        }
      }
    },
    "/{AccountHashedId}/unapproved/{cohortReference}/apprentices/{DraftApprenticeshipHashedId}/Delete": {
      "get": {
        "operationId": "GetDeleteDraftApprenticeship",
        "parameters": [
          {
            "in": "path",
            "name": "AccountHashedId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "cohortReference",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "DraftApprenticeshipHashedId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "View DeleteDraftApprenticeship page."
          }
        }
      },
      "post": {
        "operationId": "PostDeleteDraftApprenticeship",
        "parameters": [
          {
            "in": "path",
            "name": "AccountHashedId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "cohortReference",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "DraftApprenticeshipHashedId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteDraftApprenticeshipViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to cohort details or origin page after deletion."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "CohortId": {
            "type": "integer"
          },
          "AccountLegalEntityId": {
            "type": "integer"
          },
          "CacheKey": {
            "type": "string",
            "format": "uuid"
          },
          "AccountHashedId": {
            "type": "string"
          },
          "CohortReference": {
            "type": "string"
          },
          "AccountLegalEntityHashedId": {
            "type": "string"
          },
          "ReservationId": {
            "type": "string",
            "format": "uuid"
          },
          "CourseCode": {
            "type": "string"
          },
          "DeliveryModel": {
            "$ref": "#/components/schemas/DeliveryModel"
          },
          "Cost": {
            "type": "integer"
          },
          "EmploymentPrice": {
            "type": "integer"
          }
        }
      },
      "SelectCourseViewModel": {
        "type": "object",
        "properties": {
          "AccountHashedId": {
            "type": "string"
          },
          "CohortReference": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer"
          },
          "CourseCode": {
            "type": "string"
          }
        }
      },
      "SelectDeliveryModelViewModel": {
        "type": "object",
        "properties": {
          "AccountHashedId": {
            "type": "string"
          },
          "CohortReference": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer"
          }
        }
      },
      "AddDraftApprenticeshipViewModel": {
        "type": "object",
        "properties": {
          "AccountHashedId": {
            "type": "string"
          },
          "CohortReference": {
            "type": "string"
          },
          "LegalEntityName": {
            "type": "string"
          }
        }
      },
      "DeleteDraftApprenticeshipViewModel": {
        "type": "object",
        "properties": {
          "AccountHashedId": {
            "type": "string"
          },
          "DraftApprenticeshipHashedId": {
            "type": "string"
          }
        }
      },
      "DeliveryModel": {
        "type": "string",
        "enum": [
          "Regular",
          "PortableFlexiJob",
          "FlexiJobAgency"
        ]
      }
    }
  }
}
