@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_employmentcheck, "Employment Check") {
  Container(c_employment_check, "Employment Check", "Background Job")
  Container(c_employment_check_2, "Employment Check", "API")
  Container(c_employment_check_data_seeder, "Employment Check Data Seeder", "Background Job")
}

SystemDb_Ext(d_database_employment_check_database, "Employment Check Database", "SQL Server")
System_Ext(d_http_api_data_collections, "Data Collections", "HttpClient")
System_Ext(d_http_api_employer_account, "Employer Account", "HttpClient")
System_Ext(d_http_api_hmrc_esfa_levy, "HMRC ESFA Levy", "HttpClient")
System_Ext(d_http_api_token_service, "Token Service", "HttpClient")

Rel(c_employment_check_data_seeder, d_database_employment_check_database, "Reads from and writes to", "SQL Server")
Rel(c_employment_check, d_database_employment_check_database, "Reads from and writes to", "SQL Server")
Rel(c_employment_check_2, d_database_employment_check_database, "Reads from and writes to", "Azure SQL Database")
Rel(c_employment_check, d_http_api_data_collections, "Calls the API of", "HttpClient")
Rel(c_employment_check_2, d_http_api_data_collections, "Calls the API of", "HTTP")
Rel(c_employment_check, d_http_api_employer_account, "Calls the API of", "HttpClient")
Rel(c_employment_check_2, d_http_api_employer_account, "Calls the API of", "HTTP")
Rel(c_employment_check, d_http_api_hmrc_esfa_levy, "Calls the API of", "HttpClient")
Rel(c_employment_check, d_http_api_token_service, "Calls the API of", "HttpClient")

@enduml
