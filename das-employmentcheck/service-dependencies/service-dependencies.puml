@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_employmentcheck, "Employment Check") {
  Container(c_employment_check_api, "Employment Check", "API")
  Container(c_employmentcheck_data_seeder, "EmploymentCheck Data Seeder", "Background Job")
  Container(c_employmentcheck_jobs, "EmploymentCheck Jobs", "Background Job")
}

System_Ext(d_cloud_service_azure_table_storage, "Azure Table Storage")
SystemDb_Ext(d_database_employment_check_database, "Employment Check Database", "Microsoft SQL Server")
System_Ext(d_http_api_apprenticeship_levy, "Apprenticeship Levy", "HttpClient")
System_Ext(d_http_api_data_collections_api, "Data Collections API", "HTTP")
System_Ext(d_http_api_employer_account, "Employer Account", "HTTP")
System_Ext(d_http_api_token_service, "Token Service", "HttpClient")
SystemQueue_Ext(d_message_broker_azure_service_bus, "Azure Service Bus")

Rel(c_employmentcheck_jobs, d_cloud_service_azure_table_storage, "Uses")
Rel(c_employment_check_api, d_database_employment_check_database, "Reads from and writes to", "Microsoft SQL Server")
Rel(c_employmentcheck_data_seeder, d_database_employment_check_database, "Reads from and writes to", "Microsoft SQL")
Rel(c_employmentcheck_jobs, d_database_employment_check_database, "Reads from and writes to", "SQL Server")
Rel(c_employmentcheck_jobs, d_http_api_apprenticeship_levy, "Calls the API of", "HttpClient")
Rel(c_employment_check_api, d_http_api_data_collections_api, "Calls the API of", "HTTP")
Rel(c_employment_check_api, d_http_api_employer_account, "Calls the API of", "HTTP")
Rel(c_employmentcheck_jobs, d_http_api_token_service, "Calls the API of", "HttpClient")
Rel(c_employmentcheck_jobs, d_message_broker_azure_service_bus, "Publishes messages to and consumes messages from")

@enduml
