@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_employmentcheck, "Employment Check") {
  Container(c_employment_check, "Employment Check", "API")
  Container(c_employment_check_data_seeder, "Employment Check Data Seeder", "Component")
  Container(c_employmentcheck, "EmploymentCheck", "Component")
}

SystemDb_Ext(d_database_sql_database, "SQL Database", "SQL Server")
System_Ext(d_http_api_apprenticeship_levy, "Apprenticeship Levy", "HttpClient")
System_Ext(d_http_api_data_collections, "Data Collections", "HTTP")
System_Ext(d_http_api_employer_account, "Employer Account", "HTTP")
System_Ext(d_http_api_hmrc_api, "HMRC API")
System_Ext(d_http_api_token_service, "Token Service")
SystemQueue_Ext(d_message_broker_azure_service_bus, "Azure Service Bus", "Azure.Messaging.ServiceBus")

Rel(c_employment_check_data_seeder, d_database_sql_database, "Reads from and writes to", "SQL Server")
Rel(c_employment_check, d_database_sql_database, "Reads from and writes to", "SQL Server")
Rel(c_employmentcheck, d_database_sql_database, "Reads from and writes to", "Microsoft.Data.SqlClient")
Rel(c_employmentcheck, d_http_api_apprenticeship_levy, "Calls the API of", "HttpClient")
Rel(c_employment_check, d_http_api_data_collections, "Calls the API of", "HTTP")
Rel(c_employment_check, d_http_api_employer_account, "Calls the API of", "HTTP")
Rel(c_employmentcheck, d_http_api_employer_account, "Calls the API of")
Rel(c_employmentcheck, d_http_api_hmrc_api, "Calls the API of")
Rel(c_employmentcheck, d_http_api_token_service, "Calls the API of")
Rel(c_employmentcheck, d_message_broker_azure_service_bus, "Publishes messages to and consumes messages from", "Azure.Messaging.ServiceBus")

@enduml
