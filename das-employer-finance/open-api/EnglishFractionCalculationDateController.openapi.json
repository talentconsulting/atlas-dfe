{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/english-fraction-calculation-date/{empRef}": {
      "get": {
        "summary": "Get Last Calculation Date",
        "operationId": "GetLastCalculationDate",
        "parameters": [
          {
            "name": "empRef",
            "in": "path",
            "required": true,
            "description": "The employer reference used to fetch the last calculation date.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The last English fraction calculation date.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRolesReadAllEmployerAccountBalances": []
          }
        ]
      }
    },
    "/api/english-fraction-calculation-date": {
      "post": {
        "summary": "Persist Calculation Date",
        "operationId": "PersistCalculationDate",
        "requestBody": {
          "description": "Request payload containing the English fraction calculation date.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnglishFractionCalculationDateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The calculation date was persisted successfully."
          },
          "400": {
            "description": "Bad Request. The request payload is invalid or missing."
          }
        },
        "security": [
          {
            "ApiRolesReadAllEmployerAccountBalances": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "EnglishFractionCalculationDateRequest": {
        "type": "object",
        "properties": {
          "DateCalculated": {
            "type": "string",
            "format": "date-time",
            "description": "The date when the calculation was performed."
          }
        },
        "required": [
          "DateCalculated"
        ]
      }
    },
    "securitySchemes": {
      "ApiRolesReadAllEmployerAccountBalances": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "Requires the 'ReadAllEmployerAccountBalances' role."
      }
    }
  }
}
