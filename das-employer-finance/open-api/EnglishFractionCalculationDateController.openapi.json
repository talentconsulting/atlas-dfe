{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/english-fraction-calculation-date/{empRef}": {
      "get": {
        "summary": "Get the last English Fraction Calculation Date",
        "operationId": "getLastCalculationDate",
        "parameters": [
          {
            "name": "empRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The employer reference (empRef)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ]
      }
    },
    "/api/english-fraction-calculation-date": {
      "post": {
        "summary": "Persist English Fraction Calculation Date",
        "operationId": "persistCalculationDate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnglishFractionCalculationDateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation"
          },
          "400": {
            "description": "Bad request, payload is required"
          }
        },
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "EnglishFractionCalculationDateRequest": {
        "type": "object",
        "properties": {
          "DateCalculated": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "DateCalculated"
        ]
      }
    },
    "securitySchemes": {
      "ReadAllEmployerAccountBalances": {
        "type": "oauth2",
        "description": "Access policy requiring ReadAllEmployerAccountBalances role",
        "flows": {
          "implicit": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "scopes": {
              "ReadAllEmployerAccountBalances": "Access to all employer account balances"
            }
          }
        }
      }
    }
  }
}
