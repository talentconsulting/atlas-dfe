  "components": {
    "schemas": {
      "ApprovedTransferConnectionInvitationViewModel": {
        "type": "object",
        "properties": {
          "choice": {
            "type": "string",
            "enum": [
              "GoToApprenticesPage",
              "GoToHomepage"
            ]
          },
          "hashedAccountId": {
            "type": "string"
          },
          "hashedTransferConnectionInvitationId": {
            "type": "string"
          },
          "senderAccountName": {
            "type": "string"
          }
        }
      },
      "DeletedTransferConnectionInvitationViewModel": {
        "type": "object",
        "properties": {
          "choice": {
            "type": "string",
            "enum": [
              "GoToTransfersPage",
              "GoToHomepage"
            ]
          },
          "hashedAccountId": {
            "type": "string"
          },
          "hashedTransferConnectionInvitationId": {
            "type": "string"
          }
        }
      },
      "ReceiveTransferConnectionInvitationViewModel": {
        "type": "object",
        "properties": {
          "transferConnectionInvitationId": {
            "type": "string"
          },
          "choice": {
            "type": "string",
            "enum": [
              "Approve",
              "Reject"
            ]
          },
          "hashedAccountId": {
            "type": "string"
          },
          "notHashedTransferConnectionInvitationId": {
            "type": "integer"
          },
          "senderAccountName": {
            "type": "string"
          },
          "pendingChangeUserFullName": {
            "type": "string"
          },
          "pendingChangeCreatedDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RejectedTransferConnectionInvitationViewModel": {
        "type": "object",
        "properties": {
          "choice": {
            "type": "string",
            "enum": [
              "Confirm",
              "GoToTransfersPage"
            ]
          },
          "hashedAccountId": {
            "type": "string"
          },
          "hashedTransferConnectionInvitationId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "senderAccountName": {
            "type": "string"
          },
          "pendingUserName": {
            "type": "string"
          },
          "pendingChangeCreatedDate": {
            "type": "string",
            "format": "date-time"
          },
          "receiverAccountName": {
            "type": "string"
          },
          "receiverAccountPublicHashedId": {
            "type": "string"
          }
        }
      },
      "SendTransferConnectionInvitationViewModel": {
        "type": "object",
        "properties": {
          "choice": {
            "type": "string",
            "enum": [
              "Confirm",
              "ReEnterAccountId"
            ]
          },
          "receiverAccountPublicHashedId": {
            "type": "string",
            "pattern": "^[A-Za-z\\d]{6,6}$"
          },
          "hashedAccountId": {
            "type": "string"
          },
          "senderAccountName": {
            "type": "string"
          },
          "receiverAccountName": {
            "type": "string"
          }
        }
      },
      "SentTransferConnectionInvitationViewModel": {
        "type": "object",
        "properties": {
          "choice": {
            "type": "string",
            "enum": [
              "GoToTransfersPage",
              "GoToHomepage"
            ]
          },
          "receiverAccountName": {
            "type": "string"
          },
          "senderAccountName": {
            "type": "string"
          },
          "receiverPublicHashedId": {
            "type": "string"
          },
          "hashedAccountId": {
            "type": "string"
          },
          "hashedTransferConnectionInvitationId": {
            "type": "string"
          }
        }
      },
      "StartTransferConnectionInvitationViewModel": {
        "type": "object",
        "properties": {
          "hashedAccountId": {
            "type": "string"
          },
          "userRef": {
            "type": "string",
            "format": "uuid"
          },
          "receiverAccountPublicHashedId": {
            "type": "string",
            "pattern": "^[A-Za-z\\d]{6,6}$"
          }
        }
      },
      "TransferConnectionInvitationViewModel": {
        "type": "object",
        "properties": {
          "choice": {
            "type": "string",
            "enum": [
              "Confirm",
              "GoToTransfersPage"
            ]
          },
          "id": {
            "type": "integer"
          },
          "transferConnectionInvitation": {
            "$ref": "#/components/schemas/TransferConnectionInvitationDto"
          },
          "hashedAccountId": {
            "type": "string"
          },
          "hashedTransferConnectionInvitationId": {
            "type": "string"
          }
        }
      },
      "TransferConnectionInvitationDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransferConnectionInvitationChangeDto"
            }
          },
          "createdDate": {
            "type": "string",
            "format": "date-time"
          },
          "receiverAccount": {
            "$ref": "#/components/schemas/AccountDto"
          },
          "senderAccount": {
            "$ref": "#/components/schemas/AccountDto"
          },
          "status": {
            "type": "string",
            "enum": [
              "Pending",
              "Approved",
              "Rejected"
            ]
          },
          "hashedId": {
            "type": "string"
          }
        }
      },
      "TransferConnectionInvitationChangeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "createdDate": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "Pending",
              "Approved",
              "Rejected"
            ]
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        }
      },
      "AccountDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "hashedId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "publicHashedId": {
            "type": "string"
          }
        }
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "ref": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          }
        }
      }
    }
  }
}
