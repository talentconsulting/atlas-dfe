{
  "openapi": "3.1.0",
  "info": {
    "title": "Transfer Connection Invitations API",
    "version": "1.0.0",
    "description": "API for managing transfer connection invitations between employer accounts."
  },
  "paths": {
    "/accounts/{hashedAccountId}/transfers/connections/requests": {
      "get": {
        "summary": "Get transfer connection invitations overview",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "HTML view of transfer connection invitations overview"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/transfers/connections/requests/start": {
      "get": {
        "summary": "Start creating a transfer connection invitation",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "HTML view to start creating a transfer connection invitation"
          }
        }
      },
      "post": {
        "summary": "Submit a transfer connection invitation",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartTransferConnectionInvitationViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to /send or /start after processing"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/transfers/connections/requests/send": {
      "get": {
        "summary": "Get transfer connection invitation details for sending",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "HTML view of transfer connection invitation details for sending"
          }
        }
      },
      "post": {
        "summary": "Submit choice actions for transfer connection sending",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendTransferConnectionInvitationViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect based on user choice"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/transfers/connections/requests/{transferConnectionInvitationId}/sent": {
      "get": {
        "summary": "Retrieve sent transfer connection invitation details",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "transferConnectionInvitationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "HTML view of sent transfer connection invitation details"
          }
        }
      },
      "post": {
        "summary": "Perform actions when viewing sent invitation details",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "transferConnectionInvitationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SentTransferConnectionInvitationViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect based on user choice"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/transfers/connections/requests/{transferConnectionInvitationId}/receive": {
      "get": {
        "summary": "Retrieve received transfer connection invitation details",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "transferConnectionInvitationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "HTML view of received transfer connection invitation details"
          }
        }
      },
      "post": {
        "summary": "Perform actions on received invitation",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "transferConnectionInvitationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReceiveTransferConnectionInvitationViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect based on user choice"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/transfers/connections/requests/{transferConnectionInvitationId}/rejected": {
      "get": {
        "summary": "Retrieve rejected transfer connection invitation details",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "transferConnectionInvitationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "HTML view of rejected transfer connection invitation details"
          }
        }
      },
      "post": {
        "summary": "Perform actions on rejected invitation",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "transferConnectionInvitationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RejectedTransferConnectionInvitationViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect based on user choice"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/transfers/connections/requests/{transferConnectionInvitationId}/deleted": {
      "get": {
        "summary": "Retrieve details of deleted transfer connection invitation",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "transferConnectionInvitationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "HTML view of deleted transfer connection invitation details"
          }
        }
      },
      "post": {
        "summary": "Perform actions after viewing deleted invitation",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "transferConnectionInvitationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeletedTransferConnectionInvitationViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect based on user choice"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/transfers/connections/requests/outstanding": {
      "get": {
        "summary": "Process outstanding transfer connection invitations",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to corresponding view if there are outstanding invitations"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApprovedTransferConnectionInvitationViewModel": {
        "type": "object",
        "properties": {
          "choice": {
            "type": "string",
            "enum": [
              "GoToApprenticesPage",
              "GoToHomepage"
            ],
            "description": "User's choice after viewing approved transfer connection invitation"
          },
          "hashedAccountId": {
            "type": "string",
            "description": "Hashed account ID"
          },
          "hashedTransferConnectionInvitationId": {
            "type": "string",
            "description": "Hashed ID of the transfer connection invitation"
          },
          "senderAccountName": {
            "type": "string",
            "description": "Name of the sender account"
          }
        }
      },
      "DeletedTransferConnectionInvitationViewModel": {
        "type": "object",
        "properties": {
          "choice": {
            "type": "string",
            "enum": [
              "GoToTransfersPage",
              "GoToHomepage"
            ],
            "description": "User's choice after viewing deleted transfer connection invitation"
          },
          "hashedAccountId": {
            "type": "string",
            "description": "Hashed account ID"
          },
          "hashedTransferConnectionInvitationId": {
            "type": "string",
            "description": "Hashed ID of the transfer connection invitation"
          }
        }
      },
      "ReceiveTransferConnectionInvitationViewModel": {
        "type": "object",
        "properties": {
          "transferConnectionInvitationId": {
            "type": "string",
            "description": "ID of the transfer connection invitation"
          },
          "choice": {
            "type": "string",
            "enum": [
              "Approve",
              "Reject"
            ],
            "description": "User's choice of action"
          },
          "hashedAccountId": {
            "type": "string",
            "description": "Hashed account ID"
          },
          "senderAccountName": {
            "type": "string",
            "description": "Name of the sender account"
          },
          "pendingChangeUserFullName": {
            "type": "string",
            "description": "Full name of the user who initiated the pending change"
          },
          "pendingChangeCreatedDate": {
            "type": "string",
            "format": "date-time",
            "description": "Date when the pending change was created"
          }
        }
      },
      "RejectedTransferConnectionInvitationViewModel": {
        "type": "object",
        "properties": {
          "choice": {
            "type": "string",
            "enum": [
              "Confirm",
              "GoToTransfersPage"
            ],
            "description": "User's choice for rejected transfer connection invitation"
          },
          "hashedAccountId": {
            "type": "string",
            "description": "Hashed account ID"
          },
          "hashedTransferConnectionInvitationId": {
            "type": "string",
            "description": "Hashed ID of the transfer connection invitation"
          },
          "status": {
            "type": "string",
            "description": "Status of the transfer connection invitation"
          },
          "senderAccountName": {
            "type": "string",
            "description": "Name of the sender account"
          },
          "pendingUserName": {
            "type": "string",
            "description": "Full name of the user who initiated the pending change"
          },
          "pendingChangeCreatedDate": {
            "type": "string",
            "format": "date-time",
            "description": "Date when the pending change was created"
          },
          "receiverAccountName": {
            "type": "string",
            "description": "Name of the receiver account"
          },
          "receiverAccountPublicHashedId": {
            "type": "string",
            "description": "Public hashed ID of the receiver account"
          }
        }
      },
      "SendTransferConnectionInvitationViewModel": {
        "type": "object",
        "properties": {
          "choice": {
            "type": "string",
            "enum": [
              "Confirm",
              "ReEnterAccountId"
            ],
            "description": "User's choice for sending a transfer connection invitation"
          },
          "receiverAccountPublicHashedId": {
            "type": "string",
            "pattern": "^[A-Za-z\\d]{6,6}$",
            "description": "Receiver account public hashed ID"
          },
          "hashedAccountId": {
            "type": "string",
            "description": "Hashed account ID"
          },
          "senderAccountName": {
            "type": "string",
            "description": "Name of the sender account"
          },
          "receiverAccountName": {
            "type": "string",
            "description": "Name of the receiver account"
          }
        }
      },
      "SentTransferConnectionInvitationViewModel": {
        "type": "object",
        "properties": {
          "choice": {
            "type": "string",
            "enum": [
              "GoToTransfersPage",
              "GoToHomepage"
            ],
            "description": "User's choice when viewing sent invitation details"
          },
          "receiverAccountName": {
            "type": "string",
            "description": "Name of the receiver account"
          },
          "senderAccountName": {
            "type": "string",
            "description": "Name of the sender account"
          },
          "receiverPublicHashedId": {
            "type": "string",
            "description": "Public hashed ID of the receiver account"
          },
          "hashedAccountId": {
            "type": "string",
            "description": "Hashed account ID"
          },
          "hashedTransferConnectionInvitationId": {
            "type": "string",
            "description": "Hashed ID of the transfer connection invitation"
          }
        }
      },
      "StartTransferConnectionInvitationViewModel": {
        "type": "object",
        "properties": {
          "hashedAccountId": {
            "type": "string",
            "description": "Hashed account ID"
          },
          "userRef": {
            "type": "string",
            "format": "uuid",
            "description": "Reference of the user initiating the transfer"
          },
          "receiverAccountPublicHashedId": {
            "type": "string",
            "pattern": "^[A-Za-z\\d]{6,6}$",
            "description": "Receiver account public hashed ID"
          }
        }
      },
      "TransferConnectionInvitationViewModel": {
        "type": "object",
        "properties": {
          "choice": {
            "type": "string",
            "enum": [
              "Confirm",
              "GoToTransfersPage"
            ],
            "description": "User's choice when viewing invitation details"
          },
          "id": {
            "type": "integer",
            "description": "ID of the transfer connection invitation"
          },
          "transferConnectionInvitation": {
            "type": "object",
            "description": "Details of the transfer connection invitation",
            "$ref": "#/components/schemas/TransferConnectionInvitationDto"
          },
          "hashedAccountId": {
            "type": "string",
            "description": "Hashed account ID"
          },
          "hashedTransferConnectionInvitationId": {
            "type": "string",
            "description": "Hashed ID of the transfer connection invitation"
          }
        }
      },
      "TransferConnectionInvitationDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID of the transfer connection invitation"
          },
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransferConnectionInvitationChangeDto"
            },
            "description": "List of changes associated with the invitation"
          },
          "createdDate": {
            "type": "string",
            "format": "date-time",
            "description": "Date when the invitation was created"
          },
          "receiverAccount": {
            "$ref": "#/components/schemas/AccountDto"
          },
          "senderAccount": {
            "$ref": "#/components/schemas/AccountDto"
          },
          "status": {
            "type": "string",
            "enum": [
              "Pending",
              "Approved",
              "Rejected"
            ],
            "description": "Status of the invitation"
          },
          "hashedId": {
            "type": "string",
            "description": "Hashed ID of the invitation"
          }
        }
      },
      "TransferConnectionInvitationChangeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID of the change"
          },
          "createdDate": {
            "type": "string",
            "format": "date-time",
            "description": "Date when the change was created"
          },
          "status": {
            "type": "string",
            "enum": [
              "Pending",
              "Approved",
              "Rejected"
            ],
            "description": "Status of the change"
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        }
      },
      "AccountDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID of the account"
          },
          "hashedId": {
            "type": "string",
            "description": "Hashed ID of the account"
          },
          "name": {
            "type": "string",
            "description": "Name of the account"
          },
          "publicHashedId": {
            "type": "string",
            "description": "Public hashed ID of the account"
          }
        }
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID of the user"
          },
          "ref": {
            "type": "string",
            "format": "uuid",
            "description": "Reference of the user"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email of the user"
          },
          "firstName": {
            "type": "string",
            "description": "First name of the user"
          },
          "lastName": {
            "type": "string",
            "description": "Last name of the user"
          },
          "fullName": {
            "type": "string",
            "description": "Full name of the user"
          }
        }
      }
    }
  }
}
