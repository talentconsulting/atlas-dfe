{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance Transfer Connection Invitations API",
    "description": "API for managing employer transfer connection invitations",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{hashedAccountId}/transfers/connections/requests": {
      "get": {
        "summary": "Retrieve transfer connection requests",
        "tags": [
          "Transfer Connection Invitations"
        ],
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
