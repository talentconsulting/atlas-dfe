{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance Period End API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/period-ends": {
      "get": {
        "summary": "Get All Period Ends",
        "description": "Retrieves all period ends.",
        "operationId": "getAllPeriodEnds",
        "tags": [
          "PeriodEnds"
        ],
        "security": [
          {
            "ApiRolesOAuth2": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with the list of period ends.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PeriodEnd"
                  }
                }
              }
            }
          },
          "404": {
            "description": "No period ends found."
          }
        }
      },
      "post": {
        "summary": "Create a Period End",
        "description": "Creates a new period end.",
        "operationId": "createPeriodEnd",
        "tags": [
          "PeriodEnds"
        ],
        "security": [
          {
            "ApiRolesOAuth2": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ],
        "requestBody": {
          "description": "Details of the period end to create.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PeriodEnd"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response with the created period end.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeriodEnd"
                }
              }
            }
          },
          "400": {
            "description": "The request was invalid."
          },
          "500": {
            "description": "An error occurred while creating the period end."
          }
        }
      }
    },
    "/api/period-ends/{periodEndId}": {
      "get": {
        "summary": "Get Period End by ID",
        "description": "Retrieves a specific period end by its ID.",
        "operationId": "getPeriodEndById",
        "tags": [
          "PeriodEnds"
        ],
        "security": [
          {
            "ApiRolesOAuth2": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ],
        "parameters": [
          {
            "name": "periodEndId",
            "in": "path",
            "required": true,
            "description": "The ID of the period end.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with the period end data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeriodEnd"
                }
              }
            }
          },
          "404": {
            "description": "Period end not found."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PeriodEnd": {
        "type": "object",
        "properties": {
          "PeriodEndId": {
            "type": "string",
            "description": "The unique identifier for the period end."
          },
          "CalendarPeriodMonth": {
            "type": "integer",
            "description": "The month of the calendar period."
          },
          "CalendarPeriodYear": {
            "type": "integer",
            "description": "The year of the calendar period."
          },
          "AccountDataValidAt": {
            "type": "string",
            "format": "date-time",
            "description": "The date and time when the account data is valid."
          },
          "CommitmentDataValidAt": {
            "type": "string",
            "format": "date-time",
            "description": "The date and time when the commitment data is valid."
          },
          "CompletionDateTime": {
            "type": "string",
            "format": "date-time",
            "description": "The date and time when the period end is completed."
          },
          "PaymentsForPeriod": {
            "type": "string",
            "description": "The payments associated with the period."
          }
        },
        "required": [
          "PeriodEndId",
          "CalendarPeriodMonth",
          "CalendarPeriodYear",
          "CompletionDateTime",
          "PaymentsForPeriod"
        ]
      }
    },
    "securitySchemes": {
      "ApiRolesOAuth2": {
        "type": "oauth2",
        "flows": {
          "implicit": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "scopes": {
              "ReadUserAccounts": "Grants read access to user accounts.",
              "ReadAllEmployerAccountBalances": "Grants access to read all employer account balances."
            }
          }
        }
      }
    }
  }
}
