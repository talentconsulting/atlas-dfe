{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/period-ends": {
      "get": {
        "summary": "Get all period ends",
        "description": "Retrieves all period ends.",
        "operationId": "getAllPeriodEnds",
        "security": [
          {
            "ApiRoles_ReadAllEmployerAccountBalances": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PeriodEnd"
                  }
                }
              }
            }
          },
          "404": {
            "description": "No period ends found."
          }
        }
      },
      "post": {
        "summary": "Create a period end",
        "description": "Creates a new period end from the request body.",
        "operationId": "createPeriodEnd",
        "security": [
          {
            "ApiRoles_ReadAllEmployerAccountBalances": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PeriodEnd"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Period end created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeriodEnd"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body."
          },
          "500": {
            "description": "Internal server error. Could not create period end."
          }
        }
      }
    },
    "/api/period-ends/{periodEndId}": {
      "get": {
        "summary": "Get a period end by ID",
        "description": "Retrieves a specific period end by its ID.",
        "operationId": "getPeriodEndById",
        "security": [
          {
            "ApiRoles_ReadAllEmployerAccountBalances": []
          }
        ],
        "parameters": [
          {
            "name": "periodEndId",
            "in": "path",
            "required": true,
            "description": "The ID of the period end to retrieve.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeriodEnd"
                }
              }
            }
          },
          "404": {
            "description": "Period end not found."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiRoles_ReadAllEmployerAccountBalances": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "API key required to access this endpoint with the role ReadAllEmployerAccountBalances."
      }
    },
    "schemas": {
      "PeriodEnd": {
        "type": "object",
        "properties": {
          "PeriodEndId": {
            "type": "string"
          },
          "CalendarPeriodMonth": {
            "type": "integer",
            "format": "int32"
          },
          "CalendarPeriodYear": {
            "type": "integer",
            "format": "int32"
          },
          "AccountDataValidAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "CommitmentDataValidAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "CompletionDateTime": {
            "type": "string",
            "format": "date-time"
          },
          "PaymentsForPeriod": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
