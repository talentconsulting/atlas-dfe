{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance Payments API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/payments/staging": {
      "post": {
        "operationId": "BulkPaymentsIngest",
        "summary": "Ingest bulk payments into staging.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkPaymentsRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Payments staged successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "insertedCount": {
                      "type": "integer",
                      "format": "int32",
                      "description": "Number of payments inserted."
                    },
                    "paymentIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "format": "uuid",
                        "description": "IDs of inserted payments."
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - validation errors.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "string",
                      "description": "Error message for missing payments payload."
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "description": "Validation error messages."
                      }
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Conflict - conflicting payment IDs.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "paymentIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "format": "uuid",
                        "description": "IDs of conflicting payments."
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error staging payments.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "description": "Error message."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BulkPaymentsRequest": {
        "type": "object",
        "properties": {
          "Payments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaymentStagingModel"
            },
            "description": "List of payment staging models."
          }
        },
        "required": [
          "Payments"
        ]
      },
      "PaymentStagingModel": {
        "type": "object",
        "properties": {
          "PaymentId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the payment."
          },
          "AccountId": {
            "type": "integer",
            "format": "int64",
            "description": "Identifier for the employer account."
          },
          "Ukprn": {
            "type": "integer",
            "format": "int64",
            "description": "UK Provider Reference Number."
          },
          "Uln": {
            "type": "integer",
            "format": "int64",
            "description": "Unique Learner Number."
          },
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64",
            "description": "Identifier for the apprenticeship."
          },
          "CollectionPeriodId": {
            "type": "string",
            "description": "Identifier for the collection period."
          },
          "DeliveryPeriodMonth": {
            "type": "integer",
            "format": "int32",
            "description": "Delivery period month."
          },
          "DeliveryPeriodYear": {
            "type": "integer",
            "format": "int32",
            "description": "Delivery period year."
          },
          "CollectionPeriodMonth": {
            "type": "integer",
            "format": "int32",
            "description": "Collection period month."
          },
          "CollectionPeriodYear": {
            "type": "integer",
            "format": "int32",
            "description": "Collection period year."
          },
          "FundingSource": {
            "type": "string",
            "description": "Source of funding."
          },
          "TransactionType": {
            "type": "string",
            "description": "Type of transaction."
          },
          "Amount": {
            "type": "number",
            "format": "decimal",
            "description": "Amount of the payment."
          },
          "EvidenceSubmittedOn": {
            "type": "string",
            "format": "date-time",
            "description": "Date when evidence was submitted."
          },
          "EmployerAccountVersion": {
            "type": "string",
            "description": "Version of the employer account."
          },
          "ApprenticeshipVersion": {
            "type": "string",
            "description": "Version of the apprenticeship."
          }
        },
        "required": [
          "PaymentId",
          "AccountId",
          "Ukprn",
          "Uln",
          "ApprenticeshipId",
          "CollectionPeriodId",
          "DeliveryPeriodMonth",
          "DeliveryPeriodYear",
          "CollectionPeriodMonth",
          "CollectionPeriodYear",
          "FundingSource",
          "TransactionType",
          "Amount",
          "EvidenceSubmittedOn",
          "EmployerAccountVersion",
          "ApprenticeshipVersion"
        ]
      }
    }
  }
}
