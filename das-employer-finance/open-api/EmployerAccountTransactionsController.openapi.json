{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Account Transactions API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{hashedAccountId}/finance/provider/summary": {
      "get": {
        "operationId": "GetProviderPaymentSummary",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ukprn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with provider payment summary view."
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/finance": {
      "get": {
        "operationId": "GetFinanceIndex",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with finance index view."
          },
          "302": {
            "description": "Redirects to another URL if specified."
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/finance/downloadtransactions": {
      "get": {
        "operationId": "GetTransactionsDownload",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with transaction download view."
          }
        }
      },
      "post": {
        "operationId": "PostTransactionsDownload",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransactionDownloadViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful transaction file download."
          },
          "400": {
            "description": "Validation failed."
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/finance/{year}/{month}": {
      "get": {
        "operationId": "GetTransactionsView",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "month",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with transaction view."
          },
          "302": {
            "description": "Redirects to access denied view if account is not found."
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/finance/levyDeclaration/details": {
      "get": {
        "operationId": "GetLevyDeclarationDetail",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with levy declaration detail view."
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/finance/course/standard/summary": {
      "get": {
        "operationId": "GetCourseStandardPaymentSummary",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ukprn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "courseName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "courseLevel",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with course standard payment summary."
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/finance/course/framework/summary": {
      "get": {
        "operationId": "GetCourseFrameworkPaymentSummary",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ukprn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "courseName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "courseLevel",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "pathwayCode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with course framework payment summary."
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/finance/transfer/details": {
      "get": {
        "operationId": "GetTransferDetail",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "senderAccountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "receiverAccountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "transferSector",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with transfer details view."
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/finance/expiredfunds/details": {
      "get": {
        "operationId": "GetExpiredFundsDetails",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with expired funds details view."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TransactionDownloadViewModel": {
        "type": "object",
        "properties": {
          "StartDate": {
            "$ref": "#/components/schemas/MonthYear"
          },
          "EndDate": {
            "$ref": "#/components/schemas/MonthYear"
          },
          "DownloadFormat": {
            "$ref": "#/components/schemas/DownloadFormatType"
          },
          "Version": {
            "type": "string"
          }
        },
        "required": [
          "StartDate",
          "EndDate",
          "DownloadFormat",
          "Version"
        ]
      },
      "MonthYear": {
        "type": "object",
        "properties": {
          "Month": {
            "type": "string"
          },
          "Year": {
            "type": "string"
          }
        },
        "required": [
          "Month",
          "Year"
        ]
      },
      "DownloadFormatType": {
        "type": "string",
        "enum": [
          "CSV",
          "Excel"
        ]
      }
    }
  }
}
