{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance Health Check API",
    "version": "1.0.0"
  },
  "paths": {
    "/healthcheck": {
      "get": {
        "summary": "Get Health Check Info",
        "description": "Retrieves health check information.",
        "operationId": "getHealthCheck",
        "parameters": [],
        "security": [
          {
            "PolicyNames.HasEmployerViewerTransactorOwnerAccount": []
          }
        ],
        "responses": {
          "200": {
            "description": "Health check data retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetHealthCheckQueryResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Run Health Check",
        "description": "Runs a health check command.",
        "operationId": "runHealthCheck",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunHealthCheckCommand"
              }
            }
          }
        },
        "security": [
          {
            "PolicyNames.HasEmployerViewerTransactorOwnerAccount": []
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to the health check results after execution."
          }
        }
      }
    },
    "/Content/lib/govuk-frontend/dist/assets/images/favicon.ico": {
      "get": {
        "summary": "Favicon File Check",
        "description": "Checks for the availability of the favicon file.",
        "operationId": "fileCheck",
        "responses": {
          "200": {
            "description": "File exists and is accessible.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "OK"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetHealthCheckQueryResponse": {
        "type": "object",
        "properties": {
          "HealthCheck": {
            "$ref": "#/components/schemas/HealthCheckDto"
          }
        }
      },
      "RunHealthCheckCommand": {
        "type": "object",
        "properties": {
          "UserRef": {
            "type": "string",
            "format": "uuid",
            "nullable": false
          }
        },
        "required": [
          "UserRef"
        ]
      },
      "HealthCheckDto": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "example": 123
          },
          "SentRequest": {
            "type": "string",
            "format": "date-time"
          },
          "ReceivedResponse": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "PublishedEvent": {
            "type": "string",
            "format": "date-time"
          },
          "ReceivedEvent": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      }
    }
  }
}
