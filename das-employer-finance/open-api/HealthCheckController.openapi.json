{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/healthcheck": {
      "get": {
        "operationId": "getHealthCheck",
        "summary": "Gets a health check status.",
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetHealthCheckQueryResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "runHealthCheck",
        "summary": "Runs a health check.",
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunHealthCheckCommand"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to the Index page."
          }
        }
      }
    },
    "/Content/lib/govuk-frontend/dist/assets/images/favicon.ico": {
      "get": {
        "operationId": "fileCheck",
        "summary": "Checks if the favicon file exists.",
        "responses": {
          "200": {
            "description": "File exists."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetHealthCheckQueryResponse": {
        "type": "object",
        "properties": {
          "HealthCheck": {
            "$ref": "#/components/schemas/HealthCheckDto"
          }
        }
      },
      "RunHealthCheckCommand": {
        "type": "object",
        "properties": {
          "UserRef": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "required": [
          "UserRef"
        ]
      },
      "HealthCheckDto": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int32"
          },
          "SentRequest": {
            "type": "string",
            "format": "date-time"
          },
          "ReceivedResponse": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "PublishedEvent": {
            "type": "string",
            "format": "date-time"
          },
          "ReceivedEvent": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      }
    },
    "securitySchemes": {
      "HasEmployerViewerTransactorOwnerAccount": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/auth",
            "tokenUrl": "https://example.com/token",
            "scopes": {}
          }
        }
      }
    }
  }
}
