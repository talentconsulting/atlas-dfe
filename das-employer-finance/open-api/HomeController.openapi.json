{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance Service API",
    "version": "1.0.0"
  },
  "paths": {
    "/service": {
      "get": {
        "operationId": "Index",
        "responses": {
          "302": {
            "description": "Redirects to the legacy EAS action."
          }
        }
      }
    },
    "/service/signedIn": {
      "get": {
        "operationId": "SignedIn",
        "security": [
          {
            "OauthPolicy": []
          }
        ],
        "responses": {
          "200": {
            "description": "Displays the signed-in view."
          }
        }
      }
    },
    "/service/{HashedAccountId}/privacy": {
      "get": {
        "operationId": "PrivacyWithHashedAccountId",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Displays the privacy view."
          }
        }
      }
    },
    "/service/privacy": {
      "get": {
        "operationId": "Privacy",
        "responses": {
          "200": {
            "description": "Displays the privacy view without HashedAccountId."
          }
        }
      }
    },
    "/service/{HashedAccountId}/cookieConsent": {
      "get": {
        "operationId": "CookieConsentWithHashedAccountId",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to the Employer Accounts cookie consent."
          }
        }
      }
    },
    "/service/cookieConsent": {
      "get": {
        "operationId": "CookieConsent",
        "responses": {
          "302": {
            "description": "Redirects to the Employer Accounts cookie consent without HashedAccountId."
          }
        }
      }
    },
    "/service/signOut": {
      "post": {
        "operationId": "SignOutUser",
        "responses": {
          "302": {
            "description": "Signs the user out and redirects."
          }
        }
      }
    },
    "/service/SignOutCleanup": {
      "post": {
        "operationId": "SignOutCleanup",
        "responses": {
          "204": {
            "description": "Cleans up the user's session and performs sign-out."
          }
        }
      }
    },
    "/service/help": {
      "get": {
        "operationId": "Help",
        "responses": {
          "301": {
            "description": "Redirects permanently to the help center URL."
          }
        }
      }
    },
    "/service/signIn": {
      "get": {
        "operationId": "SignIn",
        "security": [
          {
            "OauthPolicy": []
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects the user to the sign-in action."
          }
        }
      }
    },
    "/service/SignIn-Stub": {
      "get": {
        "operationId": "SigninStub",
        "responses": {
          "200": {
            "description": "Displays the stub sign-in view."
          }
        }
      },
      "post": {
        "operationId": "SigninStubPost",
        "responses": {
          "302": {
            "description": "Performs stub sign-in and redirects to the stub signed-in route."
          }
        }
      }
    },
    "/service/signed-in-stub": {
      "get": {
        "operationId": "SignedInStub",
        "security": [
          {
            "OauthPolicy": []
          }
        ],
        "responses": {
          "200": {
            "description": "Displays the stub signed-in view."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "OauthPolicy": {
        "type": "oauth2",
        "description": "Requires OAuth2 authentication for specified operations.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "tokenUrl": "https://example.com/oauth/token",
            "scopes": {}
          }
        }
      }
    }
  }
}
