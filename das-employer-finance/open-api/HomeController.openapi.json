{
  "openapi": "3.1.0",
  "info": {
    "title": "HomeController API",
    "version": "1.0.0",
    "description": "API for managing service-related actions in the HomeController."
  },
  "paths": {
    "/service": {
      "get": {
        "operationId": "Index",
        "summary": "Redirect to LegacyEAS Action",
        "responses": {
          "302": {
            "description": "Redirect to LegacyEAS."
          }
        }
      }
    },
    "/service/{HashedAccountId}/privacy": {
      "get": {
        "operationId": "PrivacyWithAccountId",
        "summary": "Display Privacy policy for a specific account",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Display Privacy policy."
          }
        }
      }
    },
    "/service/privacy": {
      "get": {
        "operationId": "Privacy",
        "summary": "Display Privacy policy",
        "responses": {
          "200": {
            "description": "Display Privacy policy."
          }
        }
      }
    },
    "/service/{HashedAccountId}/cookieConsent": {
      "get": {
        "operationId": "CookieConsentWithAccountId",
        "summary": "Redirect to cookie consent for a specific account",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to cookie consent."
          }
        }
      }
    },
    "/service/cookieConsent": {
      "get": {
        "operationId": "CookieConsent",
        "summary": "Redirect to cookie consent",
        "responses": {
          "302": {
            "description": "Redirect to cookie consent."
          }
        }
      }
    },
    "/service/signOut": {
      "post": {
        "operationId": "SignOutUser",
        "summary": "Sign out the user",
        "responses": {
          "302": {
            "description": "User signed out."
          }
        }
      }
    },
    "/service/SignOutCleanup": {
      "post": {
        "operationId": "SignOutCleanup",
        "summary": "Sign out cleanup",
        "responses": {
          "200": {
            "description": "User sign-out cleanup completed."
          }
        }
      }
    },
    "/service/help": {
      "get": {
        "operationId": "Help",
        "summary": "Redirect to Help Centre",
        "responses": {
          "301": {
            "description": "Redirect to Help Centre."
          }
        }
      }
    },
    "/service/signIn": {
      "get": {
        "operationId": "SignIn",
        "summary": "Redirect to sign-in action",
        "responses": {
          "302": {
            "description": "Redirect to sign-in."
          }
        }
      }
    },
    "/service/SignIn-Stub": {
      "get": {
        "operationId": "SigninStubView",
        "summary": "Display Sign-In Stub View",
        "responses": {
          "200": {
            "description": "Stub sign-in view rendered."
          }
        }
      },
      "post": {
        "operationId": "SigninStubPost",
        "summary": "Submit stub sign-in",
        "responses": {
          "302": {
            "description": "Redirect to signed-in stub."
          }
        }
      }
    },
    "/service/signed-in-stub": {
      "get": {
        "operationId": "SignedInStub",
        "summary": "Display stub signed-in view",
        "responses": {
          "200": {
            "description": "Stub signed-in view rendered."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
