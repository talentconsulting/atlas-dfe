{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance Web API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{hashedAccountId}/transfers/connections": {
      "get": {
        "operationId": "TransferConnections_Index",
        "summary": "Retrieve transfer connections related to the specified account",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed ID of the employer account"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferViewModel"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "PolicyNames.HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "TransferViewModel": {
        "type": "object",
        "properties": {
          "ApprenticeshipEmployerType": {
            "type": "string"
          },
          "TransferAllowanceViewModel": {
            "$ref": "#/components/schemas/TransferAllowanceViewModel"
          },
          "TransferConnectionInvitationAuthorizationViewModel": {
            "$ref": "#/components/schemas/TransferConnectionInvitationAuthorizationViewModel"
          },
          "TransferConnectionInvitationsViewModel": {
            "$ref": "#/components/schemas/TransferConnectionInvitationsViewModel"
          },
          "TransferRequest": {
            "$ref": "#/components/schemas/TransferRequestsViewModel"
          }
        }
      },
      "TransferAllowanceViewModel": {
        "type": "object",
        "additionalProperties": {}
      },
      "TransferConnectionInvitationAuthorizationViewModel": {
        "type": "object",
        "properties": {
          "HashedAccountId": {
            "type": "string"
          }
        },
        "additionalProperties": {}
      },
      "TransferConnectionInvitationsViewModel": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "HashedAccountId": {
            "type": "string"
          },
          "TransferSenderConnectionInvitations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransferConnectionInvitationDto"
            }
          },
          "TransferReceiverConnectionInvitations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransferConnectionInvitationDto"
            }
          }
        },
        "additionalProperties": {}
      },
      "TransferConnectionInvitationDto": {
        "type": "object",
        "properties": {
          "Changes": {
            "type": "array",
            "items": {}
          },
          "Id": {
            "type": "integer",
            "format": "int64"
          },
          "Status": {
            "type": "string"
          },
          "CreatedDate": {
            "type": "string",
            "format": "date-time"
          },
          "ReceiverAccount": {
            "type": "object",
            "additionalProperties": {}
          },
          "SenderAccount": {
            "type": "object",
            "additionalProperties": {}
          },
          "HashedId": {
            "type": "string"
          }
        }
      },
      "TransferRequestsViewModel": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "TransferRequests": {
            "type": "array",
            "items": {}
          }
        },
        "additionalProperties": {}
      }
    },
    "securitySchemes": {
      "PolicyNames.HasEmployerViewerTransactorOwnerAccount": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
