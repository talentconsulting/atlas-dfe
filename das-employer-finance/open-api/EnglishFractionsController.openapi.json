{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "description": "API for managing English Fractions data.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/english-fractions": {
      "post": {
        "summary": "Persist English Fractions",
        "description": "Endpoint to persist English fractions data.",
        "operationId": "PersistEnglishFractions",
        "security": [
          {
            "ApiRoles.ReadAllEmployerAccountBalances": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnglishFractionsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EnglishFractionsRequest": {
        "type": "object",
        "required": [
          "EmpRef",
          "UpdateRequired",
          "DateCalculated",
          "Fractions"
        ],
        "properties": {
          "EmpRef": {
            "type": "string",
            "description": "Employer reference"
          },
          "UpdateRequired": {
            "type": "boolean",
            "description": "Flag indicating whether an update is required"
          },
          "DateCalculated": {
            "type": "string",
            "format": "date-time",
            "description": "Date the fractions were calculated"
          },
          "Fractions": {
            "type": "array",
            "description": "List of English fraction items",
            "items": {
              "$ref": "#/components/schemas/EnglishFractionItem"
            }
          }
        }
      },
      "EnglishFractionItem": {
        "type": "object",
        "required": [
          "DateCalculated",
          "Amount"
        ],
        "properties": {
          "DateCalculated": {
            "type": "string",
            "format": "date-time",
            "description": "Date the fraction was calculated"
          },
          "Amount": {
            "type": "number",
            "format": "decimal",
            "description": "Amount of the fraction"
          }
        }
      }
    },
    "securitySchemes": {
      "ApiRoles.ReadAllEmployerAccountBalances": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization policy for reading all employer account balances."
      }
    }
  }
}
