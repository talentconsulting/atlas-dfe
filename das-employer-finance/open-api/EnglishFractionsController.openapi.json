{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/english-fractions": {
      "post": {
        "summary": "Persist English fractions data",
        "description": "Persists English fractions data provided in the request payload.",
        "operationId": "persistEnglishFractions",
        "security": [
          {
            "ApiRoles.ReadAllEmployerAccountBalances": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnglishFractionsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "English fractions persisted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Request payload is required",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EnglishFractionsRequest": {
        "type": "object",
        "properties": {
          "EmpRef": {
            "type": "string",
            "description": "Employer reference"
          },
          "UpdateRequired": {
            "type": "boolean",
            "description": "Indicates whether the update is required"
          },
          "DateCalculated": {
            "type": "string",
            "format": "date-time",
            "description": "Date when the fractions were calculated"
          },
          "Fractions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnglishFractionItem"
            },
            "description": "List of English fraction items"
          }
        },
        "required": [
          "EmpRef",
          "UpdateRequired",
          "DateCalculated",
          "Fractions"
        ]
      },
      "EnglishFractionItem": {
        "type": "object",
        "properties": {
          "DateCalculated": {
            "type": "string",
            "format": "date-time",
            "description": "Date when the fraction item was calculated"
          },
          "Amount": {
            "type": "number",
            "format": "decimal",
            "description": "Fraction amount"
          }
        },
        "required": [
          "DateCalculated",
          "Amount"
        ]
      }
    },
    "securitySchemes": {
      "ApiRoles.ReadAllEmployerAccountBalances": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization required to persist English fractions data"
      }
    }
  }
}
