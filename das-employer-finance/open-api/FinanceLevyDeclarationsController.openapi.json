{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance Levy Declarations API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/levy-declarations": {
      "post": {
        "summary": "Persist Levy Declarations",
        "operationId": "persistLevyDeclarations",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PersistLevyDeclarationRequestData"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ]
      }
    },
    "/api/levy-declarations/{empRef}/period-12-declarations": {
      "get": {
        "summary": "Get Existing Period 12 Levy Declarations",
        "operationId": "getExistingPeriod12LevyDeclarations",
        "parameters": [
          {
            "name": "empRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ]
      }
    },
    "/api/levy-declarations/{empRef}/submission-ids": {
      "get": {
        "summary": "Get Submission IDs",
        "operationId": "getSubmissionIds",
        "parameters": [
          {
            "name": "empRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ]
      }
    },
    "/api/levy-declarations/{empRef}/last-submission-date": {
      "get": {
        "summary": "Get Last Submission Date by Employer Reference",
        "operationId": "getLastSubmissionDateByEmpRef",
        "parameters": [
          {
            "name": "empRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ]
      }
    },
    "/api/levy-declarations/{accountId}/last-submission-date": {
      "get": {
        "summary": "Get Last Submission Date by Account ID",
        "operationId": "getLastSubmissionDateByAccountId",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "lastSubmissionDate": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ]
      }
    },
    "/api/levy-declarations/{accountId}/summary": {
      "get": {
        "summary": "Get Levy Summary by Account ID",
        "operationId": "getLevySummaryByAccountId",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        },
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ]
      }
    },
    "/api/levy-declarations/{accountId}/summaryByDate": {
      "get": {
        "summary": "Get Levy Declaration Summary by Date Range",
        "operationId": "getLevyDeclarationSummaryByDateRange",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        },
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ]
      }
    },
    "/api/levy-declarations/{accountId}/funds-in": {
      "get": {
        "summary": "Get Levy Funds In for Calendar Periods",
        "operationId": "getLevyFundsInForCalendarPeriods",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CalendarPeriodAmount"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "PersistLevyDeclarationRequestData": {
        "type": "object",
        "properties": {
          "CorrelationId": {
            "type": "string"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "EmpRef": {
            "type": "string"
          },
          "Declarations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NormalizedLevyDeclaration"
            }
          },
          "GenerateTransactions": {
            "type": "boolean"
          }
        },
        "required": [
          "CorrelationId",
          "AccountId",
          "EmpRef",
          "Declarations",
          "GenerateTransactions"
        ]
      },
      "NormalizedLevyDeclaration": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "LevyDueYtd": {
            "type": "number"
          },
          "SubmissionDate": {
            "type": "string",
            "format": "date-time"
          },
          "SubmissionType": {
            "type": "string"
          },
          "LevyAllowanceForFullYear": {
            "type": "number"
          },
          "PayrollYear": {
            "type": "string"
          },
          "PayrollMonth": {
            "type": "integer",
            "format": "int32"
          },
          "NoPaymentForPeriod": {
            "type": "boolean"
          },
          "DateCeased": {
            "type": "string",
            "format": "date-time"
          },
          "InactiveFrom": {
            "type": "string",
            "format": "date-time"
          },
          "InactiveTo": {
            "type": "string",
            "format": "date-time"
          },
          "EndOfYearAdjustment": {
            "type": "boolean"
          },
          "EndOfYearAdjustmentAmount": {
            "type": "number"
          },
          "SubmissionId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "Id",
          "SubmissionDate",
          "SubmissionType",
          "LevyAllowanceForFullYear",
          "PayrollYear",
          "NoPaymentForPeriod",
          "EndOfYearAdjustment",
          "EndOfYearAdjustmentAmount",
          "SubmissionId"
        ]
      },
      "CalendarPeriodAmount": {
        "type": "object",
        "properties": {
          "Year": {
            "type": "integer",
            "format": "int32"
          },
          "Month": {
            "type": "integer",
            "format": "int32"
          },
          "Amount": {
            "type": "number"
          }
        },
        "required": [
          "Year",
          "Month",
          "Amount"
        ]
      }
    },
    "securitySchemes": {
      "ReadAllEmployerAccountBalances": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization using 'ReadAllEmployerAccountBalances' policy"
      }
    }
  }
}
