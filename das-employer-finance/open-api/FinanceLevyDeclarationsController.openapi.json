{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/levy-declarations": {
      "post": {
        "summary": "Persist levy declarations",
        "operationId": "persistLevyDeclarations",
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PersistLevyDeclarationRequestData"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Levy declarations persisted successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad request due to validation errors.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/levy-declarations/{empRef}/period-12-declarations": {
      "get": {
        "summary": "Get existing period 12 levy declarations",
        "operationId": "getExistingPeriod12LevyDeclarations",
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ],
        "parameters": [
          {
            "name": "empRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Period 12 declarations retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/levy-declarations/{empRef}/submission-ids": {
      "get": {
        "summary": "Get submission IDs",
        "operationId": "getSubmissionIds",
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ],
        "parameters": [
          {
            "name": "empRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Submission IDs retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/levy-declarations/{empRef}/last-submission-date": {
      "get": {
        "summary": "Get last submission date",
        "operationId": "getLastSubmissionDate",
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ],
        "parameters": [
          {
            "name": "empRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Last submission date retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      }
    },
    "/api/levy-declarations/{accountId}/summary": {
      "get": {
        "summary": "Get levy summary by account ID",
        "operationId": "getLevySummary",
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ],
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Levy summary retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Levy summary not found."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PersistLevyDeclarationRequestData": {
        "type": "object",
        "properties": {
          "CorrelationId": {
            "type": "string"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "EmpRef": {
            "type": "string"
          },
          "Declarations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NormalizedLevyDeclaration"
            }
          },
          "GenerateTransactions": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "CorrelationId",
          "AccountId",
          "EmpRef",
          "Declarations",
          "GenerateTransactions"
        ]
      },
      "NormalizedLevyDeclaration": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "LevyDueYtd": {
            "type": "number",
            "format": "decimal",
            "nullable": true
          },
          "SubmissionDate": {
            "type": "string",
            "format": "date-time"
          },
          "SubmissionType": {
            "type": "string"
          },
          "LevyAllowanceForFullYear": {
            "type": "number",
            "format": "decimal"
          },
          "PayrollYear": {
            "type": "string"
          },
          "PayrollMonth": {
            "type": "integer",
            "format": "int16",
            "nullable": true
          },
          "NoPaymentForPeriod": {
            "type": "boolean"
          },
          "DateCeased": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "InactiveFrom": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "InactiveTo": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "EndOfYearAdjustment": {
            "type": "boolean"
          },
          "EndOfYearAdjustmentAmount": {
            "type": "number",
            "format": "decimal"
          },
          "SubmissionId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "Id",
          "SubmissionDate",
          "SubmissionType",
          "LevyAllowanceForFullYear",
          "PayrollYear",
          "NoPaymentForPeriod",
          "EndOfYearAdjustment",
          "EndOfYearAdjustmentAmount",
          "SubmissionId"
        ]
      }
    },
    "securitySchemes": {
      "ReadAllEmployerAccountBalances": {
        "type": "oauth2",
        "flows": {
          "implicit": {
            "authorizationUrl": "https://example.com/auth",
            "scopes": {
              "ReadAllEmployerAccountBalances": "Allows reading all employer account balances."
            }
          }
        }
      }
    }
  }
}
