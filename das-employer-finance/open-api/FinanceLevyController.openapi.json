{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{hashedAccountId}/levy": {
      "get": {
        "summary": "Get Levy",
        "description": "Retrieve levy information for a specific account.",
        "operationId": "GetLevy",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed account identifier."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully fetched levy information.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LevyResponse"
                }
              }
            }
          },
          "404": {
            "description": "Levy information not found."
          }
        },
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/levy/{payrollYear}/{payrollMonth}": {
      "get": {
        "summary": "Get Levy for Specific Period",
        "description": "Retrieve levy information for a specific account and payroll period.",
        "operationId": "GetLevyForPeriod",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed account identifier."
          },
          {
            "name": "payrollYear",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The payroll year."
          },
          {
            "name": "payrollMonth",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int16"
            },
            "description": "The payroll month."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully fetched levy information for the specific period.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LevyResponse"
                }
              }
            }
          },
          "404": {
            "description": "Levy information for the specific period not found."
          }
        },
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/levy/english-fraction-history": {
      "get": {
        "summary": "Get English Fraction History",
        "description": "Retrieve English fraction history for a specific account and employer reference.",
        "operationId": "GetEnglishFractionHistory",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed account identifier."
          },
          {
            "name": "empRef",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The employer reference."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully fetched English fraction history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnglishFractionHistoryResponse"
                }
              }
            }
          },
          "404": {
            "description": "English fraction history not found."
          }
        },
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/levy/english-fraction-current": {
      "get": {
        "summary": "Get Current English Fractions",
        "description": "Retrieve the current English fraction values for a specific account and employer references.",
        "operationId": "GetEnglishFractionCurrent",
        "parameters": [
          {
            "name": "empRefs",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "The list of employer references."
          },
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed account identifier."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully fetched current English fractions.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnglishFractionCurrentResponse"
                }
              }
            }
          },
          "404": {
            "description": "Current English fractions not found."
          }
        },
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "LevyResponse": {
        "type": "object",
        "additionalProperties": true
      },
      "EnglishFractionHistoryResponse": {
        "type": "object",
        "additionalProperties": true
      },
      "EnglishFractionCurrentResponse": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "securitySchemes": {
      "ReadAllEmployerAccountBalances": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}
