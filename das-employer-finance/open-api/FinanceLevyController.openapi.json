{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{hashedAccountId}/levy": {
      "get": {
        "operationId": "GetLevy",
        "summary": "Retrieve levy details for an account",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed ID of the account"
          }
        ],
        "responses": {
          "200": {
            "description": "Levy information retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetLevyResponse"
                }
              }
            }
          },
          "404": {
            "description": "Levy information not found"
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/levy/{payrollYear}/{payrollMonth}": {
      "get": {
        "operationId": "GetLevyForPeriod",
        "summary": "Retrieve levy details for an account for a specific payroll year and month",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed ID of the account"
          },
          {
            "name": "payrollYear",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The payroll year"
          },
          {
            "name": "payrollMonth",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int16"
            },
            "description": "The payroll month"
          }
        ],
        "responses": {
          "200": {
            "description": "Levy information for the specified period retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetLevyResponse"
                }
              }
            }
          },
          "404": {
            "description": "Levy information not found for the specified period"
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/levy/english-fraction-history": {
      "get": {
        "operationId": "GetEnglishFractionHistory",
        "summary": "Retrieve English fraction history for an account",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed ID of the account"
          },
          {
            "name": "empRef",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The employer reference"
          }
        ],
        "responses": {
          "200": {
            "description": "English fraction history retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetEnglishFractionHistoryResponse"
                }
              }
            }
          },
          "404": {
            "description": "English fraction history not found"
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/levy/english-fraction-current": {
      "get": {
        "operationId": "GetEnglishFractionCurrent",
        "summary": "Retrieve English fraction current state for an account",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed ID of the account"
          },
          {
            "name": "empRefs",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Array of employer references"
          }
        ],
        "responses": {
          "200": {
            "description": "English fraction current state retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetEnglishFractionCurrentResponse"
                }
              }
            }
          },
          "404": {
            "description": "English fraction current state not found"
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "GetLevyResponse": {
        "type": "object",
        "description": "Response schema for levy details",
        "additionalProperties": true
      },
      "GetEnglishFractionHistoryResponse": {
        "type": "object",
        "description": "Response schema for English fraction history",
        "additionalProperties": true
      },
      "GetEnglishFractionCurrentResponse": {
        "type": "object",
        "description": "Response schema for English fraction current state",
        "additionalProperties": true
      }
    },
    "securitySchemes": {
      "ApiRoles": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization using API roles"
      }
    }
  }
}
