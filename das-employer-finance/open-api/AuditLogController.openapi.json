{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance Audit Log API",
    "version": "1.0.0"
  },
  "paths": {
    "/jobs": {
      "post": {
        "summary": "Create an audit job",
        "operationId": "CreateJob",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAuditJobRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Audit job created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateResourceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditErrorDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Get a list of audit jobs",
        "operationId": "GetJobs",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pagesize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of audit jobs returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid paging parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditErrorDetails"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{jobId}": {
      "get": {
        "summary": "Get details of an audit job",
        "operationId": "GetJob",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Audit job details returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Audit job not found"
          }
        }
      }
    },
    "/jobs/{jobId}/logs": {
      "get": {
        "summary": "Get logs of an audit job",
        "operationId": "GetJobLogs",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pagesize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Logs of the audit job retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid paging parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditErrorDetails"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{jobId}/workflows/{workflowId}/logs": {
      "post": {
        "summary": "Create a workflow log for an audit job",
        "operationId": "CreateWorkflowLog",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "workflowId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWorkflowLogRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Workflow log created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateResourceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditErrorDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Get logs of a workflow for an audit job",
        "operationId": "GetWorkflowLogs",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "workflowId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pagesize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Logs of the workflow retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid paging parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditErrorDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateAuditJobRequest": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          },
          "DateStarted": {
            "type": "string",
            "format": "date-time"
          },
          "NumRecords": {
            "type": "integer"
          }
        },
        "required": [
          "Id",
          "Description",
          "DateStarted",
          "NumRecords"
        ]
      },
      "CreateWorkflowLogRequest": {
        "type": "object",
        "properties": {
          "Sequence": {
            "type": "integer"
          },
          "SpanId": {
            "type": "string"
          },
          "Stage": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          },
          "Status": {
            "type": "string"
          },
          "Data": {
            "type": [
              "object",
              "null"
            ]
          },
          "Error": {
            "$ref": "#/components/schemas/AuditErrorDetails"
          }
        },
        "required": [
          "Sequence",
          "SpanId",
          "Stage",
          "Description",
          "Status"
        ]
      },
      "CreateResourceResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Message": {
            "type": "string"
          }
        }
      },
      "AuditErrorDetails": {
        "type": "object",
        "properties": {
          "Code": {
            "type": "string"
          },
          "Message": {
            "type": "string"
          }
        }
      }
    }
  }
}
