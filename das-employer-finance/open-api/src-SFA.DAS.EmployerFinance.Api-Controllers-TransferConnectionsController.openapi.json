{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{hashedAccountId}/transfers/connections": {
      "get": {
        "summary": "Get transfer connections for a hashed account ID",
        "operationId": "GetTransferConnectionsByHashedAccountId",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed account ID of the employer's account"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TransferConnection"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRolesReadUserAccounts": []
          }
        ]
      }
    },
    "/api/accounts/internal/{accountId}/transfers/connections": {
      "get": {
        "summary": "Get transfer connections for an internal account ID with status filter",
        "operationId": "GetTransferConnectionsByAccountId",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The internal account ID of the employer's account"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/TransferConnectionInvitationStatus"
            },
            "description": "The status of the transfer connection invitation"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TransferConnection"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRolesReadUserAccounts": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "TransferConnectionInvitationStatus": {
        "type": "string",
        "enum": [
          "Pending",
          "Approved",
          "Rejected"
        ]
      },
      "TransferConnection": {
        "type": "object",
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "ApiRolesReadUserAccounts": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization policy for reading user accounts"
      }
    }
  }
}
