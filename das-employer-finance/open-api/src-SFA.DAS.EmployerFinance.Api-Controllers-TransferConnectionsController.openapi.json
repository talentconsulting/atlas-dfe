{
  "openapi": "3.1.0",
  "info": {
    "title": "EmployerFinance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{hashedAccountId}/transfers/connections": {
      "get": {
        "summary": "Get Transfer Connections by Hashed Account ID",
        "operationId": "GetTransferConnectionsByHashed",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed account ID."
          }
        ],
        "responses": {
          "200": {
            "description": "A list of transfer connections.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TransferConnection"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRolesReadUserAccounts": []
          }
        ]
      }
    },
    "/api/accounts/internal/{accountId}/transfers/connections": {
      "get": {
        "summary": "Get Transfer Connections by Account ID and Status",
        "operationId": "GetTransferConnectionsByInternalAccount",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The account ID."
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/TransferConnectionInvitationStatus"
            },
            "description": "Filter by transfer connection invitation status. Defaults to 'Approved'."
          }
        ],
        "responses": {
          "200": {
            "description": "A list of transfer connections.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TransferConnection"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRolesReadUserAccounts": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "TransferConnection": {
        "type": "object",
        "description": "A transfer connection entity.",
        "properties": {}
      },
      "TransferConnectionInvitationStatus": {
        "type": "string",
        "enum": [
          "Pending",
          "Approved",
          "Rejected"
        ],
        "description": "The status of a transfer connection invitation."
      }
    },
    "securitySchemes": {
      "ApiRolesReadUserAccounts": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "API key for accessing resources requiring the 'ReadUserAccounts' policy."
      }
    }
  }
}
