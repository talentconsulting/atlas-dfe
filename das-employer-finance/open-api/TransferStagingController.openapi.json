{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/transfers/staging": {
      "post": {
        "summary": "Stage transfers",
        "description": "Stages transfers for employer accounts.",
        "operationId": "StageTransfers",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StageTransfersRequest"
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "example": {
                  "message": "Transfers payload is required."
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "transferIds": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    }
                  }
                },
                "example": {
                  "transferIds": [
                    12345,
                    67890
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "example": {
                  "message": "An unexpected error occurred while staging transfers."
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "insertedCount": {
                      "type": "integer"
                    },
                    "transferIds": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    }
                  }
                },
                "example": {
                  "insertedCount": 5,
                  "transferIds": [
                    12345,
                    67890
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllEmployerAccountBalances": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "StageTransfersRequest": {
        "type": "object",
        "properties": {
          "transfers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransferStaging"
            }
          }
        },
        "required": [
          "transfers"
        ]
      },
      "TransferStaging": {
        "type": "object",
        "properties": {
          "transferId": {
            "type": "integer",
            "format": "int64"
          },
          "senderAccountId": {
            "type": "integer",
            "format": "int64"
          },
          "senderAccountName": {
            "type": "string"
          },
          "receiverAccountId": {
            "type": "integer",
            "format": "int64"
          },
          "receiverAccountName": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "format": "decimal"
          },
          "transferDate": {
            "type": "string",
            "format": "date-time"
          },
          "periodEnd": {
            "type": "string"
          },
          "collectionPeriodMonth": {
            "type": "integer"
          },
          "collectionPeriodYear": {
            "type": "integer"
          },
          "ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "courseName": {
            "type": "string"
          },
          "courseLevel": {
            "type": "integer",
            "nullable": true
          },
          "learningType": {
            "type": "string"
          },
          "apprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "type": {
            "type": "string"
          },
          "requiredPaymentId": {
            "type": "string",
            "format": "uuid"
          },
          "createdBy": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          }
        },
        "required": [
          "transferId",
          "senderAccountId",
          "senderAccountName",
          "receiverAccountId",
          "receiverAccountName",
          "amount",
          "transferDate",
          "periodEnd",
          "collectionPeriodMonth",
          "collectionPeriodYear",
          "ukprn",
          "courseName",
          "learningType",
          "apprenticeshipId",
          "type",
          "requiredPaymentId",
          "createdBy",
          "correlationId"
        ]
      }
    },
    "securitySchemes": {
      "ApiRoles.ReadAllEmployerAccountBalances": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
