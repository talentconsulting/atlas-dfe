{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "description": "API for managing employer finance-related operations like transfer staging.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/transfers/staging": {
      "post": {
        "summary": "Stage Transfers",
        "description": "Stages transfers using the provided payload.",
        "operationId": "StageTransfers",
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StageTransfersRequest"
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Bad Request. The request is invalid or contains validation errors.",
            "content": {
              "application/json": {
                "examples": {
                  "InvalidPayload": {
                    "value": "Transfers payload is required."
                  },
                  "ValidationErrors": {
                    "value": {
                      "validationErrors": [
                        "TransferId must be greater than zero."
                      ]
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Conflict. Conflicting transfer IDs exist.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "transferIds": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "format": "int64"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "An unexpected error occurred while staging transfers.",
            "content": {
              "text/plain": {
                "examples": {
                  "InternalServerError": {
                    "value": "An unexpected error occurred while staging transfers."
                  }
                }
              }
            }
          },
          "201": {
            "description": "Created. Transfers were successfully staged.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "insertedCount": {
                      "type": "integer"
                    },
                    "transferIds": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "format": "int64"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ReadAllEmployerAccountBalances": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "Authorization using the 'ReadAllEmployerAccountBalances' policy."
      }
    },
    "schemas": {
      "StageTransfersRequest": {
        "type": "object",
        "properties": {
          "Transfers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransferStaging"
            }
          }
        },
        "required": [
          "Transfers"
        ]
      },
      "TransferStaging": {
        "type": "object",
        "properties": {
          "TransferId": {
            "type": "integer",
            "format": "int64"
          },
          "SenderAccountId": {
            "type": "integer",
            "format": "int64"
          },
          "SenderAccountName": {
            "type": "string"
          },
          "ReceiverAccountId": {
            "type": "integer",
            "format": "int64"
          },
          "ReceiverAccountName": {
            "type": "string"
          },
          "Amount": {
            "type": "number",
            "format": "decimal"
          },
          "TransferDate": {
            "type": "string",
            "format": "date-time"
          },
          "PeriodEnd": {
            "type": "string"
          },
          "CollectionPeriodMonth": {
            "type": "integer"
          },
          "CollectionPeriodYear": {
            "type": "integer"
          },
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "CourseName": {
            "type": "string"
          },
          "CourseLevel": {
            "type": "integer",
            "nullable": true
          },
          "LearningType": {
            "type": "string"
          },
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "Type": {
            "type": "string"
          },
          "RequiredPaymentId": {
            "type": "string",
            "format": "uuid"
          },
          "CreatedBy": {
            "type": "string"
          },
          "CorrelationId": {
            "type": "string"
          }
        },
        "required": [
          "TransferId",
          "SenderAccountId",
          "ReceiverAccountId",
          "Amount",
          "TransferDate",
          "PeriodEnd",
          "CollectionPeriodMonth",
          "CollectionPeriodYear",
          "Ukprn",
          "ApprenticeshipId",
          "RequiredPaymentId"
        ]
      }
    }
  }
}
