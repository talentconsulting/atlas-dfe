{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0",
    "description": "API for managing employer finance operations."
  },
  "paths": {
    "/api/staging/staged-to-operational": {
      "post": {
        "summary": "Transfers staged data to operational state.",
        "operationId": "transferStagedToOperational",
        "security": [
          {
            "ApiRoles.ReadAllEmployerAccountBalances": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferStagedToOperationalRequest"
              }
            }
          },
          "description": "The payload for transferring staged data to operational state."
        },
        "responses": {
          "400": {
            "description": "Bad request - validation errors or missing payload.",
            "content": {
              "application/json": {
                "examples": {
                  "missingPayload": {
                    "value": "Transfer staged-to-operational payload is required."
                  },
                  "validationErrors": {
                    "value": {
                      "errors": [
                        "Example validation error."
                      ]
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error when the operation fails.",
            "content": {
              "application/json": {
                "examples": {
                  "operationFailure": {
                    "value": {
                      "isSuccess": false,
                      "message": "Failure message example.",
                      "processedCount": 0
                    }
                  }
                }
              }
            }
          },
          "201": {
            "description": "Successful transfer to operational state.",
            "content": {
              "application/json": {
                "examples": {
                  "success": {
                    "value": {
                      "isSuccess": true,
                      "message": "Success message example.",
                      "processedCount": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TransferStagedToOperationalRequest": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64",
            "description": "The ID of the employer account to transfer."
          },
          "PeriodEnd": {
            "type": "string",
            "description": "The period end identifier for the staged data."
          },
          "CorrelationId": {
            "type": "string",
            "description": "A unique identifier for correlating requests."
          }
        },
        "required": [
          "AccountId",
          "PeriodEnd",
          "CorrelationId"
        ]
      }
    },
    "securitySchemes": {
      "ApiRoles.ReadAllEmployerAccountBalances": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "Role-based authorization scheme requiring 'ReadAllEmployerAccountBalances' API role."
      }
    }
  }
}
