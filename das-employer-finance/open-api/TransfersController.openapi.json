{
  "openapi": "3.1.0",
  "info": {
    "title": "Transfers API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{hashedAccountId}/transfers": {
      "get": {
        "summary": "Get transfers index",
        "description": "Retrieves transfer details for a given account.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed identifier of the account."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "PolicyNames.HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    },
    "/accounts/{hashedAccountId}/transfers/financial-breakdown": {
      "get": {
        "summary": "Financial breakdown",
        "description": "Redirects to an error page with a status code of 404.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed identifier of the account."
          }
        ],
        "responses": {
          "404": {
            "description": "Resource not found."
          }
        },
        "security": [
          {
            "PolicyNames.HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
