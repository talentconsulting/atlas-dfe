{
  "openapi": "3.1.0",
  "info": {
    "title": "TransfersController API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{hashedAccountId}/transfers": {
      "get": {
        "summary": "Get transfer index details",
        "operationId": "getTransfersIndex",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/transfers/financial-breakdown": {
      "get": {
        "summary": "Redirect to error page for financial breakdown",
        "operationId": "redirectFinancialBreakdown",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
