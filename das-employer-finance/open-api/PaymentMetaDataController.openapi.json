{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/payments/{paymentId}/metadata/staging": {
      "put": {
        "summary": "Update Payment Metadata Staging",
        "description": "Updates payment metadata and stores it in staging.",
        "parameters": [
          {
            "name": "paymentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentMetaDataStaging"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment metadata updated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "upserted": {
                      "type": "boolean",
                      "description": "Indicates if the metadata was created or updated."
                    },
                    "metadataId": {
                      "type": "string",
                      "format": "uuid",
                      "description": "The ID of the metadata record."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found - Payment not found."
          },
          "500": {
            "description": "Internal Server Error - Could not update Payment Metadata Staging."
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "PaymentMetaDataStaging": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderName": {
            "type": "string"
          },
          "StandardCode": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "FrameworkCode": {
            "type": "integer",
            "nullable": true
          },
          "ProgrammeType": {
            "type": "integer",
            "nullable": true
          },
          "PathwayCode": {
            "type": "integer",
            "nullable": true
          },
          "PathwayName": {
            "type": "string"
          },
          "ApprenticeshipCourseName": {
            "type": "string"
          },
          "ApprenticeshipCourseStartDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "ApprenticeshipCourseLevel": {
            "type": "integer",
            "nullable": true
          },
          "ApprenticeName": {
            "type": "string"
          },
          "ApprenticeNINumber": {
            "type": "string"
          },
          "IsHistoricProviderName": {
            "type": "boolean"
          },
          "LearningType": {
            "type": "string"
          },
          "CourseCode": {
            "type": "string"
          },
          "CohortId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "CreatedBy": {
            "type": "string"
          },
          "CorrelationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "PaymentId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "Id",
          "ProviderName",
          "PathwayName",
          "ApprenticeshipCourseName",
          "ApprenticeName",
          "ApprenticeNINumber",
          "IsHistoricProviderName",
          "LearningType",
          "CourseCode",
          "CreatedBy",
          "PaymentId"
        ]
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "tokenUrl": "https://example.com/oauth/token",
            "scopes": {}
          }
        }
      }
    }
  }
}
