{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/payments/{paymentId}/metadata/staging": {
      "put": {
        "summary": "Update Payment Metadata Staging",
        "operationId": "updatePaymentMetaDataStaging",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "paymentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentMetaDataStaging"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "upserted": {
                      "type": "boolean"
                    },
                    "metadataId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PaymentMetaDataStaging": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderName": {
            "type": "string"
          },
          "StandardCode": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "FrameworkCode": {
            "type": "integer",
            "nullable": true
          },
          "ProgrammeType": {
            "type": "integer",
            "nullable": true
          },
          "PathwayCode": {
            "type": "integer",
            "nullable": true
          },
          "PathwayName": {
            "type": "string"
          },
          "ApprenticeshipCourseName": {
            "type": "string"
          },
          "ApprenticeshipCourseStartDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "ApprenticeshipCourseLevel": {
            "type": "integer",
            "nullable": true
          },
          "ApprenticeName": {
            "type": "string"
          },
          "ApprenticeNINumber": {
            "type": "string"
          },
          "IsHistoricProviderName": {
            "type": "boolean"
          },
          "LearningType": {
            "type": "string"
          },
          "CourseCode": {
            "type": "string"
          },
          "CohortId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "CreatedBy": {
            "type": "string"
          },
          "CorrelationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "PaymentId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "Id",
          "ProviderName",
          "PaymentId"
        ]
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
