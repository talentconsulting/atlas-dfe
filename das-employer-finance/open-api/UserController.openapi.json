{
  "openapi": "3.1.0",
  "info": {
    "title": "User API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/user/upsert": {
      "put": {
        "summary": "Upsert a registered user",
        "operationId": "UpsertRegisteredUser",
        "tags": [
          "User"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertRegisteredUserCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User record successfully upserted"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "ApiRoles_ReadUserAccounts": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "UpsertRegisteredUserCommand": {
        "type": "object",
        "properties": {
          "UserRef": {
            "type": "string"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "EmailAddress": {
            "type": "string",
            "format": "email"
          },
          "CorrelationId": {
            "type": "string"
          }
        },
        "required": [
          "UserRef",
          "FirstName",
          "LastName",
          "EmailAddress",
          "CorrelationId"
        ]
      }
    },
    "securitySchemes": {
      "ApiRoles_ReadUserAccounts": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}
