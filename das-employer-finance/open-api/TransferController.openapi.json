{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{accountId}/transfer/connections": {
      "get": {
        "summary": "Retrieve transfers by period end for a specified account",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the account",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "periodEnd",
            "in": "query",
            "required": true,
            "description": "The period end identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with transfer details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request due to missing query parameter",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "periodEnd query parameter is required."
                }
              }
            }
          },
          "404": {
            "description": "Not found if no transfers match the criteria",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "No transfers found for account {accountId} and period {periodEnd}."
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "TransferResponse": {
        "type": "object",
        "properties": {
          "accountTransfers": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "ApiRoles": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "Use a valid API key with appropriate roles defined in ApiRoles to access this endpoint"
      }
    }
  }
}
