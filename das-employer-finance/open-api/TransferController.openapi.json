{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{accountId}/transfer/connections": {
      "get": {
        "summary": "Get transfers by period end",
        "description": "Fetch transfer connections for a specific account ID within a specified period end.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "Account ID for which the transfers are being fetched.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "periodEnd",
            "in": "query",
            "required": true,
            "description": "The period end for which the transfers are being fetched.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response containing transfers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request. The 'periodEnd' query parameter is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found. No transfers found for the provided accountId and periodEnd.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "TransferResponse": {
        "type": "object",
        "properties": {
          "accountTransfers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "transferId": {
                  "type": "integer",
                  "format": "int64"
                },
                "amount": {
                  "type": "number",
                  "format": "decimal"
                },
                "destinationAccountId": {
                  "type": "integer",
                  "format": "int64"
                },
                "periodEnd": {
                  "type": "string"
                }
              }
            }
          }
        },
        "required": [
          "accountTransfers"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "message"
        ]
      }
    },
    "securitySchemes": {
      "Authorization": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
