{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{hashedAccountId}/transactions": {
      "get": {
        "operationId": "GetTransactionSummary",
        "summary": "Get a summary of transactions for an account.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "transactionType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "periodEnd",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with transaction summary.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionSummary"
                }
              }
            }
          },
          "400": {
            "description": "Bad request due to missing or invalid query parameters."
          },
          "404": {
            "description": "Transaction summary not found."
          }
        },
        "security": [
          {
            "ApiRoles_ReadAllEmployerAccountBalances": []
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/transactions/{year}/{month}": {
      "get": {
        "operationId": "GetTransactions",
        "summary": "Get transaction lines for a specific year and month.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "month",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with transaction details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transactions"
                }
              }
            }
          },
          "404": {
            "description": "Transactions not found for the given year and month."
          }
        },
        "security": [
          {
            "ApiRoles_ReadAllEmployerAccountBalances": []
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/transactions/query": {
      "get": {
        "operationId": "QueryAccountTransactions",
        "summary": "Query transactions within a date range.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with transactions within the date range.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transactions"
                }
              }
            }
          },
          "400": {
            "description": "Bad request due to missing or invalid query parameters."
          },
          "404": {
            "description": "Transactions not found for the provided date range."
          }
        },
        "security": [
          {
            "ApiRoles_ReadAllEmployerAccountBalances": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "TransactionSummary": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "year": {
              "type": "integer"
            },
            "month": {
              "type": "integer"
            },
            "href": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "Transactions": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer"
          },
          "month": {
            "type": "integer"
          },
          "hasPreviousTransactions": {
            "type": "boolean"
          },
          "previousMonthUri": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "ApiRoles_ReadAllEmployerAccountBalances": {
        "type": "oauth2",
        "description": "Authorization required using the ReadAllEmployerAccountBalances policy.",
        "flows": {
          "implicit": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "scopes": {
              "ReadAllEmployerAccountBalances": "Access employer account balances."
            }
          }
        }
      }
    }
  }
}
