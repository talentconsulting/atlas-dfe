{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API - Account Transactions",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{hashedAccountId}/transactions": {
      "get": {
        "operationId": "getTransactionSummary",
        "summary": "Get account transaction summary or existing transaction lines",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "transactionType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "periodEnd",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TransactionSummary"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input parameter(s)"
          },
          "404": {
            "description": "Transaction summary not found"
          }
        },
        "security": [
          {
            "oauth2": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ],
        "tags": [
          "Account Transactions"
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/transactions/{year}/{month}": {
      "get": {
        "operationId": "getTransactions",
        "summary": "Get transactions for a specific year and month",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "month",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transactions"
                }
              }
            }
          },
          "404": {
            "description": "Transactions not found"
          }
        },
        "security": [
          {
            "oauth2": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ],
        "tags": [
          "Account Transactions"
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/transactions/query": {
      "get": {
        "operationId": "queryAccountTransactions",
        "summary": "Query account transactions within a date range",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fetched account transactions successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transactions"
                }
              }
            }
          },
          "400": {
            "description": "Invalid date range"
          },
          "404": {
            "description": "Transactions not found"
          }
        },
        "security": [
          {
            "oauth2": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ],
        "tags": [
          "Account Transactions"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "TransactionSummary": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer"
          },
          "month": {
            "type": "integer"
          },
          "href": {
            "type": "string"
          }
        }
      },
      "Transactions": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer"
          },
          "month": {
            "type": "integer"
          },
          "hasPreviousTransactions": {
            "type": "boolean"
          },
          "previousMonthUri": {
            "type": "string"
          },
          "transactionLines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransactionLine"
            }
          }
        }
      },
      "TransactionLine": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "format": "double"
          }
        }
      }
    },
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/auth",
            "tokenUrl": "https://example.com/token",
            "scopes": {
              "ReadAllEmployerAccountBalances": "Permission to read all employer account balances"
            }
          }
        }
      }
    }
  }
}
