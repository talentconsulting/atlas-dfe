{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/paye-schemes/last-submission-date": {
      "get": {
        "operationId": "GetLastSubmissionDate",
        "summary": "Retrieve the last submission date for a PAYE scheme.",
        "parameters": [
          {
            "name": "empRef",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The PAYE scheme reference. Must be provided as a query parameter."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response, returns the last submission date for the PAYE scheme.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "2023-10-01T00:00:00Z"
                }
              }
            }
          },
          "400": {
            "description": "Bad request due to validation errors.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRolesAuth": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ValidationError": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        },
        "description": "Validation error details keyed by field or context."
      }
    },
    "securitySchemes": {
      "ApiRolesAuth": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "API key-based authorization using predefined roles."
      }
    }
  }
}
