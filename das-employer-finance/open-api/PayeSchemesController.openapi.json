{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/paye-schemes/last-submission-date": {
      "get": {
        "summary": "Get the last submission date for a PAYE scheme",
        "operationId": "GetLastSubmissionDate",
        "parameters": [
          {
            "name": "empRef",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "The employer PAYE reference (empRef)."
          }
        ],
        "responses": {
          "200": {
            "description": "Last submission date retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request due to validation errors.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles_ReadAllEmployerAccountBalances": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ValidationError": {
        "type": "object",
        "properties": {
          "Validation": {
            "type": "string",
            "description": "Validation error message."
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Dictionary of validation errors with field names as keys and error messages as values."
          }
        }
      }
    },
    "securitySchemes": {
      "ApiRoles_ReadAllEmployerAccountBalances": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization scheme requiring 'ReadAllEmployerAccountBalances' role."
      }
    }
  }
}
