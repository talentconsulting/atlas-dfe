@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_employer_finance, "Employer Finance") {
  Container(c_employer_finance, "Employer Finance", "API")
  Container(c_employer_finance_jobs, "Employer Finance Jobs", "Background Job")
  Container(c_employer_finance_message_handlers, "Employer Finance Message Handlers", "Background Job")
  Container(c_employer_finance_web, "Employer Finance", "Web Application")
}

SystemDb_Ext(d_cache_redis, "Redis", "Redis")
SystemDb_Ext(d_cache_stackexchange_redis, "StackExchange Redis", "Redis")
SystemDb_Ext(d_database_sql_server, "SQL Server", "SQL Server")
System_Ext(d_http_api_apprenticeship_levy, "Apprenticeship Levy", "HttpClient")
System_Ext(d_http_api_commitments_v2, "Commitments V2", "HttpClient")
System_Ext(d_http_api_content_api, "Content API", "HTTP")
System_Ext(d_http_api_outer_api, "Outer API", "HTTP")
System_Ext(d_http_api_payments_events, "Payments Events")
System_Ext(d_http_api_token_service, "Token Service", "HttpClient")
SystemQueue_Ext(d_message_broker_azure_service_bus, "Azure Service Bus", "Azure")

Rel(c_employer_finance, d_cache_redis, "Caches data in", "Redis")
Rel(c_employer_finance, d_cache_stackexchange_redis, "Caches data in", "Redis")
Rel(c_employer_finance, d_database_sql_server, "Reads from and writes to", "SQL Server")
Rel(c_employer_finance_web, d_database_sql_server, "Reads from and writes to", "EntityFrameworkCore")
Rel(c_employer_finance_message_handlers, d_http_api_apprenticeship_levy, "Calls the API of", "HttpClient")
Rel(c_employer_finance_message_handlers, d_http_api_commitments_v2, "Calls the API of", "HttpClient")
Rel(c_employer_finance, d_http_api_content_api, "Calls the API of", "HTTP")
Rel(c_employer_finance, d_http_api_outer_api, "Calls the API of", "HTTP")
Rel(c_employer_finance_web, d_http_api_outer_api, "Calls the API of", "HttpClient")
Rel(c_employer_finance_message_handlers, d_http_api_payments_events, "Calls the API of")
Rel(c_employer_finance_web, d_http_api_token_service, "Calls the API of", "HttpClient")
Rel(c_employer_finance, d_message_broker_azure_service_bus, "Publishes messages to and consumes messages from", "Azure")
Rel(c_employer_finance_jobs, d_message_broker_azure_service_bus, "Publishes messages to and consumes messages from", "Azure Service Bus")
Rel(c_employer_finance_message_handlers, d_message_broker_azure_service_bus, "Publishes messages to and consumes messages from", "Azure Service Bus")

@enduml
