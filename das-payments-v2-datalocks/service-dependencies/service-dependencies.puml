@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_payments_v2_datalocks, "Payments DataLocks") {
  Container(c_payments_datalocks_application, "Payments DataLocks Application", "Component")
  Container(c_payments_datalocks_approvalsservice, "Payments DataLocks ApprovalsService", "Background Job")
  Container(c_payments_datalocks_datalockeventservice, "Payments DataLocks DataLockEventService", "Background Job")
  Container(c_payments_datalocks_datalockproxyservice, "Payments DataLocks DataLockProxyService", "Background Job")
  Container(c_payments_datalocks_datalockservice, "Payments DataLocks DataLockService", "Background Job")
  Container(c_payments_datalocks_datalockstatuschangedservice, "Payments DataLocks DataLockStatusChangedService", "Background Job")
}

SystemQueue_Ext(d_message_broker_azure_service_bus, "Azure Service Bus", "Azure Service Bus")
System_Ext(d_telemetry_application_insights, "Application Insights", "Application Insights")

Rel(c_payments_datalocks_approvalsservice, d_message_broker_azure_service_bus, "Publishes messages to and consumes messages from", "Azure Service Bus")
Rel(c_payments_datalocks_approvalsservice, d_telemetry_application_insights, "Sends telemetry to", "Application Insights")
Rel(c_payments_datalocks_datalockeventservice, d_telemetry_application_insights, "Sends telemetry to", "Application Insights")

@enduml
