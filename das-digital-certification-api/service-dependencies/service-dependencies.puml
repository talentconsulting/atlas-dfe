@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_digital_certification_api, "Digital Certificates") {
  Container(c_digital_certificates, "Digital Certificates", "API")
}

SystemDb_Ext(d_configuration_store_azure_app_configuration, "Azure App Configuration")
SystemDb_Ext(d_database_digital_certificates_database, "Digital Certificates Database", "SQL Server")
System_Ext(d_identity_provider_microsoft_entra_id, "Microsoft Entra ID")
System_Ext(d_telemetry_application_insights, "Application Insights")

Rel(c_digital_certificates, d_configuration_store_azure_app_configuration, "Reads configuration from")
Rel(c_digital_certificates, d_database_digital_certificates_database, "Reads from and writes to", "SQL Server")
Rel(c_digital_certificates, d_identity_provider_microsoft_entra_id, "Authenticates with")
Rel(c_digital_certificates, d_telemetry_application_insights, "Sends telemetry to")

@enduml
