{
  "openapi": "3.1.0",
  "info": {
    "title": "Digital Certificates Sharing API",
    "version": "1.0.0",
    "description": "API for managing digital certificate sharing and related operations."
  },
  "paths": {
    "/api/sharing/sharingemail/emaillinkcode/{emailLinkCode}": {
      "get": {
        "summary": "Retrieve sharing email details by email link code",
        "parameters": [
          {
            "name": "emailLinkCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetSharingByEmailLinkCodeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Entity not found"
          },
          "400": {
            "description": "Validation errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/sharing/linkcode/{linkCode}": {
      "get": {
        "summary": "Retrieve sharing details by link code",
        "parameters": [
          {
            "name": "linkCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetSharingByLinkCodeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Entity not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/sharing/{id}": {
      "delete": {
        "summary": "Delete sharing by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Sharing deleted successfully"
          },
          "404": {
            "description": "Entity not found"
          },
          "400": {
            "description": "Validation errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/sharing": {
      "post": {
        "summary": "Create a new sharing",
        "requestBody": {
          "description": "Sharing creation request data",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSharingRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sharing created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateSharingResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/sharing/{id}/email": {
      "post": {
        "summary": "Create sharing email for a given sharing ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "description": "Sharing email creation request data",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSharingEmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sharing email created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateSharingEmailResponse"
                }
              }
            }
          },
          "404": {
            "description": "Entity not found"
          },
          "400": {
            "description": "Validation errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/sharing/sharingaccess": {
      "post": {
        "summary": "Create sharing access",
        "requestBody": {
          "description": "Sharing access creation request data",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSharingAccessRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Sharing access created successfully"
          },
          "400": {
            "description": "Validation errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/sharing/sharingemailaccess": {
      "post": {
        "summary": "Create sharing email access",
        "requestBody": {
          "description": "Sharing email access creation request data",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSharingEmailAccessRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Sharing email access created successfully"
          },
          "400": {
            "description": "Validation errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateSharingRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "certificateId": {
            "type": "string",
            "format": "uuid"
          },
          "certificateType": {
            "type": "string",
            "enum": [
              "Unknown",
              "Standard",
              "Framework"
            ]
          },
          "courseName": {
            "type": "string"
          }
        },
        "required": [
          "userId",
          "certificateId",
          "certificateType",
          "courseName"
        ]
      },
      "CreateSharingResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "certificateId": {
            "type": "string",
            "format": "uuid"
          },
          "certificateType": {
            "type": "string",
            "enum": [
              "Unknown",
              "Standard",
              "Framework"
            ]
          },
          "courseName": {
            "type": "string"
          },
          "sharingId": {
            "type": "string",
            "format": "uuid"
          },
          "sharingNumber": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "linkCode": {
            "type": "string",
            "format": "uuid"
          },
          "expiryTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateSharingEmailRequest": {
        "type": "object",
        "properties": {
          "emailAddress": {
            "type": "string"
          }
        },
        "required": [
          "emailAddress"
        ]
      },
      "CreateSharingEmailResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "emailLinkCode": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CreateSharingAccessRequest": {
        "type": "object",
        "properties": {
          "sharingId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "sharingId"
        ]
      },
      "CreateSharingEmailAccessRequest": {
        "type": "object",
        "properties": {
          "sharingEmailId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "sharingEmailId"
        ]
      },
      "GetSharingByEmailLinkCodeResponse": {
        "type": "object",
        "properties": {
          "sharingEmailId": {
            "type": "string",
            "format": "uuid"
          },
          "certificateId": {
            "type": "string",
            "format": "uuid"
          },
          "certificateType": {
            "type": "string",
            "enum": [
              "Unknown",
              "Standard",
              "Framework"
            ]
          },
          "expiryTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GetSharingByLinkCodeResponse": {
        "type": "object",
        "properties": {
          "sharingId": {
            "type": "string",
            "format": "uuid"
          },
          "certificateId": {
            "type": "string",
            "format": "uuid"
          },
          "certificateType": {
            "type": "string",
            "enum": [
              "Unknown",
              "Standard",
              "Framework"
            ]
          },
          "expiryTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GetSharingByIdResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "certificateId": {
            "type": "string",
            "format": "uuid"
          },
          "certificateType": {
            "type": "string",
            "enum": [
              "Unknown",
              "Standard",
              "Framework"
            ]
          },
          "courseName": {
            "type": "string"
          },
          "sharingId": {
            "type": "string",
            "format": "uuid"
          },
          "sharingNumber": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "linkCode": {
            "type": "string",
            "format": "uuid"
          },
          "expiryTime": {
            "type": "string",
            "format": "date-time"
          },
          "sharingAccess": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "date-time"
            }
          },
          "sharingEmails": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SharingEmailDetailGetById"
            }
          }
        }
      },
      "SharingEmailDetailGetById": {
        "type": "object",
        "properties": {
          "sharingEmailId": {
            "type": "string",
            "format": "uuid"
          },
          "emailAddress": {
            "type": "string"
          },
          "emailLinkCode": {
            "type": "string",
            "format": "uuid"
          },
          "sentTime": {
            "type": "string",
            "format": "date-time"
          },
          "sharingEmailAccess": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
