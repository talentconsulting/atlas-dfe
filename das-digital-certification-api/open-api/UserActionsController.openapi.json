{
  "openapi": "3.1.0",
  "info": {
    "title": "Digital Certificates API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/user-actions/{userActionId}/admin-actions": {
      "post": {
        "summary": "Create an admin action for a user action",
        "operationId": "createAdminAction",
        "parameters": [
          {
            "name": "userActionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAdminActionRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/user-actions/{code}": {
      "get": {
        "summary": "Retrieve a user action by code",
        "operationId": "getUserActionByCode",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetUserActionByCodeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateAdminActionRequest": {
        "type": "object",
        "properties": {
          "Username": {
            "type": "string"
          },
          "Action": {
            "$ref": "#/components/schemas/AdminActionType"
          }
        },
        "required": [
          "Username",
          "Action"
        ]
      },
      "GetUserActionByCodeResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          },
          "UserId": {
            "type": "string",
            "format": "uuid"
          },
          "ActionType": {
            "$ref": "#/components/schemas/ActionType"
          },
          "ActionTime": {
            "type": "string",
            "format": "date-time"
          },
          "ActionStatus": {
            "$ref": "#/components/schemas/UserActionStatus"
          },
          "FamilyName": {
            "type": "string"
          },
          "GivenNames": {
            "type": "string"
          },
          "CertificateId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "CertificateType": {
            "$ref": "#/components/schemas/CertificateType",
            "nullable": true
          },
          "CourseName": {
            "type": "string",
            "nullable": true
          },
          "AdminActions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminActionResponse"
            },
            "nullable": true
          },
          "Uln": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          }
        },
        "required": [
          "Id",
          "UserId",
          "ActionType",
          "ActionTime",
          "ActionStatus",
          "FamilyName",
          "GivenNames"
        ]
      },
      "AdminActionResponse": {
        "type": "object",
        "properties": {
          "Username": {
            "type": "string"
          },
          "ActionTime": {
            "type": "string",
            "format": "date-time"
          },
          "Action": {
            "$ref": "#/components/schemas/AdminActionType"
          }
        },
        "required": [
          "Username",
          "ActionTime",
          "Action"
        ]
      },
      "ActionType": {
        "type": "string",
        "enum": [
          "Reprint",
          "Help",
          "Contact",
          "NotMatched",
          "NotFound"
        ]
      },
      "CertificateType": {
        "type": "string",
        "enum": [
          "Unknown",
          "Standard",
          "Framework"
        ]
      },
      "AdminActionType": {
        "type": "string",
        "enum": [
          "Viewed",
          "Unlocked"
        ]
      },
      "UserActionStatus": {
        "type": "string",
        "enum": [
          "New",
          "Viewed"
        ]
      }
    }
  }
}
