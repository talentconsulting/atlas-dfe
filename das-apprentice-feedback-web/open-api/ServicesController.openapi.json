{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Feedback Web API",
    "version": "1.0.0"
  },
  "paths": {
    "/account-details": {
      "get": {
        "operationId": "getAccountDetails",
        "summary": "Retrieve stub account details view.",
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response. Returns the account details view."
          },
          "404": {
            "description": "Not Found if the environment is production."
          }
        }
      },
      "post": {
        "operationId": "postAccountDetails",
        "summary": "Submit stub account details and sign in.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StubAuthenticationViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to route after successful sign-in."
          },
          "404": {
            "description": "Not Found if the environment is production."
          }
        }
      }
    },
    "/Stub-Auth": {
      "get": {
        "operationId": "getStubSignedIn",
        "summary": "Retrieve stub signed-in view.",
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response. Returns signed-in user view.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StubAuthenticationViewModel"
                }
              }
            }
          },
          "404": {
            "description": "Not Found if the environment is production."
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "StubAuthenticationViewModel": {
        "type": "object",
        "properties": {
          "ReturnUrl": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "Id": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "CookieAuthentication"
      }
    }
  }
}
