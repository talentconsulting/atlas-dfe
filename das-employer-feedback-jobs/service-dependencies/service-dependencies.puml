@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_employer_feedback_jobs, "Employer Feedback") {
  Container(c_employer_feedback_jobs, "Employer Feedback Jobs", "Background Job")
}

SystemDb_Ext(d_configuration_store_azure_table_storage_configuration, "Azure Table Storage Configuration")
System_Ext(d_http_api_employer_feedback_outer, "Employer Feedback Outer", "HTTP")
System_Ext(d_telemetry_application_insights, "Application Insights")

Rel(c_employer_feedback_jobs, d_configuration_store_azure_table_storage_configuration, "Reads configuration from")
Rel(c_employer_feedback_jobs, d_http_api_employer_feedback_outer, "Calls the API of", "HTTP")
Rel(c_employer_feedback_jobs, d_telemetry_application_insights, "Sends telemetry to")

@enduml
